@model HealthTrack.Areas.Trainer.ViewModels.ExerciseLibraryViewModel

@{
    ViewBag.Title = "Exercise Library";
}

<div class="container-fluid px-4 py-3">

    <!-- Header & Action Row -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                    <i class="bi bi-collection-play me-1"></i>Exercise Library
                </span>
                <span class="badge bg-light text-dark border px-2 py-1">
                    @Model.TotalExercisesCount Reusable Movements
                </span>
            </div>
            <h2 class="h3 fw-bold mb-0 text-dark">Exercise Library</h2>
            <p class="text-muted small mb-0">Browse, filter, and select verified exercises across muscle groups, equipment, and difficulty levels</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Create")" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Add New Exercise</span>
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill fs-5 text-success"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Quick Category Metric Pills -->
    <div class="d-flex flex-wrap gap-2 mb-4">
        <a href="@Url.Action("Index")" class="btn btn-sm @(string.IsNullOrEmpty(Model.SelectedCategory) || Model.SelectedCategory == "All Categories" ? "btn-dark shadow-sm" : "btn-outline-secondary bg-white") rounded-pill px-3">
            All <span class="badge bg-secondary ms-1">@Model.TotalExercisesCount</span>
        </a>
        <a href="@Url.Action("Index", new { category = "Strength" })" class="btn btn-sm @(Model.SelectedCategory == "Strength" ? "btn-primary shadow-sm" : "btn-outline-secondary bg-white") rounded-pill px-3">
            <i class="bi bi-bar-chart-steps me-1"></i> Strength <span class="badge bg-primary-subtle text-primary ms-1">@Model.StrengthCount</span>
        </a>
        <a href="@Url.Action("Index", new { category = "Cardio" })" class="btn btn-sm @(Model.SelectedCategory == "Cardio" ? "btn-danger shadow-sm" : "btn-outline-secondary bg-white") rounded-pill px-3">
            <i class="bi bi-heart-pulse me-1"></i> Cardio <span class="badge bg-danger-subtle text-danger ms-1">@Model.CardioCount</span>
        </a>
        <a href="@Url.Action("Index", new { category = "Core" })" class="btn btn-sm @(Model.SelectedCategory == "Core" ? "btn-success shadow-sm" : "btn-outline-secondary bg-white") rounded-pill px-3">
            <i class="bi bi-shield-check me-1"></i> Core <span class="badge bg-success-subtle text-success ms-1">@Model.CoreCount</span>
        </a>
        <a href="@Url.Action("Index", new { category = "HIIT" })" class="btn btn-sm @(Model.SelectedCategory == "HIIT" ? "btn-warning shadow-sm" : "btn-outline-secondary bg-white") rounded-pill px-3">
            <i class="bi bi-lightning-charge me-1"></i> HIIT <span class="badge bg-warning-subtle text-dark ms-1">@Model.HiitCount</span>
        </a>
        <a href="@Url.Action("Index", new { category = "Flexibility" })" class="btn btn-sm @(Model.SelectedCategory == "Flexibility" ? "btn-info shadow-sm" : "btn-outline-secondary bg-white") rounded-pill px-3">
            <i class="bi bi-peace me-1"></i> Flexibility <span class="badge bg-info-subtle text-info ms-1">@Model.FlexibilityCount</span>
        </a>
    </div>

    <!-- Search & Faceted Filter Controls -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" action="@Url.Action("Index")" class="row g-2 align-items-center">
                <div class="col-md-3">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" name="search" value="@Model.SearchTerm" class="form-control bg-light border-start-0" 
                               placeholder="Search exercise, muscle, equipment..." />
                    </div>
                </div>

                <div class="col-md-2">
                    <select name="category" class="form-select bg-light">
                        @foreach (var cat in Model.Categories)
                        {
                            var catVal = cat.StartsWith("All ") ? "" : cat;
                            <option value="@catVal" @(Model.SelectedCategory == cat || Model.SelectedCategory == catVal || (string.IsNullOrEmpty(Model.SelectedCategory) && catVal == "") ? "selected" : "")>@cat</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <select name="difficulty" class="form-select bg-light">
                        @foreach (var diff in Model.Difficulties)
                        {
                            var diffVal = diff.StartsWith("All ") ? "" : diff;
                            <option value="@diffVal" @(Model.SelectedDifficulty == diff || Model.SelectedDifficulty == diffVal || (string.IsNullOrEmpty(Model.SelectedDifficulty) && diffVal == "") ? "selected" : "")>@diff</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <select name="muscle" class="form-select bg-light">
                        @foreach (var m in Model.MuscleGroups)
                        {
                            var mVal = m.StartsWith("All ") ? "" : m;
                            <option value="@mVal" @(Model.SelectedMuscle == m || Model.SelectedMuscle == mVal || (string.IsNullOrEmpty(Model.SelectedMuscle) && mVal == "") ? "selected" : "")>@m</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <select name="equipment" class="form-select bg-light">
                        @foreach (var eq in Model.EquipmentList)
                        {
                            var eqVal = eq.StartsWith("All ") ? "" : eq;
                            <option value="@eqVal" @(Model.SelectedEquipment == eq || Model.SelectedEquipment == eqVal || (string.IsNullOrEmpty(Model.SelectedEquipment) && eqVal == "") ? "selected" : "")>@eq</option>
                        }
                    </select>
                </div>

                <div class="col-md-1 d-flex gap-1">
                    <button type="submit" class="btn btn-dark w-100" title="Apply Filters">
                        <i class="bi bi-funnel"></i>
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary" title="Reset Filters">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Exercise Grid -->
    @if (!Model.Exercises.Any())
    {
        <div class="card border-0 shadow-sm rounded-3 text-center p-5 bg-white">
            <div class="py-4">
                <i class="bi bi-search display-4 text-muted mb-3 d-block"></i>
                <h4 class="fw-semibold text-dark">No Exercises Found</h4>
                <p class="text-muted mb-4">No exercises matched your search or filter combination.</p>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary me-2">Clear Filters</a>
                <a href="@Url.Action("Create")" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i> Add Custom Exercise
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var ex in Model.Exercises)
            {
                <div class="col-3">
                    <div class="card border-0 shadow-sm rounded-3 h-100 transition-hover bg-white">
                        <div class="card-body p-4 d-flex flex-column">

                            <!-- Top Badges -->
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge @(ex.Category == "Strength" ? "bg-primary-subtle text-primary border border-primary-subtle" :
                                                    ex.Category == "Cardio" ? "bg-danger-subtle text-danger border border-danger-subtle" :
                                                    ex.Category == "Core" ? "bg-success-subtle text-success border border-success-subtle" :
                                                    ex.Category == "HIIT" ? "bg-warning-subtle text-dark border border-warning-subtle" : "bg-info-subtle text-info border border-info-subtle") fw-semibold">
                                    @ex.Category
                                </span>
                                
                                <span class="badge @(ex.DifficultyLevel == "Beginner" ? "bg-success-subtle text-success" :
                                                    ex.DifficultyLevel == "Intermediate" ? "bg-warning-subtle text-dark" : "bg-danger-subtle text-danger") border">
                                    @ex.DifficultyLevel
                                </span>
                            </div>

                            <!-- Exercise Thumbnail Photo -->
                            @if (!string.IsNullOrEmpty(ex.ImagePath))
                            {
                                <div class="rounded-2 overflow-hidden mb-2 border" style="height: 115px; background-color: #f1f5f9;">
                                    <img src="@Url.Content(ex.ImagePath)" alt="@ex.Name" class="w-100 h-100 object-fit-cover" 
                                         onerror="this.onerror=null;this.src='@Url.Content("~/Content/images/exercises/placeholder-exercise.png")';" />
                                </div>
                            }

                            <!-- Exercise Name & Muscle Info -->
                            <h5 class="fw-bold text-dark mt-1 mb-1">@ex.Name</h5>
                            
                            <div class="d-flex flex-wrap gap-1 mb-2">
                                <span class="badge bg-light text-dark border small">
                                    <i class="bi bi-crosshair text-primary me-1"></i>@ex.TargetMuscle
                                </span>
                                <span class="badge bg-light text-secondary border small">
                                    <i class="bi bi-tools me-1"></i>@ex.Equipment
                                </span>
                            </div>

                            <!-- Description Preview -->
                            <p class="text-muted small flex-grow-1 mb-3" style="min-height: 42px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @ex.Description
                            </p>

                            <!-- Calorie and Secondary Muscles Bar -->
                            <div class="bg-light rounded-3 p-2 mb-3 small d-flex justify-content-between align-items-center">
                                <span class="text-muted">
                                    <i class="bi bi-fire text-danger me-1"></i>~@ex.DefaultCaloriesBurnEstimate kcal / 10m
                                </span>
                                <span class="text-secondary small text-truncate" style="max-width: 130px;" title="@ex.SecondaryMuscles">
                                    @(string.IsNullOrWhiteSpace(ex.SecondaryMuscles) ? "Direct Focus" : ex.SecondaryMuscles)
                                </span>
                            </div>

                            <!-- Action Toolbar -->
                            <div class="d-flex gap-2 pt-2 border-top">
                                <a href="@Url.Action("Details", new { id = ex.ExerciseId })" class="btn btn-sm btn-outline-primary flex-fill">
                                    <i class="bi bi-eye me-1"></i> Details
                                </a>
                                
                                <!-- Direct Link to use this exercise in a Workout Plan -->
                                <a href="@Url.Action("Create", "WorkoutPlans", new { exerciseId = ex.ExerciseId })" 
                                   class="btn btn-sm btn-primary flex-fill" title="Prescribe this exercise in a new workout routine">
                                    <i class="bi bi-plus-circle me-1"></i> Use in Plan
                                </a>

                                <a href="@Url.Action("Edit", new { id = ex.ExerciseId })" class="btn btn-sm btn-outline-secondary" title="Edit Exercise">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                <form action="@Url.Action("Delete", new { id = ex.ExerciseId })" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Exercise"
                                            onclick="return confirm('Remove @ex.Name from exercise library?');">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>

<style>
    .transition-hover {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .transition-hover:hover {
        transform: translateY(-3px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.08) !important;
    }
</style>
