@model HealthTrack.Areas.Trainer.ViewModels.EditFeedbackViewModel

@{
    ViewBag.Title = "Edit Client Feedback";
}

<div class="container-fluid px-4 py-3">

    <!-- Header Row -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                    <i class="bi bi-chat-quote me-1"></i>Coaching Communication
                </span>
                <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                    <i class="bi bi-pencil-square me-1"></i>Edit Mode (FR-T-44)
                </span>
            </div>
            <h2 class="h3 fw-bold mb-0 text-dark">Edit Client Feedback</h2>
            <p class="text-muted small mb-0">Modify previously submitted feedback, recommendations, or observations for your assigned client</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("History", "Feedback", new { clientId = Model.ClientId })" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm">
                <i class="bi bi-arrow-left"></i>
                <span>Back to History</span>
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5 text-success"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Client & Original Submission Summary Banner -->
    <div class="alert alert-light border shadow-sm rounded-3 d-flex flex-wrap align-items-center justify-content-between mb-4 py-3 px-4 gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary">
                <i class="bi bi-person-check-fill fs-3"></i>
            </div>
            <div>
                <div class="text-muted x-small text-uppercase fw-semibold">Target Client</div>
                <div class="fw-bold text-dark fs-5">@Model.ClientName</div>
                <div class="text-muted small">@Model.ClientEmail</div>
            </div>
        </div>
        <div class="text-md-end">
            <div class="text-muted x-small text-uppercase fw-semibold">Original Submission Timestamp</div>
            <div class="fw-semibold text-primary">
                <i class="bi bi-calendar-check me-1"></i>@Model.SentAt.ToString("MMMM dd, yyyy 'at' hh:mm tt")
            </div>
            <div class="text-muted x-small">Original creation date is preserved upon update</div>
        </div>
    </div>

    <div class="row g-4">

        <!-- LEFT COLUMN: Feedback Edit Form -->
        <div class="col-lg-8">
            <div class="card border shadow-sm rounded-3 bg-white">
                <div class="card-body p-4">
                    @using (Html.BeginForm("Edit", "Feedback", FormMethod.Post, new { id = "editFeedbackForm" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.FeedbackId)
                        @Html.HiddenFor(m => m.ClientId)
                        @Html.HiddenFor(m => m.SentAt)
                        @Html.HiddenFor(m => m.ParentFeedbackId)

                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger small mb-3" })

                        <!-- 1. CATEGORY SELECTION -->
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark small text-uppercase d-block mb-2">
                                <i class="bi bi-tags text-primary me-1"></i> Feedback Category <span class="text-danger">*</span>
                            </label>
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <label class="card h-100 p-3 border rounded-3 cursor-pointer category-card @(Model.Category == "Workout" ? "border-primary bg-primary-subtle" : "")" for="catWorkout">
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <input type="radio" name="Category" id="catWorkout" value="Workout" class="form-check-input" @(Model.Category == "Workout" ? "checked" : "") />
                                            <span class="fw-bold text-dark"><i class="bi bi-stopwatch text-primary me-1"></i>Workout</span>
                                        </div>
                                        <p class="text-muted x-small mb-0">Routines, consistency &amp; exertion</p>
                                    </label>
                                </div>
                                <div class="col-md-4">
                                    <label class="card h-100 p-3 border rounded-3 cursor-pointer category-card @(Model.Category == "Diet" ? "border-success bg-success-subtle" : "")" for="catDiet">
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <input type="radio" name="Category" id="catDiet" value="Diet" class="form-check-input" @(Model.Category == "Diet" ? "checked" : "") />
                                            <span class="fw-bold text-dark"><i class="bi bi-egg-fried text-success me-1"></i>Diet &amp; Nutrition</span>
                                        </div>
                                        <p class="text-muted x-small mb-0">Meal logging, calories &amp; hydration</p>
                                    </label>
                                </div>
                                <div class="col-md-4">
                                    <label class="card h-100 p-3 border rounded-3 cursor-pointer category-card @(Model.Category == "General Progress" ? "border-info bg-info-subtle" : "")" for="catProgress">
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <input type="radio" name="Category" id="catProgress" value="General Progress" class="form-check-input" @(Model.Category == "General Progress" ? "checked" : "") />
                                            <span class="fw-bold text-dark"><i class="bi bi-graph-up-arrow text-info me-1"></i>General Progress</span>
                                        </div>
                                        <p class="text-muted x-small mb-0">Weight, BMI &amp; goal milestones</p>
                                    </label>
                                </div>
                            </div>
                            @Html.ValidationMessageFor(m => m.Category, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- 2. TITLE / SUBJECT -->
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark small text-uppercase">
                                <i class="bi bi-card-heading text-primary me-1"></i> Feedback Title / Subject <span class="text-danger">*</span>
                            </label>
                            @Html.TextBoxFor(m => m.Title, new { 
                                @class = "form-control shadow-sm", 
                                placeholder = "e.g., Week 3 Workout Consistency & Exertion Adjustments",
                                maxlength = "200",
                                required = "required"
                            })
                            @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- 3. FEEDBACK OBSERVATIONS -->
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark small text-uppercase">
                                <i class="bi bi-chat-text text-primary me-1"></i> Observations &amp; Detailed Review <span class="text-danger">*</span>
                            </label>
                            @Html.TextAreaFor(m => m.FeedbackText, new { 
                                @class = "form-control shadow-sm", 
                                rows = "6", 
                                placeholder = "Write your updated analysis of their logged workouts, nutrition adherence, or body measurements...",
                                required = "required"
                            })
                            @Html.ValidationMessageFor(m => m.FeedbackText, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- 4. ACTIONABLE RECOMMENDATIONS -->
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark small text-uppercase">
                                <i class="bi bi-list-check text-success me-1"></i> Actionable Recommendations &amp; Next Steps
                            </label>
                            @Html.TextAreaFor(m => m.Recommendations, new { 
                                @class = "form-control shadow-sm", 
                                rows = "4", 
                                placeholder = "1. Specific change or target for next week&#10;2. Rest intervals or hydration cue&#10;3. Check-in reminder..." 
                            })
                            <div class="form-text text-muted x-small">
                                Provide concrete recommendations that the client can immediately put into practice.
                            </div>
                        </div>

                        <!-- ACTION BUTTONS: Save Changes & Cancel -->
                        <div class="d-flex flex-wrap align-items-center justify-content-between pt-3 border-top gap-2">
                            <a href="@Url.Action("History", "Feedback", new { clientId = Model.ClientId })" class="btn btn-outline-secondary px-4 shadow-sm">
                                <i class="bi bi-x-circle me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm fw-semibold">
                                <i class="bi bi-check-circle-fill me-1"></i> Save Changes
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: Live Client Activity Snapshot Side Panel -->
        <div class="col-lg-4">
            <div class="card border shadow-sm rounded-3 bg-white sticky-top" style="top: 1rem;">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-activity text-primary me-2"></i>Client Activity Snapshot
                    </h6>
                    <span class="badge bg-light text-muted border x-small">Live Data</span>
                </div>
                <div class="card-body p-4" id="clientSnapshotContainer">
                    @if (Model.ClientSnapshot != null)
                    {
                        <!-- Client Header -->
                        <div class="d-flex align-items-center gap-3 mb-3 pb-3 border-bottom">
                            @{
                                var initials = "CL";
                                if (!string.IsNullOrWhiteSpace(Model.ClientSnapshot.FullName))
                                {
                                    var parts = Model.ClientSnapshot.FullName.Trim().Split(' ');
                                    initials = parts.Length > 1 
                                        ? (parts[0].Substring(0, 1) + parts[parts.Length - 1].Substring(0, 1)).ToUpper()
                                        : Model.ClientSnapshot.FullName.Substring(0, Math.Min(2, Model.ClientSnapshot.FullName.Length)).ToUpper();
                                }
                            }
                            <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-sm"
                                 style="width: 48px; height: 48px; background: linear-gradient(135deg, #0d6efd, #0dcaf0);">
                                @initials
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0 text-dark">@Model.ClientSnapshot.FullName</h6>
                                <div class="text-muted x-small">@Model.ClientSnapshot.Email</div>
                            </div>
                        </div>

                        <!-- Metrics Grid -->
                        <div class="row g-2 mb-3 text-center">
                            <div class="col-6">
                                <div class="p-2 bg-light rounded-3">
                                    <div class="text-muted x-small text-uppercase">Current Weight</div>
                                    <div class="fw-bold text-primary">
                                        @(Model.ClientSnapshot.CurrentWeightKg.HasValue ? Model.ClientSnapshot.CurrentWeightKg.Value.ToString("0.0") + " kg" : "—")
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 bg-light rounded-3">
                                    <div class="text-muted x-small text-uppercase">BMI Category</div>
                                    <div class="fw-bold text-info">
                                        @(Model.ClientSnapshot.CurrentBmi.HasValue ? Model.ClientSnapshot.CurrentBmi.Value.ToString("0.0") : "—")
                                        <span class="d-block x-small text-muted">@Model.ClientSnapshot.BmiCategory</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Goal & Assigned Plans -->
                        <ul class="list-group list-group-flush small mb-3">
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                <span class="text-muted"><i class="bi bi-flag me-1 text-primary"></i>Primary Goal</span>
                                <span class="fw-semibold text-dark">@Model.ClientSnapshot.PrimaryGoal</span>
                            </li>
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                <span class="text-muted"><i class="bi bi-stopwatch me-1 text-success"></i>Workout Plan</span>
                                <span class="fw-semibold text-dark text-truncate" style="max-width: 150px;">@Model.ClientSnapshot.ActiveWorkoutPlan</span>
                            </li>
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                <span class="text-muted"><i class="bi bi-egg-fried me-1 text-warning"></i>Diet Plan</span>
                                <span class="fw-semibold text-dark text-truncate" style="max-width: 150px;">@Model.ClientSnapshot.ActiveDietPlan</span>
                            </li>
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                <span class="text-muted"><i class="bi bi-journal-check me-1 text-info"></i>Total Logged Meals</span>
                                <span class="badge bg-secondary">@Model.ClientSnapshot.LoggedMealsCount</span>
                            </li>
                        </ul>

                        <div class="p-2 bg-light rounded-3 small">
                            <div class="text-muted x-small fw-semibold text-uppercase mb-1">
                                <i class="bi bi-clock-history me-1"></i>Last Workout
                            </div>
                            <div class="text-dark">@Model.ClientSnapshot.LastWorkoutSummary</div>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>

</div>

<style>
    .x-small {
        font-size: 0.75rem;
    }
    .category-card {
        transition: all 0.2s ease-in-out;
    }
    .category-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 0.25rem 0.5rem rgba(0, 0, 0, 0.05);
    }
</style>

@section scripts {
    <script>
        $(document).ready(function () {
            // Radio button styling toggle
            $('input[name="Category"]').on('change', function () {
                $('.category-card').removeClass('border-primary bg-primary-subtle border-success bg-success-subtle border-info bg-info-subtle');
                var val = $(this).val();
                if (val === 'Workout') {
                    $(this).closest('.category-card').addClass('border-primary bg-primary-subtle');
                } else if (val === 'Diet') {
                    $(this).closest('.category-card').addClass('border-success bg-success-subtle');
                } else if (val === 'General Progress') {
                    $(this).closest('.category-card').addClass('border-info bg-info-subtle');
                }
            });
        });
    </script>
}
