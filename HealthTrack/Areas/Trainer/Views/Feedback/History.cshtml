@model HealthTrack.Areas.Trainer.ViewModels.FeedbackHistoryViewModel

@{
    ViewBag.Title = "Feedback History";
}

<div class="container-fluid px-4 py-3">

    <!-- Header Row -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                    <i class="bi bi-chat-left-text me-1"></i>Client Management
                </span>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                    <i class="bi bi-shield-check me-1"></i>Audit &amp; Coaching History
                </span>
            </div>
            <h2 class="h3 fw-bold mb-0 text-dark">Feedback History</h2>
            <p class="text-muted small mb-0">Review previously sent coaching guidance, monitor drafts, and issue follow-up recommendations</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Send", "Feedback")" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm fw-semibold">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Send New Feedback</span>
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5 text-success"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Quick Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-md-4">
            <div class="card border shadow-sm rounded-3 p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted x-small text-uppercase fw-semibold">Total Sent Feedback</div>
                        <div class="h3 fw-bold text-success mb-0">@Model.TotalSentCount</div>
                        <div class="text-muted x-small">Permanent read-only records</div>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success">
                        <i class="bi bi-check2-circle fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-4">
            <div class="card border shadow-sm rounded-3 p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted x-small text-uppercase fw-semibold">Saved Drafts</div>
                        <div class="h3 fw-bold text-warning mb-0">@Model.TotalDraftsCount</div>
                        <div class="text-muted x-small">Unsent editable messages</div>
                    </div>
                    <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning">
                        <i class="bi bi-pencil-square fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-4">
            <div class="card border shadow-sm rounded-3 p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted x-small text-uppercase fw-semibold">Feedback Maintenance</div>
                        <div class="fw-semibold text-dark small mb-0">Active &amp; Editable</div>
                        <div class="text-muted x-small">View and update existing guidance</div>
                    </div>
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary">
                        <i class="bi bi-pencil-square fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter & Search Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 bg-light">
        <div class="card-body p-3">
            @using (Html.BeginForm("History", "Feedback", FormMethod.Get, new { @class = "row g-2 align-items-center" }))
            {
                <!-- Client Filter -->
                <div class="col-md-4 col-lg-3">
                    <select name="clientId" class="form-select border shadow-sm" onchange="this.form.submit()">
                        <option value="">-- All Assigned Clients --</option>
                        @foreach (var c in Model.AvailableClients)
                        {
                            <option value="@c.Value" @(Model.SelectedClientId == c.Value ? "selected" : "")>@c.Text</option>
                        }
                    </select>
                </div>

                <!-- Category Filter -->
                <div class="col-md-3 col-lg-3">
                    <select name="category" class="form-select border shadow-sm" onchange="this.form.submit()">
                        <option value="all" @(Model.SelectedCategory == "all" ? "selected" : "")>-- All Categories --</option>
                        <option value="Workout" @(Model.SelectedCategory == "Workout" ? "selected" : "")>🏋️ Workout Feedback</option>
                        <option value="Diet" @(Model.SelectedCategory == "Diet" ? "selected" : "")>🥗 Diet Feedback</option>
                        <option value="General Progress" @(Model.SelectedCategory == "General Progress" ? "selected" : "")>📈 General Progress Feedback</option>
                    </select>
                </div>

                <!-- Search Input -->
                <div class="col-md-3 col-lg-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" 
                               name="search" 
                               value="@Model.SearchTerm" 
                               class="form-control border-start-0 ps-0" 
                               placeholder="Search title, client, or content..." 
                               autocomplete="off" />
                    </div>
                </div>

                <!-- Submit / Clear Buttons -->
                <div class="col-md-2 col-lg-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 d-inline-flex align-items-center justify-content-center gap-1">
                        <i class="bi bi-funnel"></i>
                        <span>Filter</span>
                    </button>
                    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) || !string.IsNullOrWhiteSpace(Model.SelectedClientId) || (Model.SelectedCategory != null && Model.SelectedCategory != "all"))
                    {
                        <a href="@Url.Action("History", "Feedback")" class="btn btn-outline-secondary d-inline-flex align-items-center" title="Reset Filters">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                </div>
            }
        </div>
    </div>

    <!-- FEEDBACK CARDS LIST -->
    @if (Model.FeedbackList != null && Model.FeedbackList.Any())
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var item in Model.FeedbackList)
            {
                var categoryColor = "primary";
                var categoryIcon = "bi-stopwatch";
                if (item.Category == "Diet") { categoryColor = "success"; categoryIcon = "bi-egg-fried"; }
                else if (item.Category == "General Progress") { categoryColor = "info"; categoryIcon = "bi-graph-up-arrow"; }

                var initials = "CL";
                if (!string.IsNullOrWhiteSpace(item.ClientName))
                {
                    var parts = item.ClientName.Trim().Split(' ');
                    initials = parts.Length > 1 
                        ? (parts[0].Substring(0, 1) + parts[parts.Length - 1].Substring(0, 1)).ToUpper()
                        : item.ClientName.Substring(0, Math.Min(2, item.ClientName.Length)).ToUpper();
                }

                <div class="card border shadow-sm rounded-3 bg-white hover-shadow transition-all overflow-hidden @(item.IsDraft ? "border-warning" : "")">
                    
                    <!-- Card Header -->
                    <div class="card-header bg-white py-3 border-bottom d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-sm"
                                 style="width: 44px; height: 44px; background: linear-gradient(135deg, #0d6efd, #0dcaf0); font-size: 0.95rem;">
                                @initials
                            </div>
                            <div>
                                <div class="d-flex align-items-center gap-2">
                                    <h6 class="fw-bold mb-0 text-dark">@item.ClientName</h6>
                                    <span class="badge bg-@categoryColor-subtle text-@categoryColor border border-@categoryColor-subtle px-2 py-1 small">
                                        <i class="bi @categoryIcon me-1"></i>@item.Category Feedback
                                    </span>
                                    @if (item.IsDraft)
                                    {
                                        <span class="badge bg-warning text-dark px-2 py-1">
                                            <i class="bi bi-pencil me-1"></i>Draft (Unsent)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="bi bi-check2-circle me-1"></i>Sent
                                        </span>
                                    }
                                </div>
                                <div class="text-muted x-small">
                                    <i class="bi bi-calendar3 me-1"></i>@item.SentAt.ToString("MMMM dd, yyyy 'at' hh:mm tt")
                                    <span class="mx-1">&bull;</span>
                                    <i class="bi bi-envelope me-1"></i>@item.ClientEmail
                                </div>
                            </div>
                        </div>

                        <!-- Header Actions -->
                        <div class="d-flex align-items-center gap-2">
                            @if (item.IsDraft)
                            {
                                <!-- Draft Actions: Can Edit or Discard -->
                                <a href="@Url.Action("Send", "Feedback", new { draftId = item.FeedbackId })" class="btn btn-sm btn-warning d-inline-flex align-items-center gap-1 shadow-sm">
                                    <i class="bi bi-pencil-square"></i>
                                    <span>Resume Draft</span>
                                </a>
                                using (Html.BeginForm("DiscardDraft", "Feedback", new { id = item.FeedbackId }, FormMethod.Post, new { onsubmit = "return confirm('Are you sure you want to discard this draft?');", @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            }
                            else
                            {
                                <!-- Sent Feedback: View Details, Edit Feedback, Send Follow-Up, View Client Profile -->
                                <a href="@Url.Action("Details", "Feedback", new { id = item.FeedbackId })" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm" title="View Full Details">
                                    <i class="bi bi-eye"></i>
                                    <span>View</span>
                                </a>
                                <a href="@Url.Action("Edit", "Feedback", new { id = item.FeedbackId })" class="btn btn-sm btn-outline-warning d-inline-flex align-items-center gap-1 shadow-sm" title="Edit Feedback">
                                    <i class="bi bi-pencil-square"></i>
                                    <span>Edit</span>
                                </a>
                                <a href="@Url.Action("Send", "Feedback", new { parentId = item.FeedbackId })" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1 shadow-sm" title="Send Follow-Up">
                                    <i class="bi bi-reply-fill"></i>
                                    <span>Follow-Up</span>
                                </a>
                                <a href="@Url.Action("Details", "Clients", new { id = item.ClientId })" class="btn btn-sm btn-light border text-muted" title="View Client Profile" target="_blank">
                                    <i class="bi bi-person-badge"></i>
                                </a>
                            }
                        </div>
                    </div>

                    <!-- Card Body -->
                    <div class="card-body p-4">
                        
                        <!-- Parent Follow-Up indicator -->
                        @if (!string.IsNullOrWhiteSpace(item.ParentFeedbackTitle))
                        {
                            <div class="badge bg-light text-muted border mb-2 px-2 py-1">
                                <i class="bi bi-arrow-return-right me-1 text-primary"></i>Follow-up to: <strong>@item.ParentFeedbackTitle</strong>
                            </div>
                        }

                        <!-- Feedback Subject / Headline -->
                        <h5 class="fw-bold text-dark mb-2">@item.Title</h5>

                        <!-- Observations / Main Text -->
                        <p class="text-secondary mb-3" style="white-space: pre-line; line-height: 1.6;">@item.FeedbackText</p>

                        <!-- Actionable Recommendations Box (if provided) -->
                        @if (!string.IsNullOrWhiteSpace(item.Recommendations))
                        {
                            <div class="p-3 bg-light border-start border-4 border-success rounded-end-3">
                                <div class="fw-bold text-success small text-uppercase mb-1 d-flex align-items-center gap-1">
                                    <i class="bi bi-check2-circle"></i> Coach Recommendations &amp; Action Items
                                </div>
                                <div class="text-dark small" style="white-space: pre-line; line-height: 1.5;">@item.Recommendations</div>
                            </div>
                        }

                    </div>

                    <!-- Card Footer: Audit Stamp -->
                    <div class="card-footer bg-light border-top py-2 px-4 d-flex justify-content-between align-items-center">
                        <span class="text-muted x-small">
                            <i class="bi bi-fingerprint me-1"></i>Feedback Record #@item.FeedbackId
                        </span>
                        <span class="text-muted x-small">
                            <i class="bi bi-calendar-event me-1"></i>Submitted: @item.SentAt.ToString("MMM dd, yyyy")
                        </span>
                    </div>

                </div>
            }
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="card border-0 shadow-sm rounded-3 p-5 text-center bg-white my-4">
            <div class="py-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light p-4 mb-3">
                    <i class="bi bi-chat-left-quote text-muted display-4"></i>
                </div>
                <h4 class="fw-bold text-dark mb-2">No feedback records found</h4>
                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) || !string.IsNullOrWhiteSpace(Model.SelectedClientId) || (Model.SelectedCategory != null && Model.SelectedCategory != "all"))
                {
                    <p class="text-muted mb-4">No coaching feedback matched your filter criteria. Try adjusting your search or category filter.</p>
                    <a href="@Url.Action("History", "Feedback")" class="btn btn-outline-primary px-4">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Filters
                    </a>
                }
                else
                {
                    <p class="text-muted mb-4">You have not sent any client feedback yet. Start by sending feedback on a client's workout or meal log.</p>
                    <a href="@Url.Action("Send", "Feedback")" class="btn btn-primary px-4 shadow-sm fw-semibold">
                        <i class="bi bi-send-fill me-1"></i> Send First Feedback
                    </a>
                }
            </div>
        </div>
    }

</div>

<style>
    .x-small {
        font-size: 0.75rem;
    }
    .hover-shadow:hover {
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.08) !important;
    }
    .transition-all {
        transition: all 0.2s ease-in-out;
    }
</style>
