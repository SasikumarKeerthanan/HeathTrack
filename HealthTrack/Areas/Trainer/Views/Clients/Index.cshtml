@model HealthTrack.Areas.Trainer.ViewModels.AssignedClientsIndexViewModel

@{
    ViewBag.Title = "Assigned Clients";
}

<div class="container-fluid px-4 py-3">

    <!-- Header & Action Row -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                    <i class="bi bi-people me-1"></i>Client Management
                </span>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                    <i class="bi bi-person-check me-1"></i>Assigned Clients
                </span>
            </div>
            <h2 class="h3 fw-bold mb-0 text-dark">Assigned Clients</h2>
            <p class="text-muted small mb-0">Search, view, and monitor clients assigned to your training and nutrition roster</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("History", "Feedback")" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm">
                <i class="bi bi-clock-history"></i>
                <span>Feedback History</span>
            </a>
            <a href="@Url.Action("Send", "Feedback")" class="btn btn-primary d-inline-flex align-items-center gap-1 shadow-sm">
                <i class="bi bi-chat-quote-fill"></i>
                <span>Send Feedback</span>
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5 text-success"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 me-3">
                        <i class="bi bi-people fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Total Clients</div>
                        <h3 class="fw-bold mb-0 text-dark">@Model.TotalAssigned</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-3 me-3">
                        <i class="bi bi-stopwatch fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Workout Active</div>
                        <h3 class="fw-bold mb-0 text-success">@Model.WithActiveWorkoutCount</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-info bg-opacity-10 text-info p-3 me-3">
                        <i class="bi bi-egg-fried fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Diet Active</div>
                        <h3 class="fw-bold mb-0 text-info">@Model.WithActiveDietCount</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-3 me-3">
                        <i class="bi bi-exclamation-circle fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Needs Plan Setup</div>
                        <h3 class="fw-bold mb-0 text-warning">@Model.NeedsAttentionCount</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search & Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" action="@Url.Action("Index", "Clients")" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" name="search" value="@Model.SearchTerm" class="form-control bg-light border-start-0" 
                               placeholder="Search client name, email, or ID..." />
                    </div>
                </div>

                <div class="col-md-3">
                    <select name="goal" class="form-select bg-light">
                        <option value="all">All Goals</option>
                        @if (Model.AvailableGoals != null)
                        {
                            foreach (var g in Model.AvailableGoals)
                            {
                                <option value="@g" selected="@(Model.SelectedGoal == g ? "selected" : null)">@g</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <select name="status" class="form-select bg-light">
                        <option value="all" selected="@(Model.SelectedStatus == "all" ? "selected" : null)">All Plan Statuses</option>
                        <option value="configured" selected="@(Model.SelectedStatus == "configured" ? "selected" : null)">Fully Configured (Both)</option>
                        <option value="missing_workout" selected="@(Model.SelectedStatus == "missing_workout" ? "selected" : null)">Needs Workout Plan</option>
                        <option value="missing_diet" selected="@(Model.SelectedStatus == "missing_diet" ? "selected" : null)">Needs Diet Plan</option>
                        <option value="has_workout" selected="@(Model.SelectedStatus == "has_workout" ? "selected" : null)">Has Workout Plan</option>
                        <option value="has_diet" selected="@(Model.SelectedStatus == "has_diet" ? "selected" : null)">Has Diet Plan</option>
                    </select>
                </div>

                <div class="col-md-1 d-flex gap-1">
                    <button type="submit" class="btn btn-primary w-100" title="Filter Clients">
                        <i class="bi bi-funnel"></i>
                    </button>
                    <a href="@Url.Action("Index", "Clients")" class="btn btn-outline-secondary" title="Reset Filters">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Client Cards -->
    @if (Model.Clients != null && Model.Clients.Any())
    {
        <div class="row g-3">
            @foreach (var client in Model.Clients)
            {
                var initials = "CL";
                if (!string.IsNullOrWhiteSpace(client.FullName))
                {
                    var parts = client.FullName.Trim().Split(' ');
                    initials = parts.Length > 1 
                        ? (parts[0].Substring(0, 1) + parts[parts.Length - 1].Substring(0, 1)).ToUpper()
                        : client.FullName.Substring(0, Math.Min(2, client.FullName.Length)).ToUpper();
                }

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <!-- Client Header -->
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-sm" 
                                             style="width: 50px; height: 50px; background: linear-gradient(135deg, #0d6efd, #0dcaf0); font-size: 1.1rem;">
                                            @initials
                                        </div>
                                        <div>
                                            <h5 class="fw-bold mb-0 text-dark">@client.FullName</h5>
                                            <div class="text-muted small">@client.Email</div>
                                        </div>
                                    </div>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 small">
                                        <i class="bi bi-check-circle-fill me-1"></i>Assigned
                                    </span>
                                </div>

                                <!-- Vitals Strip -->
                                <div class="p-3 bg-light rounded-3 text-center border mb-3">
                                    <div class="row g-2">
                                        <div class="col-4 border-end">
                                            <span class="text-muted small fw-semibold text-uppercase">Goal</span>
                                            <div class="fw-bold text-dark small text-truncate mt-1" title="@client.PrimaryGoal">@client.PrimaryGoal</div>
                                        </div>
                                        <div class="col-4 border-end">
                                            <span class="text-muted small fw-semibold text-uppercase">Weight</span>
                                            <div class="fw-bold text-primary small mt-1">
                                                @(client.CurrentWeightKg.HasValue ? client.CurrentWeightKg.Value.ToString("0.0") + " kg" : "—")
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <span class="text-muted small fw-semibold text-uppercase">BMI</span>
                                            <div class="fw-bold text-dark small mt-1">
                                                @(client.CurrentBmi.HasValue ? client.CurrentBmi.Value.ToString("0.0") : "—")
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Plans Status -->
                                <div class="d-flex flex-column gap-2 mb-3 small">
                                    <div class="d-flex align-items-center justify-content-between p-2 rounded-2 bg-light border">
                                        <span class="text-muted"><i class="bi bi-stopwatch text-primary me-1"></i>Workout:</span>
                                        @if (client.HasActiveWorkout)
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle text-truncate" style="max-width: 170px;" title="@client.ActiveWorkoutPlanTitle">
                                                @client.ActiveWorkoutPlanTitle
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Needs Workout</span>
                                        }
                                    </div>

                                    <div class="d-flex align-items-center justify-content-between p-2 rounded-2 bg-light border">
                                        <span class="text-muted"><i class="bi bi-egg-fried text-success me-1"></i>Diet:</span>
                                        @if (client.HasActiveDiet)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle text-truncate" style="max-width: 170px;" title="@client.ActiveDietPlanTitle">
                                                @client.ActiveDietPlanTitle
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Needs Diet</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Actions -->
                            <div class="d-flex gap-2 pt-2 border-top">
                                <a href="@Url.Action("Details", "Clients", new { id = client.ClientId })" 
                                   class="btn btn-primary flex-grow-1 d-inline-flex align-items-center justify-content-center gap-1 py-2 fw-semibold shadow-sm">
                                    <i class="bi bi-person"></i>
                                    <span>View Profile</span>
                                </a>
                                <a href="@Url.Action("History", "Feedback", new { clientId = client.ClientId })" 
                                   class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center px-3" 
                                   title="View Feedback History">
                                    <i class="bi bi-clock-history"></i>
                                </a>
                                <a href="@Url.Action("Send", "Feedback", new { clientId = client.ClientId })" 
                                   class="btn btn-outline-info d-inline-flex align-items-center justify-content-center px-3" 
                                   title="Send Feedback">
                                    <i class="bi bi-chat-quote-fill"></i>
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-3 p-5 text-center bg-white my-4">
            <div class="py-4">
                <i class="bi bi-people text-muted display-4 d-block mb-3"></i>
                <h4 class="fw-bold text-dark mb-2">No assigned clients found</h4>
                <p class="text-muted mb-4">No clients match your search and filter criteria.</p>
                <a href="@Url.Action("Index", "Clients")" class="btn btn-outline-primary">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Filters
                </a>
            </div>
        </div>
    }

</div>
