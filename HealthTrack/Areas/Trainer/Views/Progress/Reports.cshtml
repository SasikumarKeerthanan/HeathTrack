@model HealthTrack.Areas.Trainer.ViewModels.ClientReportViewModel

@{
    ViewBag.Title = Model.ClientName + " - Progress & Health Report";
}

<div class="container-fluid px-4 py-3">

    <!-- Header & Action Row -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                    <i class="bi bi-file-earmark-medical me-1"></i>Health & Progress Report
                </span>
                <span class="badge bg-light text-dark border font-monospace">
                    ID: @Model.ReportId
                </span>
            </div>
            <h2 class="h3 fw-bold mb-0 text-dark">Client Progress, Workout & Health Report</h2>
            <p class="text-muted small mb-0">Official progress documentation, physiological metrics, workout adherence, and coaching evaluation</p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <!-- Modal Preview Button -->
            <button type="button" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#reportPreviewModal">
                <i class="bi bi-eye"></i> Report Preview
            </button>

            <!-- Direct Print / Save as PDF Button -->
            <a href="@Url.Action("ExportPdf", "Progress", new { clientId = Model.ClientId, preset = Model.DatePreset })" 
               class="btn btn-danger d-inline-flex align-items-center gap-1 shadow-sm">
                <i class="bi bi-file-earmark-pdf"></i> Export / Print PDF
            </a>

            <a href="@Url.Action("Index", "Progress", new { clientId = Model.ClientId })" class="btn btn-outline-secondary">
                <i class="bi bi-graph-up me-1"></i> Analytics Dashboard
            </a>
        </div>
    </div>

    <!-- Date Filtering & Client Selector Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 bg-white">
        <div class="card-body p-3">
            <form method="get" action="@Url.Action("Reports", "Progress")" class="row g-2 align-items-center" id="reportFilterForm">
                <!-- Client Dropdown -->
                <div class="col-4">
                    <label class="form-label small fw-semibold text-muted mb-1">Client Profile</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="bi bi-person text-danger"></i>
                        </span>
                        <select name="clientId" class="form-select bg-light border-start-0" onchange="document.getElementById('reportFilterForm').submit();">
                            @foreach (var c in Model.AvailableClients)
                            {
                                <option value="@c.Id" selected="@(Model.ClientId == c.Id ? "selected" : null)">
                                    @c.FullName (@c.PrimaryGoal)
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Date Range Presets -->
                <div class="col-5">
                    <label class="form-label small fw-semibold text-muted mb-1">Date Range Filter</label>
                    <div class="btn-group w-100" role="group">
                        <a href="@Url.Action("Reports", "Progress", new { clientId = Model.ClientId, preset = "7days" })" 
                           class="btn btn-sm @(Model.DatePreset == "7days" ? "btn-danger text-white fw-bold shadow-sm" : "btn-outline-secondary bg-light")">
                            Last 7 Days
                        </a>
                        <a href="@Url.Action("Reports", "Progress", new { clientId = Model.ClientId, preset = "30days" })" 
                           class="btn btn-sm @(Model.DatePreset == "30days" ? "btn-danger text-white fw-bold shadow-sm" : "btn-outline-secondary bg-light")">
                            Last 30 Days
                        </a>
                        <a href="@Url.Action("Reports", "Progress", new { clientId = Model.ClientId, preset = "90days" })" 
                           class="btn btn-sm @(Model.DatePreset == "90days" ? "btn-danger text-white fw-bold shadow-sm" : "btn-outline-secondary bg-light")">
                            Last 90 Days
                        </a>
                        <a href="@Url.Action("Reports", "Progress", new { clientId = Model.ClientId, preset = "all" })" 
                           class="btn btn-sm @(Model.DatePreset == "all" ? "btn-danger text-white fw-bold shadow-sm" : "btn-outline-secondary bg-light")">
                            All History
                        </a>
                    </div>
                </div>

                <!-- Window Info -->
                <div class="col-3 text-end">
                    <div class="small text-muted">Reporting Period:</div>
                    <span class="badge bg-light text-dark border font-monospace py-2 px-3">
                        @Model.FromDate.ToString("MMM dd") - @Model.ToDate.ToString("MMM dd, yyyy")
                    </span>
                </div>
            </form>
        </div>
    </div>

    <!-- Official Report Document Container -->
    <div class="card border shadow-sm rounded-3 bg-white p-5 mb-5" id="printableReportSection">

        <!-- Top Header & Branding -->
        <div class="row align-items-center pb-4 mb-4 border-bottom">
            <div class="col-6">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="rounded-3 bg-danger text-white p-2 d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 40px; height: 40px;">
                        <i class="bi bi-activity fs-4"></i>
                    </span>
                    <div>
                        <h4 class="fw-bold mb-0 text-dark">HealthTrack</h4>
                        <div class="x-small text-uppercase text-muted fw-bold" style="letter-spacing: 0.8px;">Personal Fitness & Nutrition Portal</div>
                    </div>
                </div>
                <div class="small text-muted">Official Client Progress & Physiological Summary</div>
            </div>
            <div class="col-6 text-end">
                <div class="fw-bold text-dark fs-5">Client Health Progress Report</div>
                <div class="small text-muted">Document ID: <strong class="font-monospace">@Model.ReportId</strong></div>
                <div class="small text-muted">Generated: <strong>@Model.GeneratedAt.ToString("MMMM dd, yyyy - HH:mm")</strong></div>
            </div>
        </div>

        <!-- Client & Coach Metadata Grid -->
        <div class="row g-3 p-3 bg-light rounded-3 border mb-4">
            <div class="col-3">
                <span class="text-muted x-small text-uppercase fw-semibold d-block">Client Name</span>
                <span class="fw-bold text-dark fs-6">@Model.ClientName</span>
            </div>
            <div class="col-3">
                <span class="text-muted x-small text-uppercase fw-semibold d-block">Client Email</span>
                <span class="small font-monospace text-secondary">@Model.ClientEmail</span>
            </div>
            <div class="col-3">
                <span class="text-muted x-small text-uppercase fw-semibold d-block">Primary Focus</span>
                <span class="badge bg-danger-subtle text-danger border">@Model.PrimaryGoal</span>
            </div>
            <div class="col-3">
                <span class="text-muted x-small text-uppercase fw-semibold d-block">Assigned Coach</span>
                <span class="fw-semibold text-dark">@Model.CoachName</span>
            </div>
        </div>

        <!-- 1. Physical & Anthropometric Benchmarks -->
        <div class="mb-4">
            <h5 class="fw-bold text-dark border-bottom pb-2 mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-person-lines-fill text-danger"></i> 1. Anthropometric & Body Composition Benchmarks
            </h5>
            <div class="row g-3">
                <div class="col-3">
                    <div class="p-3 bg-light rounded-3 text-center border">
                        <div class="text-muted x-small text-uppercase fw-semibold">Baseline Weight</div>
                        <div class="fs-4 fw-bold text-dark mt-1">@Model.BaselineWeightKg kg</div>
                        <div class="x-small text-muted">Initial Assessment</div>
                    </div>
                </div>
                <div class="col-3">
                    <div class="p-3 bg-light rounded-3 text-center border">
                        <div class="text-muted x-small text-uppercase fw-semibold">Current Weight</div>
                        <div class="fs-4 fw-bold text-danger mt-1">@Model.CurrentWeightKg kg</div>
                        <div class="x-small @(Model.WeightChangeKg <= 0 ? "text-success fw-bold" : "text-primary fw-bold")">
                            @(Model.WeightChangeKg > 0 ? $"+{Model.WeightChangeKg} kg" : $"{Model.WeightChangeKg} kg") net delta
                        </div>
                    </div>
                </div>
                <div class="col-3">
                    <div class="p-3 bg-light rounded-3 text-center border">
                        <div class="text-muted x-small text-uppercase fw-semibold">BMI Classification</div>
                        <div class="fs-4 fw-bold text-dark mt-1">@Model.CurrentBmi</div>
                        <span class="badge @(Model.BmiCategory == "Normal" ? "bg-success" : "bg-warning text-dark") small">@Model.BmiCategory</span>
                    </div>
                </div>
                <div class="col-3">
                    <div class="p-3 bg-light rounded-3 text-center border">
                        <div class="text-muted x-small text-uppercase fw-semibold">Target Goal Weight</div>
                        <div class="fs-4 fw-bold text-primary mt-1">@Model.TargetWeightKg kg</div>
                        <div class="x-small text-muted">Target milestone</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Training Adherence & Activity Volume -->
        <div class="mb-4">
            <h5 class="fw-bold text-dark border-bottom pb-2 mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-activity text-success"></i> 2. Workout Adherence & Physiological Output
            </h5>
            <div class="row g-3 mb-3">
                <div class="col-3">
                    <div class="p-3 bg-light rounded-3 text-center border">
                        <div class="text-muted x-small text-uppercase fw-semibold">Workouts Completed</div>
                        <div class="fs-4 fw-bold text-success mt-1">@Model.TotalWorkoutsCompleted / @Model.TotalWorkoutsScheduled</div>
                        <div class="x-small text-muted">Sessions</div>
                    </div>
                </div>
                <div class="col-3">
                    <div class="p-3 bg-light rounded-3 text-center border">
                        <div class="text-muted x-small text-uppercase fw-semibold">Adherence Rate</div>
                        <div class="fs-4 fw-bold text-success mt-1">@Model.FormattedAdherenceRate</div>
                        <div class="x-small text-muted">Attendance ratio</div>
                    </div>
                </div>
                <div class="col-3">
                    <div class="p-3 bg-light rounded-3 text-center border">
                        <div class="text-muted x-small text-uppercase fw-semibold">Total Active Time</div>
                        <div class="fs-4 fw-bold text-dark mt-1">@Model.TotalExerciseMinutes mins</div>
                        <div class="x-small text-muted">Exercise duration</div>
                    </div>
                </div>
                <div class="col-3">
                    <div class="p-3 bg-light rounded-3 text-center border">
                        <div class="text-muted x-small text-uppercase fw-semibold">Calories Expended</div>
                        <div class="fs-4 fw-bold text-danger mt-1">@Model.TotalCaloriesBurned kcal</div>
                        <div class="x-small text-muted">Training expenditure</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Nutritional Compliance & Hydration -->
        <div class="mb-4">
            <h5 class="fw-bold text-dark border-bottom pb-2 mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-egg-fried text-warning"></i> 3. Nutrition & Hydration Compliance
            </h5>
            <div class="row g-3">
                <div class="col-4">
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="text-muted x-small text-uppercase fw-semibold">Prescribed Daily Target</div>
                        <div class="fs-5 fw-bold text-dark mt-1">@Model.PrescribedDailyCalories kcal</div>
                        <div class="small text-muted">Average Consumed: <strong>@Model.AverageConsumedCalories kcal</strong></div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="text-muted x-small text-uppercase fw-semibold">Calorie Adherence</div>
                        <div class="fs-5 fw-bold @(Math.Abs(Model.CalorieVariance) <= 100 ? "text-success" : "text-warning") mt-1">
                            @(Model.CalorieVariance >= 0 ? $"+{Model.CalorieVariance} kcal" : $"{Model.CalorieVariance} kcal")
                        </div>
                        <div class="small text-muted">Difference from target prescription</div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="text-muted x-small text-uppercase fw-semibold">Daily Hydration</div>
                        <div class="fs-5 fw-bold text-info mt-1">@Model.AverageWaterLiters L / @Model.PrescribedWaterLiters L</div>
                        <div class="small text-muted">Daily water intake compliance</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. Goal Achievements & Milestones Table -->
        <div class="mb-4">
            <h5 class="fw-bold text-dark border-bottom pb-2 mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-trophy text-danger"></i> 4. Goal Progression & Objective Milestones
            </h5>
            <div class="table-responsive">
                <table class="table table-bordered table-sm align-middle mb-0">
                    <thead class="table-light small text-uppercase">
                        <tr>
                            <th>Goal Description</th>
                            <th>Baseline</th>
                            <th>Current Level</th>
                            <th>Target Benchmark</th>
                            <th>Progress</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var g in Model.GoalMilestones)
                        {
                            <tr>
                                <td class="fw-semibold">@g.GoalName</td>
                                <td>@g.BaselineValue @g.Unit</td>
                                <td class="fw-bold">@g.CurrentValue @g.Unit</td>
                                <td>@g.TargetValue @g.Unit</td>
                                <td style="width: 160px;">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 6px;">
                                            <div class="progress-bar @(g.IsAchieved ? "bg-success" : "bg-primary")" style="width: @g.ProgressPercentage%"></div>
                                        </div>
                                        <span class="x-small fw-bold">@g.ProgressPercentage%</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @(g.IsAchieved ? "bg-success-subtle text-success border border-success-subtle" : "bg-light text-dark border") small">
                                        @g.StatusMessage
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- 5. Logged Training Session History -->
        <div class="mb-4">
            <h5 class="fw-bold text-dark border-bottom pb-2 mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-clipboard-data text-primary"></i> 5. Verified Training Session Logs
            </h5>
            <div class="table-responsive">
                <table class="table table-bordered table-sm align-middle mb-0">
                    <thead class="table-light small text-uppercase">
                        <tr>
                            <th>Date</th>
                            <th>Session Title</th>
                            <th>Duration</th>
                            <th>Calories</th>
                            <th>RPE</th>
                            <th>Status</th>
                            <th>Client & Coach Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.SessionLogs.Take(10))
                        {
                            <tr>
                                <td class="font-monospace small">@s.LogDate.ToString("yyyy-MM-dd")</td>
                                <td class="small fw-semibold">@s.SessionName</td>
                                <td class="small">@s.DurationMinutes mins</td>
                                <td class="small">@s.CaloriesBurned kcal</td>
                                <td class="small">RPE @s.PerceivedExertion/10</td>
                                <td>
                                    <span class="badge @(s.IsCompleted ? "bg-success-subtle text-success" : "bg-warning-subtle text-dark") small">
                                        @(s.IsCompleted ? "Completed" : "Missed")
                                    </span>
                                </td>
                                <td class="small text-muted">@s.CoachFeedback</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- 6. Professional Coach Evaluation & Recommendations -->
        <div class="p-4 bg-light rounded-3 border mb-4">
            <h5 class="fw-bold text-dark mb-2">Coach Clinical Evaluation</h5>
            <p class="small text-secondary mb-3" style="line-height: 1.6;">
                @Model.CoachEvaluationNotes
            </p>

            <h6 class="fw-bold text-dark mb-2">Prescribed Next-Phase Recommendations</h6>
            <div class="small text-secondary" style="white-space: pre-line; line-height: 1.6;">
                @Model.NextPhaseRecommendations
            </div>
        </div>

        <!-- Signature Section -->
        <div class="row pt-4 border-top mt-5">
            <div class="col-6">
                <div class="small text-muted">Certified Personal Trainer / Coach</div>
                <div class="fw-bold text-dark fs-6 mt-1">@Model.CoachName</div>
                <div class="x-small text-muted">CS6004ES HealthTrack Portal &bull; Head Performance Specialist</div>
            </div>
            <div class="col-6 text-end">
                <div class="small text-muted">Verification Signature & Stamp</div>
                <div class="font-monospace fw-bold text-success fs-6 mt-1">[VERIFIED HEALTH TRACK RECORD]</div>
                <div class="x-small text-muted">Certified Timestamp: @Model.GeneratedAt.ToString("yyyy-MM-dd HH:mm:ss")</div>
            </div>
        </div>

    </div>

</div>

<!-- Modal: Report Preview Modal -->
<div class="modal fade" id="reportPreviewModal" tabindex="-1" aria-labelledby="reportPreviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" id="reportPreviewModalLabel">
                    <i class="bi bi-file-earmark-medical me-2 text-danger"></i>Report Preview - @Model.ClientName
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 bg-white">
                <div class="alert alert-info d-flex align-items-center gap-2 mb-3">
                    <i class="bi bi-info-circle-fill"></i>
                    <div>This is the formatted print/PDF preview for <strong>@Model.ClientName</strong>. Click the Export/Print PDF button to download or print.</div>
                </div>
                <!-- Inline Preview clone -->
                <div class="p-3 border rounded bg-white">
                    <h6><strong>Document:</strong> @Model.ReportId</h6>
                    <h6><strong>Client:</strong> @Model.ClientName (@Model.ClientEmail)</h6>
                    <h6><strong>Weight Trajectory:</strong> @Model.BaselineWeightKg kg &rarr; @Model.CurrentWeightKg kg (@Model.WeightChangeKg kg)</h6>
                    <h6><strong>Workout Adherence:</strong> @Model.FormattedAdherenceRate (@Model.TotalWorkoutsCompleted completed sessions)</h6>
                    <hr />
                    <h6><strong>Coach Notes:</strong></h6>
                    <p class="small text-muted">@Model.CoachEvaluationNotes</p>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <a href="@Url.Action("ExportPdf", "Progress", new { clientId = Model.ClientId, preset = Model.DatePreset })" target="_blank" class="btn btn-danger">
                    <i class="bi bi-printer me-1"></i> Open Printable / PDF View
                </a>
            </div>
        </div>
    </div>
</div>
