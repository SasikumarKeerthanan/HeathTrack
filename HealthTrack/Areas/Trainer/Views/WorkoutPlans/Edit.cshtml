@model HealthTrack.Areas.Trainer.ViewModels.WorkoutPlanFormViewModel

@{
    ViewBag.Title = "Edit Client Workout Plan";
}

<div class="container-fluid px-4 py-3">

    <!-- Breadcrumb & Header -->
    <nav aria-label="breadcrumb" class="mb-2">
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a href="@Url.Action("Index")" class="text-decoration-none">Client Plans</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Details", new { id = Model.Id })" class="text-decoration-none">@Model.Title</a></li>
            <li class="breadcrumb-item active" aria-current="page">Edit Plan</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="h3 fw-bold mb-0 text-dark">Edit Routine for @Model.ClientName</h2>
            <p class="text-muted small mb-0">Update program parameters, schedule adjustments, and exercise prescriptions for this client</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Details", new { id = Model.Id })" class="btn btn-outline-secondary">
                <i class="bi bi-eye me-1"></i> View Details
            </a>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Plans
            </a>
        </div>
    </div>

    <form action="@Url.Action("Edit")" method="post" id="workoutPlanEditForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id" />
        <input type="hidden" name="ClientId" value="@Model.ClientId" />
        <input type="hidden" name="ClientName" value="@Model.ClientName" />
        <input type="hidden" name="ClientEmail" value="@Model.ClientEmail" />

        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger shadow-sm mb-4" })

        <div class="row g-4">
            
            <!-- Left Column: Client & Plan Specifications -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                            <i class="bi bi-person-fill text-primary"></i> Client & Program Focus
                        </h5>
                    </div>
                    <div class="card-body p-4">

                        <!-- Client Info Card -->
                        <div class="p-3 bg-light rounded-3 mb-3 border">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <i class="bi bi-person-circle fs-5 text-primary"></i>
                                <div class="fw-bold text-dark">@Model.ClientName</div>
                            </div>
                            <div class="small text-muted">@Model.ClientEmail &bull; <span class="font-monospace">@Model.ClientId</span></div>
                        </div>

                        <div class="mb-3">
                            <label for="Title" class="form-label fw-semibold">Personalized Plan Title <span class="text-danger">*</span></label>
                            <input type="text" name="Title" id="Title" class="form-control" value="@Model.Title" />
                            @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger small" })
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label for="Goal" class="form-label fw-semibold">Client Goal <span class="text-danger">*</span></label>
                                <select name="Goal" id="Goal" class="form-select">
                                    @foreach (var g in Model.GoalsList)
                                    {
                                        <option value="@g" @(Model.Goal == g ? "selected" : "")>@g</option>
                                    }
                                </select>
                                @Html.ValidationMessageFor(m => m.Goal, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-6">
                                <label for="DifficultyLevel" class="form-label fw-semibold">Difficulty <span class="text-danger">*</span></label>
                                <select name="DifficultyLevel" id="DifficultyLevel" class="form-select">
                                    @foreach (var d in Model.DifficultiesList)
                                    {
                                        <option value="@d" @(Model.DifficultyLevel == d ? "selected" : "")>@d</option>
                                    }
                                </select>
                                @Html.ValidationMessageFor(m => m.DifficultyLevel, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label for="DurationWeeks" class="form-label fw-semibold">Duration (Weeks)</label>
                                <input type="number" name="DurationWeeks" id="DurationWeeks" class="form-control" min="1" max="52" value="@Model.DurationWeeks" />
                                @Html.ValidationMessageFor(m => m.DurationWeeks, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-6">
                                <label for="DaysPerWeek" class="form-label fw-semibold">Days / Week</label>
                                <input type="number" name="DaysPerWeek" id="DaysPerWeek" class="form-control" min="1" max="7" value="@Model.DaysPerWeek" />
                                @Html.ValidationMessageFor(m => m.DaysPerWeek, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label for="StartDate" class="form-label fw-semibold">Start Date</label>
                                <input type="date" name="StartDate" id="StartDate" class="form-control" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                                @Html.ValidationMessageFor(m => m.StartDate, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-6">
                                <label for="EndDate" class="form-label fw-semibold">Target End Date</label>
                                <input type="date" name="EndDate" id="EndDate" class="form-control" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
                                @Html.ValidationMessageFor(m => m.EndDate, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="ScheduledStartTime" class="form-label fw-semibold">
                                <i class="bi bi-clock me-1 text-primary"></i>Daily Workout Start Time <span class="text-muted fw-normal small">(Optional - for automated 30-min reminders)</span>
                            </label>
                            <input type="time" name="ScheduledStartTime" id="ScheduledStartTime" class="form-control" value="@(Model.ScheduledStartTime.HasValue ? Model.ScheduledStartTime.Value.ToString(@"hh\:mm") : "")" />
                            <div class="form-text small text-muted">When configured, client receives an automated reminder notification 30 minutes before workout time. Leave empty if no reminder is needed.</div>
                            @Html.ValidationMessageFor(m => m.ScheduledStartTime, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3">
                            <label for="Description" class="form-label fw-semibold">Objectives & Strategy <span class="text-danger">*</span></label>
                            <textarea name="Description" id="Description" class="form-control" rows="3">@Model.Description</textarea>
                            @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3">
                            <label for="TrainerNotes" class="form-label fw-semibold">Special Guidance for Client</label>
                            <textarea name="TrainerNotes" id="TrainerNotes" class="form-control" rows="2">@Model.TrainerNotes</textarea>
                            @Html.ValidationMessageFor(m => m.TrainerNotes, "", new { @class = "text-danger small" })
                        </div>

                        <!-- Hypertrophy Targets & Strategy -->
                        <div class="p-3 bg-light rounded-3 border mb-3">
                            <h6 class="fw-bold text-dark small mb-2 d-flex align-items-center gap-1">
                                <i class="bi bi-bullseye text-primary"></i> Hypertrophy Guidelines
                            </h6>
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <label class="form-label x-small fw-semibold text-muted mb-0">Rep Range</label>
                                    <input type="text" name="TargetRepRange" class="form-control form-control-sm" value="@Model.TargetRepRange" placeholder="6 – 30" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label x-small fw-semibold text-muted mb-0">Weekly Sets</label>
                                    <input type="text" name="WeeklySetVolume" class="form-control form-control-sm" value="@Model.WeeklySetVolume" placeholder="10 – 20" />
                                </div>
                            </div>
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <label class="form-label x-small fw-semibold text-muted mb-0">RIR Target</label>
                                    <input type="text" name="RirTarget" class="form-control form-control-sm" value="@Model.RirTarget" placeholder="1 – 3" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label x-small fw-semibold text-muted mb-0">Rest Period</label>
                                    <input type="text" name="RecommendedRest" class="form-control form-control-sm" value="@Model.RecommendedRest" placeholder="1 – 2.5 min" />
                                </div>
                            </div>
                            <div class="mb-2">
                                <label class="form-label x-small fw-semibold text-muted mb-0">Progression Strategy</label>
                                <input type="text" name="ProgressionStrategy" class="form-control form-control-sm" value="@Model.ProgressionStrategy" placeholder="e.g. Add 1-2 reps per week" />
                            </div>
                            <div>
                                <label class="form-label x-small fw-semibold text-muted mb-0">Recovery Considerations</label>
                                <input type="text" name="RecoveryGuidelines" class="form-control form-control-sm" value="@Model.RecoveryGuidelines" placeholder="e.g. 48-72h between sessions" />
                            </div>
                        </div>

                        <div class="form-check form-switch pt-2">
                            <input class="form-check-input" type="checkbox" name="IsActive" id="isActiveSwitch" value="true" @(Model.IsActive ? "checked" : "") />
                            <input type="hidden" name="IsActive" value="false" />
                            <label class="form-check-label fw-semibold" for="isActiveSwitch">
                                Active Routine Status
                            </label>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Right Column: Exercise Schedule Builder -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                                <i class="bi bi-calendar-week-fill text-success"></i> Prescribed Exercise Routines
                            </h5>
                            <small class="text-muted">Configure daily exercises, target sets, repetitions, duration, and personal form cues</small>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1" id="btnAddExercise">
                            <i class="bi bi-plus-lg"></i> Add Exercise
                        </button>
                    </div>

                    <div class="card-body p-4">
                        <div id="exerciseListContainer">
                            @for (int i = 0; i < Model.Exercises.Count; i++)
                            {
                                <div class="exercise-item-row card mb-3 border bg-light" data-index="@i">
                                    <div class="card-body p-3">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="badge bg-secondary exercise-number-badge">Exercise #@(i + 1)</span>
                                            <button type="button" class="btn btn-sm btn-outline-danger border-0 btn-remove-row" title="Remove exercise">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>

                                        <div class="row g-2 mb-2">
                                            <div class="col-md-4">
                                                <label class="form-label small fw-semibold text-muted mb-1">Schedule Day</label>
                                                <select name="Exercises[@i].DayOfWeek" class="form-select form-select-sm">
                                                    @foreach (var day in Model.DaysList)
                                                    {
                                                        <option value="@day" @(Model.Exercises[i].DayOfWeek == day ? "selected" : "")>@day</option>
                                                    }
                                                </select>
                                            </div>

                                            <div class="col-md-5">
                                                <label class="form-label small fw-semibold text-muted mb-1">Select Exercise (Library)</label>
                                                <select name="Exercises[@i].ExerciseId" class="form-select form-select-sm exercise-select">
                                                    @foreach (var ex in Model.AvailableExercises)
                                                    {
                                                        <option value="@ex.ExerciseId" @(Model.Exercises[i].ExerciseId == ex.ExerciseId ? "selected" : "")>
                                                            @ex.Name (@ex.TargetMuscle - @ex.DifficultyLevel)
                                                        </option>
                                                    }
                                                </select>
                                            </div>

                                            <div class="col-md-3">
                                                <label class="form-label small fw-semibold text-muted mb-1">Exercise Role</label>
                                                <select name="Exercises[@i].ExerciseRole" class="form-select form-select-sm">
                                                    <option value="Primary Exercise" @(Model.Exercises[i].ExerciseRole == "Primary Exercise" ? "selected" : "")>Primary Exercise</option>
                                                    <option value="Core Exercise" @(Model.Exercises[i].ExerciseRole == "Core Exercise" ? "selected" : "")>Core Exercise</option>
                                                    <option value="Accessory Movement" @(Model.Exercises[i].ExerciseRole == "Accessory Movement" ? "selected" : "")>Accessory Movement</option>
                                                    <option value="Warm-Up" @(Model.Exercises[i].ExerciseRole == "Warm-Up" ? "selected" : "")>Warm-Up</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="row g-2 mb-2">
                                            <div class="col-3">
                                                <label class="form-label small fw-semibold text-muted mb-1">Sets</label>
                                                <input type="number" name="Exercises[@i].Sets" value="@Model.Exercises[i].Sets" min="1" max="20" class="form-control form-control-sm" />
                                            </div>
                                            <div class="col-3">
                                                <label class="form-label small fw-semibold text-muted mb-1">Reps</label>
                                                <input type="number" name="Exercises[@i].Reps" value="@Model.Exercises[i].Reps" min="1" max="100" class="form-control form-control-sm" />
                                            </div>
                                            <div class="col-3">
                                                <label class="form-label small fw-semibold text-muted mb-1">Duration (Min)</label>
                                                <input type="number" name="Exercises[@i].DurationMinutes" value="@Model.Exercises[i].DurationMinutes" min="0" max="180" class="form-control form-control-sm" placeholder="Optional" />
                                            </div>
                                            <div class="col-3">
                                                <label class="form-label small fw-semibold text-muted mb-1">Rest (Sec)</label>
                                                <input type="number" name="Exercises[@i].RestSeconds" value="@Model.Exercises[i].RestSeconds" min="0" max="600" class="form-control form-control-sm" />
                                            </div>
                                        </div>

                                        <div>
                                            <label class="form-label small fw-semibold text-muted mb-1">Personal Coaching Instructions for Client</label>
                                            <input type="text" name="Exercises[@i].Instructions" value="@Model.Exercises[i].Instructions" 
                                                   class="form-control form-control-sm" placeholder="e.g. Pause 1 sec at bottom; focus on chest stretch" />
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="d-grid mt-3">
                            <button type="button" class="btn btn-outline-secondary border-dashed py-2" id="btnAddExerciseBottom">
                                <i class="bi bi-plus-circle me-1"></i> Add Another Exercise to Client's Plan
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Form Action Buttons -->
                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a href="@Url.Action("Details", new { id = Model.Id })" class="btn btn-light px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm">
                        <i class="bi bi-check-lg me-1"></i> Save Changes
                    </button>
                </div>
            </div>

        </div>
    </form>

</div>

<!-- Hidden template for dynamically added exercise rows -->
<template id="exerciseRowTemplate">
    <div class="exercise-item-row card mb-3 border bg-light" data-index="__INDEX__">
        <div class="card-body p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="badge bg-secondary exercise-number-badge">Exercise #__NUM__</span>
                <button type="button" class="btn btn-sm btn-outline-danger border-0 btn-remove-row" title="Remove exercise">
                    <i class="bi bi-trash"></i>
                </button>
            </div>

            <div class="row g-2 mb-2">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-muted mb-1">Schedule Day</label>
                    <select name="Exercises[__INDEX__].DayOfWeek" class="form-select form-select-sm">
                        @foreach (var day in Model.DaysList)
                        {
                            <option value="@day">@day</option>
                        }
                    </select>
                </div>

                <div class="col-md-5">
                    <label class="form-label small fw-semibold text-muted mb-1">Select Exercise (Library)</label>
                    <select name="Exercises[__INDEX__].ExerciseId" class="form-select form-select-sm">
                        @foreach (var ex in Model.AvailableExercises)
                        {
                            <option value="@ex.ExerciseId">@ex.Name (@ex.TargetMuscle - @ex.DifficultyLevel)</option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted mb-1">Exercise Role</label>
                    <select name="Exercises[__INDEX__].ExerciseRole" class="form-select form-select-sm">
                        <option value="Primary Exercise">Primary Exercise</option>
                        <option value="Core Exercise">Core Exercise</option>
                        <option value="Accessory Movement">Accessory Movement</option>
                        <option value="Warm-Up">Warm-Up</option>
                    </select>
                </div>
            </div>

            <div class="row g-2 mb-2">
                <div class="col-3">
                    <label class="form-label small fw-semibold text-muted mb-1">Sets</label>
                    <input type="number" name="Exercises[__INDEX__].Sets" value="3" min="1" max="20" class="form-control form-control-sm" />
                </div>
                <div class="col-3">
                    <label class="form-label small fw-semibold text-muted mb-1">Reps</label>
                    <input type="number" name="Exercises[__INDEX__].Reps" value="12" min="1" max="100" class="form-control form-control-sm" />
                </div>
                <div class="col-3">
                    <label class="form-label small fw-semibold text-muted mb-1">Duration (Min)</label>
                    <input type="number" name="Exercises[__INDEX__].DurationMinutes" min="0" max="180" class="form-control form-control-sm" placeholder="Optional" />
                </div>
                <div class="col-3">
                    <label class="form-label small fw-semibold text-muted mb-1">Rest (Sec)</label>
                    <input type="number" name="Exercises[__INDEX__].RestSeconds" value="60" min="0" max="600" class="form-control form-control-sm" />
                </div>
            </div>

            <div>
                <label class="form-label small fw-semibold text-muted mb-1">Personal Coaching Instructions for Client</label>
                <input type="text" name="Exercises[__INDEX__].Instructions" class="form-control form-control-sm" placeholder="e.g. Focus on tempo and full extension" />
            </div>
        </div>
    </div>
</template>

@section Scripts {
    @Html.Partial("_ValidationScriptsPartial")
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const container = document.getElementById('exerciseListContainer');
            const template = document.getElementById('exerciseRowTemplate').innerHTML;
            const btnAddTop = document.getElementById('btnAddExercise');
            const btnAddBottom = document.getElementById('btnAddExerciseBottom');

            function addRow() {
                const rows = container.querySelectorAll('.exercise-item-row');
                const nextIndex = rows.length;
                const nextNumber = nextIndex + 1;

                const rowHtml = template
                    .replace(/__INDEX__/g, nextIndex)
                    .replace(/__NUM__/g, nextNumber);

                const tempDiv = document.createElement('div');
                tempDiv.innerHTML = rowHtml.trim();
                const newRow = tempDiv.firstChild;

                container.appendChild(newRow);
                updateBadges();
            }

            function updateBadges() {
                const rows = container.querySelectorAll('.exercise-item-row');
                rows.forEach((row, idx) => {
                    const badge = row.querySelector('.exercise-number-badge');
                    if (badge) badge.textContent = `Exercise #${idx + 1}`;
                });
            }

            btnAddTop.addEventListener('click', addRow);
            btnAddBottom.addEventListener('click', addRow);

            container.addEventListener('click', function (e) {
                const removeBtn = e.target.closest('.btn-remove-row');
                if (removeBtn) {
                    const rows = container.querySelectorAll('.exercise-item-row');
                    if (rows.length <= 1) {
                        alert('A workout routine requires at least 1 exercise.');
                        return;
                    }
                    const rowToRemove = removeBtn.closest('.exercise-item-row');
                    rowToRemove.remove();
                    updateBadges();
                }
            });
        });
    </script>
}

<style>
    .border-dashed {
        border-style: dashed !important;
    }
</style>
