@model HealthTrack.Models.Exercises

@{
    var plan = ViewBag.Plan as HealthTrack.Models.WorkoutPlans;
    var prescription = ViewBag.Prescription as HealthTrack.Models.WorkoutPlanExercises;
    var clientName = plan != null && plan.Clients != null ? plan.Clients.FullName : "Client";
    var trainerName = plan != null && plan.Trainers != null ? plan.Trainers.FullName : "Trainer";
    
    ViewBag.Title = Model.Name + " - Exercise Guide";
}

<div class="container-fluid px-4 py-3">

    <!-- Breadcrumb Navigation -->
    <nav aria-label="breadcrumb" class="mb-2">
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "WorkoutPlans")" class="text-decoration-none">Client Plans</a></li>
            @if (plan != null)
            {
                <li class="breadcrumb-item"><a href="@Url.Action("Details", "WorkoutPlans", new { id = plan.WorkoutPlanId })" class="text-decoration-none">@clientName</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Details", "WorkoutPlans", new { id = plan.WorkoutPlanId })" class="text-decoration-none">@plan.Title</a></li>
            }
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <!-- Header Actions & Title Bar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                @if (prescription != null && !string.IsNullOrEmpty(prescription.ExerciseRole))
                {
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                        @prescription.ExerciseRole
                    </span>
                }
                else
                {
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                        @(!string.IsNullOrEmpty(Model.MovementPattern) ? Model.MovementPattern : Model.Category)
                    </span>
                }
                <span class="badge bg-success-subtle text-success border border-success-subtle">
                    <i class="bi bi-bullseye me-1"></i>@Model.TargetMuscle
                </span>
                <span class="badge bg-light text-dark border">
                    @Model.DifficultyLevel
                </span>
            </div>
            <h2 class="h3 fw-bold mb-0 text-dark">@Model.Name</h2>
            <p class="text-muted small mb-0">
                Prescribed for <strong>@clientName</strong> on 
                <strong>@(prescription != null ? prescription.DayOfWeek : "Scheduled Days")</strong> &bull; Assigned by @trainerName
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            @if (plan != null)
            {
                <a href="@Url.Action("Details", "WorkoutPlans", new { id = plan.WorkoutPlanId })" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm">
                    <i class="bi bi-arrow-left"></i> Back to Workout Plan
                </a>
            }
            else
            {
                <a href="@Url.Action("Index", "Exercises")" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to Library
                </a>
            }
        </div>
    </div>

    <!-- Prescribed Training Details Highlight Box -->
    @if (prescription != null)
    {
        <div class="card border-0 shadow-sm rounded-3 mb-4 bg-primary bg-opacity-10 border-start border-4 border-primary">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-primary text-white"><i class="bi bi-calendar-check me-1"></i>@prescription.DayOfWeek Session</span>
                            <span class="fw-bold text-dark fs-6">Personal Prescription for @clientName</span>
                        </div>
                        <p class="text-muted small mb-0">Follow the designated repetition targets, rest intervals, and customized coaching directives.</p>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <div class="bg-white px-3 py-2 rounded-3 border text-center shadow-2xs">
                            <div class="text-muted x-small text-uppercase fw-bold">Sets</div>
                            <div class="fs-4 fw-bold text-primary lh-1">@prescription.Sets</div>
                        </div>
                        <div class="bg-white px-3 py-2 rounded-3 border text-center shadow-2xs">
                            <div class="text-muted x-small text-uppercase fw-bold">Reps</div>
                            <div class="fs-4 fw-bold text-success lh-1">@(prescription.Reps.HasValue ? prescription.Reps.ToString() : "-")</div>
                        </div>
                        <div class="bg-white px-3 py-2 rounded-3 border text-center shadow-2xs">
                            <div class="text-muted x-small text-uppercase fw-bold">Rest</div>
                            <div class="fs-4 fw-bold text-warning lh-1">@(prescription.RestSeconds)s</div>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(prescription.Instructions))
                {
                    <div class="mt-3 p-3 bg-white rounded-3 border">
                        <div class="fw-bold text-dark small mb-1">
                            <i class="bi bi-chat-quote-fill text-primary me-1"></i> Trainer's Specific Form Note:
                        </div>
                        <p class="text-secondary small mb-0 fst-italic">"@prescription.Instructions"</p>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Main Content Layout -->
    <div class="row g-4 mb-4">

        <!-- Left Column: Visual Demonstrations & Stages -->
        <div class="col-lg-5">
            <!-- Primary Demonstration Card -->
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                        <i class="bi bi-camera-video text-primary"></i> Movement Demonstration
                    </h5>
                    <span class="badge bg-light text-dark border">HD Technique</span>
                </div>
                <div class="card-body p-3">
                    <div class="rounded-3 overflow-hidden shadow-sm border mb-3" style="background-color: #0f172a;">
                        @{
                            string mainImg = !string.IsNullOrEmpty(Model.ImagePath) ? Model.ImagePath : "~/Content/images/exercises/placeholder-exercise.png";
                        }
                        <img src="@Url.Content(mainImg)" alt="@Model.Name Demonstration" class="w-100 object-fit-cover" style="max-height: 340px; display: block;" 
                             onerror="this.onerror=null;this.src='@Url.Content("~/Content/images/exercises/placeholder-exercise.png")';" />
                    </div>

                    <!-- Movement Stages Gallery -->
                    <div class="row g-2">
                        <div class="col-6">
                            <div class="border rounded-2 overflow-hidden bg-light p-1">
                                <div class="position-relative" style="height: 110px;">
                                    @{
                                        string startImg = !string.IsNullOrEmpty(Model.StartImagePath) ? Model.StartImagePath : mainImg;
                                    }
                                    <img src="@Url.Content(startImg)" alt="Start Stage" class="w-100 h-100 object-fit-cover rounded-2" 
                                         onerror="this.onerror=null;this.src='@Url.Content("~/Content/images/exercises/placeholder-exercise.png")';" />
                                    <span class="position-absolute top-0 start-0 badge bg-dark bg-opacity-75 text-white m-1" style="font-size: 0.65rem;">STAGE 1: START</span>
                                </div>
                                <div class="text-center x-small fw-semibold text-secondary pt-1">Setup &amp; Alignment</div>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="border rounded-2 overflow-hidden bg-light p-1">
                                <div class="position-relative" style="height: 110px;">
                                    @{
                                        string moveImg = !string.IsNullOrEmpty(Model.MovementImagePath) ? Model.MovementImagePath : mainImg;
                                    }
                                    <img src="@Url.Content(moveImg)" alt="Movement Stage" class="w-100 h-100 object-fit-cover rounded-2" 
                                         onerror="this.onerror=null;this.src='@Url.Content("~/Content/images/exercises/placeholder-exercise.png")';" />
                                    <span class="position-absolute top-0 start-0 badge bg-dark bg-opacity-75 text-white m-1" style="font-size: 0.65rem;">STAGE 2: MOVEMENT</span>
                                </div>
                                <div class="text-center x-small fw-semibold text-secondary pt-1">Peak Contraction</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Exercise Anatomical Profile Snapshot -->
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                        <i class="bi bi-info-circle text-primary"></i> Anatomical &amp; Equipment Profile
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex flex-column gap-3 small">
                        <div class="d-flex justify-content-between pb-2 border-bottom">
                            <span class="text-muted">Primary Muscle:</span>
                            <span class="fw-bold text-dark">@Model.TargetMuscle</span>
                        </div>
                        <div class="d-flex justify-content-between pb-2 border-bottom">
                            <span class="text-muted">Secondary Muscles:</span>
                            <span class="fw-semibold text-dark">@(!string.IsNullOrEmpty(Model.SecondaryMuscles) ? Model.SecondaryMuscles : "Core, Stabilizers")</span>
                        </div>
                        <div class="d-flex justify-content-between pb-2 border-bottom">
                            <span class="text-muted">Movement Pattern:</span>
                            <span class="badge bg-light text-dark border">@(!string.IsNullOrEmpty(Model.MovementPattern) ? Model.MovementPattern : Model.Category)</span>
                        </div>
                        <div class="d-flex justify-content-between pb-2 border-bottom">
                            <span class="text-muted">Required Equipment:</span>
                            <span class="fw-semibold text-dark">@Model.Equipment</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Est. Caloric Burn:</span>
                            <span class="badge bg-success-subtle text-success">@Model.DefaultCaloriesBurnEstimate kcal / session</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Step-by-Step Instructions & Technique Guidance -->
        <div class="col-lg-7">

            <!-- Step-by-Step Instructions Card -->
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                        <i class="bi bi-list-ol text-primary"></i> Step-by-Step Execution Guide
                    </h5>
                    <span class="badge bg-primary-subtle text-primary">Standard Protocol</span>
                </div>
                <div class="card-body p-4">
                    <p class="text-secondary mb-4" style="line-height: 1.6;">
                        @Model.Description
                    </p>

                    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-play-circle text-primary me-1"></i> Execution Sequence</h6>

                    @{
                        var rawInstructions = (!string.IsNullOrWhiteSpace(Model.Instructions))
                            ? Model.Instructions.Replace(@"\r\n", "\n").Replace(@"\n", "\n")
                            : "";
                        var instructionSteps = rawInstructions.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries)
                            .Where(s => !string.IsNullOrWhiteSpace(s))
                            .ToList();

                        if (!instructionSteps.Any())
                        {
                            instructionSteps.Add("Set up with feet firmly planted shoulder-width apart, ensuring correct joint alignment.");
                            instructionSteps.Add("Engage your core, keep your chest lifted, and maintain a neutral cervical spine.");
                            instructionSteps.Add("Initiate the movement smoothly under control, adhering to the 2-second eccentric tempo.");
                            instructionSteps.Add("Pause briefly at the designated range of motion without sacrificing posture.");
                            instructionSteps.Add("Exhale as you drive through your mid-foot to return to the starting position.");
                        }
                    }

                    <div class="d-flex flex-column gap-3 mb-4">
                        @for (int i = 0; i < instructionSteps.Count; i++)
                        {
                            var stepText = instructionSteps[i].Trim();
                            // strip leading numbers if already numbered
                            if (stepText.Length > 2 && char.IsDigit(stepText[0]) && (stepText[1] == '.' || stepText[1] == ')'))
                            {
                                stepText = stepText.Substring(2).Trim();
                            }

                            <div class="d-flex align-items-start gap-3">
                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center flex-shrink-0 fw-bold" style="width: 30px; height: 30px; font-size: 0.85rem;">
                                    @(i + 1)
                                </div>
                                <div class="flex-grow-1 pt-1 text-dark" style="line-height: 1.5;">
                                    @stepText
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Breathing Protocol -->
                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <div class="fw-bold text-dark small mb-1 d-flex align-items-center gap-1">
                            <i class="bi bi-wind text-info"></i> Breathing Guidance
                        </div>
                        <p class="text-muted small mb-0">
                            Inhale deeply into your diaphragm prior to initiating the eccentric phase to create intra-abdominal pressure. Exhale steadily during the concentric drive phase.
                        </p>
                    </div>

                    <!-- Common Mistakes to Avoid -->
                    <div class="p-3 bg-danger bg-opacity-10 rounded-3 border border-danger-subtle">
                        <div class="fw-bold text-danger small mb-1 d-flex align-items-center gap-1">
                            <i class="bi bi-exclamation-triangle-fill"></i> Common Mistakes to Avoid
                        </div>
                        <ul class="mb-0 text-dark small ps-3">
                            <li>Rushing the descent or bouncing at the bottom of the movement.</li>
                            <li>Allowing the knees to cave inward or rounding the lower back.</li>
                            <li>Losing core tension before completing the full repetition.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Technique and Safety Tips Card -->
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                        <i class="bi bi-shield-check text-success"></i> Technique &amp; Safety Reminders
                    </h5>
                </div>
                <div class="card-body p-4">
                    @{
                        var tipsList = new List<string>();
                        if (!string.IsNullOrWhiteSpace(Model.KeyGuidance))
                        {
                            tipsList.AddRange(Model.KeyGuidance.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries));
                        }
                        if (!string.IsNullOrWhiteSpace(Model.TipsAndPrecautions))
                        {
                            tipsList.AddRange(Model.TipsAndPrecautions.Split(new[] { '.', ';', '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries));
                        }

                        if (!tipsList.Any())
                        {
                            tipsList.Add("Always complete a thorough dynamic warm-up before working sets.");
                            tipsList.Add("Choose a manageable resistance load that allows strict adherence to proper form.");
                            tipsList.Add("Stop 1 to 3 repetitions in reserve (RIR) to maximize hypertrophy stimulus safely.");
                        }
                    }

                    <div class="d-flex flex-column gap-2 mb-3">
                        @foreach (var tip in tipsList.Distinct().Take(4))
                        {
                            if (!string.IsNullOrWhiteSpace(tip))
                            {
                                <div class="d-flex align-items-start gap-2 small text-secondary">
                                    <i class="bi bi-check-circle-fill text-success fs-6 flex-shrink-0 mt-n1"></i>
                                    <span>@tip.Trim()</span>
                                </div>
                            }
                        }
                    </div>

                    <div class="p-3 bg-light rounded-3 text-muted x-small d-flex align-items-center gap-2">
                        <i class="bi bi-shield-exclamation text-warning fs-5 flex-shrink-0"></i>
                        <span>If you experience sharp joint discomfort, pause the movement immediately and notify Coach @trainerName for form assessment or an exercise modification.</span>
                    </div>
                </div>
            </div>

        </div>
    </div>

</div>
