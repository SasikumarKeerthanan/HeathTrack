@model HealthTrack.Areas.Trainer.ViewModels.WorkoutPlanIndexViewModel

@{
    ViewBag.Title = "Client Workout Plans";
}

<div class="container-fluid px-4 py-3">

    <!-- Header & Action Row -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                    <i class="bi bi-stopwatch me-1"></i>Workout Management
                </span>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                    <i class="bi bi-person-check me-1"></i>Personalized Client Plans
                </span>
            </div>
            <h2 class="h3 fw-bold mb-0 text-dark">Personalized Workout Plans</h2>
            <p class="text-muted small mb-0">Design, monitor, and update individual training routines tailored to your assigned clients' goals</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("PopularRoutines")" class="btn btn-outline-primary d-inline-flex align-items-center gap-2 shadow-sm">
                <i class="bi bi-trophy"></i>
                <span>Popular Routines Report</span>
            </a>
            <a href="@Url.Action("Create")" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Create Plan for Client</span>
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill fs-5 text-success"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 me-3">
                        <i class="bi bi-people fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Assigned Clients</div>
                        <h3 class="fw-bold mb-0 text-dark">@Model.TotalClientsCount</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-3 me-3">
                        <i class="bi bi-activity fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Active Client Plans</div>
                        <h3 class="fw-bold mb-0 text-success">@Model.ActivePlansCount</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-secondary bg-opacity-10 text-secondary p-3 me-3">
                        <i class="bi bi-archive fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Archived Plans</div>
                        <h3 class="fw-bold mb-0 text-secondary">@Model.DeactivatedPlansCount</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-3 me-3">
                        <i class="bi bi-person-plus fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Needs Workout Plan</div>
                        <h3 class="fw-bold mb-0 text-warning">@Model.ClientsWithoutPlanCount</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter & Search Controls -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" action="@Url.Action("Index")" class="row g-2 align-items-center">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" name="search" value="@Model.SearchTerm" class="form-control bg-light border-start-0" 
                               placeholder="Search client name, plan title, or goals..." />
                    </div>
                </div>

                <div class="col-md-3">
                    <select name="clientId" class="form-select bg-light">
                        <option value="">All Assigned Clients</option>
                        @foreach (var c in Model.AssignedClients)
                        {
                            <option value="@c.Id" selected="@(Model.SelectedClientId == c.Id ? "selected" : null)">
                                @c.FullName (Goal: @c.PrimaryGoal)
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <select name="goal" class="form-select bg-light">
                        @foreach (var g in Model.Goals)
                        {
                            var gVal = g.StartsWith("All ") ? "" : g;
                            <option value="@gVal" selected="@(Model.SelectedGoal == g || Model.SelectedGoal == gVal || (string.IsNullOrEmpty(Model.SelectedGoal) && gVal == "") ? "selected" : null)">@g</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <select name="status" class="form-select bg-light">
                        <option value="all" selected="@(Model.SelectedStatus == "all" || string.IsNullOrEmpty(Model.SelectedStatus) ? "selected" : null)">All Status</option>
                        <option value="active" selected="@(Model.SelectedStatus == "active" ? "selected" : null)">Active Only</option>
                        <option value="deactivated" selected="@(Model.SelectedStatus == "deactivated" ? "selected" : null)">Archived Only</option>
                    </select>
                </div>

                <div class="col-md-1 d-flex gap-1">
                    <button type="submit" class="btn btn-dark w-100" title="Filter Plans">
                        <i class="bi bi-funnel"></i>
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary" title="Reset Filters">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Section: Clients Currently Awaiting a Workout Plan -->
    @{
        var unassigned = Model.AssignedClients.Where(c => !(Model.AllPlans.Any() ? Model.AllPlans : Model.Plans).Any(p => p.ClientId == c.Id && p.IsActive)).ToList();
    }
    @if (unassigned.Any())
    {
        <div class="card border-0 shadow-sm rounded-3 mb-4 bg-white border-start border-4 border-warning">
            <div class="card-body p-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-2">
                        <i class="bi bi-exclamation-circle fs-4"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark">Clients Awaiting Personalized Plans</div>
                        <div class="small text-muted">
                            The following assigned client(s) do not have an active workout routine: 
                            <strong>@string.Join(", ", unassigned.Select(u => $"{u.FullName} ({u.PrimaryGoal})"))</strong>
                        </div>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    @foreach (var u in unassigned)
                    {
                        <a href="@Url.Action("Create", new { clientId = u.Id })" class="btn btn-sm btn-outline-warning text-dark fw-semibold">
                            <i class="bi bi-plus-circle me-1"></i> Create Plan for @u.FullName
                        </a>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Personalized Workout Plans Grid -->
    @if (!Model.Plans.Any())
    {
        <div class="card border-0 shadow-sm rounded-3 text-center p-5 bg-white">
            <div class="py-4">
                <i class="bi bi-calendar-x display-3 text-muted"></i>
                <h4 class="mt-3 fw-bold text-dark">No Client Plans Found</h4>
                <p class="text-muted mb-4">No routines matched your filter criteria. Create an individual routine for one of your clients.</p>
                <a href="@Url.Action("Create")" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i> Create Plan for a Client
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var plan in Model.Plans)
            {
                <div class="col-4">
                    <div class="card border-0 shadow-sm rounded-3 h-100 transition-hover @(plan.IsActive ? "bg-white" : "bg-white opacity-75 border-start border-3 border-secondary")">
                        <div class="card-body p-4 d-flex flex-column">
                            
                            <!-- Client Header Pill -->
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="rounded-circle bg-primary bg-opacity-10 text-primary p-2 d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                        <i class="bi bi-person-fill"></i>
                                    </span>
                                    <div>
                                        <div class="fw-bold text-dark lh-1">@(plan.Clients != null ? plan.Clients.FullName : "Client")</div>
                                        <div class="text-muted x-small">@(plan.Clients != null ? plan.Clients.Email : "")</div>
                                    </div>
                                </div>

                                @if (plan.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle d-inline-flex align-items-center gap-1">
                                        <span class="spinner-grow spinner-grow-sm" style="width: 0.35rem; height: 0.35rem;"></span> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                        Archived
                                    </span>
                                }
                            </div>

                            <!-- Plan Title & Goal Badges -->
                            <div class="d-flex flex-wrap gap-1 my-2">
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-semibold">
                                    <i class="bi bi-flag me-1"></i>@plan.Goal
                                </span>
                                <span class="badge bg-light text-dark border">
                                    @plan.DifficultyLevel
                                </span>
                            </div>

                            <h5 class="fw-bold text-dark mb-1">@plan.Title</h5>
                            <p class="text-muted small flex-grow-1 mb-3" style="min-height: 38px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @plan.Description
                            </p>

                            <!-- Program Specs -->
                            <div class="bg-light rounded-3 p-2 mb-3">
                                <div class="row text-center g-0">
                                    <div class="col-4 border-end">
                                        <div class="text-muted x-small">DURATION</div>
                                        <div class="fw-bold text-dark small"><i class="bi bi-calendar3 me-1 text-primary"></i>@plan.DurationWeeks Wks</div>
                                    </div>
                                    <div class="col-4 border-end">
                                        <div class="text-muted x-small">FREQUENCY</div>
                                        <div class="fw-bold text-dark small"><i class="bi bi-repeat me-1 text-success"></i>@plan.DaysPerWeek Days/Wk</div>
                                    </div>
                                    <div class="col-4">
                                        <div class="text-muted x-small">EXERCISES</div>
                                        <div class="fw-bold text-dark small"><i class="bi bi-activity me-1 text-danger"></i>@plan.WorkoutPlanExercises.Count Moves</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Schedule Timeline Info -->
                            <div class="d-flex align-items-center justify-content-between small text-muted mb-3 border-top pt-2">
                                <span>
                                    <i class="bi bi-calendar-check me-1 text-secondary"></i>
                                    @plan.StartDate.ToString("MMM dd") - @plan.EndDate.ToString("MMM dd, yyyy")
                                </span>
                                <span class="badge bg-light text-muted border font-monospace">@plan.ClientId</span>
                            </div>

                            <!-- Action Toolbar -->
                            <div class="d-flex gap-2 pt-2 border-top">
                                <a href="@Url.Action("Details", new { id = plan.WorkoutPlanId })" class="btn btn-sm btn-outline-primary flex-fill">
                                    <i class="bi bi-eye me-1"></i> View Routine
                                </a>
                                <a href="@Url.Action("Edit", new { id = plan.WorkoutPlanId })" class="btn btn-sm btn-primary flex-fill" title="Edit Client Plan">
                                    <i class="bi bi-pencil-square me-1"></i> Edit Plan
                                </a>

                                <!-- Toggle Activate / Deactivate Form -->
                                <form action="@Url.Action("ToggleStatus", new { id = plan.WorkoutPlanId })" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm @(plan.IsActive ? "btn-outline-warning" : "btn-outline-success")" 
                                            title="@(plan.IsActive ? "Archive / Deactivate Plan" : "Reactivate Plan")"
                                            onclick="return confirm('Change status of @(plan.Clients != null ? plan.Clients.FullName : "Client")\'s workout plan?');">
                                        <i class="bi @(plan.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                    </button>
                                </form>

                                <!-- Delete Form -->
                                <form action="@Url.Action("Delete", new { id = plan.WorkoutPlanId })" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Plan"
                                            onclick="return confirm('Permanently delete this workout plan for @(plan.Clients != null ? plan.Clients.FullName : "Client")?');">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>

<style>
    .x-small {
        font-size: 0.70rem;
        letter-spacing: 0.5px;
    }
    .transition-hover {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .transition-hover:hover {
        transform: translateY(-3px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.08) !important;
    }
</style>
