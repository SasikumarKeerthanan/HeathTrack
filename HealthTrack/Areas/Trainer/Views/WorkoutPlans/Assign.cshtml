@model HealthTrack.Areas.Trainer.ViewModels.AssignPlanViewModel

@{
    ViewBag.Title = "Assign Workout Plan to Client";
}

<div class="container py-4" style="max-width: 720px;">

    <!-- Breadcrumbs -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index")" class="text-decoration-none">Workout Plans</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Details", new { id = Model.WorkoutPlanId })" class="text-decoration-none">@Model.WorkoutPlanTitle</a></li>
            <li class="breadcrumb-item active" aria-current="page">Assign to Client</li>
        </ol>
    </nav>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-success text-white py-3 px-4">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-person-plus-fill fs-4"></i>
                <div>
                    <h5 class="fw-bold mb-0">Assign Workout Routine</h5>
                    <small class="opacity-75">Enroll a client into "@Model.WorkoutPlanTitle"</small>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            
            <form action="@Url.Action("Assign")" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="WorkoutPlanId" value="@Model.WorkoutPlanId" />
                <input type="hidden" name="WorkoutPlanTitle" value="@Model.WorkoutPlanTitle" />

                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger shadow-sm mb-3" })

                <!-- Client Selector -->
                <div class="mb-3">
                    <label for="ClientId" class="form-label fw-semibold">Select Client <span class="text-danger">*</span></label>
                    <select name="ClientId" id="ClientId" class="form-select form-select-lg">
                        <option value="">-- Choose a registered client --</option>
                        @foreach (var c in Model.AvailableClients)
                        {
                            <option value="@c.Id" 
                                    data-name="@c.FullName" 
                                    data-email="@c.Email"
                                    data-goal="@c.PrimaryGoal"
                                    data-gender="@c.Gender"
                                    data-height="@c.HeightCm"
                                    data-weight="@(c.CurrentWeightKg.HasValue ? c.CurrentWeightKg.Value.ToString("0.0") : "--")"
                                    data-targetweight="@(c.TargetWeightKg.HasValue ? c.TargetWeightKg.Value.ToString("0.0") : "--")"
                                    data-bmi="@(c.CurrentBmi.HasValue ? c.CurrentBmi.Value.ToString("0.0") : "--")"
                                    data-bmicategory="@c.BmiCategory"
                                    data-allergies="@c.Allergies"
                                    data-dietary="@c.DietaryRestrictions"
                                    data-medical="@c.MedicalConditions"
                                    @(Model.ClientId == c.Id ? "selected" : "")>
                                @c.FullName (@c.Email) - Goal: @c.PrimaryGoal
                            </option>
                        }
                    </select>
                    @Html.ValidationMessageFor(m => m.ClientId, "", new { @class = "text-danger small" })
                    <div class="form-text small">
                        <i class="bi bi-info-circle me-1"></i> Choose from registered clients enrolled in the platform.
                    </div>
                </div>

                <!-- Live Client Health & Safety Snapshot -->
                <div id="assignHealthSnapshot" class="card border rounded-3 mb-4 shadow-sm bg-light" style="display: none;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                            <div>
                                <span class="fw-bold text-dark fs-6" id="assignClientName">--</span>
                                <div class="text-muted small" id="assignClientEmail">--</div>
                            </div>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle" id="assignGoalBadge">Goal</span>
                        </div>
                        <div class="row g-2 text-center mb-2">
                            <div class="col-4">
                                <div class="p-2 bg-white rounded border">
                                    <span class="x-small text-muted d-block">Current Wt</span>
                                    <strong class="text-dark small" id="assignWeight">-- kg</strong>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 bg-white rounded border">
                                    <span class="x-small text-muted d-block">Target Wt</span>
                                    <strong class="text-primary small" id="assignTargetWeight">-- kg</strong>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 bg-white rounded border">
                                    <span class="x-small text-muted d-block">BMI</span>
                                    <strong class="text-dark small" id="assignBmi">--</strong>
                                </div>
                            </div>
                        </div>
                        <div id="assignMedicalBox" class="p-2 rounded border small mb-2">
                            <i id="assignMedicalIcon" class="bi bi-shield-exclamation me-1"></i><span id="assignMedicalText">Medical Conditions: None</span>
                        </div>
                        <div class="d-flex gap-1 flex-wrap x-small">
                            <span class="badge bg-white text-muted border" id="assignDietaryBadge">Diet: Balanced</span>
                            <span class="badge bg-white text-muted border" id="assignAllergyBadge">Allergies: None</span>
                        </div>
                    </div>
                </div>

                <!-- Schedule Dates -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label for="StartDate" class="form-label fw-semibold">Program Start Date <span class="text-danger">*</span></label>
                        <input type="date" name="StartDate" id="StartDate" class="form-control" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                        @Html.ValidationMessageFor(m => m.StartDate, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-6">
                        <label for="EndDate" class="form-label fw-semibold">Program End Date <span class="text-danger">*</span></label>
                        <input type="date" name="EndDate" id="EndDate" class="form-control" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
                        @Html.ValidationMessageFor(m => m.EndDate, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <!-- Custom Trainer Notes -->
                <div class="mb-4">
                    <label for="Notes" class="form-label fw-semibold">Personalized Notes / Guidance for this Client</label>
                    <textarea name="Notes" id="Notes" class="form-control" rows="3" placeholder="e.g. Remember to foam roll quads before workout; keep weight moderate for week 1...">@Model.Notes</textarea>
                    @Html.ValidationMessageFor(m => m.Notes, "", new { @class = "text-danger small" })
                </div>

                <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                    <a href="@Url.Action("Details", new { id = Model.WorkoutPlanId })" class="btn btn-outline-secondary px-4">Cancel</a>
                    <button type="submit" class="btn btn-success px-4 shadow-sm">
                        <i class="bi bi-check-circle-fill me-1"></i> Confirm & Assign Plan
                    </button>
                </div>
            </form>

        </div>
    </div>

</div>

@section Scripts {
    @Html.Partial("_ValidationScriptsPartial")
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const clientSelect = document.getElementById('ClientId');
            const snapshotCard = document.getElementById('assignHealthSnapshot');
            const nameEl = document.getElementById('assignClientName');
            const emailEl = document.getElementById('assignClientEmail');
            const goalEl = document.getElementById('assignGoalBadge');
            const weightEl = document.getElementById('assignWeight');
            const targetWeightEl = document.getElementById('assignTargetWeight');
            const bmiEl = document.getElementById('assignBmi');
            const medBox = document.getElementById('assignMedicalBox');
            const medIcon = document.getElementById('assignMedicalIcon');
            const medText = document.getElementById('assignMedicalText');
            const dietBadge = document.getElementById('assignDietaryBadge');
            const allergyBadge = document.getElementById('assignAllergyBadge');

            function updateAssignSnapshot() {
                if (!clientSelect) return;
                const opt = clientSelect.options[clientSelect.selectedIndex];
                if (!opt || !opt.value) {
                    if (snapshotCard) snapshotCard.style.display = 'none';
                    return;
                }

                const name = opt.getAttribute('data-name') || opt.textContent.split('(')[0].trim();
                const email = opt.getAttribute('data-email') || '';
                const goal = opt.getAttribute('data-goal') || 'Fitness';
                const weight = opt.getAttribute('data-weight') || '--';
                const targetWeight = opt.getAttribute('data-targetweight') || '--';
                const bmi = opt.getAttribute('data-bmi') || '--';
                const medical = opt.getAttribute('data-medical') || 'None';
                const dietary = opt.getAttribute('data-dietary') || 'Balanced';
                const allergies = opt.getAttribute('data-allergies') || 'None';

                if (nameEl) nameEl.textContent = name;
                if (emailEl) emailEl.textContent = email;
                if (goalEl) goalEl.textContent = goal;
                if (weightEl) weightEl.textContent = (weight && weight !== '--') ? `${weight} kg` : '--';
                if (targetWeightEl) targetWeightEl.textContent = (targetWeight && targetWeight !== '--') ? `${targetWeight} kg` : '--';
                if (bmiEl) bmiEl.textContent = bmi;

                if (medBox && medIcon && medText) {
                    const hasMed = medical && !medical.toLowerCase().includes('none');
                    if (hasMed) {
                        medBox.className = 'p-2 rounded border small mb-2 bg-warning-subtle border-warning text-dark';
                        medIcon.className = 'bi bi-exclamation-triangle-fill text-warning me-1';
                        medText.innerHTML = `<strong>Medical Precaution:</strong> ${medical}`;
                    } else {
                        medBox.className = 'p-2 rounded border small mb-2 bg-success-subtle border-success text-success';
                        medIcon.className = 'bi bi-check-circle-fill text-success me-1';
                        medText.textContent = 'No injuries or medical conditions reported';
                    }
                }

                if (dietBadge) dietBadge.textContent = `Diet: ${dietary}`;
                if (allergyBadge) {
                    allergyBadge.textContent = `Allergies: ${allergies}`;
                    const hasAllergies = allergies && !allergies.toLowerCase().includes('none');
                    if (hasAllergies) {
                        allergyBadge.className = 'badge bg-danger-subtle text-danger border border-danger-subtle';
                    } else {
                        allergyBadge.className = 'badge bg-white text-muted border';
                    }
                }

                if (snapshotCard) snapshotCard.style.display = 'block';
            }

            if (clientSelect) {
                clientSelect.addEventListener('change', updateAssignSnapshot);
            }
            updateAssignSnapshot();
        });
    </script>
}
