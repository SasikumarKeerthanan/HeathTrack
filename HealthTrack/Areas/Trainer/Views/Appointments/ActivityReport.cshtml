@model HealthTrack.Areas.Trainer.ViewModels.TrainerAppointmentActivityReportViewModel

@{
    ViewBag.Title = "Appointment Activity Report";
}

<div class="container-fluid px-4 py-3">

    <!-- Breadcrumbs -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item">
                <a href="@Url.Action("Index", "Dashboard", new { area = "Trainer" })" class="text-decoration-none">
                    <i class="bi bi-speedometer2 me-1"></i>Dashboard
                </a>
            </li>
            <li class="breadcrumb-item">
                <a href="@Url.Action("Index", "Appointments", new { area = "Trainer" })" class="text-decoration-none">
                    <i class="bi bi-calendar2-check me-1"></i>Appointments &amp; Slots
                </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                Appointment Activity Report
            </li>
        </ol>
    </nav>

    <!-- Header & Action Row -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom gap-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                    <i class="bi bi-calendar2-range-fill me-1"></i>FR-T-51
                </span>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                    <i class="bi bi-bar-chart-fill me-1"></i>Appointment Reporting
                </span>
            </div>
            <h2 class="h3 fw-bold mb-0 text-dark">Appointment Activity Report</h2>
            <p class="text-muted small mb-0">
                Review appointment counts, statuses, and consultation activity records within a selected date range for coach <strong>@Model.TrainerName</strong>
            </p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 shadow-sm">
                <i class="bi bi-arrow-left"></i>
                <span>Appointments &amp; Slots</span>
            </a>
        </div>
    </div>

    <!-- Date Range Validation Warning (FR-T-51 Section 2.C.8) -->
    @if (!string.IsNullOrEmpty(Model.ValidationError))
    {
        <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm border-0 rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 text-warning"></i>
            <div>
                <strong>Invalid Date Range:</strong> @Model.ValidationError
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat Summary Metric Cards (FR-T-51 Section 2.A.4, 2.A.5, 2.A.6) -->
    <div class="row g-3 mb-4">
        <!-- 1. Total Appointments -->
        <div class="col-6 col-md-4 col-xl-2">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted x-small text-uppercase fw-semibold">Total</span>
                        <div class="rounded-circle bg-dark bg-opacity-10 text-dark p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                            <i class="bi bi-calendar2-event-fill fs-6"></i>
                        </div>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-0 text-dark">@Model.TotalAppointments</h3>
                        <span class="text-muted x-small">All sessions in range</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Pending Appointments -->
        <div class="col-6 col-md-4 col-xl-2">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted x-small text-uppercase fw-semibold text-warning">Pending</span>
                        <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                            <i class="bi bi-hourglass-split fs-6"></i>
                        </div>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-0 text-warning">@Model.PendingAppointments</h3>
                        <span class="text-muted x-small">
                            @(Model.TotalAppointments > 0 ? $"{(int)Math.Round((double)Model.PendingAppointments / Model.TotalAppointments * 100)}% of total" : "Awaiting review")
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Approved Appointments -->
        <div class="col-6 col-md-4 col-xl-2">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted x-small text-uppercase fw-semibold text-primary">Approved</span>
                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                            <i class="bi bi-check-circle-fill fs-6"></i>
                        </div>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-0 text-primary">@Model.ApprovedAppointments</h3>
                        <span class="text-muted x-small">
                            @(Model.TotalAppointments > 0 ? $"{(int)Math.Round((double)Model.ApprovedAppointments / Model.TotalAppointments * 100)}% of total" : "Confirmed sessions")
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. Completed Appointments -->
        <div class="col-6 col-md-4 col-xl-2">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted x-small text-uppercase fw-semibold text-success">Completed</span>
                        <div class="rounded-circle bg-success bg-opacity-10 text-success p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                            <i class="bi bi-patch-check-fill fs-6"></i>
                        </div>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-0 text-success">@Model.CompletedAppointments</h3>
                        <span class="text-muted x-small">
                            @(Model.TotalAppointments > 0 ? $"{(int)Math.Round((double)Model.CompletedAppointments / Model.TotalAppointments * 100)}% of total" : "Finished consults")
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 5. Cancelled Appointments -->
        <div class="col-6 col-md-4 col-xl-2">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted x-small text-uppercase fw-semibold text-danger">Cancelled</span>
                        <div class="rounded-circle bg-danger bg-opacity-10 text-danger p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                            <i class="bi bi-x-circle-fill fs-6"></i>
                        </div>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-0 text-danger">@Model.CancelledAppointments</h3>
                        <span class="text-muted x-small">
                            @(Model.TotalAppointments > 0 ? $"{(int)Math.Round((double)Model.CancelledAppointments / Model.TotalAppointments * 100)}% of total" : "Cancelled history")
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 6. Rejected Appointments -->
        <div class="col-6 col-md-4 col-xl-2">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted x-small text-uppercase fw-semibold text-secondary">Rejected</span>
                        <div class="rounded-circle bg-secondary bg-opacity-10 text-secondary p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                            <i class="bi bi-slash-circle-fill fs-6"></i>
                        </div>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-0 text-secondary">@Model.RejectedAppointments</h3>
                        <span class="text-muted x-small">
                            @(Model.TotalAppointments > 0 ? $"{(int)Math.Round((double)Model.RejectedAppointments / Model.TotalAppointments * 100)}% of total" : "Declined requests")
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Date Range & Filter Card (FR-T-51 Section 2.C) -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 bg-white">
        <div class="card-body p-3">
            <form method="get" action="@Url.Action("ActivityReport")" class="row g-3 align-items-end" id="activityReportFilterForm">
                
                <!-- Quick Date Preset -->
                <div class="col-12 col-md-3">
                    <label class="form-label small fw-semibold text-muted mb-1">
                        <i class="bi bi-calendar-range me-1"></i>Date Preset
                    </label>
                    <select name="preset" class="form-select form-select-sm bg-light" id="activityPresetSelect" onchange="toggleReportCustomDates()">
                        <option value="all" @(Model.DatePreset == "all" ? "selected" : "")>All Time</option>
                        <option value="30days" @(Model.DatePreset == "30days" ? "selected" : "")>Last 30 Days</option>
                        <option value="90days" @(Model.DatePreset == "90days" ? "selected" : "")>Last 90 Days</option>
                        <option value="7days" @(Model.DatePreset == "7days" ? "selected" : "")>Last 7 Days</option>
                        <option value="custom" @(Model.DatePreset == "custom" ? "selected" : "")>Custom Date Range</option>
                    </select>
                </div>

                <!-- From Date (Boundaries inclusive) -->
                <div class="col-12 col-sm-6 col-md-2" id="fromDateCol" style="display: @(Model.DatePreset == "custom" || Model.FromDate.HasValue ? "block" : "none");">
                    <label class="form-label small fw-semibold text-muted mb-1">From Date</label>
                    <input type="date" name="fromDate" id="fromDateInput" class="form-control form-control-sm bg-light" 
                           value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
                </div>

                <!-- To Date (Boundaries inclusive) -->
                <div class="col-12 col-sm-6 col-md-2" id="toDateCol" style="display: @(Model.DatePreset == "custom" || Model.ToDate.HasValue ? "block" : "none");">
                    <label class="form-label small fw-semibold text-muted mb-1">To Date</label>
                    <input type="date" name="toDate" id="toDateInput" class="form-control form-control-sm bg-light" 
                           value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
                </div>

                <!-- Status Filter on Detail Table -->
                <div class="col-12 col-md-2">
                    <label class="form-label small fw-semibold text-muted mb-1">
                        <i class="bi bi-funnel me-1"></i>Status Filter
                    </label>
                    <select name="status" class="form-select form-select-sm bg-light">
                        <option value="all" @(Model.StatusFilter == "all" ? "selected" : "")>All Statuses</option>
                        <option value="Pending" @(Model.StatusFilter == "Pending" ? "selected" : "")>Pending (@Model.PendingAppointments)</option>
                        <option value="Approved" @(Model.StatusFilter == "Approved" ? "selected" : "")>Approved (@Model.ApprovedAppointments)</option>
                        <option value="Completed" @(Model.StatusFilter == "Completed" ? "selected" : "")>Completed (@Model.CompletedAppointments)</option>
                        <option value="Cancelled" @(Model.StatusFilter == "Cancelled" ? "selected" : "")>Cancelled (@Model.CancelledAppointments)</option>
                        <option value="Rejected" @(Model.StatusFilter == "Rejected" ? "selected" : "")>Rejected (@Model.RejectedAppointments)</option>
                    </select>
                </div>

                <!-- Action Buttons (Generate Report + Clear Filters) -->
                <div class="col-12 col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm flex-grow-1 shadow-sm d-inline-flex align-items-center justify-content-center gap-1">
                        <i class="bi bi-search"></i>
                        <span>Apply Filter</span>
                    </button>
                    <a href="@Url.Action("ActivityReport")" class="btn btn-outline-secondary btn-sm shadow-sm d-inline-flex align-items-center gap-1" title="Clear Filters (FR-T-51 Section 2.C.6)">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        <span>Clear</span>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Appointment Activity Details Table Card (FR-T-51 Section 2.D) -->
    <div class="card border-0 shadow-sm rounded-3 bg-white overflow-hidden mb-4">
        <div class="card-header bg-white py-3 px-4 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-journal-text text-primary me-2"></i>Appointment Activity Records
                </h5>
                <span class="text-muted small">
                    Showing scheduled consultations within selected date range
                    @(Model.FromDate.HasValue || Model.ToDate.HasValue 
                        ? $"({(Model.FromDate.HasValue ? Model.FromDate.Value.ToString("MMM dd, yyyy") : "Beginning")} to {(Model.ToDate.HasValue ? Model.ToDate.Value.ToString("MMM dd, yyyy") : "Present")})" 
                        : "(All Time)")
                </span>
            </div>
            <div>
                <span class="badge bg-light text-secondary border px-2 py-1">
                    @Model.ActivityDetails.Count Record@(Model.ActivityDetails.Count == 1 ? "" : "s") Displayed
                </span>
            </div>
        </div>

        <div class="card-body p-0">
            @if (Model.ActivityDetails.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-uppercase text-muted small">
                            <tr>
                                <th style="width: 120px;">Code</th>
                                <th>Appointment Date</th>
                                <th>Client Name</th>
                                <th>Start Time</th>
                                <th>End Time</th>
                                <th>Consultation Topic</th>
                                <th>Status</th>
                                <th>Details / Location</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.ActivityDetails)
                            {
                                <tr>
                                    <!-- Appointment Code -->
                                    <td>
                                        <span class="badge bg-light text-dark border font-monospace">
                                            @item.AppointmentCode
                                        </span>
                                    </td>

                                    <!-- Appointment Date (Section 2.D) -->
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rounded-circle bg-light text-primary p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                                <i class="bi bi-calendar3"></i>
                                            </div>
                                            <div>
                                                <span class="fw-bold text-dark d-block">
                                                    @item.AppointmentDate.ToString("MMM dd, yyyy")
                                                </span>
                                                <span class="text-muted x-small">
                                                    @item.AppointmentDate.ToString("dddd")
                                                </span>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- Client Name (Section 2.D) -->
                                    <td>
                                        <div>
                                            <span class="fw-semibold text-dark d-block">
                                                <i class="bi bi-person me-1 text-muted"></i>@item.ClientName
                                            </span>
                                            @if (!string.IsNullOrWhiteSpace(item.ClientEmail))
                                            {
                                                <span class="text-muted x-small">@item.ClientEmail</span>
                                            }
                                        </div>
                                    </td>

                                    <!-- Start Time (Section 2.D) -->
                                    <td>
                                        <span class="small fw-semibold text-dark">
                                            <i class="bi bi-clock me-1 text-muted"></i>@(DateTime.Today.Add(item.StartTime).ToString("hh:mm tt"))
                                        </span>
                                    </td>

                                    <!-- End Time (Section 2.D) -->
                                    <td>
                                        <span class="small text-muted">
                                            @(DateTime.Today.Add(item.EndTime).ToString("hh:mm tt"))
                                        </span>
                                    </td>

                                    <!-- Topic / Title -->
                                    <td>
                                        <span class="small text-dark fw-semibold d-block">
                                            @item.Title
                                        </span>
                                    </td>

                                    <!-- Status (Section 2.D) -->
                                    <td>
                                        @if (string.Equals(item.Status, "Pending", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                                                <i class="bi bi-hourglass-split me-1"></i>Pending
                                            </span>
                                        }
                                        else if (string.Equals(item.Status, "Approved", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                                <i class="bi bi-check-circle-fill me-1"></i>Approved
                                            </span>
                                        }
                                        else if (string.Equals(item.Status, "Completed", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                <i class="bi bi-patch-check-fill me-1"></i>Completed
                                            </span>
                                        }
                                        else if (string.Equals(item.Status, "Cancelled", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                                <i class="bi bi-x-circle-fill me-1"></i>Cancelled
                                            </span>
                                        }
                                        else if (string.Equals(item.Status, "Rejected", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                                <i class="bi bi-slash-circle-fill me-1"></i>Rejected
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border px-2 py-1">
                                                @item.Status
                                            </span>
                                        }
                                    </td>

                                    <!-- Location / Notes -->
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.MeetingLocation))
                                        {
                                            <span class="x-small text-muted d-block">
                                                <i class="bi bi-geo-alt me-1"></i>@item.MeetingLocation
                                            </span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.CancellationReason))
                                        {
                                            <span class="x-small text-danger d-block text-truncate" style="max-width: 200px;" title="@item.CancellationReason">
                                                <i class="bi bi-info-circle me-1"></i>@item.CancellationReason
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <!-- Empty-State Message (FR-T-51 Section 2.A.7) -->
                <div class="text-center py-5 px-3">
                    <div class="rounded-circle bg-light d-inline-flex p-4 mb-3 text-muted">
                        <i class="bi bi-calendar-x fs-1"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-1">No Appointments Found</h5>
                    <p class="text-muted small mb-3" style="max-width: 480px; margin: 0 auto;">
                        There are no appointment records matching your selected date range or status criteria. Try selecting a broader date range or clearing your filters.
                    </p>
                    <div class="d-flex justify-content-center gap-2">
                        <a href="@Url.Action("ActivityReport")" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>Clear Filters
                        </a>
                        <a href="@Url.Action("Index")" class="btn btn-sm btn-primary">
                            <i class="bi bi-calendar2-check me-1"></i>View All Appointments
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Methodology / Calculation Transparency Card (FR-T-51 Section 2.B) -->
    <div class="card border-0 bg-light rounded-3 shadow-sm p-3">
        <div class="d-flex align-items-start gap-3">
            <i class="bi bi-info-circle-fill text-primary fs-4 mt-1"></i>
            <div>
                <h6 class="fw-bold text-dark mb-1">About the Appointment Activity Report (FR-T-51)</h6>
                <p class="text-muted small mb-0">
                    <strong>Report Calculation:</strong> Appointment counts are aggregated from distinct appointment records scheduled within the selected date range for the authenticated trainer.
                    The sum of status counts (Pending + Approved + Completed + Cancelled + Rejected) exactly equals the Total Appointments metric.
                    Cancelled and rejected appointments are included as part of consultation history.
                    Individual availability slots, client rescheduling requests, and alternative time proposals are not counted as additional appointments.
                </p>
            </div>
        </div>
    </div>

</div>

<script>
    function toggleReportCustomDates() {
        var preset = document.getElementById("activityPresetSelect").value;
        var fromCol = document.getElementById("fromDateCol");
        var toCol = document.getElementById("toDateCol");
        if (preset === "custom") {
            fromCol.style.display = "block";
            toCol.style.display = "block";
        } else {
            fromCol.style.display = "none";
            toCol.style.display = "none";
        }
    }
</script>
