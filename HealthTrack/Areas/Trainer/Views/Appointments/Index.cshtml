<div class="modal fade" id="proposeAlternativeModal" tabindex="-1" aria-labelledby="proposeAlternativeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            @using (Html.BeginForm("ProposeAlternative", "Appointments", new { area = "Trainer" }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="AppointmentId" id="proposeAltAppointmentId" />

                <div class="modal-header bg-light border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="proposeAlternativeModalLabel">
                        <i class="bi bi-calendar-event text-primary me-2"></i>Propose Alternative Time
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-3">
                    <p class="text-muted small mb-3">
                        Select one of your available published slots to propose to <strong id="proposeAltClientName" class="text-dark"></strong> for consultation <strong id="proposeAltCode" class="text-primary"></strong>. The current schedule will remain active until the client confirms.
                    </p>

                    <div class="p-3 bg-light rounded-3 mb-3 border small">
                        <div class="text-muted mb-1"><i class="bi bi-calendar-check me-1"></i><strong>Current Schedule:</strong></div>
                        <div id="proposeAltCurrentSchedule" class="fw-semibold text-dark"></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark">Select Alternative Available Slot <span class="text-danger">*</span></label>
                        @if (Model.FutureUnbookedSlots != null && Model.FutureUnbookedSlots.Any())
                        {
                            <select name="AvailabilityId" id="proposeAltAvailabilityId" class="form-select" required>
                                <option value="">-- Choose an open slot --</option>
                                @foreach (var slot in Model.FutureUnbookedSlots)
                                {
                                    <option value="@slot.AvailabilityId" data-date="@slot.SlotDate.ToString("yyyy-MM-dd")">
                                        @slot.DisplayText
                                    </option>
                                }
                            </select>
                        }
                        else
                        {
                            <div class="alert alert-warning small mb-0">
                                <i class="bi bi-exclamation-triangle me-1"></i> You currently have no unbooked future availability slots published. Please add available slots in your schedule first.
                            </div>
                        }
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-semibold small text-dark">Message to Client (Optional)</label>
                        <textarea name="TrainerMessage" id="proposeAltTrainerMessage" class="form-control" rows="3" maxlength="500" placeholder="e.g., I have an earlier opening this Friday if that works better for your fitness schedule..."></textarea>
                        <div class="form-text small">Explain why this alternative time is recommended (max 500 characters).</div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold" @(Model.FutureUnbookedSlots == null || !Model.FutureUnbookedSlots.Any() ? "disabled" : "")>
                        <i class="bi bi-send me-1"></i> Send Proposal
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            // Robust tab switching for trainer appointment tabs
            $('#trainerAptTabs button[data-bs-toggle="tab"]').on('click', function (e) {
                e.preventDefault();
                var target = $(this).attr('data-bs-target');

                // Update active tab buttons
                $('#trainerAptTabs button').removeClass('active').attr('aria-selected', 'false');
                $(this).addClass('active').attr('aria-selected', 'true');

                // Switch visible pane
                $('#trainerAptTabsContent .tab-pane').removeClass('show active');
                $(target).addClass('show active');

                // Remember active tab in browser URL hash
                if (history.replaceState) {
                    history.replaceState(null, null, target);
                }
            });

            // Activate tab from URL hash if present
            var currentHash = window.location.hash;
            if (currentHash) {
                var targetBtn = $('#trainerAptTabs button[data-bs-target="' + currentHash + '"]');
                if (targetBtn.length) {
                    targetBtn.trigger('click');
                }
            }
        });

        function openApproveModal(id, code, clientName) {
            $('#approveAptId').val(id);
            $('#approveAptCode').text(code);
            $('#approveClientName').text(clientName);
            var m = new bootstrap.Modal(document.getElementById('approveModal'));
            m.show();
        }

        function openRejectModal(id, code, clientName) {
            $('#rejectAptId').val(id);
            $('#rejectClientName').text(clientName + ' (' + code + ')');
            var m = new bootstrap.Modal(document.getElementById('rejectModal'));
            m.show();
        }

        function openCompleteModal(id, code, clientName) {
            $('#completeAptId').val(id);
            $('#completeClientName').text(clientName + ' (' + code + ')');
            var m = new bootstrap.Modal(document.getElementById('completeModal'));
            m.show();
        }

        function openCancelTrainerModal(id, code, clientName) {
            $('#cancelTrainerAptId').val(id);
            $('#cancelTrainerClientName').text(clientName + ' (' + code + ')');
            var m = new bootstrap.Modal(document.getElementById('cancelTrainerModal'));
            m.show();
        }

        function openApproveRescheduleModal(reqId, code, clientName, newSlot, location) {
            $('#approveRescheduleReqId').val(reqId);
            $('#approveRescheduleAptCode').text(code);
            $('#approveRescheduleClientName').text(clientName);
            $('#approveRescheduleNewSlot').text(newSlot);
            $('#approveRescheduleLocation').val(location || 'Main Fitness Center - Floor Consult Desk');
            var m = new bootstrap.Modal(document.getElementById('approveRescheduleModal'));
            m.show();
        }

        function openRejectRescheduleModal(reqId, code, clientName, slot) {
            $('#rejectRescheduleReqId').val(reqId);
            $('#rejectRescheduleAptCode').text(code);
            $('#rejectRescheduleClientName').text(clientName);
            $('#rejectRescheduleSlot').text(slot);
            var m = new bootstrap.Modal(document.getElementById('rejectRescheduleModal'));
            m.show();
        }

        function openProposeAlternativeModal(id, code, clientName, dateStr, displayDate, timeStr) {
            $('#proposeAltAppointmentId').val(id);
            $('#proposeAltCode').text(code);
            $('#proposeAltClientName').text(clientName);
            $('#proposeAltCurrentSchedule').text(displayDate + ' (' + timeStr + ')');
            $('#proposeAltTrainerMessage').val('');
            $('#proposeAltAvailabilityId').val('');
            var m = new bootstrap.Modal(document.getElementById('proposeAlternativeModal'));
            m.show();
        }
    </script>
