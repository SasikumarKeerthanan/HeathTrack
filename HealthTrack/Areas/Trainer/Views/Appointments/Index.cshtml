@model HealthTrack.Areas.Trainer.ViewModels.TrainerAppointmentIndexViewModel

@{
    ViewBag.Title = "Appointments & Availability";
}

<div class="container-fluid px-4 py-3">
    <!-- Header Row -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom gap-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                    <i class="bi bi-calendar2-check me-1"></i>Consultation Management
                </span>
                <span class="badge bg-warning-subtle text-dark border border-warning-subtle px-2 py-1">
                    <i class="bi bi-clock-history me-1"></i>1-on-1 Sessions
                </span>
            </div>
            <h2 class="h3 fw-bold mb-0 text-dark">Client Appointments &amp; Availability</h2>
            <p class="text-muted small mb-0">Post open availability slots, review client booking requests, and record post-consultation coaching notes.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("ActivityReport")" class="btn btn-outline-primary d-inline-flex align-items-center gap-1 shadow-sm">
                <i class="bi bi-calendar2-range"></i>
                <span>Activity Report</span>
            </a>
            <button type="button" class="btn btn-warning text-dark fw-semibold d-inline-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#addSlotModal">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Add Open Time Slot</span>
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 rounded-4 shadow-sm py-3 px-4 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <span>@TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 rounded-4 shadow-sm py-3 px-4 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <span>@TempData["ErrorMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.RescheduleRequestsCount > 0)
    {
        <div class="alert alert-info border-0 rounded-4 shadow-sm py-3 px-4 mb-4 d-flex flex-wrap align-items-center justify-content-between gap-3" role="alert">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-info bg-opacity-25 text-info p-2 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                    <i class="bi bi-arrow-repeat fs-4"></i>
                </div>
                <div>
                    <h6 class="fw-bold text-dark mb-0">You have @Model.RescheduleRequestsCount pending appointment rescheduling request@(Model.RescheduleRequestsCount > 1 ? "s" : "")</h6>
                    <span class="small text-muted">Clients have requested a new time slot for their existing sessions. Review and approve or decline.</span>
                </div>
            </div>
            <button type="button" class="btn btn-sm btn-info text-dark fw-semibold rounded-pill px-3 shadow-sm" onclick="$('#reschedule-tab').trigger('click');">
                Review Reschedule Requests <i class="bi bi-arrow-right ms-1"></i>
            </button>
        </div>
    }

    <!-- KPI Row -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="x-small text-uppercase fw-bold text-muted">Pending Requests</span>
                    <div class="rounded-3 bg-warning bg-opacity-10 text-warning p-2">
                        <i class="bi bi-hourglass-split fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-warning mb-0">@Model.PendingCount</h3>
                <span class="x-small text-muted">Awaiting your confirmation</span>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="x-small text-uppercase fw-bold text-muted">Confirmed Upcoming</span>
                    <div class="rounded-3 bg-success bg-opacity-10 text-success p-2">
                        <i class="bi bi-calendar-check-fill fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-success mb-0">@Model.ApprovedCount</h3>
                <span class="x-small text-muted">Ready on schedule</span>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="x-small text-uppercase fw-bold text-muted">Total Schedule Slots</span>
                    <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-2">
                        <i class="bi bi-calendar-plus fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-primary mb-0">@Model.TotalSlotsCount</h3>
                <span class="x-small text-muted">@Model.OpenSlotsCount open &bull; @(Model.TotalSlotsCount - Model.OpenSlotsCount) booked</span>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="x-small text-uppercase fw-bold text-muted">Completed Sessions</span>
                    <div class="rounded-3 bg-info bg-opacity-10 text-info p-2">
                        <i class="bi bi-journal-check fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-dark mb-0">@Model.CompletedCount</h3>
                <span class="x-small text-muted">Consultations completed</span>
            </div>
        </div>
    </div>

    <style>
        /* Modern Tab Navigation for Trainer Appointments */
        #trainerAptTabs {
            border-bottom: 2px solid #f1f5f9;
            display: flex;
            flex-wrap: wrap;
            gap: 0.25rem;
        }
        #trainerAptTabs .nav-link {
            color: #475569;
            background: transparent !important;
            border: none !important;
            border-bottom: 3px solid transparent !important;
            font-weight: 600;
            font-size: 0.95rem;
            padding: 1rem 1.25rem;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            cursor: pointer;
            transition: all 0.2s ease-in-out;
            position: relative;
            bottom: -2px;
        }
        #trainerAptTabs .nav-link:hover {
            color: #0f172a;
            background: #f8fafc !important;
            border-radius: 8px 8px 0 0;
        }
        #trainerAptTabs .nav-link.active {
            color: #0d6efd !important;
            border-bottom: 3px solid #ffc107 !important;
            font-weight: 700 !important;
            background: transparent !important;
        }
    </style>

    <!-- Main Navigation Tabs -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden mb-4">
        <div class="card-header bg-white border-bottom p-0 px-4">
            <ul class="nav nav-tabs border-0" id="trainerAptTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="pending-tab" data-bs-toggle="tab" data-bs-target="#pendingTab" type="button" role="tab" aria-controls="pendingTab" aria-selected="true">
                        <i class="bi bi-bell-fill text-warning me-1"></i> Pending Requests
                        @if (Model.PendingCount > 0)
                        {
                            <span class="badge bg-warning text-dark ms-1">@Model.PendingCount</span>
                        }
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="reschedule-tab" data-bs-toggle="tab" data-bs-target="#rescheduleTab" type="button" role="tab" aria-controls="rescheduleTab" aria-selected="false">
                        <i class="bi bi-arrow-repeat text-info me-1"></i> Reschedule Requests
                        @if (Model.RescheduleRequestsCount > 0)
                        {
                            <span class="badge bg-info text-dark ms-1">@Model.RescheduleRequestsCount</span>
                        }
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="approved-tab" data-bs-toggle="tab" data-bs-target="#approvedTab" type="button" role="tab" aria-controls="approvedTab" aria-selected="false">
                        <i class="bi bi-calendar2-check-fill text-success me-1"></i> Confirmed Sessions
                        <span class="badge bg-success ms-1">@Model.ApprovedCount</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="history-tab" data-bs-toggle="tab" data-bs-target="#historyTab" type="button" role="tab" aria-controls="historyTab" aria-selected="false">
                        <i class="bi bi-check2-all text-info me-1"></i> Session History
                        <span class="badge bg-secondary ms-1">@Model.CompletedCount</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="slots-tab" data-bs-toggle="tab" data-bs-target="#slotsTab" type="button" role="tab" aria-controls="slotsTab" aria-selected="false">
                        <i class="bi bi-clock-fill text-primary me-1"></i> Manage Availability Slots
                        <span class="badge bg-primary ms-1">@Model.TotalSlotsCount</span>
                    </button>
                </li>
            </ul>
        </div>

        <div class="card-body p-4">
            <div class="tab-content" id="trainerAptTabsContent">
                
                <!-- TAB 1: PENDING REQUESTS -->
                <div class="tab-pane fade show active" id="pendingTab" role="tabpanel">
                    @if (Model.PendingRequests != null && Model.PendingRequests.Any())
                    {
                        <div class="row g-3">
                            @foreach (var req in Model.PendingRequests)
                            {
                                <div class="col-lg-6 col-12">
                                    <div class="card border rounded-4 p-3 shadow-none bg-warning bg-opacity-10 border-warning-subtle">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge bg-warning text-dark fw-bold">@req.AppointmentCode</span>
                                                <span class="small fw-bold text-dark">@req.ClientName</span>
                                            </div>
                                            <span class="badge bg-white text-dark border">
                                                <i class="bi bi-calendar me-1"></i>@req.AppointmentDate.ToString("ddd, MMM dd, yyyy")
                                            </span>
                                        </div>

                                        <h5 class="fw-bold text-dark mb-1">@req.Title</h5>
                                        <div class="small text-muted mb-2">
                                            <i class="bi bi-clock me-1 text-primary"></i>
                                            <strong>@DateTime.Today.Add(req.StartTime).ToString("hh:mm tt")</strong> - <strong>@DateTime.Today.Add(req.EndTime).ToString("hh:mm tt")</strong>
                                            &bull; Requested: @req.CreatedAt.ToString("MMM dd, hh:mm tt")
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(req.ClientNotes))
                                        {
                                            <div class="p-2 rounded-3 bg-white border small text-muted mb-3">
                                                <span class="fw-semibold text-dark">Client Goals:</span> @req.ClientNotes
                                            </div>
                                        }

                                        @if (req.HasActiveProposal)
                                        {
                                            <div class="alert alert-info py-2 px-3 mb-3 small rounded-3 border">
                                                <div class="d-flex align-items-center justify-content-between mb-1">
                                                    <span class="fw-bold text-dark"><i class="bi bi-clock-history me-1 text-primary"></i>Alternative Proposed</span>
                                                    <span class="badge bg-primary">Awaiting Client Confirmation</span>
                                                </div>
                                                <div class="text-primary fw-semibold">@req.ProposedDisplayDateTime</div>
                                                @if (!string.IsNullOrWhiteSpace(req.TrainerProposalMessage))
                                                {
                                                    <div class="text-muted small mt-1 fst-italic">"@req.TrainerProposalMessage"</div>
                                                }
                                            </div>
                                        }

                                        <!-- Actions -->
                                        <div class="d-flex gap-2 justify-content-end pt-2 border-top flex-wrap">
                                            @if (req.CanProposeAlternative && !req.HasActiveProposal)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3"
                                                        onclick="openProposeAlternativeModal(@req.AppointmentId, '@req.AppointmentCode', '@Html.Raw(HttpUtility.JavaScriptStringEncode(req.ClientName))', '@req.AppointmentDate.ToString("yyyy-MM-dd")', '@req.AppointmentDate.ToString("ddd, MMM dd, yyyy")', '@DateTime.Today.Add(req.StartTime).ToString("hh:mm tt") - @DateTime.Today.Add(req.EndTime).ToString("hh:mm tt")')">
                                                    <i class="bi bi-calendar-event me-1"></i> Propose Alternative
                                                </button>
                                            }
                                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                                    onclick="openRejectModal(@req.AppointmentId, '@req.AppointmentCode', '@Html.Raw(HttpUtility.JavaScriptStringEncode(req.ClientName))')">
                                                <i class="bi bi-x-circle me-1"></i> Decline
                                            </button>
                                            <button type="button" class="btn btn-sm btn-success rounded-pill px-4 fw-semibold shadow-sm"
                                                    onclick="openApproveModal(@req.AppointmentId, '@req.AppointmentCode', '@Html.Raw(HttpUtility.JavaScriptStringEncode(req.ClientName))')">
                                                <i class="bi bi-check-circle-fill me-1"></i> Confirm &amp; Approve
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-inbox text-muted fs-1 mb-2"></i>
                            <h5 class="fw-bold text-dark">No Pending Requests</h5>
                            <p class="text-muted small mb-0">All client consultation requests have been addressed.</p>
                        </div>
                    }
                </div>

                <!-- TAB 2: CONFIRMED SESSIONS -->
                <div class="tab-pane fade" id="approvedTab" role="tabpanel">
                    @if (Model.ApprovedUpcoming != null && Model.ApprovedUpcoming.Any())
                    {
                        <div class="row g-3">
                            @foreach (var apt in Model.ApprovedUpcoming)
                            {
                                <div class="col-lg-6 col-12">
                                    <div class="card border rounded-4 p-3 shadow-none bg-light">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <span class="badge bg-success-subtle text-success border border-success-subtle fw-bold me-1">@apt.AppointmentCode</span>
                                                <span class="fw-bold text-dark">@apt.ClientName</span>
                                            </div>
                                            <span class="small fw-semibold text-primary">
                                                @apt.AppointmentDate.ToString("ddd, MMM dd, yyyy")
                                            </span>
                                        </div>

                                        <h5 class="fw-bold text-dark mb-1">@apt.Title</h5>
                                        <div class="small text-muted mb-2">
                                            <i class="bi bi-clock me-1 text-info"></i>
                                            @DateTime.Today.Add(apt.StartTime).ToString("hh:mm tt") - @DateTime.Today.Add(apt.EndTime).ToString("hh:mm tt")
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(apt.MeetingLocation))
                                        {
                                            <div class="small text-dark mb-2">
                                                <i class="bi bi-geo-alt-fill text-danger me-1"></i>Location: <strong>@apt.MeetingLocation</strong>
                                            </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(apt.ClientNotes))
                                        {
                                            <div class="p-2 rounded-3 bg-white border small text-muted mb-3">
                                                <span class="fw-semibold text-dark">Client Focus:</span> @apt.ClientNotes
                                            </div>
                                        }

                                        @if (apt.HasActiveProposal)
                                        {
                                            <div class="alert alert-info py-2 px-3 mb-3 small rounded-3 border">
                                                <div class="d-flex align-items-center justify-content-between mb-1">
                                                    <span class="fw-bold text-dark"><i class="bi bi-clock-history me-1 text-primary"></i>Alternative Proposed</span>
                                                    <span class="badge bg-primary">Awaiting Client Confirmation</span>
                                                </div>
                                                <div class="text-primary fw-semibold">@apt.ProposedDisplayDateTime</div>
                                                @if (!string.IsNullOrWhiteSpace(apt.TrainerProposalMessage))
                                                {
                                                    <div class="text-muted small mt-1 fst-italic">"@apt.TrainerProposalMessage"</div>
                                                }
                                            </div>
                                        }

                                        <!-- Completion / Cancellation Actions -->
                                        <div class="mt-auto pt-2 border-top d-flex flex-wrap align-items-center justify-content-between gap-2">
                                            <div class="d-flex gap-2 flex-wrap">
                                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3"
                                                        onclick="openCancelTrainerModal(@apt.AppointmentId, '@apt.AppointmentCode', '@Html.Raw(HttpUtility.JavaScriptStringEncode(apt.ClientName))')">
                                                    <i class="bi bi-x-circle me-1"></i> Cancel Session
                                                </button>
                                                @if (apt.CanProposeAlternative && !apt.HasActiveProposal)
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-info rounded-pill px-3"
                                                            onclick="openProposeAlternativeModal(@apt.AppointmentId, '@apt.AppointmentCode', '@Html.Raw(HttpUtility.JavaScriptStringEncode(apt.ClientName))', '@apt.AppointmentDate.ToString("yyyy-MM-dd")', '@apt.AppointmentDate.ToString("ddd, MMM dd, yyyy")', '@DateTime.Today.Add(apt.StartTime).ToString("hh:mm tt") - @DateTime.Today.Add(apt.EndTime).ToString("hh:mm tt")')">
                                                        <i class="bi bi-calendar-event me-1"></i> Propose Alternative
                                                    </button>
                                                }
                                            </div>

                                            @if (apt.CanBeCompleted)
                                            {
                                                <button type="button" class="btn btn-sm btn-primary rounded-pill px-4 fw-semibold shadow-sm"
                                                        onclick="openCompleteModal(@apt.AppointmentId, '@apt.AppointmentCode', '@Html.Raw(HttpUtility.JavaScriptStringEncode(apt.ClientName))')">
                                                    <i class="bi bi-journal-check me-1"></i> Complete Session &amp; Add Notes
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-4"
                                                        onclick="openCompleteModal(@apt.AppointmentId, '@apt.AppointmentCode', '@Html.Raw(HttpUtility.JavaScriptStringEncode(apt.ClientName))')">
                                                    <i class="bi bi-journal-text me-1"></i> Session Notes
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-calendar2-x text-muted fs-1 mb-2"></i>
                            <h5 class="fw-bold text-dark">No Confirmed Upcoming Sessions</h5>
                            <p class="text-muted small mb-0">Confirmed client consultations will appear here.</p>
                        </div>
                    }
                </div>

                <!-- TAB 3: SESSION HISTORY & COMPLETED -->
                <div class="tab-pane fade" id="historyTab" role="tabpanel">
                    @if (Model.CompletedHistory != null && Model.CompletedHistory.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light small text-uppercase fw-bold text-muted">
                                    <tr>
                                        <th>Date &amp; Time</th>
                                        <th>Session Code</th>
                                        <th>Client</th>
                                        <th>Topic</th>
                                        <th>Status</th>
                                        <th>Recorded Coaching Notes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in Model.CompletedHistory)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-semibold text-dark">@c.AppointmentDate.ToString("MMM dd, yyyy")</div>
                                                <div class="x-small text-muted">@DateTime.Today.Add(c.StartTime).ToString("hh:mm tt") - @DateTime.Today.Add(c.EndTime).ToString("hh:mm tt")</div>
                                            </td>
                                            <td><span class="badge bg-light text-dark border">@c.AppointmentCode</span></td>
                                            <td><strong class="text-dark">@c.ClientName</strong></td>
                                            <td>@c.Title</td>
                                            <td>
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Completed</span>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(c.TrainerNotes))
                                                {
                                                    <span class="small text-dark">@c.TrainerNotes</span>
                                                }
                                                else
                                                {
                                                    <span class="x-small text-muted">No notes recorded</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-clock-history text-muted fs-1 mb-2"></i>
                            <h5 class="fw-bold text-dark">No Completed Consultations Yet</h5>
                            <p class="text-muted small mb-0">Completed sessions with coaching summaries will be archived here.</p>
                        </div>
                    }
                </div>

                <!-- TAB 4: MANAGE AVAILABILITY SLOTS -->
                <div class="tab-pane fade" id="slotsTab" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h6 class="fw-bold text-dark mb-0">Your Open Schedule Slots</h6>
                            <small class="text-muted">Clients can only request appointments during these posted open slots.</small>
                        </div>
                        <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold" data-bs-toggle="modal" data-bs-target="#addSlotModal">
                            <i class="bi bi-plus-lg me-1"></i> Add Availability
                        </button>
                    </div>

                    @if (Model.OpenAvailabilitySlots != null && Model.OpenAvailabilitySlots.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light small text-uppercase fw-bold text-muted">
                                    <tr>
                                        <th>Date</th>
                                        <th>Time Slot</th>
                                        <th>Booking Status</th>
                                        <th>Reserved By</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var slot in Model.OpenAvailabilitySlots)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-bold text-dark">@slot.AvailableDate.ToString("ddd, MMM dd, yyyy")</div>
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-primary border fw-bold px-2 py-1">
                                                    @DateTime.Today.Add(slot.StartTime).ToString("hh:mm tt") - @DateTime.Today.Add(slot.EndTime).ToString("hh:mm tt")
                                                </span>
                                            </td>
                                            <td>
                                                @if (slot.IsBooked)
                                                {
                                                    <span class="badge bg-warning-subtle text-dark border border-warning-subtle">
                                                        <i class="bi bi-lock-fill me-1"></i> Booked
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                        <i class="bi bi-check-circle-fill me-1"></i> Open for Booking
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                @if (slot.IsBooked && !string.IsNullOrEmpty(slot.BookedClientName))
                                                {
                                                    <span class="small fw-semibold text-dark">@slot.BookedClientName (@slot.BookedAppointmentCode)</span>
                                                }
                                                else
                                                {
                                                    <span class="x-small text-muted">--</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                @if (slot.CanDelete)
                                                {
                                                    using (Html.BeginForm("DeleteAvailability", "Appointments", new { area = "Trainer" }, FormMethod.Post, new { @class = "d-inline" }))
                                                    {
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@slot.AvailabilityId" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2 py-1" onclick="return confirm('Remove this availability slot?');" title="Delete slot">
                                                            <i class="bi bi-trash"></i> Remove
                                                        </button>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="x-small text-muted" title="Booked slots cannot be deleted directly">In Use</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-calendar-plus text-muted fs-1 mb-2"></i>
                            <h5 class="fw-bold text-dark">No Availability Slots Posted</h5>
                            <p class="text-muted small mb-3">Add open dates and times so your assigned clients can book sessions with you.</p>
                            <button type="button" class="btn btn-primary rounded-pill px-4 fw-semibold" data-bs-toggle="modal" data-bs-target="#addSlotModal">
                                <i class="bi bi-plus-circle me-1"></i> Add First Time Slot
                            </button>
                        </div>
                    }
                </div>

                <!-- TAB 5: RESCHEDULE REQUESTS (FR-C-45) -->
                <div class="tab-pane fade" id="rescheduleTab" role="tabpanel">
                    @if (Model.RescheduleRequests != null && Model.RescheduleRequests.Any())
                    {
                        <div class="row g-3">
                            @foreach (var req in Model.RescheduleRequests)
                            {
                                <div class="col-lg-6 col-12">
                                    <div class="card border rounded-4 p-3 shadow-none bg-info bg-opacity-10 border-info-subtle">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge bg-info text-dark fw-bold">@req.AppointmentCode</span>
                                                <span class="small fw-bold text-dark">@req.ClientName</span>
                                            </div>
                                            <span class="badge bg-white text-info border border-info-subtle">
                                                <i class="bi bi-clock-history me-1"></i>Requested @req.RequestedAt.ToString("MMM dd, hh:mm tt")
                                            </span>
                                        </div>

                                        <h5 class="fw-bold text-dark mb-2">@req.Title</h5>

                                        <!-- Comparison: Original Schedule vs Requested Schedule -->
                                        <div class="p-3 bg-white rounded-3 border mb-3">
                                            <div class="row g-2 align-items-center">
                                                <div class="col-sm-5 col-12">
                                                    <span class="x-small text-uppercase fw-bold text-muted d-block">Current Schedule</span>
                                                    <div class="small fw-bold text-secondary text-decoration-line-through">
                                                        <i class="bi bi-calendar-event me-1"></i>@req.OriginalDisplayDateTime
                                                    </div>
                                                </div>
                                                <div class="col-sm-2 col-12 text-center text-primary d-none d-sm-block">
                                                    <i class="bi bi-arrow-right-circle-fill fs-4"></i>
                                                </div>
                                                <div class="col-sm-5 col-12">
                                                    <span class="x-small text-uppercase fw-bold text-success d-block">Requested New Slot</span>
                                                    <div class="small fw-bold text-success">
                                                        <i class="bi bi-calendar-check-fill me-1"></i>@req.RequestedDisplayDateTime
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(req.Reason))
                                        {
                                            <div class="p-2 rounded-3 bg-white border small text-muted mb-3">
                                                <span class="fw-semibold text-dark">Client Reason:</span> @req.Reason
                                            </div>
                                        }

                                        <!-- Actions -->
                                        <div class="d-flex gap-2 justify-content-end pt-2 border-top">
                                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                                    onclick="openRejectRescheduleModal(@req.RescheduleRequestId, '@req.AppointmentCode', '@Html.Raw(HttpUtility.JavaScriptStringEncode(req.ClientName))', '@Html.Raw(HttpUtility.JavaScriptStringEncode(req.RequestedDisplayDateTime))')">
                                                <i class="bi bi-x-circle me-1"></i> Decline
                                            </button>
                                            <button type="button" class="btn btn-sm btn-success rounded-pill px-4 fw-semibold shadow-sm"
                                                    onclick="openApproveRescheduleModal(@req.RescheduleRequestId, '@req.AppointmentCode', '@Html.Raw(HttpUtility.JavaScriptStringEncode(req.ClientName))', '@Html.Raw(HttpUtility.JavaScriptStringEncode(req.RequestedDisplayDateTime))', '@Html.Raw(HttpUtility.JavaScriptStringEncode(req.MeetingLocation ?? ""))')">
                                                <i class="bi bi-check-circle-fill me-1"></i> Approve Reschedule
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-calendar2-check text-muted fs-1 mb-2"></i>
                            <h5 class="fw-bold text-dark">No Pending Rescheduling Requests</h5>
                            <p class="text-muted small mb-0">Clients' rescheduling requests for sessions will be listed here for your approval.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

