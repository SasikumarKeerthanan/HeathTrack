@model HealthTrack.Areas.Admin.ViewModels.AdminAppointmentIndexViewModel

@{
    ViewBag.Title = "Appointments Operational Monitoring";
}

<div class="container-fluid py-4 px-md-4">
    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-calendar2-range me-2" style="color: #00A3FF;"></i>Appointments Operational Monitoring
            </h2>
            <p class="text-muted small mb-0">
                System-wide oversight of all client-trainer consultation sessions, pending requests, and scheduled bookings.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Index", "Assignments", new { area = "Admin" })" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 shadow-sm px-3 py-2 fw-semibold" style="border-radius: 8px;">
                <i class="bi bi-person-check-fill"></i>
                <span>Client Assignments</span>
            </a>
            <a href="@Url.Action("Index", "Trainers", new { area = "Admin" })" class="btn btn-outline-primary d-inline-flex align-items-center gap-2 shadow-sm px-3 py-2 fw-semibold" style="border-radius: 8px;">
                <i class="bi bi-person-badge-fill"></i>
                <span>Trainers</span>
            </a>
        </div>
    </div>

    <!-- KPI Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="x-small text-uppercase fw-bold text-muted">Total Consultations</span>
                    <div class="rounded-3 p-2 d-flex align-items-center justify-content-center" style="background-color: rgba(0, 163, 255, 0.12); color: #0284c7;">
                        <i class="bi bi-calendar-event fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-dark mb-0">@Model.TotalCount</h3>
                <span class="x-small text-muted">All-time booking requests</span>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="x-small text-uppercase fw-bold text-muted">Pending Approval</span>
                    <div class="rounded-3 bg-warning bg-opacity-10 text-warning p-2">
                        <i class="bi bi-hourglass-split fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-warning mb-0">@Model.PendingCount</h3>
                <span class="x-small text-muted">Awaiting coach response</span>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="x-small text-uppercase fw-bold text-muted">Confirmed Active</span>
                    <div class="rounded-3 bg-success bg-opacity-10 text-success p-2">
                        <i class="bi bi-check-circle-fill fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-success mb-0">@Model.ApprovedCount</h3>
                <span class="x-small text-muted">Scheduled on calendar</span>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="x-small text-uppercase fw-bold text-muted">Completed Sessions</span>
                    <div class="rounded-3 bg-info bg-opacity-10 text-info p-2">
                        <i class="bi bi-journal-check fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-dark mb-0">@Model.CompletedCount</h3>
                <span class="x-small text-muted">Successfully attended</span>
            </div>
        </div>
    </div>

    <!-- Filters & Search Toolbar -->
    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
        <form method="get" action="@Url.Action("Index", "Appointments", new { area = "Admin" })" class="row g-2 align-items-center">
            <div class="col-md-7 d-flex flex-wrap gap-2">
                <a href="@Url.Action("Index", "Appointments", new { area = "Admin", status = "all", search = Model.SearchTerm })" 
                   class="btn btn-sm @(Model.ActiveStatusFilter == "all" ? "btn-primary fw-bold" : "btn-light border") rounded-pill px-3">
                    All (@Model.TotalCount)
                </a>
                <a href="@Url.Action("Index", "Appointments", new { area = "Admin", status = "pending", search = Model.SearchTerm })" 
                   class="btn btn-sm @(Model.ActiveStatusFilter == "pending" ? "btn-warning text-dark fw-bold" : "btn-light border") rounded-pill px-3">
                    Pending (@Model.PendingCount)
                </a>
                <a href="@Url.Action("Index", "Appointments", new { area = "Admin", status = "approved", search = Model.SearchTerm })" 
                   class="btn btn-sm @(Model.ActiveStatusFilter == "approved" ? "btn-success fw-bold" : "btn-light border") rounded-pill px-3">
                    Confirmed (@Model.ApprovedCount)
                </a>
                <a href="@Url.Action("Index", "Appointments", new { area = "Admin", status = "completed", search = Model.SearchTerm })" 
                   class="btn btn-sm @(Model.ActiveStatusFilter == "completed" ? "btn-info text-dark fw-bold" : "btn-light border") rounded-pill px-3">
                    Completed (@Model.CompletedCount)
                </a>
                <a href="@Url.Action("Index", "Appointments", new { area = "Admin", status = "cancelled", search = Model.SearchTerm })" 
                   class="btn btn-sm @(Model.ActiveStatusFilter == "cancelled" ? "btn-secondary text-white fw-bold" : "btn-light border") rounded-pill px-3">
                    Cancelled (@Model.CancelledCount)
                </a>
            </div>
            <div class="col-md-5">
                <div class="input-group">
                    <input type="hidden" name="status" value="@Model.ActiveStatusFilter" />
                    <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Search by code, client, coach, or topic..." />
                    <button class="btn btn-primary" type="submit" style="background: linear-gradient(135deg, #00A3FF 0%, #0284c7 100%); border: none;">
                        <i class="bi bi-search"></i> Search
                    </button>
                    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                    {
                        <a href="@Url.Action("Index", "Appointments", new { area = "Admin", status = Model.ActiveStatusFilter })" class="btn btn-outline-secondary" title="Clear Search">
                            <i class="bi bi-x"></i>
                        </a>
                    }
                </div>
            </div>
        </form>
    </div>

    <!-- Master Appointments Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
        <div class="card-header bg-white py-3 px-4 border-bottom">
            <h5 class="fw-bold mb-0 text-dark">System Appointments Directory</h5>
        </div>
        <div class="card-body p-0">
            @if (Model.Appointments != null && Model.Appointments.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-uppercase fw-bold text-muted">
                            <tr>
                                <th class="ps-4">Code</th>
                                <th>Date &amp; Time</th>
                                <th>Client</th>
                                <th>Assigned Trainer</th>
                                <th>Topic &amp; Location</th>
                                <th>Status</th>
                                <th class="pe-4">Session Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model.Appointments)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <span class="badge bg-light text-dark border fw-bold">@a.AppointmentCode</span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@a.AppointmentDate.ToString("ddd, MMM dd, yyyy")</div>
                                        <div class="x-small text-muted">@DateTime.Today.Add(a.StartTime).ToString("hh:mm tt") - @DateTime.Today.Add(a.EndTime).ToString("hh:mm tt")</div>
                                    </td>
                                    <td>
                                        <strong class="text-dark">@a.ClientName</strong>
                                        <div class="x-small text-muted">@a.ClientEmail</div>
                                    </td>
                                    <td>
                                        <span class="fw-semibold text-dark">@a.TrainerName</span>
                                        <div class="x-small text-muted">@a.TrainerSpecialization</div>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-dark">@a.Title</span>
                                        @if (!string.IsNullOrWhiteSpace(a.MeetingLocation))
                                        {
                                            <div class="x-small text-muted"><i class="bi bi-geo-alt text-danger me-1"></i>@a.MeetingLocation</div>
                                        }
                                    </td>
                                    <td>
                                        @if (a.Status == "Approved")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Confirmed</span>
                                        }
                                        else if (a.Status == "Pending")
                                        {
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">Pending</span>
                                        }
                                        else if (a.Status == "Completed")
                                        {
                                            <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">Completed</span>
                                        }
                                        else if (a.Status == "Cancelled")
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">Cancelled</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">@a.Status</span>
                                        }
                                    </td>
                                    <td class="pe-4">
                                        @if (!string.IsNullOrWhiteSpace(a.TrainerNotes))
                                        {
                                            <span class="small text-dark text-truncate d-inline-block" style="max-width: 250px;" title="@a.TrainerNotes">@a.TrainerNotes</span>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(a.CancellationReason))
                                        {
                                            <span class="small text-muted fst-italic">Reason: @a.CancellationReason</span>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(a.ClientNotes))
                                        {
                                            <span class="x-small text-muted text-truncate d-inline-block" style="max-width: 200px;" title="@a.ClientNotes">Goal: @a.ClientNotes</span>
                                        }
                                        else
                                        {
                                            <span class="x-small text-muted">--</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-calendar-x text-muted fs-1 mb-2"></i>
                    <h5 class="fw-bold text-dark">No Appointments Found</h5>
                    <p class="text-muted small mb-0">No appointment records match the selected status filter or search query.</p>
                </div>
            }
        </div>
    </div>
</div>
