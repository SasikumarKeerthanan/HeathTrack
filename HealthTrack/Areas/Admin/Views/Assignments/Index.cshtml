@model HealthTrack.Areas.Admin.ViewModels.ClientAssignmentIndexViewModel
@{
    ViewBag.Title = "Client-Trainer Assignment";
}

<div class="container-fluid py-4 px-md-4">

    <!-- ========================================================
         PAGE HEADER
         ======================================================== -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-person-check-fill me-2" style="color: #00A3FF;"></i>Client-Trainer Assignment
            </h2>
            <p class="text-muted small mb-0">
                Match clients with suitable fitness coaches based on goals, workout types, fitness levels, gender preferences, and capacity balancing.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Requests", "Assignments", new { area = "Admin" })" class="btn btn-outline-warning text-dark d-inline-flex align-items-center gap-2 px-3 py-2 fw-semibold shadow-sm" style="border-radius: 8px;">
                <i class="bi bi-arrow-repeat text-warning"></i>
                <span>Change Requests</span>
            </a>
            <a href="@Url.Action("Index", "Trainers", new { area = "Admin" })" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 px-3 py-2 fw-semibold" style="border-radius: 8px;">
                <i class="bi bi-people"></i>
                <span>View Trainers</span>
            </a>
        </div>
    </div>

    <!-- SUB-NAVIGATION TABS -->
    <ul class="nav nav-pills gap-2 mb-4">
        <li class="nav-item">
            <a class="nav-link active bg-dark text-white rounded-pill px-3 py-2 fw-semibold small" href="@Url.Action("Index", "Assignments", new { area = "Admin" })">
                <i class="bi bi-person-check-fill me-1"></i> Client Roster &amp; Recommendations
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link bg-light text-secondary rounded-pill px-3 py-2 fw-semibold small" href="@Url.Action("Requests", "Assignments", new { area = "Admin" })">
                <i class="bi bi-arrow-repeat me-1 text-warning"></i> Trainer Change Requests
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link bg-light text-secondary rounded-pill px-3 py-2 fw-semibold small" href="@Url.Action("History", "Assignments", new { area = "Admin" })">
                <i class="bi bi-clock-history me-1 text-info"></i> Assignment History
            </a>
        </li>
    </ul>

    <!-- ========================================================
         ALERTS & FEEDBACK
         ======================================================== -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm mb-4" role="alert" style="border-radius: 10px;">
            <i class="bi bi-check-circle-fill fs-5 text-success flex-shrink-0"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm mb-4" role="alert" style="border-radius: 10px;">
            <i class="bi bi-exclamation-triangle-fill fs-5 text-warning flex-shrink-0"></i>
            <div>@TempData["WarningMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm mb-4" role="alert" style="border-radius: 10px;">
            <i class="bi bi-info-circle-fill fs-5 text-info flex-shrink-0"></i>
            <div>@TempData["InfoMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm mb-4" role="alert" style="border-radius: 10px;">
            <i class="bi bi-shield-exclamation fs-5 text-danger flex-shrink-0"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- ========================================================
         METRIC SUMMARY COUNTERS
         ======================================================== -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Unassigned Clients</div>
                        <div class="fs-4 fw-bold text-warning mt-1">@Model.UnassignedClientsCount</div>
                    </div>
                    <div class="rounded-3 bg-warning bg-opacity-10 text-warning p-3">
                        <i class="bi bi-clock-history fs-4"></i>
                    </div>
                </div>
                <div class="small text-muted mt-2">Clients requiring a personal coach</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Assigned Clients</div>
                        <div class="fs-4 fw-bold text-success mt-1">@Model.AssignedClientsCount</div>
                    </div>
                    <div class="rounded-3 bg-success bg-opacity-10 text-success p-3">
                        <i class="bi bi-check2-circle fs-4"></i>
                    </div>
                </div>
                <div class="small text-muted mt-2">Active coaching relationships</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Total Clients</div>
                        <div class="fs-4 fw-bold text-dark mt-1">@Model.TotalClientsCount</div>
                    </div>
                    <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3">
                        <i class="bi bi-people fs-4"></i>
                    </div>
                </div>
                <div class="small text-muted mt-2">Registered member roster</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Active Coaches</div>
                        <div class="fs-4 fw-bold text-danger mt-1">@Model.TotalTrainersCount</div>
                    </div>
                    <div class="rounded-3 bg-danger bg-opacity-10 text-danger p-3">
                        <i class="bi bi-person-workspace fs-4"></i>
                    </div>
                </div>
                <div class="small text-muted mt-2">Available for client assignment</div>
            </div>
        </div>
    </div>

    <!-- ========================================================
         MAIN TWO-COLUMN WORKFLOW
         ======================================================== -->
    <div class="row g-4">

        <!-- ====================================================
             LEFT COLUMN: Client Roster & Selector
             ==================================================== -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <!-- Card Header with Filters -->
                <div class="card-header bg-white border-bottom p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h5 class="fw-bold text-dark mb-0 fs-6">
                            <i class="bi bi-person-lines-fill text-danger me-2"></i>Select Client
                        </h5>
                        <span class="badge bg-light text-dark border">@Model.Clients.Count Showing</span>
                    </div>

                    <!-- Filter Tabs: Unassigned / Assigned / All -->
                    <ul class="nav nav-pills nav-fill mb-2 small" style="background: #f8f9fa; padding: 4px; border-radius: 8px;">
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Assignments", new { area = "Admin", filter = "unassigned", search = Model.SearchTerm })" 
                               class="nav-link py-1 px-2 @(Model.Filter == "unassigned" ? "active bg-danger" : "text-dark")" style="border-radius: 6px;">
                                Unassigned (@Model.UnassignedClientsCount)
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Assignments", new { area = "Admin", filter = "assigned", search = Model.SearchTerm })" 
                               class="nav-link py-1 px-2 @(Model.Filter == "assigned" ? "active bg-danger" : "text-dark")" style="border-radius: 6px;">
                                Assigned (@Model.AssignedClientsCount)
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Assignments", new { area = "Admin", filter = "all", search = Model.SearchTerm })" 
                               class="nav-link py-1 px-2 @(Model.Filter == "all" ? "active bg-danger" : "text-dark")" style="border-radius: 6px;">
                                All (@Model.TotalClientsCount)
                            </a>
                        </li>
                    </ul>

                    <!-- Search Input -->
                    @using (Html.BeginForm("Index", "Assignments", new { area = "Admin" }, FormMethod.Get))
                    {
                        @Html.Hidden("filter", Model.Filter)
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text" name="search" value="@Model.SearchTerm" class="form-control border-start-0" placeholder="Search by client name..." />
                            @if (!string.IsNullOrEmpty(Model.SearchTerm))
                            {
                                <a href="@Url.Action("Index", "Assignments", new { area = "Admin", filter = Model.Filter })" class="btn btn-outline-secondary">
                                    <i class="bi bi-x"></i>
                                </a>
                            }
                            <button type="submit" class="btn btn-dark">Find</button>
                        </div>
                    }
                </div>

                <!-- Client List Body (Scrollable) -->
                <div class="card-body p-2" style="max-height: 640px; overflow-y: auto;">
                    @if (Model.Clients == null || !Model.Clients.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            <div class="fw-semibold">No clients found</div>
                            <div class="small">Try switching filter tabs or clearing search.</div>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush gap-2">
                            @foreach (var client in Model.Clients)
                            {
                                bool isSelected = Model.SelectedClient != null && Model.SelectedClient.ClientId == client.ClientId;
                                <a href="@Url.Action("Index", "Assignments", new { area = "Admin", clientId = client.ClientId, filter = Model.Filter, search = Model.SearchTerm })" 
                                   class="list-group-item list-group-item-action rounded-3 border p-3 @(isSelected ? "border-danger bg-danger bg-opacity-10 shadow-sm" : "")"
                                   style="transition: all 0.15s ease;">
                                    <div class="d-flex align-items-start justify-content-between gap-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold flex-shrink-0" 
                                                 style="width: 38px; height: 38px; background: @(isSelected ? "#dc3545" : "#4b5563"); font-size: 0.9rem;">
                                                @(string.IsNullOrEmpty(client.FullName) ? "C" : client.FullName.Substring(0, 1).ToUpper())
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark text-truncate" style="max-width: 170px;">
                                                    @client.FullName
                                                </div>
                                                <div class="text-muted small text-truncate" style="font-size: 0.75rem; max-width: 170px;">
                                                    @client.Email
                                                </div>
                                            </div>
                                        </div>

                                        @if (client.IsAssigned)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill" style="font-size: 0.68rem;">
                                                <i class="bi bi-check-circle-fill me-1"></i>Assigned
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill" style="font-size: 0.68rem;">
                                                <i class="bi bi-clock-fill me-1"></i>Needs Coach
                                            </span>
                                        }
                                    </div>

                                    <!-- Quick Preference Chips -->
                                    <div class="d-flex flex-wrap gap-1 mt-2 pt-2 border-top border-light">
                                        <span class="badge bg-light text-secondary border" style="font-size: 0.7rem;">
                                            <i class="bi bi-bullseye me-1"></i>@client.PrimaryGoal
                                        </span>
                                        <span class="badge bg-light text-secondary border" style="font-size: 0.7rem;">
                                            <i class="bi bi-lightning-charge me-1"></i>@client.PreferredWorkoutType
                                        </span>
                                        <span class="badge bg-light text-secondary border" style="font-size: 0.7rem;">
                                            <i class="bi bi-gender-ambiguous me-1"></i>@(client.PreferredTrainerGender ?? "Any Coach")
                                        </span>
                                    </div>

                                    @if (client.IsAssigned)
                                    {
                                        <div class="mt-2 text-success small" style="font-size: 0.75rem;">
                                            <i class="bi bi-person-badge me-1"></i>Coach: <strong>@client.AssignedTrainerName</strong>
                                        </div>
                                    }
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- ====================================================
             RIGHT COLUMN: Match Scoring & Recommendation Studio
             ==================================================== -->
        <div class="col-lg-8">
            @if (Model.SelectedClient == null)
            {
                <div class="card border-0 shadow-sm rounded-3 p-5 text-center text-muted">
                    <i class="bi bi-arrow-left-circle fs-1 text-secondary opacity-50 mb-3 d-block"></i>
                    <h5 class="fw-bold text-dark">No Client Selected</h5>
                    <p class="small mb-0">Select a client from the left roster to view profile matching recommendations and assign a personal trainer.</p>
                </div>
            }
            else
            {
                <!-- ================================================
                     1. Selected Client Preference Snapshot
                     ================================================ -->
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                    <div class="card-body p-4">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 pb-3 mb-3 border-bottom">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center fw-bold fs-4 flex-shrink-0" style="width: 52px; height: 52px;">
                                    @(Model.SelectedClient.FullName?.Substring(0, 1).ToUpper() ?? "C")
                                </div>
                                <div>
                                    <div class="d-flex align-items-center gap-2">
                                        <h4 class="fw-bold text-dark mb-0">@Model.SelectedClient.FullName</h4>
                                        <span class="badge bg-light text-dark border">@Model.SelectedClient.Gender</span>
                                    </div>
                                    <div class="text-muted small">@Model.SelectedClient.Email &bull; Member ID: @Model.SelectedClient.ClientId</div>
                                </div>
                            </div>

                            <div>
                                @if (Model.SelectedClient.IsAssigned)
                                {
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="text-end">
                                            <div class="small text-muted">Current Coach</div>
                                            <div class="fw-bold text-success">@Model.SelectedClient.AssignedTrainerName</div>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-danger shadow-sm d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#removeAssignmentModal" title="Remove Assignment While Preserving History">
                                            <i class="bi bi-person-x-fill"></i>
                                            <span>Remove Assignment</span>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2 fs-6">
                                        <i class="bi bi-clock-history me-1"></i>Needs Trainer Assignment
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Preference Matrix Cards -->
                        <div class="row g-2">
                            <div class="col-sm-6 col-md-3">
                                <div class="p-2 border rounded-3 bg-light bg-opacity-50">
                                    <div class="text-muted small" style="font-size: 0.72rem;">PRIMARY FITNESS GOAL</div>
                                    <div class="fw-bold text-dark text-truncate">
                                        <i class="bi bi-trophy text-danger me-1"></i>@Model.SelectedClient.PrimaryGoal
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-md-3">
                                <div class="p-2 border rounded-3 bg-light bg-opacity-50">
                                    <div class="text-muted small" style="font-size: 0.72rem;">PREFERRED WORKOUT</div>
                                    <div class="fw-bold text-dark text-truncate">
                                        <i class="bi bi-activity text-primary me-1"></i>@Model.SelectedClient.PreferredWorkoutType
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-md-3">
                                <div class="p-2 border rounded-3 bg-light bg-opacity-50">
                                    <div class="text-muted small" style="font-size: 0.72rem;">FITNESS EXPERIENCE</div>
                                    <div class="fw-bold text-dark text-truncate">
                                        <i class="bi bi-bar-chart-steps text-info me-1"></i>@Model.SelectedClient.FitnessLevel
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-md-3">
                                <div class="p-2 border rounded-3 bg-light bg-opacity-50">
                                    <div class="text-muted small" style="font-size: 0.72rem;">PREFERRED COACH GENDER</div>
                                    <div class="fw-bold text-dark text-truncate">
                                        <i class="bi bi-gender-ambiguous text-success me-1"></i>@(Model.SelectedClient.PreferredTrainerGender ?? "Any (No Preference)")
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ================================================
                     2. Ranked Coach Recommendations with Match Scores
                     ================================================ -->
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-white border-bottom p-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                        <div>
                            <h5 class="fw-bold text-dark mb-0 fs-6">
                                <i class="bi bi-stars text-warning me-2"></i>Coaches Ranked by Compatibility Score
                            </h5>
                            <div class="text-muted small" style="font-size: 0.75rem;">
                                Score weighted: Goal (30%), Workout (25%), Level (20%), Gender (15%), Capacity (10%).
                            </div>
                        </div>

                        <!-- Quick Auto-Assign Best Match Button -->
                        @if (Model.TrainerMatches.Any() && !Model.SelectedClient.IsAssigned)
                        {
                            var topMatch = Model.TrainerMatches.FirstOrDefault(t => !t.IsAtCapacity);
                            if (topMatch != null)
                            {
                                using (Html.BeginForm("Assign", "Assignments", new { area = "Admin" }, FormMethod.Post, new { @class = "m-0" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("clientId", Model.SelectedClient.ClientId)
                                    @Html.Hidden("trainerId", topMatch.TrainerId)
                                    @Html.Hidden("filter", Model.Filter)
                                    <button type="submit" class="btn btn-sm btn-success fw-semibold shadow-sm d-inline-flex align-items-center gap-1">
                                        <i class="bi bi-lightning-fill"></i>
                                        <span>Auto-Assign #1 Match (@topMatch.FullName - @topMatch.MatchPercentage%)</span>
                                    </button>
                                }
                            }
                        }
                    </div>

                    <div class="card-body p-3">
                        @if (!Model.TrainerMatches.Any())
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-person-x fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                <div class="fw-semibold">No active trainers available in the system.</div>
                                <div class="small mt-1">
                                    <a href="@Url.Action("Create", "Trainers", new { area = "Admin" })" class="text-danger fw-semibold">Click here to add your first trainer.</a>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-3">
                                @foreach (var trainer in Model.TrainerMatches)
                                {
                                    int matchScore = trainer.MatchPercentage;
                                    string badgeClass = trainer.MatchBadgeClass; // success, primary, warning, secondary

                                    <div class="card border rounded-3 p-3 @(trainer.IsCurrentlyAssigned ? "border-success bg-success bg-opacity-10" : "bg-white")" style="transition: transform 0.15s ease;">
                                        <div class="row align-items-center g-3">
                                            
                                            <!-- Trainer Identity & Specialization -->
                                            <div class="col-md-5">
                                                <div class="d-flex align-items-center gap-3">
                                                    <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold flex-shrink-0" 
                                                         style="width: 46px; height: 46px; background: @(trainer.IsCurrentlyAssigned ? "#198754" : "#1f2937");">
                                                        @(trainer.FullName?.Substring(0, 1).ToUpper() ?? "T")
                                                    </div>
                                                    <div>
                                                        <div class="d-flex align-items-center gap-2">
                                                            <h6 class="fw-bold text-dark mb-0">@trainer.FullName</h6>
                                                            <span class="badge bg-light text-secondary border" style="font-size: 0.68rem;">@trainer.Gender</span>
                                                        </div>
                                                        <div class="text-danger small fw-semibold">
                                                            <i class="bi bi-award me-1"></i>@trainer.PrimarySpecialization
                                                        </div>
                                                        <div class="text-muted small" style="font-size: 0.75rem;">
                                                            @trainer.Email &bull; @(trainer.ExperienceYears.HasValue ? $"{trainer.ExperienceYears} yrs exp" : "Certified Coach")
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Compatibility Match Score & Breakdown -->
                                            <div class="col-md-4">
                                                <div class="d-flex align-items-center gap-2 mb-1">
                                                    <!-- Percentage Progress Meter -->
                                                    <div class="progress flex-grow-1" style="height: 10px; border-radius: 6px; background-color: #e5e7eb;">
                                                        <div class="progress-bar bg-@badgeClass" 
                                                             role="progressbar" 
                                                             style="width: @matchScore%;" 
                                                             aria-valuenow="@matchScore" 
                                                             aria-valuemin="0" 
                                                             aria-valuemax="100"></div>
                                                    </div>
                                                    <span class="badge bg-@badgeClass text-white fw-bold px-2 py-1 fs-6" style="min-width: 58px;">
                                                        @matchScore%
                                                    </span>
                                                </div>
                                                <div class="small text-muted d-flex justify-content-between mb-2" style="font-size: 0.72rem;">
                                                    <span class="fw-semibold text-@badgeClass">@trainer.MatchTier</span>
                                                    <span>
                                                        Capacity: <strong>@trainer.ActiveClientsCount / @trainer.MaxClientCapacity</strong>
                                                        @(trainer.IsAtCapacity ? "(Full)" : $"({trainer.CapacityRemaining} free)")
                                                    </span>
                                                </div>

                                                <!-- Breakdown Checklist Tags -->
                                                <div class="d-flex flex-wrap gap-1" style="font-size: 0.7rem;">
                                                    <span class="badge @(trainer.GoalMatch ? "bg-success-subtle text-success border border-success-subtle" : "bg-light text-muted border")">
                                                        @(trainer.GoalMatch ? "✓" : "✗") Goal
                                                    </span>
                                                    <span class="badge @(trainer.WorkoutTypeMatch ? "bg-success-subtle text-success border border-success-subtle" : "bg-light text-muted border")">
                                                        @(trainer.WorkoutTypeMatch ? "✓" : "✗") Workout
                                                    </span>
                                                    <span class="badge @(trainer.FitnessLevelMatch ? "bg-success-subtle text-success border border-success-subtle" : "bg-light text-muted border")">
                                                        @(trainer.FitnessLevelMatch ? "✓" : "✗") Level
                                                    </span>
                                                    <span class="badge @(trainer.GenderMatch ? "bg-success-subtle text-success border border-success-subtle" : "bg-light text-muted border")">
                                                        @(trainer.GenderMatch ? "✓" : "✗") Gender
                                                    </span>
                                                </div>
                                            </div>

                                            <!-- Assignment Action Button -->
                                            <div class="col-md-3 text-md-end">
                                                @if (trainer.IsCurrentlyAssigned)
                                                {
                                                    <div class="d-flex flex-column gap-1">
                                                        <span class="btn btn-sm btn-success disabled w-100 py-1 fw-semibold" style="font-size: 0.8rem;">
                                                            <i class="bi bi-check2-circle me-1"></i>Current Coach
                                                        </span>
                                                        <button type="button" class="btn btn-sm btn-outline-danger w-100 py-1 fw-semibold" data-bs-toggle="modal" data-bs-target="#removeAssignmentModal" title="Remove Assignment While Preserving History">
                                                            <i class="bi bi-person-x-fill me-1"></i>Remove Assignment
                                                        </button>
                                                    </div>
                                                }
                                                else if (trainer.IsAtCapacity)
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-secondary disabled w-100 py-2" title="Trainer has reached maximum client capacity">
                                                        <i class="bi bi-slash-circle me-1"></i>At Capacity
                                                    </button>
                                                }
                                                else
                                                {
                                                    using (Html.BeginForm("Assign", "Assignments", new { area = "Admin" }, FormMethod.Post, new { @class = "m-0" }))
                                                    {
                                                        @Html.AntiForgeryToken()
                                                        @Html.Hidden("clientId", Model.SelectedClient.ClientId)
                                                        @Html.Hidden("trainerId", trainer.TrainerId)
                                                        @Html.Hidden("filter", Model.Filter)

                                                        string buttonText = Model.SelectedClient.IsAssigned ? "Reassign to Coach" : "Assign Coach";
                                                        string buttonClass = Model.SelectedClient.IsAssigned ? "btn-outline-primary" : "btn-primary";

                                                        <button type="submit" 
                                                                class="btn btn-sm @buttonClass w-100 py-2 fw-semibold shadow-sm d-flex align-items-center justify-content-center gap-1"
                                                                onclick="return confirm('Assign @trainer.FullName to @Model.SelectedClient.FullName?');">
                                                            <i class="bi bi-person-check-fill"></i>
                                                            <span>@buttonText</span>
                                                        </button>
                                                    }
                                                }
                                            </div>

                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

    </div>

</div>

@if (Model.SelectedClient != null && Model.SelectedClient.IsAssigned)
{
    <!-- FR-A-18: Remove Assignment Confirmation Modal -->
    <div class="modal fade" id="removeAssignmentModal" tabindex="-1" aria-labelledby="removeAssignmentModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold" id="removeAssignmentModalLabel">
                        <i class="bi bi-person-x-fill me-2"></i>Confirm Assignment Removal
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-warning border-warning d-flex align-items-start gap-2 mb-3">
                        <i class="bi bi-exclamation-triangle-fill fs-5 text-warning flex-shrink-0 mt-1"></i>
                        <div class="small">
                            <strong>Notice:</strong> Removing this assignment will end the active Trainer&ndash;Client relationship. 
                            <strong>All historical assignment records, workout logs, diet plans, completed appointments, and trainer feedback will remain safely preserved.</strong>
                        </div>
                    </div>

                    <h6 class="fw-bold text-dark mb-2">Assignment Relationship</h6>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <div class="p-3 border rounded-3 bg-light h-100">
                                <div class="text-muted small fw-semibold" style="font-size: 0.72rem;">CLIENT / MEMBER</div>
                                <div class="fw-bold text-dark text-truncate">@Model.SelectedClient.FullName</div>
                                <div class="text-muted small text-truncate">ID: @Model.SelectedClient.ClientId</div>
                                <div class="text-muted small text-truncate">@Model.SelectedClient.Email</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 border rounded-3 bg-light h-100">
                                <div class="text-muted small fw-semibold" style="font-size: 0.72rem;">CURRENT COACH</div>
                                <div class="fw-bold text-success text-truncate">@Model.SelectedClient.AssignedTrainerName</div>
                                <div class="text-muted small text-truncate">ID: @Model.SelectedClient.AssignedTrainerId</div>
                                <span class="badge bg-success-subtle text-success border border-success-subtle mt-1" style="font-size: 0.7rem;">Active Relationship</span>
                            </div>
                        </div>
                    </div>

                    <div class="bg-light p-3 rounded-3 border small text-secondary">
                        <div class="fw-semibold text-dark mb-1"><i class="bi bi-info-circle me-1 text-primary"></i>What happens after removal?</div>
                        <ul class="mb-0 ps-3">
                            <li>The coach's active capacity will be restored.</li>
                            <li>The client will be moved to the <strong>Unassigned</strong> roster for future reassignment.</li>
                            <li>No historical records, workout routines, diet plans, or user accounts will be deleted.</li>
                        </ul>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top-0 d-flex justify-content-between">
                    <!-- Action 1: Keep Assignment (Cancel without changing data) -->
                    <button type="button" class="btn btn-outline-secondary px-3" data-bs-dismiss="modal">
                        <i class="bi bi-arrow-left-circle me-1"></i>Keep Assignment
                    </button>
                    <!-- Action 2: Remove Assignment (Confirm removal via POST) -->
                    @using (Html.BeginForm("RemoveAssignment", "Assignments", new { area = "Admin" }, FormMethod.Post, new { @class = "m-0" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("clientId", Model.SelectedClient.ClientId)
                        @Html.Hidden("filter", Model.Filter)
                        <button type="submit" class="btn btn-danger px-4 fw-semibold shadow-sm">
                            <i class="bi bi-person-x-fill me-1"></i>Remove Assignment
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

