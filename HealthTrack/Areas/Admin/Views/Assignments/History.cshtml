@model HealthTrack.Areas.Admin.ViewModels.AssignmentHistoryIndexViewModel
@{
    ViewBag.Title = "Trainer-Client Assignment History";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4 px-md-4">

    <!-- PAGE HEADER -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a href="@Url.Action("Index", "Assignments", new { area = "Admin" })" class="btn btn-sm btn-outline-secondary py-1 px-2 rounded-2" title="Back to Assignments">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h2 class="h3 fw-bold text-dark mb-0">Trainer&ndash;Client Assignment History</h2>
                <span class="badge bg-secondary rounded-pill px-2 py-1 small">
                    FR-A-19
                </span>
            </div>
            <p class="text-muted small mb-0 ps-4 ms-2">
                Audit and monitor active and historical personal coach assignments, reassignments, and removals while preserving full historical records.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a href="@Url.Action("Index", "Assignments", new { area = "Admin" })" class="btn btn-outline-primary d-inline-flex align-items-center gap-2 shadow-sm px-3 py-2 fw-semibold" style="border-radius: 8px;">
                <i class="bi bi-person-check-fill"></i>
                <span>Assignment Studio</span>
            </a>
            <a href="@Url.Action("Requests", "Assignments", new { area = "Admin" })" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 shadow-sm px-3 py-2 fw-semibold" style="border-radius: 8px;">
                <i class="bi bi-arrow-repeat text-warning"></i>
                <span>Change Requests</span>
            </a>
        </div>
    </div>

    <!-- SUB-NAVIGATION TABS -->
    <ul class="nav nav-pills gap-2 mb-4">
        <li class="nav-item">
            <a class="nav-link bg-light text-secondary rounded-pill px-3 py-2 fw-semibold small" href="@Url.Action("Index", "Assignments", new { area = "Admin" })">
                <i class="bi bi-person-check-fill me-1"></i> Client Roster &amp; Recommendations
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link bg-light text-secondary rounded-pill px-3 py-2 fw-semibold small" href="@Url.Action("Requests", "Assignments", new { area = "Admin" })">
                <i class="bi bi-arrow-repeat me-1 text-warning"></i> Trainer Change Requests
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link active bg-dark text-white rounded-pill px-3 py-2 fw-semibold small" href="@Url.Action("History", "Assignments", new { area = "Admin" })">
                <i class="bi bi-clock-history me-1 text-info"></i> Assignment History
            </a>
        </li>
    </ul>

    <!-- SUMMARY METRICS -->
    <div class="row g-3 mb-4">
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">TOTAL ASSIGNMENTS LOGGED</div>
                        <div class="h3 fw-bold text-dark mb-0">@Model.TotalAssignmentsCount</div>
                        <div class="small text-muted mt-1">All historical &amp; active records</div>
                    </div>
                    <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3">
                        <i class="bi bi-journal-text fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">CURRENT ACTIVE RELATIONSHIPS</div>
                        <div class="h3 fw-bold text-success mb-0">@Model.ActiveAssignmentsCount</div>
                        <div class="small text-muted mt-1">Active coach &amp; client pairs</div>
                    </div>
                    <div class="rounded-3 bg-success bg-opacity-10 text-success p-3">
                        <i class="bi bi-person-check-fill fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">ENDED / REMOVED ASSIGNMENTS</div>
                        <div class="h3 fw-bold text-danger mb-0">@Model.EndedAssignmentsCount</div>
                        <div class="small text-muted mt-1">Preserved historical relationships</div>
                    </div>
                    <div class="rounded-3 bg-danger bg-opacity-10 text-danger p-3">
                        <i class="bi bi-clock-history fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- FILTER & SEARCH BAR -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <!-- Status Tabs: All / Active / Ended -->
                <ul class="nav nav-pills small" style="background: #f8f9fa; padding: 4px; border-radius: 8px;">
                    <li class="nav-item">
                        <a href="@Url.Action("History", "Assignments", new { area = "Admin", status = "all", search = Model.SearchTerm })" 
                           class="nav-link py-1 px-3 @(Model.StatusFilter == "all" ? "active bg-dark text-white" : "text-dark")" style="border-radius: 6px;">
                            All (@Model.TotalAssignmentsCount)
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("History", "Assignments", new { area = "Admin", status = "active", search = Model.SearchTerm })" 
                           class="nav-link py-1 px-3 @(Model.StatusFilter == "active" ? "active bg-success text-white" : "text-dark")" style="border-radius: 6px;">
                            Active (@Model.ActiveAssignmentsCount)
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("History", "Assignments", new { area = "Admin", status = "ended", search = Model.SearchTerm })" 
                           class="nav-link py-1 px-3 @(Model.StatusFilter == "ended" ? "active bg-danger text-white" : "text-dark")" style="border-radius: 6px;">
                            Ended (@Model.EndedAssignmentsCount)
                        </a>
                    </li>
                </ul>

                <!-- Search Input Form -->
                @using (Html.BeginForm("History", "Assignments", new { area = "Admin" }, FormMethod.Get, new { @class = "d-flex gap-2" }))
                {
                    @Html.Hidden("status", Model.StatusFilter)
                    <div class="input-group input-group-sm" style="max-width: 320px;">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" name="search" value="@Model.SearchTerm" class="form-control border-start-0" placeholder="Search client or trainer..." />
                        @if (!string.IsNullOrEmpty(Model.SearchTerm))
                        {
                            <a href="@Url.Action("History", "Assignments", new { area = "Admin", status = Model.StatusFilter })" class="btn btn-outline-secondary">
                                <i class="bi bi-x"></i>
                            </a>
                        }
                        <button type="submit" class="btn btn-dark">Search</button>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ASSIGNMENT HISTORY TABLE -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
            <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-clock-history text-primary"></i>Historical &amp; Active Assignment Records
            </h5>
            <span class="badge bg-light text-dark border">@Model.HistoryRecords.Count Records Showing</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-4">Member / Client</th>
                        <th>Assigned Coach / Trainer</th>
                        <th>Assignment Date</th>
                        <th>End Date</th>
                        <th>Relationship Status</th>
                        <th>Audit &amp; Action Notes</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.HistoryRecords == null || !Model.HistoryRecords.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                <span class="fw-semibold">No assignment history records match your criteria.</span>
                                <div class="small">Try switching filter tabs or clearing the search box.</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.HistoryRecords)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-danger bg-opacity-10 text-danger d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px; font-size: 0.85rem;">
                                            @(string.IsNullOrWhiteSpace(item.ClientName) ? "C" : item.ClientName.Substring(0, 1).ToUpper())
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@item.ClientName</div>
                                            <div class="text-muted small" style="font-size: 0.75rem;">
                                                <span class="font-monospace text-secondary">@item.ClientId</span> &bull; @item.ClientEmail
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px; font-size: 0.85rem;">
                                            @(string.IsNullOrWhiteSpace(item.TrainerName) ? "T" : item.TrainerName.Substring(0, 1).ToUpper())
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@item.TrainerName</div>
                                            <div class="text-muted small" style="font-size: 0.75rem;">
                                                <span class="font-monospace text-secondary">@item.TrainerId</span> &bull; @item.TrainerSpecialization
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark small">
                                        @item.AssignmentDate.ToString("MMM dd, yyyy")
                                    </span>
                                </td>
                                <td>
                                    @if (item.EndDate.HasValue)
                                    {
                                        <span class="text-dark small">
                                            @item.EndDate.Value.ToString("MMM dd, yyyy")
                                        </span>
                                        <div class="text-muted" style="font-size: 0.72rem;">@item.EndDate.Value.ToString("hh:mm tt UTC")</div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">
                                            <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>Present (Active)
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i>Active Relationship
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-1">
                                            <i class="bi bi-clock-history me-1"></i>Ended / Preserved
                                        </span>
                                    }
                                </td>
                                <td style="max-width: 280px;">
                                    <div class="small text-truncate" title="@item.Details">
                                        @item.Details
                                    </div>
                                    <div class="text-muted" style="font-size: 0.72rem;">
                                        By: <strong>@item.AdminActionBy</strong>
                                    </div>
                                </td>
                                <td class="text-end pe-4">
                                    <a href="@Url.Action("Index", "Assignments", new { area = "Admin", clientId = item.ClientId })" class="btn btn-sm btn-outline-primary" title="Open Assignment Studio">
                                        <i class="bi bi-arrow-right-circle"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
