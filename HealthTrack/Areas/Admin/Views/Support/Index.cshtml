@model HealthTrack.Areas.Admin.ViewModels.AdminSupportIndexViewModel
@{
    ViewBag.Title = "Support Helpdesk Management";
}

<div class="container-fluid py-4 px-md-4">

    <!-- Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5 me-2"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Page Header (Clean, Standard without background) -->
    <div class="mb-4">
        <h2 class="h3 fw-bold text-dark mb-1">
            <i class="bi bi-headset me-2" style="color: #00A3FF;"></i>Support Helpdesk Management
        </h2>
        <p class="text-muted small mb-0">
            Centralized helpdesk for managing client inquiries, reviewing technical issues, and providing fast resolution.
        </p>
    </div>

    <!-- KPI Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.72rem;">Total Tickets</div>
                        <div class="h3 fw-bold mb-0 text-dark">@Model.TotalTicketsCount</div>
                    </div>
                    <div class="rounded-3 p-3 fs-3 d-flex align-items-center justify-content-center" style="background-color: rgba(0, 163, 255, 0.12); color: #0284c7;">
                        <i class="bi bi-ticket-detailed-fill"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.72rem;">Open &amp; Pending</div>
                        <div class="h3 fw-bold mb-0 text-primary">@Model.OpenTicketsCount</div>
                    </div>
                    <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3 fs-3">
                        <i class="bi bi-envelope-open-fill"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.72rem;">In Progress</div>
                        <div class="h3 fw-bold mb-0 text-warning">@Model.InProgressTicketsCount</div>
                    </div>
                    <div class="rounded-3 bg-warning bg-opacity-10 text-warning p-3 fs-3">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.72rem;">Resolved</div>
                        <div class="h3 fw-bold mb-0 text-success">@Model.ResolvedTicketsCount</div>
                    </div>
                    <div class="rounded-3 bg-success bg-opacity-10 text-success p-3 fs-3">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter & Search Toolbar -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-body p-3 p-md-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <!-- Status Filter Pills -->
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="text-muted small fw-bold text-uppercase me-2" style="font-size: 0.72rem;">
                        <i class="bi bi-funnel-fill text-primary me-1"></i>Status Filter:
                    </span>
                    <a href="@Url.Action("Index", "Support", new { area = "Admin", status = "All", search = Model.SearchQuery })" 
                       class="btn btn-sm rounded-pill px-3 @(Model.SelectedStatus == "All" ? "btn-primary shadow-sm" : "btn-light text-secondary border")">
                        All (@Model.TotalTicketsCount)
                    </a>
                    <a href="@Url.Action("Index", "Support", new { area = "Admin", status = "Open", search = Model.SearchQuery })" 
                       class="btn btn-sm rounded-pill px-3 @(Model.SelectedStatus == "Open" ? "btn-primary shadow-sm" : "btn-light text-secondary border")">
                        Open (@Model.OpenTicketsCount)
                    </a>
                    <a href="@Url.Action("Index", "Support", new { area = "Admin", status = "In Progress", search = Model.SearchQuery })" 
                       class="btn btn-sm rounded-pill px-3 @(Model.SelectedStatus == "In Progress" ? "btn-warning text-dark shadow-sm" : "btn-light text-secondary border")">
                        In Progress (@Model.InProgressTicketsCount)
                    </a>
                    <a href="@Url.Action("Index", "Support", new { area = "Admin", status = "Resolved", search = Model.SearchQuery })" 
                       class="btn btn-sm rounded-pill px-3 @(Model.SelectedStatus == "Resolved" ? "btn-success shadow-sm" : "btn-light text-secondary border")">
                        Resolved (@Model.ResolvedTicketsCount)
                    </a>
                </div>

                <!-- Search Input -->
                <form method="get" action="@Url.Action("Index", "Support", new { area = "Admin" })" class="d-flex gap-2">
                    <input type="hidden" name="status" value="@Model.SelectedStatus" />
                    <div class="input-group input-group-sm" style="min-width: 280px;">
                        <input type="text" name="search" class="form-control" placeholder="Search ticket #, client, subject..." value="@Model.SearchQuery" />
                        <button class="btn btn-outline-secondary" type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                    {
                        <a href="@Url.Action("Index", "Support", new { area = "Admin", status = Model.SelectedStatus })" class="btn btn-sm btn-outline-danger" title="Clear Filter">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                </form>
            </div>
        </div>
    </div>

    <!-- Tickets Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="card-header bg-white py-3 px-4 border-bottom d-flex align-items-center justify-content-between">
            <h5 class="fw-bold mb-0 text-dark">Client Support Queue</h5>
            <span class="badge bg-light text-secondary border">@Model.Tickets.Count Ticket@(Model.Tickets.Count == 1 ? "" : "s") Listed</span>
        </div>

        @if (!Model.Tickets.Any())
        {
            <div class="p-5 text-center">
                <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                    <i class="bi bi-inbox text-muted fs-2"></i>
                </div>
                <h6 class="fw-bold text-dark">No Support Tickets Found</h6>
                <p class="text-muted small mb-0">There are currently no tickets matching the selected filters.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="text-secondary small">
                            <th scope="col" style="width: 80px;" class="ps-4">ID</th>
                            <th scope="col" style="width: 200px;">Client</th>
                            <th scope="col">Subject &amp; Category</th>
                            <th scope="col" style="width: 100px;">Priority</th>
                            <th scope="col" style="width: 130px;">Status</th>
                            <th scope="col" style="width: 170px;">Submitted</th>
                            <th scope="col" class="text-end pe-4" style="width: 150px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in Model.Tickets)
                        {
                            var priorityClass = "bg-secondary";
                            if (ticket.Priority == "Urgent") { priorityClass = "bg-danger"; }
                            else if (ticket.Priority == "High") { priorityClass = "bg-warning text-dark"; }
                            else if (ticket.Priority == "Medium") { priorityClass = "bg-info text-dark"; }

                            var statusClass = "bg-primary";
                            if (ticket.Status == "In Progress") { statusClass = "bg-warning text-dark"; }
                            else if (ticket.Status == "Resolved" || ticket.Status == "Closed") { statusClass = "bg-success"; }

                            <tr>
                                <td class="ps-4">
                                    <span class="fw-bold text-primary">#@ticket.TicketId</span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@ticket.ClientName</div>
                                    <div class="text-muted small">
                                        <span class="badge bg-light text-secondary border">@ticket.ClientId</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@ticket.Subject</div>
                                    <div class="text-muted small">
                                        <i class="bi bi-tag me-1"></i>@ticket.Category
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @priorityClass rounded-pill px-2 py-1">@ticket.Priority</span>
                                </td>
                                <td>
                                    <span class="badge @statusClass rounded-pill px-2 py-1">@ticket.Status</span>
                                </td>
                                <td>
                                    <div class="small text-dark">@ticket.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</div>
                                    <div class="text-muted" style="font-size: 0.78rem;">@ticket.CreatedAt.ToLocalTime().ToString("hh:mm tt")</div>
                                </td>
                                <td class="text-end pe-4">
                                    <button type="button" 
                                            class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1 shadow-sm"
                                            data-bs-toggle="modal" 
                                            data-bs-target="#respondModal-@ticket.TicketId">
                                        <i class="bi bi-reply-fill"></i>
                                        <span>Respond</span>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- ========================================================
     MODALS: RESPOND & RESOLVE (For Each Ticket)
     ======================================================== -->
@foreach (var ticket in Model.Tickets)
{
    var priorityClass = "bg-secondary";
    if (ticket.Priority == "Urgent") { priorityClass = "bg-danger"; }
    else if (ticket.Priority == "High") { priorityClass = "bg-warning text-dark"; }
    else if (ticket.Priority == "Medium") { priorityClass = "bg-info text-dark"; }

    var statusClass = "bg-primary";
    if (ticket.Status == "In Progress") { statusClass = "bg-warning text-dark"; }
    else if (ticket.Status == "Resolved" || ticket.Status == "Closed") { statusClass = "bg-success"; }

    <div class="modal fade" id="respondModal-@ticket.TicketId" tabindex="-1" aria-labelledby="respondModalLabel-@ticket.TicketId" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow">
                <form method="post" action="@Url.Action("Respond", "Support", new { area = "Admin" })">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="TicketId" value="@ticket.TicketId" />

                    <div class="modal-header bg-dark text-white">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-danger rounded-pill">Ticket #@ticket.TicketId</span>
                            <span class="badge @priorityClass rounded-pill">@ticket.Priority Priority</span>
                            <span class="badge @statusClass rounded-pill">@ticket.Status</span>
                        </div>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body p-4">
                        <!-- Client Header Info -->
                        <div class="d-flex align-items-center justify-content-between p-3 bg-light rounded-3 mb-3 border">
                            <div>
                                <div class="fw-bold text-dark">@ticket.ClientName (@ticket.ClientId)</div>
                                <div class="text-muted small"><i class="bi bi-envelope me-1"></i>@ticket.ClientEmail</div>
                            </div>
                            <div class="text-end text-muted small">
                                <div>Submitted on</div>
                                <div class="fw-semibold text-dark">@ticket.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy, hh:mm tt")</div>
                            </div>
                        </div>

                        <!-- Ticket Subject & Inquiry -->
                        <div class="mb-3">
                            <h5 class="fw-bold text-dark mb-1">@ticket.Subject</h5>
                            <span class="badge bg-light text-secondary border"><i class="bi bi-tag me-1"></i>@ticket.Category</span>
                        </div>

                        <!-- Member Description -->
                        <div class="card border rounded-3 bg-light bg-opacity-50 mb-4">
                            <div class="card-body">
                                <h6 class="text-secondary small fw-bold text-uppercase mb-2">Member Request Description</h6>
                                <p class="mb-0 text-dark" style="white-space: pre-wrap;">@ticket.Description</p>
                            </div>
                        </div>

                        <!-- Admin Response Input -->
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">
                                <i class="bi bi-chat-left-text-fill text-primary me-1"></i>Administrator Response / Resolution Notes <span class="text-danger">*</span>
                            </label>
                            <textarea name="AdminResponse" class="form-control" rows="5" placeholder="Write your response, guidance, or resolution details here..." required>@ticket.AdminResponse</textarea>
                            <div class="form-text text-muted">This response will be visible to the client in their Support portal.</div>
                        </div>

                        <!-- Status Selection -->
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark">Update Ticket Status <span class="text-danger">*</span></label>
                                <select name="Status" class="form-select" required>
                                    <option value="In Progress" @(ticket.Status == "In Progress" ? "selected" : "")>In Progress (Staff Reviewing)</option>
                                    <option value="Resolved" @(ticket.Status == "Resolved" || ticket.Status == "Open" ? "selected" : "")>Resolved (Issue Resolved)</option>
                                    <option value="Closed" @(ticket.Status == "Closed" ? "selected" : "")>Closed (Completed / Inactive)</option>
                                </select>
                            </div>
                            <div class="col-md-6 d-flex align-items-end">
                                @if (ticket.ResolvedAt.HasValue)
                                {
                                    <div class="text-success small pb-2">
                                        <i class="bi bi-check-circle-fill me-1"></i>Previously resolved on @ticket.ResolvedAt.Value.ToLocalTime().ToString("MMM dd, yyyy, hh:mm tt")
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary px-4 shadow-sm" style="background: linear-gradient(135deg, #00A3FF 0%, #0284c7 100%); border: none;">
                            <i class="bi bi-check2-circle me-1"></i> Save &amp; Update Ticket
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
