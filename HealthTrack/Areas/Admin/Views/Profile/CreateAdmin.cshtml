@model HealthTrack.Areas.Admin.ViewModels.CreateAdminViewModel
@{
    ViewBag.Title = "Add Administrator Account";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4 px-md-4">

    <!-- Page Header & Back Button -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a href="@Url.Action("Index", "Profile", new { area = "Admin" })" class="btn btn-sm btn-outline-secondary py-1 px-2 rounded-2" title="Back to Admin Profile">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h2 class="h3 fw-bold text-dark mb-0">Create Administrator Account</h2>
            </div>
            <p class="text-muted small mb-0 ps-4 ms-2">
                Provision a new administrator account with administrative access to HealthTrack.
            </p>
        </div>
        <div>
            <a href="@Url.Action("Index", "Profile", new { area = "Admin" })" class="btn btn-outline-secondary rounded-pill px-3 btn-sm">
                <i class="bi bi-person-lines-fill me-1"></i> View Administrators
            </a>
        </div>
    </div>

    <!-- Validation Summary Alert -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger shadow-sm mb-4" role="alert" style="border-radius: 10px;">
            <div class="d-flex align-items-center gap-2 fw-semibold mb-1">
                <i class="bi bi-shield-exclamation text-danger fs-5"></i>
                <span>Please correct the errors below:</span>
            </div>
            @Html.ValidationSummary(false, "", new { @class = "mb-0 ps-3" })
        </div>
    }

    @using (Html.BeginForm("CreateAdmin", "Profile", new { area = "Admin" }, FormMethod.Post, new { id = "createAdminForm", autocomplete = "off" }))
    {
        @Html.AntiForgeryToken()

        <div class="row g-4">
            
            <!-- LEFT COLUMN: Profile & Contact Details -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                    <div class="card-header bg-white py-3 px-4 border-bottom">
                        <h5 class="card-title mb-0 fw-bold fs-6 text-dark d-flex align-items-center gap-2">
                            <i class="bi bi-person-circle" style="color: #00A3FF;"></i>
                            <span>1. Administrator Information</span>
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        
                        <!-- Full Name -->
                        <div class="mb-3">
                            @Html.LabelFor(m => m.FullName, new { @class = "form-label fw-semibold text-dark small" }) <span class="text-danger">*</span>
                            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", placeholder = "e.g. Eleanor Vance", autofocus = "autofocus", maxlength = "100" })
                            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                            <div class="form-text text-muted">Legal full name of the administrator.</div>
                        </div>

                        <!-- Email Address -->
                        <div class="mb-3">
                            @Html.LabelFor(m => m.Email, new { @class = "form-label fw-semibold text-dark small" }) <span class="text-danger">*</span>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope"></i></span>
                                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "admin.user@healthtrack.com", type = "email", maxlength = "150" })
                            </div>
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                            <div class="form-text text-muted">Must be a unique email address used for administrator sign-in.</div>
                        </div>

                        <!-- Phone Number -->
                        <div class="mb-3">
                            @Html.LabelFor(m => m.PhoneNumber, new { @class = "form-label fw-semibold text-dark small" })
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-telephone"></i></span>
                                @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "+1 (555) 000-0000", type = "tel", maxlength = "20" })
                            </div>
                            @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger small" })
                            <div class="form-text text-muted">Optional contact telephone or mobile number.</div>
                        </div>

                        <!-- Administrator Role -->
                        <div class="mb-0">
                            @Html.LabelFor(m => m.Role, new { @class = "form-label fw-semibold text-dark small" }) <span class="text-danger">*</span>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-shield-check"></i></span>
                                <input type="text" class="form-control bg-light" value="Admin" readonly />
                                @Html.HiddenFor(m => m.Role)
                            </div>
                            @Html.ValidationMessageFor(m => m.Role, "", new { @class = "text-danger small" })
                            <div class="form-text text-muted">Standard Administrator role with management portal privileges.</div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN: Initial Security & Credentials -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                    <div class="card-header bg-white py-3 px-4 border-bottom">
                        <h5 class="card-title mb-0 fw-bold fs-6 text-dark d-flex align-items-center gap-2">
                            <i class="bi bi-shield-lock-fill" style="color: #22C55E;"></i>
                            <span>2. Initial Login Credentials</span>
                        </h5>
                    </div>
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        
                        <div>
                            <!-- Initial Password -->
                            <div class="mb-3">
                                @Html.LabelFor(m => m.Password, new { @class = "form-label fw-semibold text-dark small" }) <span class="text-danger">*</span>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-key"></i></span>
                                    @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Minimum 6 characters", maxlength = "100" })
                                </div>
                                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                                <div class="form-text text-muted">Initial password required for the new administrator's sign-in.</div>
                            </div>

                            <!-- Confirm Password -->
                            <div class="mb-4">
                                @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label fw-semibold text-dark small" }) <span class="text-danger">*</span>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-key-fill"></i></span>
                                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Re-enter initial password", maxlength = "100" })
                                </div>
                                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                                <div class="form-text text-muted">Must exactly match the initial password above.</div>
                            </div>
                        </div>

                        <!-- Security Policy Callout -->
                        <div class="p-3 bg-light rounded-3 border">
                            <div class="fw-semibold text-dark small mb-1">
                                <i class="bi bi-info-circle-fill text-primary me-1"></i>Security Standards
                            </div>
                            <ul class="text-muted small ps-3 mb-0" style="line-height: 1.5;">
                                <li>Password is immediately hashed with PBKDF2 (10,000 iterations &amp; cryptographic salt).</li>
                                <li>Plaintext passwords are never saved, logged, or emailed.</li>
                                <li>Account is immediately active upon creation and ready for administrator sign-in.</li>
                            </ul>
                        </div>

                    </div>
                </div>
            </div>

        </div>

        <!-- Sticky Submit Footer Bar -->
        <div class="card border-0 shadow-sm rounded-4 mt-4 p-3 bg-white">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div class="text-muted small">
                    <i class="bi bi-shield-lock text-success me-1"></i>
                    Authorized Administrator action. A secure audit log entry will be created.
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a href="@Url.Action("Index", "Profile", new { area = "Admin" })" class="btn btn-outline-secondary px-4 fw-semibold rounded-pill">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm rounded-pill" style="background: linear-gradient(135deg, #00A3FF 0%, #0284c7 100%); border: none;">
                        <i class="bi bi-shield-plus"></i>
                        <span>Create Administrator</span>
                    </button>
                </div>
            </div>
        </div>
    }

</div>
