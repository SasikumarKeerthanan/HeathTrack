@model HealthTrack.Areas.Admin.ViewModels.AdminResetPasswordViewModel
@{
    ViewBag.Title = "Reset Administrator Password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<link rel="stylesheet" href="@Url.Content("~/Content/trainer-auth.css")" />

<div class="trainer-auth-wrapper">
    <div class="trainer-auth-card">

        <!-- ========================================================
             LEFT COLUMN: Form Panel (Inputs & Credentials)
             ======================================================== -->
        <div class="trainer-form-side">
            <div>
                <!-- Brand Header (HealthTrack Logo + Name + Admin Badge) -->
                <a href="@Url.Action("Login", "Account", new { area = "Admin" })" class="trainer-brand-header text-decoration-none d-flex align-items-center mb-4">
                    <img src="@Url.Content("~/Content/images/logo.png")" alt="HealthTrack Logo" class="trainer-brand-icon flex-shrink-0" style="width: 46px; height: 46px;" />
                    <div class="d-flex flex-column justify-content-center ms-2" style="line-height: 1.1;">
                        <span class="fw-bold tracking-tight" style="font-size: 1.45rem; color: #00A3FF; font-weight: 800; letter-spacing: -0.3px;">HealthTrack</span>
                        <span class="text-uppercase fw-bold" style="font-size: 0.66rem; letter-spacing: 0.8px; color: #22C55E; margin-top: 2px;">WORKOUT &amp; NUTRITION</span>
                    </div>
                    <span class="badge rounded-pill px-2 py-1 ms-3" style="background-color: rgba(0, 163, 255, 0.18); color: #38bdf8; border: 1px solid rgba(0, 163, 255, 0.35); font-size: 0.65rem; letter-spacing: 0.6px;">ADMIN</span>
                </a>

                <!-- Headline & Subtext -->
                <h1 class="trainer-headline">Create New Password</h1>
                <p class="trainer-subtext">Administrator Portal. Set a secure new password for <strong>@Model.Email</strong>.</p>

                <!-- Feedback / Error Alerts -->
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="dark-alert-error mb-4">
                        <div class="dark-alert-content">
                            <i class="bi bi-shield-exclamation fs-5 flex-shrink-0 text-danger"></i>
                            <div>@TempData["ErrorMessage"]</div>
                        </div>
                    </div>
                }

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Count > 0)
                {
                    <div class="dark-alert-error mb-4">
                        <div class="dark-alert-content">
                            <i class="bi bi-shield-exclamation fs-5 flex-shrink-0 text-danger"></i>
                            <div>
                                @Html.ValidationSummary(true, "", new { @class = "mb-0 ps-0 list-unstyled" })
                            </div>
                        </div>
                    </div>
                }

                <!-- Reset Password Form -->
                @using (Html.BeginForm("ResetPassword", "Account", new { area = "Admin" }, FormMethod.Post, new { id = "adminResetPasswordForm" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.Email)
                    @Html.HiddenFor(m => m.Token)

                    <!-- New Password Field with Embedded Eye Toggle -->
                    <div class="mb-3">
                        <label class="trainer-input-label" for="newPasswordInput">New Password</label>
                        <div class="password-input-wrapper">
                            @Html.PasswordFor(m => m.Password, new { 
                                @class = "trainer-input", 
                                id = "newPasswordInput",
                                placeholder = "At least 6 characters",
                                autocomplete = "new-password",
                                autofocus = "autofocus"
                            })
                            <button type="button" class="password-toggle-btn" id="toggleNewPassBtn" aria-label="Toggle password visibility">
                                <i class="bi bi-eye" id="toggleNewPassIcon"></i>
                            </button>
                        </div>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small mt-1 d-block" })
                    </div>

                    <!-- Confirm Password Field with Embedded Eye Toggle -->
                    <div class="mb-4">
                        <label class="trainer-input-label" for="confirmPasswordInput">Confirm New Password</label>
                        <div class="password-input-wrapper">
                            @Html.PasswordFor(m => m.ConfirmPassword, new { 
                                @class = "trainer-input", 
                                id = "confirmPasswordInput",
                                placeholder = "Re-enter new password",
                                autocomplete = "new-password"
                            })
                            <button type="button" class="password-toggle-btn" id="toggleConfirmPassBtn" aria-label="Toggle confirm password visibility">
                                <i class="bi bi-eye" id="toggleConfirmPassIcon"></i>
                            </button>
                        </div>
                        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small mt-1 d-block" })
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn-trainer-signin mb-3" id="adminResetSubmitBtn" style="background: linear-gradient(135deg, #00A3FF 0%, #0284c7 100%) !important; color: #ffffff !important; box-shadow: 0 4px 18px rgba(0, 163, 255, 0.35) !important;">
                        Update Password &amp; Sign In
                    </button>

                    <!-- Back to Login Link -->
                    <div class="text-center mt-3">
                        <a href="@Url.Action("Login", "Account", new { area = "Admin" })" class="text-decoration-none small" style="color: #94a3b8; transition: color 0.2s ease;">
                            <i class="bi bi-arrow-left me-1"></i> Back to Administrator Sign In
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- ========================================================
             RIGHT COLUMN: Visual Panel (Matching Admin Design)
             ======================================================== -->
        <div class="trainer-visual-side">
            <div class="trainer-visual-container">
                <img src="@Url.Content("~/Content/images/trainer-login-hero.jpg")" 
                     alt="HealthTrack System Management" 
                     class="trainer-visual-img" />
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function setupToggle(btnId, inputId, iconId) {
            var btn = document.getElementById(btnId);
            var input = document.getElementById(inputId);
            var icon = document.getElementById(iconId);
            if (btn && input && icon) {
                btn.addEventListener('click', function () {
                    if (input.type === 'password') {
                        input.type = 'text';
                        icon.classList.remove('bi-eye');
                        icon.classList.add('bi-eye-slash');
                    } else {
                        input.type = 'password';
                        icon.classList.remove('bi-eye-slash');
                        icon.classList.add('bi-eye');
                    }
                });
            }
        }
        setupToggle('toggleNewPassBtn', 'newPasswordInput', 'toggleNewPassIcon');
        setupToggle('toggleConfirmPassBtn', 'confirmPasswordInput', 'toggleConfirmPassIcon');
    </script>
}
