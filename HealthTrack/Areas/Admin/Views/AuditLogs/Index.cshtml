@model HealthTrack.Areas.Admin.ViewModels.AdminAuditLogsIndexViewModel
@{
    ViewBag.Title = Model.LogType == "health" ? "Health Record Audit Logs" : "Security & Authentication Audit Logs";
}

<style>
    /* Security & Health Audit Center Custom Styles */
    .audit-table th {
        font-size: 0.72rem;
        letter-spacing: 0.6px;
        text-transform: uppercase;
        font-weight: 700;
        color: #64748b;
        background-color: #f8fafc;
        border-top: none;
        padding-top: 14px;
        padding-bottom: 14px;
    }
    .audit-table td {
        padding-top: 14px;
        padding-bottom: 14px;
        vertical-align: middle;
        font-size: 0.85rem;
    }
    .audit-table tbody tr {
        transition: background-color 0.15s ease;
    }
    .audit-table tbody tr:hover {
        background-color: #f8fafc;
    }
    .log-badge {
        font-weight: 600;
        font-size: 0.72rem;
        padding: 5px 10px;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        letter-spacing: 0.2px;
    }
    .filter-chip {
        font-size: 0.78rem;
        font-weight: 600;
        border-radius: 20px;
        padding: 5px 12px;
        transition: all 0.15s ease;
        text-decoration: none;
    }
    .terminal-box {
        background-color: #0f172a;
        color: #38bdf8;
        font-family: SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        font-size: 0.8rem;
        border-radius: 10px;
        padding: 14px;
        line-height: 1.5;
        border: 1px solid #1e293b;
    }
    .nav-pills .nav-link.active {
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.25);
    }
</style>

<div class="container-fluid py-4 px-md-4">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="h3 fw-bold text-dark mb-1">
                @if (Model.LogType == "health")
                {
                    <i class="bi bi-heart-pulse-fill text-danger me-2"></i><span>Health Record Audit Logs (FR-S-20)</span>
                }
                else
                {
                    <i class="bi bi-shield-lock-fill text-primary me-2"></i><span>Security & Authentication Logs (FR-S-05/11)</span>
                }
            </h2>
            <p class="text-muted small mb-0">
                @if (Model.LogType == "health")
                {
                    <span>Chronological, immutable audit ledger tracking access, creation, updates, deletions and exports of sensitive client health records.</span>
                }
                else
                {
                    <span>Chronological ledger of user authentication attempts, account status modifications, lockout events, and security exceptions.</span>
                }
            </p>
        </div>

        <!-- Mode Switcher Tabs -->
        <ul class="nav nav-pills gap-2 bg-light p-1 rounded-pill border">
            <li class="nav-item">
                <a class="nav-link rounded-pill px-3 py-1 fw-semibold small @(Model.LogType == "health" ? "active bg-primary text-white" : "text-muted")"
                   href="@Url.Action("Index", "AuditLogs", new { area = "Admin", logType = "health" })">
                    <i class="bi bi-heart-pulse me-1"></i>Health Record Audits
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link rounded-pill px-3 py-1 fw-semibold small @(Model.LogType == "security" ? "active bg-dark text-white" : "text-muted")"
                   href="@Url.Action("Index", "AuditLogs", new { area = "Admin", logType = "security" })">
                    <i class="bi bi-shield-lock me-1"></i>Auth & Security
                </a>
            </li>
        </ul>
    </div>

    <!-- SMART FILTER TOOLBAR CARD -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-body p-3 p-md-4">
            
            <!-- Quick Preset Chips -->
            <div class="d-flex align-items-center gap-2 mb-3 pb-3 border-bottom flex-wrap">
                <span class="text-muted small fw-bold text-uppercase me-2" style="font-size: 0.72rem;">
                    <i class="bi bi-lightning-charge-fill text-warning me-1"></i>Quick Filters:
                </span>
                
                @if (Model.LogType == "health")
                {
                    <a href="@Url.Action("Index", "AuditLogs", new { area = "Admin", logType = "health" })" 
                       class="filter-chip @(string.IsNullOrEmpty(Model.SelectedEventType) ? "bg-dark text-white shadow-sm" : "bg-light text-secondary border")">
                        All Health Operations
                    </a>
                    <a href="@Url.Action("Index", "AuditLogs", new { area = "Admin", logType = "health", eventType = "View" })" 
                       class="filter-chip @(Model.SelectedEventType == "View" ? "bg-primary text-white shadow-sm" : "bg-light text-secondary border")">
                        <i class="bi bi-eye me-1"></i>Views
                    </a>
                    <a href="@Url.Action("Index", "AuditLogs", new { area = "Admin", logType = "health", eventType = "Create" })" 
                       class="filter-chip @(Model.SelectedEventType == "Create" ? "bg-success text-white shadow-sm" : "bg-light text-secondary border")">
                        <i class="bi bi-plus-circle me-1"></i>Creations
                    </a>
                    <a href="@Url.Action("Index", "AuditLogs", new { area = "Admin", logType = "health", eventType = "Update" })" 
                       class="filter-chip @(Model.SelectedEventType == "Update" ? "bg-warning text-dark shadow-sm" : "bg-light text-secondary border")">
                        <i class="bi bi-pencil me-1"></i>Updates
                    </a>
                    <a href="@Url.Action("Index", "AuditLogs", new { area = "Admin", logType = "health", eventType = "Delete" })" 
                       class="filter-chip @(Model.SelectedEventType == "Delete" ? "bg-danger text-white shadow-sm" : "bg-light text-secondary border")">
                        <i class="bi bi-trash me-1"></i>Deletions
                    </a>
                    <a href="@Url.Action("Index", "AuditLogs", new { area = "Admin", logType = "health", eventType = "Export" })" 
                       class="filter-chip @(Model.SelectedEventType == "Export" ? "bg-info text-white shadow-sm" : "bg-light text-secondary border")">
                        <i class="bi bi-file-earmark-pdf me-1"></i>Exports
                    </a>
                }
                else
                {
                    <a href="@Url.Action("Index", "AuditLogs", new { area = "Admin", logType = "security" })" 
                       class="filter-chip @(string.IsNullOrEmpty(Model.SelectedEventType) ? "bg-dark text-white shadow-sm" : "bg-light text-secondary border")">
                        All Security Events
                    </a>
                    <a href="@Url.Action("Index", "AuditLogs", new { area = "Admin", logType = "security", eventType = "LOGIN_SUCCESS" })" 
                       class="filter-chip @(Model.SelectedEventType == "LOGIN_SUCCESS" ? "bg-success text-white shadow-sm" : "bg-light text-secondary border")">
                        <i class="bi bi-shield-check me-1"></i>Successful Logins
                    </a>
                    <a href="@Url.Action("Index", "AuditLogs", new { area = "Admin", logType = "security", eventType = "LOGIN_FAILED" })" 
                       class="filter-chip @(Model.SelectedEventType == "LOGIN_FAILED" ? "bg-danger text-white shadow-sm" : "bg-light text-secondary border")">
                        <i class="bi bi-shield-x me-1"></i>Failed Logins
                    </a>
                    <a href="@Url.Action("Index", "AuditLogs", new { area = "Admin", logType = "security", eventType = "CLIENT_DEACTIVATED" })" 
                       class="filter-chip @(Model.SelectedEventType == "CLIENT_DEACTIVATED" ? "bg-warning text-dark shadow-sm" : "bg-light text-secondary border")">
                        <i class="bi bi-slash-circle me-1"></i>Client Deactivations
                    </a>
                    <a href="@Url.Action("Index", "AuditLogs", new { area = "Admin", logType = "security", eventType = "TRAINER_CREATED" })" 
                       class="filter-chip @(Model.SelectedEventType == "TRAINER_CREATED" ? "bg-primary text-white shadow-sm" : "bg-light text-secondary border")">
                        <i class="bi bi-person-plus me-1"></i>Trainer Created
                    </a>
                }
            </div>

            <!-- Detailed Filter Form -->
            @using (Html.BeginForm("Index", "AuditLogs", new { area = "Admin" }, FormMethod.Get, new { @class = "row g-3 align-items-end" }))
            {
                <input type="hidden" name="logType" value="@Model.LogType" />

                <!-- 1. Operation / Event Type Filter -->
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted text-uppercase mb-1">
                        <i class="bi bi-tag-fill me-1 text-primary"></i>@(Model.LogType == "health" ? "Operation" : "Event Type")
                    </label>
                    <select name="eventType" class="form-select bg-light border-light-subtle rounded-3">
                        <option value="">All @(Model.LogType == "health" ? "Operations" : "Classifications")</option>
                        @foreach (var evt in Model.AvailableEventTypes)
                        {
                            <option value="@evt" @(Model.SelectedEventType == evt ? "selected" : "")>@evt</option>
                        }
                    </select>
                </div>

                <!-- 2. Role Filter -->
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted text-uppercase mb-1">
                        <i class="bi bi-people-fill me-1 text-info"></i>Actor Role
                    </label>
                    <select name="role" class="form-select bg-light border-light-subtle rounded-3">
                        <option value="">All Roles</option>
                        @foreach (var r in Model.AvailableRoles)
                        {
                            <option value="@r" @(Model.SelectedRole == r ? "selected" : "")>@r</option>
                        }
                    </select>
                </div>

                @if (Model.LogType == "health")
                {
                    <!-- 2b. Record Type Filter -->
                    <div class="col-md-2">
                        <label class="form-label small fw-bold text-muted text-uppercase mb-1">
                            <i class="bi bi-file-medical me-1 text-danger"></i>Record Type
                        </label>
                        <select name="recordType" class="form-select bg-light border-light-subtle rounded-3">
                            <option value="">All Record Types</option>
                            @foreach (var rt in Model.AvailableRecordTypes)
                            {
                                <option value="@rt" @(Model.SelectedRecordType == rt ? "selected" : "")>@rt</option>
                            }
                        </select>
                    </div>
                }

                <!-- 3. Time Window -->
                <div class="@(Model.LogType == "health" ? "col-md-2" : "col-md-2")">
                    <label class="form-label small fw-bold text-muted text-uppercase mb-1">
                        <i class="bi bi-calendar3 me-1 text-warning"></i>Time Window
                    </label>
                    <select name="dateRange" class="form-select bg-light border-light-subtle rounded-3">
                        <option value="all" @(Model.DateRange == "all" ? "selected" : "")>All Time</option>
                        <option value="today" @(Model.DateRange == "today" ? "selected" : "")>Today Only</option>
                        <option value="7days" @(Model.DateRange == "7days" ? "selected" : "")>Past 7 Days</option>
                        <option value="30days" @(Model.DateRange == "30days" ? "selected" : "")>Past 30 Days</option>
                    </select>
                </div>

                <!-- 4. Keyword Search -->
                <div class="@(Model.LogType == "health" ? "col-md-2" : "col-md-3")">
                    <label class="form-label small fw-bold text-muted text-uppercase mb-1">
                        <i class="bi bi-search me-1 text-secondary"></i>Search
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 border-light-subtle"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="search" value="@Model.SearchQuery" class="form-control bg-light border-start-0 border-light-subtle" placeholder="ID, details..." />
                    </div>
                </div>

                <!-- 5. Submit & Reset -->
                <div class="@(Model.LogType == "health" ? "col-md-1" : "col-md-2") d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 fw-semibold rounded-3 py-2 shadow-sm" title="Apply Filters">
                        <i class="bi bi-funnel-fill"></i>
                    </button>
                    <a href="@Url.Action("Index", "AuditLogs", new { area = "Admin", logType = Model.LogType })" class="btn btn-outline-secondary rounded-3 py-2 px-3" title="Clear All Filters">
                        <i class="bi bi-x-lg"></i>
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- AUDIT LOGS DATA TABLE CARD -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        
        <!-- Table Header Banner -->
        <div class="card-header bg-white py-3 px-4 border-bottom d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div>
                <h5 class="card-title mb-0 fw-bold fs-6 text-dark d-flex align-items-center gap-2">
                    @if (Model.LogType == "health")
                    {
                        <i class="bi bi-heart-pulse text-danger"></i>
                        <span>Health Record Clinical Audit Trail (FR-S-20)</span>
                    }
                    else
                    {
                        <i class="bi bi-shield-check text-primary"></i>
                        <span>Authentication & Security Audit Telemetry</span>
                    }
                </h5>
                <span class="text-muted small">Showing immutable sequence logs matching current filter parameters</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-light text-muted border px-2 py-1">
                    @Model.TotalRecords Total Records
                </span>
                <span class="badge bg-secondary-subtle text-secondary px-2 py-1 font-monospace">
                    Page @Model.CurrentPage of @(Model.TotalPages == 0 ? 1 : Model.TotalPages)
                </span>
            </div>
        </div>

        @if (Model.LogType == "health")
        {
            <!-- HEALTH RECORD AUDIT LOGS TABLE -->
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 audit-table">
                    <thead>
                        <tr>
                            <th class="ps-4" style="width: 90px;">Audit ID</th>
                            <th style="min-width: 170px;">Timestamp (UTC & Local)</th>
                            <th style="min-width: 160px;">Actor Identity</th>
                            <th style="min-width: 130px;">Target Client</th>
                            <th style="min-width: 140px;">Record Type</th>
                            <th style="min-width: 120px;">Operation</th>
                            <th>Context Details (Sanitized)</th>
                            <th class="text-end pe-4" style="width: 100px;">Inspect</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.HealthLogs == null || !Model.HealthLogs.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <div class="py-4">
                                        <div class="rounded-circle bg-light d-inline-flex p-3 mb-3 text-secondary">
                                            <i class="bi bi-heart-pulse fs-1"></i>
                                        </div>
                                        <h6 class="fw-bold text-dark">No Health Record Audit Logs Found</h6>
                                        <p class="small text-muted mb-3">No clinical data access or modification events match your current filter parameters.</p>
                                        <a href="@Url.Action("Index", "AuditLogs", new { area = "Admin", logType = "health" })" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                            Reset Filters
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var log in Model.HealthLogs)
                            {
                                var opBadge = "bg-secondary-subtle text-secondary border";
                                if (log.Operation == "View") { opBadge = "bg-primary-subtle text-primary border border-primary-subtle"; }
                                else if (log.Operation == "Create") { opBadge = "bg-success-subtle text-success border border-success-subtle"; }
                                else if (log.Operation == "Update") { opBadge = "bg-warning-subtle text-dark border border-warning-subtle"; }
                                else if (log.Operation == "Delete") { opBadge = "bg-danger-subtle text-danger border border-danger-subtle"; }
                                else if (log.Operation == "Export") { opBadge = "bg-info-subtle text-info-emphasis border border-info-subtle"; }

                                var roleBadge = "bg-secondary-subtle text-secondary";
                                var avatarBg = "bg-secondary";
                                if (log.ActorRole == "Administrator" || log.ActorRole == "Admin") { roleBadge = "bg-danger-subtle text-danger border border-danger-subtle"; avatarBg = "bg-danger"; }
                                else if (log.ActorRole == "Trainer") { roleBadge = "bg-primary-subtle text-primary border border-primary-subtle"; avatarBg = "bg-primary"; }
                                else if (log.ActorRole == "Client") { roleBadge = "bg-success-subtle text-success border border-success-subtle"; avatarBg = "bg-success"; }

                                <tr>
                                    <!-- Audit ID -->
                                    <td class="ps-4">
                                        <span class="badge bg-light text-dark font-monospace border fw-bold px-2 py-1" style="font-size: 0.78rem;">
                                            #@log.AuditLogId.ToString("D5")
                                        </span>
                                    </td>

                                    <!-- Timestamp -->
                                    <td>
                                        <div class="fw-bold text-dark" style="font-size: 0.85rem;">
                                            @log.TimestampUtc.ToLocalTime().ToString("MMM dd, yyyy")
                                        </div>
                                        <div class="text-muted small" style="font-size: 0.75rem;">
                                            <i class="bi bi-clock me-1 text-secondary"></i>@log.TimestampUtc.ToLocalTime().ToString("hh:mm:ss tt")
                                            <span class="text-muted font-monospace" style="font-size: 0.7rem;">(UTC @log.TimestampUtc.ToString("HH:mm"))</span>
                                        </div>
                                    </td>

                                    <!-- Actor -->
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rounded-circle @avatarBg text-white d-flex align-items-center justify-content-center fw-bold flex-shrink-0" style="width: 32px; height: 32px; font-size: 0.75rem;">
                                                @((log.ActorRole ?? "U").Substring(0, 1).ToUpper())
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark font-monospace" style="font-size: 0.82rem;">
                                                    @(string.IsNullOrWhiteSpace(log.ActorId) ? "Anonymous" : log.ActorId)
                                                </div>
                                                <span class="badge @roleBadge px-2 py-0 fw-semibold" style="font-size: 0.65rem;">
                                                    @(log.ActorRole ?? "Unknown")
                                                </span>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- Target Client -->
                                    <td>
                                        @if (!string.IsNullOrEmpty(log.ClientId))
                                        {
                                            <span class="badge bg-light text-dark border font-monospace px-2 py-1">
                                                <i class="bi bi-person me-1 text-muted"></i>@log.ClientId
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">System / Self</span>
                                        }
                                    </td>

                                    <!-- Record Type -->
                                    <td>
                                        <span class="badge bg-light text-dark border px-2 py-1">
                                            @if (log.RecordType == "HealthProfile") { <i class="bi bi-heart-pulse text-danger me-1"></i> }
                                            else if (log.RecordType == "ClientProgress") { <i class="bi bi-graph-up text-primary me-1"></i> }
                                            else if (log.RecordType == "SleepLog") { <i class="bi bi-moon-stars text-info me-1"></i> }
                                            else if (log.RecordType == "WaterLog") { <i class="bi bi-droplet text-primary me-1"></i> }
                                            else if (log.RecordType == "ClientGoal") { <i class="bi bi-bullseye text-warning me-1"></i> }
                                            else { <i class="bi bi-file-medical text-secondary me-1"></i> }
                                            @log.RecordType
                                        </span>
                                    </td>

                                    <!-- Operation & Outcome -->
                                    <td>
                                        <span class="log-badge @opBadge">
                                            @if (log.Success)
                                            {
                                                <i class="bi bi-check-circle-fill text-success"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-x-circle-fill text-danger"></i>
                                            }
                                            @log.Operation
                                        </span>
                                    </td>

                                    <!-- Context Details -->
                                    <td>
                                        <div class="text-dark fw-medium text-truncate" style="max-width: 380px;" title="@log.Details">
                                            @log.Details
                                        </div>
                                    </td>

                                    <!-- Inspect Button -->
                                    <td class="text-end pe-4">
                                        <button type="button" 
                                                class="btn btn-sm btn-outline-dark rounded-pill px-3 py-1 fw-semibold d-inline-flex align-items-center gap-1 shadow-sm" 
                                                data-bs-toggle="modal" 
                                                data-bs-target="#inspectHealthModal-@log.AuditLogId" 
                                                title="View audit record">
                                            <i class="bi bi-eye"></i>
                                            <span>Inspect</span>
                                        </button>

                                        <!-- Inspect Modal -->
                                        <div class="modal fade text-start" id="inspectHealthModal-@log.AuditLogId" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered modal-lg">
                                                <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                                                    
                                                    <!-- Modal Header -->
                                                    <div class="modal-header bg-dark text-white p-4">
                                                        <div class="d-flex align-items-center gap-3">
                                                            <div class="rounded-3 bg-white bg-opacity-10 p-2 text-danger">
                                                                <i class="bi bi-heart-pulse-fill fs-4"></i>
                                                            </div>
                                                            <div>
                                                                <div class="d-flex align-items-center gap-2">
                                                                    <h5 class="modal-title fw-bold mb-0 text-white">
                                                                        Health Record Audit Log #@log.AuditLogId.ToString("D5")
                                                                    </h5>
                                                                    <span class="badge @opBadge rounded-pill" style="font-size: 0.7rem;">
                                                                        @log.Operation
                                                                    </span>
                                                                </div>
                                                                <span class="text-white-50 small">Recorded @log.TimestampUtc.ToLocalTime().ToString("dddd, MMMM dd, yyyy 'at' hh:mm:ss tt") (UTC: @log.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss 'UTC'"))</span>
                                                            </div>
                                                        </div>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>

                                                    <!-- Modal Body -->
                                                    <div class="modal-body p-4 bg-light bg-opacity-50">
                                                        
                                                        <!-- Metadata Grid Cards -->
                                                        <div class="row g-3 mb-4">
                                                            <div class="col-sm-4">
                                                                <div class="p-3 bg-white rounded-3 border">
                                                                    <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.68rem;">Actor Identity</div>
                                                                    <div class="fw-bold font-monospace text-dark mt-1 fs-6">@log.ActorId</div>
                                                                    <span class="badge @roleBadge mt-1" style="font-size: 0.65rem;">@log.ActorRole</span>
                                                                </div>
                                                            </div>
                                                            <div class="col-sm-4">
                                                                <div class="p-3 bg-white rounded-3 border">
                                                                    <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.68rem;">Target Clinical Record</div>
                                                                    <div class="fw-bold text-dark mt-1 fs-6">@log.RecordType</div>
                                                                    <span class="text-muted small font-monospace" style="font-size: 0.72rem;">Client: @(log.ClientId ?? "N/A")</span>
                                                                </div>
                                                            </div>
                                                            <div class="col-sm-4">
                                                                <div class="p-3 bg-white rounded-3 border">
                                                                    <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.68rem;">Outcome & Security</div>
                                                                    <div class="fw-bold @(log.Success ? "text-success" : "text-danger") mt-1 fs-6">
                                                                        <i class="bi @(log.Success ? "bi-check-circle-fill" : "bi-x-circle-fill") me-1"></i>@(log.Success ? "Authorized / Success" : "Blocked / Unauthorized")
                                                                    </div>
                                                                    <span class="text-muted small" style="font-size: 0.72rem;">FR-S-20 Compliant</span>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <!-- Full Event Payload Terminal -->
                                                        <div class="mb-0">
                                                            <div class="d-flex align-items-center justify-content-between mb-2">
                                                                <span class="fw-bold text-dark small text-uppercase" style="font-size: 0.72rem;">
                                                                    <i class="bi bi-terminal me-1 text-primary"></i>Audit Payload & Telemetry (No Clinical Data Stored):
                                                                </span>
                                                                <span class="badge bg-secondary-subtle text-secondary small font-monospace">Sanitized Metadata</span>
                                                            </div>
                                                            <div class="terminal-box">
                                                                <span class="text-white-50">[audit-entry seq="@log.AuditLogId" timestamp="@log.TimestampUtc.ToString("o")"]</span><br />
                                                                <span class="text-warning">Actor:</span> @log.ActorId (@log.ActorRole)<br />
                                                                <span class="text-warning">Target Client:</span> @(log.ClientId ?? "N/A")<br />
                                                                <span class="text-warning">Record Category:</span> @log.RecordType<br />
                                                                <span class="text-warning">Record Entity ID:</span> @(log.RecordId.HasValue ? log.RecordId.ToString() : "N/A")<br />
                                                                <span class="text-warning">Operation:</span> @log.Operation (Success: @log.Success)<br />
                                                                <span class="text-warning">Sanitized Context:</span> @log.Details
                                                            </div>
                                                        </div>

                                                    </div>

                                                    <!-- Modal Footer -->
                                                    <div class="modal-footer border-top bg-white p-3">
                                                        <button type="button" class="btn btn-secondary rounded-pill px-4 fw-semibold" data-bs-dismiss="modal">Close</button>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>

                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <!-- SECURITY & AUTHENTICATION AUDIT LOGS TABLE -->
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 audit-table">
                    <thead>
                        <tr>
                            <th class="ps-4" style="width: 100px;">Log Seq</th>
                            <th style="min-width: 180px;">Event Timestamp</th>
                            <th style="min-width: 170px;">Actor Identity</th>
                            <th style="min-width: 200px;">Event Classification</th>
                            <th>Event Description / Payload Snippet</th>
                            <th class="text-end pe-4" style="width: 100px;">Inspect</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Logs == null || !Model.Logs.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <div class="py-4">
                                        <div class="rounded-circle bg-light d-inline-flex p-3 mb-3 text-secondary">
                                            <i class="bi bi-shield-slash fs-1"></i>
                                        </div>
                                        <h6 class="fw-bold text-dark">No Security Audit Logs Match The Selected Filter</h6>
                                        <p class="small text-muted mb-3">Try adjusting your event classification, actor role, or time window filters.</p>
                                        <a href="@Url.Action("Index", "AuditLogs", new { area = "Admin", logType = "security" })" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                            Reset Filters
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var log in Model.Logs)
                            {
                                var badgeClass = "bg-secondary-subtle text-secondary border border-secondary-subtle";
                                var iconClass = "bi-info-circle";

                                if (log.EventType.Contains("SUCCESS"))
                                {
                                    badgeClass = "bg-success-subtle text-success border border-success-subtle";
                                    iconClass = "bi-shield-check";
                                }
                                else if (log.EventType.Contains("FAILED"))
                                {
                                    badgeClass = "bg-danger-subtle text-danger border border-danger-subtle";
                                    iconClass = "bi-shield-x";
                                }
                                else if (log.EventType.Contains("LOCKED"))
                                {
                                    badgeClass = "bg-warning-subtle text-dark border border-warning-subtle";
                                    iconClass = "bi-lock-fill";
                                }
                                else if (log.EventType.Contains("ACTIVATED"))
                                {
                                    badgeClass = "bg-info-subtle text-info-emphasis border border-info-subtle";
                                    iconClass = "bi-person-check-fill";
                                }
                                else if (log.EventType.Contains("DEACTIVATED"))
                                {
                                    badgeClass = "bg-danger-subtle text-danger border border-danger-subtle";
                                    iconClass = "bi-person-x-fill";
                                }
                                else if (log.EventType.Contains("CREATED"))
                                {
                                    badgeClass = "bg-primary-subtle text-primary border border-primary-subtle";
                                    iconClass = "bi-person-plus-fill";
                                }
                                else if (log.EventType.Contains("PASSWORD") || log.EventType.Contains("RESET") || log.EventType.Contains("RESENT"))
                                {
                                    badgeClass = "bg-warning-subtle text-dark border border-warning-subtle";
                                    iconClass = "bi-key-fill";
                                }
                                else if (log.EventType.Contains("LOGOUT"))
                                {
                                    badgeClass = "bg-light text-muted border";
                                    iconClass = "bi-box-arrow-right";
                                }

                                var roleBadgeClass = "bg-secondary-subtle text-secondary";
                                var actorAvatarBg = "bg-secondary";

                                if (log.UserRole == "Admin")
                                {
                                    roleBadgeClass = "bg-danger-subtle text-danger border border-danger-subtle";
                                    actorAvatarBg = "bg-danger";
                                }
                                else if (log.UserRole == "Trainer")
                                {
                                    roleBadgeClass = "bg-primary-subtle text-primary border border-primary-subtle";
                                    actorAvatarBg = "bg-primary";
                                }
                                else if (log.UserRole == "Client")
                                {
                                    roleBadgeClass = "bg-success-subtle text-success border border-success-subtle";
                                    actorAvatarBg = "bg-success";
                                }

                                <tr>
                                    <!-- Log Seq ID -->
                                    <td class="ps-4">
                                        <span class="badge bg-light text-dark font-monospace border fw-bold px-2 py-1" style="font-size: 0.78rem;">
                                            #@log.LogId.ToString("D5")
                                        </span>
                                    </td>

                                    <!-- Timestamp -->
                                    <td>
                                        <div class="fw-bold text-dark" style="font-size: 0.85rem;">
                                            @log.TimestampUtc.ToLocalTime().ToString("MMM dd, yyyy")
                                        </div>
                                        <div class="text-muted small" style="font-size: 0.75rem;">
                                            <i class="bi bi-clock me-1 text-secondary"></i>@log.TimestampUtc.ToLocalTime().ToString("hh:mm:ss tt")
                                        </div>
                                    </td>

                                    <!-- Actor Identity -->
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rounded-circle @actorAvatarBg text-white d-flex align-items-center justify-content-center fw-bold flex-shrink-0" style="width: 32px; height: 32px; font-size: 0.75rem;">
                                                @((log.UserRole ?? "S").Substring(0, 1).ToUpper())
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark font-monospace" style="font-size: 0.82rem;">
                                                    @(string.IsNullOrWhiteSpace(log.UserId) ? "Anonymous" : log.UserId)
                                                </div>
                                                <span class="badge @roleBadgeClass px-2 py-0 fw-semibold" style="font-size: 0.65rem;">
                                                    @(log.UserRole ?? "System")
                                                </span>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- Event Classification -->
                                    <td>
                                        <span class="log-badge @badgeClass">
                                            <i class="bi @iconClass"></i>
                                            @log.EventType
                                        </span>
                                    </td>

                                    <!-- Event Details Snippet -->
                                    <td>
                                        <div class="text-dark fw-medium text-truncate" style="max-width: 440px;" title="@log.Details">
                                            @log.Details
                                        </div>
                                    </td>

                                    <!-- Inspect Button -->
                                    <td class="text-end pe-4">
                                        <button type="button" 
                                                class="btn btn-sm btn-outline-dark rounded-pill px-3 py-1 fw-semibold d-inline-flex align-items-center gap-1 shadow-sm" 
                                                data-bs-toggle="modal" 
                                                data-bs-target="#inspectModal-@log.LogId" 
                                                title="View complete audit payload">
                                            <i class="bi bi-eye"></i>
                                            <span>Inspect</span>
                                        </button>

                                        <!-- Inspect Modal -->
                                        <div class="modal fade text-start" id="inspectModal-@log.LogId" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered modal-lg">
                                                <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                                                    
                                                    <!-- Modal Header -->
                                                    <div class="modal-header bg-dark text-white p-4">
                                                        <div class="d-flex align-items-center gap-3">
                                                            <div class="rounded-3 bg-white bg-opacity-10 p-2 text-info">
                                                                <i class="bi bi-shield-lock fs-4"></i>
                                                            </div>
                                                            <div>
                                                                <div class="d-flex align-items-center gap-2">
                                                                    <h5 class="modal-title fw-bold mb-0 text-white">
                                                                        Security Audit Record #@log.LogId.ToString("D5")
                                                                    </h5>
                                                                    <span class="badge @badgeClass rounded-pill" style="font-size: 0.7rem;">
                                                                        @log.EventType
                                                                    </span>
                                                                </div>
                                                                <span class="text-white-50 small">Recorded on @log.TimestampUtc.ToLocalTime().ToString("dddd, MMMM dd, yyyy 'at' hh:mm:ss tt")</span>
                                                            </div>
                                                        </div>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>

                                                    <!-- Modal Body -->
                                                    <div class="modal-body p-4 bg-light bg-opacity-50">
                                                        <div class="row g-3 mb-4">
                                                            <div class="col-sm-4">
                                                                <div class="p-3 bg-white rounded-3 border">
                                                                    <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.68rem;">Actor Identity</div>
                                                                    <div class="fw-bold font-monospace text-dark mt-1 fs-6">@log.UserId</div>
                                                                    <span class="badge @roleBadgeClass mt-1" style="font-size: 0.65rem;">@log.UserRole Role</span>
                                                                </div>
                                                            </div>
                                                            <div class="col-sm-4">
                                                                <div class="p-3 bg-white rounded-3 border">
                                                                    <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.68rem;">Event Classification</div>
                                                                    <div class="fw-bold text-dark mt-1 fs-6">@log.EventType</div>
                                                                    <span class="text-muted small" style="font-size: 0.72rem;">Standard Authorization</span>
                                                                </div>
                                                            </div>
                                                            <div class="col-sm-4">
                                                                <div class="p-3 bg-white rounded-3 border">
                                                                    <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.68rem;">Date & Time</div>
                                                                    <div class="fw-bold text-dark mt-1 fs-6">@log.TimestampUtc.ToLocalTime().ToString("hh:mm:ss tt")</div>
                                                                    <span class="text-muted small" style="font-size: 0.72rem;">@log.TimestampUtc.ToLocalTime().ToString("MMM dd, yyyy")</span>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="mb-0">
                                                            <div class="d-flex align-items-center justify-content-between mb-2">
                                                                <span class="fw-bold text-dark small text-uppercase" style="font-size: 0.72rem;">
                                                                    <i class="bi bi-terminal me-1 text-primary"></i>Event Details & Audit Payload:
                                                                </span>
                                                                <span class="badge bg-secondary-subtle text-secondary small font-monospace">Plaintext Log</span>
                                                            </div>
                                                            <div class="terminal-box">
                                                                <span class="text-white-50">[log sequence="@log.LogId" time="@log.TimestampUtc.ToLocalTime().ToString("yyyy-MM-dd hh:mm:ss tt")"]</span><br />
                                                                <span class="text-warning">Actor:</span> @log.UserId (@log.UserRole)<br />
                                                                <span class="text-warning">Event:</span> @log.EventType<br />
                                                                <span class="text-warning">Payload:</span> @log.Details
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- Modal Footer -->
                                                    <div class="modal-footer border-top bg-white p-3">
                                                        <button type="button" class="btn btn-secondary rounded-pill px-4 fw-semibold" data-bs-dismiss="modal">Close</button>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>

                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }

        <!-- PAGINATION TOOLBAR -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white py-3 px-4 border-top d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">
                <span class="text-muted small">
                    Showing entries <strong class="text-dark">@(((Model.CurrentPage - 1) * Model.PageSize) + 1)</strong> to <strong class="text-dark">@Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalRecords)</strong> of <strong class="text-dark">@Model.TotalRecords</strong> total
                </span>
                <nav aria-label="Audit log pages">
                    <ul class="pagination pagination-sm mb-0">
                        <!-- Previous Page -->
                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            <a class="page-link rounded-start-pill px-3" 
                               href="@Url.Action("Index", "AuditLogs", new { area = "Admin", logType = Model.LogType, eventType = Model.SelectedEventType, role = Model.SelectedRole, recordType = Model.SelectedRecordType, dateRange = Model.DateRange, search = Model.SearchQuery, page = Model.CurrentPage - 1 })">
                                &laquo; Previous
                            </a>
                        </li>

                        <!-- Page Numbers -->
                        @for (int p = Math.Max(1, Model.CurrentPage - 2); p <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); p++)
                        {
                            <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" 
                                   href="@Url.Action("Index", "AuditLogs", new { area = "Admin", logType = Model.LogType, eventType = Model.SelectedEventType, role = Model.SelectedRole, recordType = Model.SelectedRecordType, dateRange = Model.DateRange, search = Model.SearchQuery, page = p })">
                                    @p
                                </a>
                            </li>
                        }

                        <!-- Next Page -->
                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link rounded-end-pill px-3" 
                               href="@Url.Action("Index", "AuditLogs", new { area = "Admin", logType = Model.LogType, eventType = Model.SelectedEventType, role = Model.SelectedRole, recordType = Model.SelectedRecordType, dateRange = Model.DateRange, search = Model.SearchQuery, page = Model.CurrentPage + 1 })">
                                Next &raquo;
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>

</div>
