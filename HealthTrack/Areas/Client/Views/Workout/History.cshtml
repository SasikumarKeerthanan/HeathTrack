@model HealthTrack.Areas.Client.ViewModels.WorkoutHistoryViewModel

@{
    ViewBag.Title = "Workout History - " + Model.Client.FullName;
}

<div class="container-fluid px-4 py-3">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-2">
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Workout", new { area = "Client" })" class="text-decoration-none">Workout Hub</a></li>
            <li class="breadcrumb-item active" aria-current="page">Workout History</li>
        </ol>
    </nav>

    <!-- Header & Action -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom g-3">
        <div>
            <h2 class="h3 fw-bold mb-1 text-dark d-flex align-items-center gap-2">
                <i class="bi bi-clock-history text-primary"></i> Workout History &amp; Logs
            </h2>
            <p class="text-muted small mb-0">
                Detailed timeline of recorded training sessions, duration, exertion, and coach feedback for <strong>@Model.Client.FullName</strong>
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a href="@Url.Action("Calendar", "Workout", new { area = "Client" })" class="btn btn-outline-secondary">
                <i class="bi bi-calendar3 me-1"></i> View Calendar
            </a>
            <a href="@Url.Action("Index", "Workout", new { area = "Client" })" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Today's Workout
            </a>
        </div>
    </div>

    <!-- Analytics KPI Overview Bar -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white text-center">
                <div class="text-muted x-small text-uppercase fw-bold">Total Workouts</div>
                <div class="fs-4 fw-bold text-dark mt-1">@Model.TotalLogsCount</div>
                <div class="x-small text-success"><i class="bi bi-check-circle-fill"></i> Verified Entries</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white text-center">
                <div class="text-muted x-small text-uppercase fw-bold">Total Time Trained</div>
                <div class="fs-4 fw-bold text-primary mt-1">@Model.TotalDurationHours <span class="fs-6 text-muted">hrs</span></div>
                <div class="x-small text-muted">Accumulated Hours</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white text-center">
                <div class="text-muted x-small text-uppercase fw-bold">Total Energy Burned</div>
                <div class="fs-4 fw-bold text-danger mt-1">@Model.TotalCalories.ToString("N0") <span class="fs-6 text-muted">kcal</span></div>
                <div class="x-small text-muted">Estimated Expenditure</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white text-center">
                <div class="text-muted x-small text-uppercase fw-bold">Average Exertion</div>
                <div class="fs-4 fw-bold text-warning mt-1">RPE @Model.AverageRpe <span class="fs-6 text-muted">/10</span></div>
                <div class="x-small text-muted">Intensity Score</div>
            </div>
        </div>
    </div>

    <!-- Search & Filter Toolbar (FR-C-62) -->
    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
        <form action="@Url.Action("History", "Workout", new { area = "Client" })" method="get" class="row g-2 align-items-end">
            
            <!-- Search Text -->
            <div class="col-lg-3 col-md-6">
                <label class="form-label x-small text-muted fw-bold text-uppercase mb-1">Search</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" class="form-control border-start-0 bg-light" 
                           placeholder="Title, notes, coach feedback..." value="@Model.SearchTerm" />
                </div>
            </div>

            <!-- From Date -->
            <div class="col-lg-2 col-md-3 col-6">
                <label class="form-label x-small text-muted fw-bold text-uppercase mb-1">From Date</label>
                <input type="date" name="fromDate" class="form-control form-control-sm bg-light" 
                       value="@(Model.FromDate.HasValue ? Model.FromDate.Value.ToString("yyyy-MM-dd") : "")" />
            </div>

            <!-- To Date -->
            <div class="col-lg-2 col-md-3 col-6">
                <label class="form-label x-small text-muted fw-bold text-uppercase mb-1">To Date</label>
                <input type="date" name="toDate" class="form-control form-control-sm bg-light" 
                       value="@(Model.ToDate.HasValue ? Model.ToDate.Value.ToString("yyyy-MM-dd") : "")" />
            </div>

            <!-- Status Filter -->
            <div class="col-lg-2 col-md-4">
                <label class="form-label x-small text-muted fw-bold text-uppercase mb-1">Status</label>
                <select name="status" class="form-select form-select-sm bg-light">
                    <option value="all" selected="@(string.IsNullOrEmpty(Model.FilterStatus) || Model.FilterStatus.Equals("all", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">All Statuses</option>
                    <option value="completed" selected="@(Model.FilterStatus == "completed" ? "selected" : null)">Completed Only</option>
                    <option value="partial" selected="@(Model.FilterStatus == "partial" || Model.FilterStatus == "incomplete" ? "selected" : null)">Partial / Incomplete</option>
                </select>
            </div>

            <!-- Plan Filter -->
            <div class="col-lg-2 col-md-4">
                <label class="form-label x-small text-muted fw-bold text-uppercase mb-1">Workout Plan</label>
                <select name="planId" class="form-select form-select-sm bg-light">
                    <option value="" selected="@(!Model.FilterPlanId.HasValue ? "selected" : null)">All Workout Plans</option>
                    @foreach (var p in Model.AvailablePlans)
                    {
                        <option value="@p.WorkoutPlanId" selected="@(Model.FilterPlanId == p.WorkoutPlanId ? "selected" : null)">
                            @p.Title
                        </option>
                    }
                </select>
            </div>

            <!-- Action Buttons -->
            <div class="col-lg-1 col-md-4 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-primary w-100 shadow-sm" title="Apply Filters">
                    <i class="bi bi-funnel"></i>
                </button>
                @if (Model.HasActiveFilter)
                {
                    <a href="@Url.Action("History", "Workout", new { area = "Client" })" class="btn btn-sm btn-outline-secondary" title="Reset / Clear Filters">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Workout Logs Feed -->
    @if (!Model.Logs.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
            <i class="bi bi-journal-x fs-1 text-muted mb-3 d-block"></i>
            <h4 class="fw-bold text-dark">No Workout History Found</h4>
            <p class="text-muted mb-4" style="max-width: 500px; margin: 0 auto;">
                @(Model.HasActiveFilter ? "No workout sessions matched your selected date or status filters." : "You have not completed any recorded workouts yet. Jump into today's session to begin tracking!")
            </p>
            <div class="d-flex justify-content-center gap-2">
                @if (Model.HasActiveFilter)
                {
                    <a href="@Url.Action("History", "Workout", new { area = "Client" })" class="btn btn-outline-primary px-4 rounded-pill">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Clear Filters
                    </a>
                }
                <a href="@Url.Action("Index", "Workout", new { area = "Client" })" class="btn btn-primary px-4 shadow-sm rounded-pill">
                    Go to Workout Hub
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3 mb-4">
            @foreach (var log in Model.Logs)
            {
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                    <div class="card-body p-4">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3">
                            
                            <!-- Left: Date & Session Info -->
                            <div class="d-flex align-items-start gap-3">
                                <div class="date-badge p-2 px-3 rounded-3 bg-light text-center border">
                                    <div class="text-danger x-small fw-bold text-uppercase">@log.LogDate.ToString("MMM")</div>
                                    <div class="fs-4 fw-bold text-dark lh-1">@log.LogDate.ToString("dd")</div>
                                    <div class="text-muted x-small">@log.LogDate.ToString("yyyy")</div>
                                </div>

                                <div>
                                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                        <h5 class="fw-bold text-dark mb-0">@log.SessionName</h5>
                                        @if (log.IsCompleted)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                <i class="bi bi-check-circle-fill me-1"></i>Completed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                                Partial
                                            </span>
                                        }

                                        @if (log.WorkoutPlans != null)
                                        {
                                            <span class="badge bg-light text-muted border">
                                                <i class="bi bi-flag me-1"></i>@log.WorkoutPlans.Goal
                                            </span>
                                        }
                                    </div>

                                    <div class="text-muted small d-flex flex-wrap gap-3">
                                        <span><i class="bi bi-clock me-1 text-primary"></i><strong>@log.DurationMinutes</strong> Minutes</span>
                                        <span><i class="bi bi-fire me-1 text-danger"></i><strong>@log.CaloriesBurned</strong> Calories</span>
                                        @if (log.PerceivedExertion > 0)
                                        {
                                            <span>
                                                <i class="bi bi-speedometer2 me-1 text-warning"></i>
                                                Intensity: <strong>RPE @log.PerceivedExertion/10</strong>
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Right: Exertion Rating Pill -->
                            <div>
                                @if (log.PerceivedExertion >= 8)
                                {
                                    <span class="badge bg-danger py-2 px-3 rounded-pill fw-bold">
                                        <i class="bi bi-fire me-1"></i>High Exertion (RPE @log.PerceivedExertion)
                                    </span>
                                }
                                else if (log.PerceivedExertion >= 5)
                                {
                                    <span class="badge bg-warning text-dark py-2 px-3 rounded-pill fw-bold">
                                        <i class="bi bi-lightning-charge-fill me-1"></i>Moderate Exertion (RPE @log.PerceivedExertion)
                                    </span>
                                }
                                else if (log.PerceivedExertion > 0)
                                {
                                    <span class="badge bg-info text-dark py-2 px-3 rounded-pill fw-bold">
                                        <i class="bi bi-stars me-1"></i>Light Session (RPE @log.PerceivedExertion)
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Client Notes Section -->
                        @if (!string.IsNullOrWhiteSpace(log.ClientNotes))
                        {
                            <div class="mt-3 p-3 bg-light rounded-3 border-start border-3 border-primary">
                                <div class="small text-muted fw-bold mb-1">
                                    <i class="bi bi-pencil-square me-1 text-primary"></i>MEMBER REFLECTIONS &amp; WORKOUT NOTES:
                                </div>
                                <div class="fs-6 text-dark lh-base">@log.ClientNotes</div>
                            </div>
                        }

                        <!-- Coach Feedback Section -->
                        @if (!string.IsNullOrWhiteSpace(log.CoachFeedback))
                        {
                            <div class="mt-2 p-3 bg-primary bg-opacity-10 text-primary rounded-3 border border-primary-subtle">
                                <div class="small fw-bold mb-1 text-primary">
                                    <i class="bi bi-chat-quote-fill me-1"></i>COACH FEEDBACK:
                                </div>
                                <div class="fs-6 text-dark lh-base">@log.CoachFeedback</div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }

</div>

<style>
    .date-badge {
        min-width: 65px;
    }
</style>
