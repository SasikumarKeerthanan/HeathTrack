@model HealthTrack.Areas.Client.ViewModels.WorkoutPlanDetailsViewModel

@{
    ViewBag.Title = (Model.Plan != null ? Model.Plan.Title : "Workout Routine") + " - Exercise Instructions";
    var plan = Model.Plan;
}

<div class="container-fluid px-4 py-3">

    <!-- Breadcrumb & Top Bar -->
    <nav aria-label="breadcrumb" class="mb-2">
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Workout", new { area = "Client" })" class="text-decoration-none">Workout Hub</a></li>
            <li class="breadcrumb-item active" aria-current="page">Assigned Routine &amp; Exercise Guide</li>
        </ol>
    </nav>

    <!-- Routine Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom g-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                @if (plan != null && plan.IsActive)
                {
                    <span class="badge bg-emerald-subtle text-emerald border border-emerald-subtle d-inline-flex align-items-center gap-1">
                        <span class="pulse-indicator"></span> Active Routine
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary-subtle text-secondary border">Archived Routine</span>
                }
                @if (plan != null)
                {
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                        <i class="bi bi-flag-fill me-1"></i>@plan.Goal
                    </span>
                    <span class="badge bg-light text-dark border">
                        <i class="bi bi-speedometer2 me-1"></i>@plan.DifficultyLevel
                    </span>
                }
            </div>
            <h2 class="h3 fw-bold mb-1 text-dark">@(plan != null ? plan.Title : "Prescribed Workout Routine")</h2>
            <p class="text-muted small mb-0">
                Prescribed for <strong>@Model.Client.FullName</strong> &bull; Assigned by <strong>@Model.Client.TrainerName</strong>
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a href="@Url.Action("Index", "Workout", new { area = "Client" })" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Hub
            </a>
            <a href="@Url.Action("Calendar", "Workout", new { area = "Client" })" class="btn btn-primary shadow-sm">
                <i class="bi bi-calendar3 me-1"></i> View on Calendar
            </a>
        </div>
    </div>

    @if (plan == null)
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
            <i class="bi bi-journal-x fs-1 text-muted mb-3 d-block"></i>
            <h4 class="fw-bold text-dark">No Workout Routine Assigned Yet</h4>
            <p class="text-muted mb-4" style="max-width: 500px; margin: 0 auto;">
                Your trainer has not yet published an active workout routine for your account. Please check back shortly or message your coach!
            </p>
            <div>
                <a href="@Url.Action("Index", "Workout", new { area = "Client" })" class="btn btn-primary px-4">
                    Return to Workout Hub
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Program Specification & Coach Guidelines Banner -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
            <div class="row g-4 align-items-center">
                <div class="col-lg-7">
                    <h5 class="fw-bold text-dark mb-2">Program Overview &amp; Strategy</h5>
                    <p class="text-muted small mb-3">@plan.Description</p>

                    <div class="row g-3">
                        <div class="col-4">
                            <div class="p-3 bg-light rounded-3 text-center border">
                                <div class="text-muted x-small text-uppercase fw-bold">Duration</div>
                                <div class="fs-4 fw-bold text-primary">@plan.DurationWeeks</div>
                                <div class="x-small text-muted">Weeks Total</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-3 bg-light rounded-3 text-center border">
                                <div class="text-muted x-small text-uppercase fw-bold">Frequency</div>
                                <div class="fs-4 fw-bold text-success">@plan.DaysPerWeek</div>
                                <div class="x-small text-muted">Days / Week</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-3 bg-light rounded-3 text-center border">
                                <div class="text-muted x-small text-uppercase fw-bold">Schedule</div>
                                <div class="fs-4 fw-bold text-warning">@Model.GroupedDays.Count</div>
                                <div class="x-small text-muted">Split Days</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-5 border-start-lg">
                    <h6 class="fw-bold text-dark small mb-2"><i class="bi bi-chat-left-quote text-primary me-1"></i>Coach Programming Directives:</h6>
                    
                    <div class="d-flex flex-column gap-2 small">
                        @if (plan.ScheduledStartTime.HasValue)
                        {
                            <div class="d-flex justify-content-between p-2 rounded bg-light border-start border-3 border-warning">
                                <span class="text-muted"><i class="bi bi-alarm text-warning me-1"></i>Scheduled Start Time:</span>
                                <strong class="text-dark">@DateTime.Today.Add(plan.ScheduledStartTime.Value).ToString("hh:mm tt") <span class="badge bg-warning text-dark ms-1">30m Reminder Active</span></strong>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(plan.TargetRepRange))
                        {
                            <div class="d-flex justify-content-between p-2 rounded bg-light">
                                <span class="text-muted">Target Rep Range:</span>
                                <strong class="text-dark">@plan.TargetRepRange</strong>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(plan.RecommendedRest))
                        {
                            <div class="d-flex justify-content-between p-2 rounded bg-light">
                                <span class="text-muted">Rest Guidance:</span>
                                <strong class="text-dark">@plan.RecommendedRest</strong>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(plan.RirTarget))
                        {
                            <div class="d-flex justify-content-between p-2 rounded bg-light">
                                <span class="text-muted">RIR (Reps in Reserve):</span>
                                <strong class="text-dark">@plan.RirTarget</strong>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(plan.ProgressionStrategy))
                        {
                            <div class="p-3 bg-primary bg-opacity-10 rounded-3 border border-primary-subtle mt-3">
                                <strong class="text-primary d-flex align-items-center gap-1 mb-1 small fw-bold">
                                    <i class="bi bi-graph-up-arrow"></i> Progression Strategy:
                                </strong>
                                <div class="text-dark small lh-base">
                                    @plan.ProgressionStrategy
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- ========================================================
             DAY-BY-DAY SPLIT TABS
             ======================================================== -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
            <h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-collection-play-fill text-primary"></i> Scheduled Daily Workouts &amp; Exercise Library
            </h5>

            <!-- Tabs Nav -->
            <ul class="nav nav-pills mb-4 gap-2 border-bottom pb-3" id="workoutDayTabs" role="tablist">
                @for (int d = 0; d < Model.GroupedDays.Count; d++)
                {
                    var dayItem = Model.GroupedDays[d];
                    bool isSelected = dayItem.DayOfWeek.Equals(Model.SelectedDay, StringComparison.OrdinalIgnoreCase);
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(isSelected ? "active fw-bold shadow-sm" : "bg-light text-dark") rounded-pill px-4" 
                                id="tab-@dayItem.DayOfWeek" data-bs-toggle="pill" data-bs-target="#content-@dayItem.DayOfWeek" type="button" role="tab">
                            <span class="d-flex align-items-center gap-2">
                                <span>@dayItem.DayOfWeek</span>
                                <span class="badge @(isSelected ? "bg-white text-primary" : "bg-secondary bg-opacity-25 text-dark") rounded-pill">
                                    @dayItem.ExerciseCount
                                </span>
                            </span>
                        </button>
                    </li>
                }
            </ul>

            <!-- Tabs Content -->
            <div class="tab-content" id="workoutDayTabsContent">
                @for (int d = 0; d < Model.GroupedDays.Count; d++)
                {
                    var dayItem = Model.GroupedDays[d];
                    bool isSelected = dayItem.DayOfWeek.Equals(Model.SelectedDay, StringComparison.OrdinalIgnoreCase);

                    <div class="tab-pane fade @(isSelected ? "show active" : "")" id="content-@dayItem.DayOfWeek" role="tabpanel">
                        
                        <!-- Day Sub-Header -->
                        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 p-3 rounded-3 bg-light border g-2">
                            <div>
                                <h5 class="fw-bold text-dark mb-0">@dayItem.DayOfWeek: @dayItem.FocusTitle</h5>
                                <div class="text-muted small">
                                    Target: <strong>@dayItem.ExerciseCount Movements</strong> &bull; 
                                    <strong>@dayItem.TotalSets Sets Total</strong> &bull; 
                                    Est. Time: <strong>@dayItem.EstimatedDurationMinutes mins</strong> &bull; 
                                    Est. Burn: <strong>@dayItem.EstimatedCaloriesBurn kcal</strong>
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <a href="@Url.Action("Index", "Workout", new { area = "Client" })" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1">
                                    <i class="bi bi-play-circle-fill"></i> Launch Live Player
                                </a>
                                <button type="button" class="btn btn-sm btn-success d-inline-flex align-items-center gap-1 shadow-sm btn-trigger-plan-complete"
                                        data-bs-toggle="modal" data-bs-target="#completeWorkoutModal"
                                        data-session-name="@dayItem.DayOfWeek: @dayItem.FocusTitle"
                                        data-est-mins="@dayItem.EstimatedDurationMinutes"
                                        data-est-cals="@dayItem.EstimatedCaloriesBurn">
                                    <i class="bi bi-check2-circle"></i> Log &amp; Mark Completed
                                </button>
                            </div>
                        </div>

                        <!-- Exercises in Day -->
                        <div class="row g-4">
                            @for (int i = 0; i < dayItem.Exercises.Count; i++)
                            {
                                var ex = dayItem.Exercises[i];
                                <div class="col-lg-6">
                                    <div class="card border rounded-4 shadow-sm h-100 overflow-hidden bg-white">
                                        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge bg-dark text-white rounded-circle p-2" style="width: 28px; height: 28px; display: flex; align-items: center; justify-content: center;">
                                                    @(i + 1)
                                                </span>
                                                <h6 class="fw-bold mb-0 text-dark">@ex.Name</h6>
                                            </div>
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                                @ex.TargetMuscle
                                            </span>
                                        </div>

                                        <div class="card-body p-4">
                                            <!-- Dual-Image Demonstration -->
                                            <div class="row g-2 mb-3">
                                                <div class="col-6">
                                                    <div class="border rounded-3 p-2 bg-light text-center">
                                                        <div class="x-small text-muted fw-bold mb-1">START POSTURE</div>
                                                        <img src="@(!string.IsNullOrEmpty(ex.StartImagePath) ? Url.Content(ex.StartImagePath) : (!string.IsNullOrEmpty(ex.ImagePath) ? Url.Content(ex.ImagePath) : Url.Content("~/Content/images/exercises/placeholder-exercise.png")))" 
                                                             alt="Start Posture" class="img-fluid rounded-2 object-fit-contain" style="height: 140px;" 
                                                             onerror="this.onerror=null;this.src='@Url.Content("~/Content/images/exercises/placeholder-exercise.png")';" />
                                                    </div>
                                                </div>
                                                <div class="col-6">
                                                    <div class="border rounded-3 p-2 bg-light text-center">
                                                        <div class="x-small text-muted fw-bold mb-1">EXECUTION APEX</div>
                                                        <img src="@(!string.IsNullOrEmpty(ex.MovementImagePath) ? Url.Content(ex.MovementImagePath) : (!string.IsNullOrEmpty(ex.ImagePath) ? Url.Content(ex.ImagePath) : Url.Content("~/Content/images/exercises/placeholder-exercise.png")))" 
                                                             alt="Execution Apex" class="img-fluid rounded-2 object-fit-contain" style="height: 140px;" 
                                                             onerror="this.onerror=null;this.src='@Url.Content("~/Content/images/exercises/placeholder-exercise.png")';" />
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Prescription Specs -->
                                            <div class="row g-2 mb-3 text-center">
                                                <div class="col-3">
                                                    <div class="p-2 bg-light rounded-2 border">
                                                        <div class="x-small text-muted fw-bold">SETS</div>
                                                        <div class="fw-bold text-primary">@ex.Sets</div>
                                                    </div>
                                                </div>
                                                <div class="col-3">
                                                    <div class="p-2 bg-light rounded-2 border">
                                                        <div class="x-small text-muted fw-bold">REPS</div>
                                                        <div class="fw-bold text-success">@(ex.Reps.HasValue ? ex.Reps.ToString() : "--")</div>
                                                    </div>
                                                </div>
                                                <div class="col-3">
                                                    <div class="p-2 bg-light rounded-2 border">
                                                        <div class="x-small text-muted fw-bold">REST</div>
                                                        <div class="fw-bold text-warning">@ex.RestSeconds s</div>
                                                    </div>
                                                </div>
                                                <div class="col-3">
                                                    <div class="p-2 bg-light rounded-2 border">
                                                        <div class="x-small text-muted fw-bold">BURN</div>
                                                        <div class="fw-bold text-danger">~@ex.DefaultCaloriesBurnEstimate</div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Instructions & Form Tips -->
                                            @if (!string.IsNullOrWhiteSpace(ex.KeyGuidance))
                                            {
                                                <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-3 mb-2 border border-primary-subtle guidance-box">
                                                    <strong class="d-inline-flex align-items-center gap-1 mb-1">
                                                        <i class="bi bi-lightbulb-fill"></i> Key Guidance:
                                                    </strong>
                                                    <div class="text-dark lh-base">@ex.KeyGuidance</div>
                                                </div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(ex.Instructions))
                                            {
                                                <div class="p-3 bg-light rounded-3 mb-2 border step-instruction-box">
                                                    <strong class="text-dark d-block mb-1">Step-by-step:</strong>
                                                    <div class="text-secondary lh-base">@ex.Instructions</div>
                                                </div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(ex.TipsAndPrecautions))
                                            {
                                                <div class="p-3 bg-warning bg-opacity-10 rounded-3 text-dark mb-2 border border-warning-subtle safety-cue-box">
                                                    <strong class="d-inline-flex align-items-center gap-1 mb-1 text-warning-emphasis">
                                                        <i class="bi bi-shield-check text-warning"></i> Safety Form Cue:
                                                    </strong>
                                                    <div class="text-dark lh-base">@ex.TipsAndPrecautions</div>
                                                </div>
                                            }
                                        </div>

                                        <div class="card-footer bg-light py-2 px-4 d-flex justify-content-between align-items-center">
                                            <small class="text-muted"><i class="bi bi-tools me-1"></i>@ex.Equipment</small>
                                            <span class="badge bg-light text-dark border">@ex.DifficultyLevel</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                    </div>
                }
            </div>
        </div>
    }

</div>

<!-- ========================================================
     MODAL: MARK WORKOUT COMPLETED & RECORD DETAILS
     ======================================================== -->
<div class="modal fade" id="completeWorkoutModal" tabindex="-1" aria-labelledby="completeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-dark text-white border-0 py-3">
                <h5 class="modal-title fw-bold d-flex align-items-center gap-2" id="completeModalLabel">
                    <i class="bi bi-trophy-fill text-warning"></i> Log &amp; Record Completed Workout
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form action="@Url.Action("CompleteWorkout", "Workout", new { area = "Client" })" method="post" id="completeWorkoutForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ClientId" value="@Model.Client.ClientId" />
                <input type="hidden" name="WorkoutPlanId" value="@(plan != null ? plan.WorkoutPlanId : (int?)null)" />
                <input type="hidden" name="IsCompleted" value="true" />
                <input type="hidden" name="PerceivedExertion" id="inputPerceivedExertion" value="7" />

                <div class="modal-body p-4">
                    <!-- Session Name -->
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Session Title <span class="text-danger">*</span></label>
                        <input type="text" name="SessionName" id="modalSessionName" class="form-control" value="Workout Session" required />
                    </div>

                    <div class="row g-3 mb-3">
                        <!-- Duration in Minutes -->
                        <div class="col-6">
                            <label class="form-label fw-bold small text-dark"><i class="bi bi-clock me-1 text-primary"></i>Duration (Minutes)</label>
                            <div class="input-group">
                                <input type="number" name="DurationMinutes" id="modalDurationMinutes" class="form-control fw-bold" value="45" min="5" max="300" required />
                                <span class="input-group-text">mins</span>
                            </div>
                        </div>

                        <!-- Calories Burned -->
                        <div class="col-6">
                            <label class="form-label fw-bold small text-dark"><i class="bi bi-fire me-1 text-danger"></i>Calories Burned</label>
                            <div class="input-group">
                                <input type="number" name="CaloriesBurned" id="modalCaloriesBurned" class="form-control fw-bold" value="320" min="10" max="2500" required />
                                <span class="input-group-text">kcal</span>
                            </div>
                        </div>
                    </div>

                    <!-- Interactive Borg RPE 1-10 Exertion Scale -->
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-speedometer2 me-1 text-warning"></i>Rate of Perceived Exertion (RPE)</span>
                            <span class="badge bg-warning text-dark fw-bold" id="rpeValueBadge">7 / 10 &bull; Vigorous Effort</span>
                        </label>
                        
                        <div class="rpe-buttons-grid d-flex gap-1 justify-content-between mb-2">
                            @for (int r = 1; r <= 10; r++)
                            {
                                <button type="button" class="btn btn-sm rpe-select-btn @(r == 7 ? "active" : "")" data-rpe="@r">
                                    @r
                                </button>
                            }
                        </div>
                        <div class="x-small text-muted d-flex justify-content-between px-1">
                            <span>1-3 (Light)</span>
                            <span>4-6 (Moderate)</span>
                            <span>7-8 (Hard)</span>
                            <span>9-10 (Maximum)</span>
                        </div>
                    </div>

                    <!-- Client Notes -->
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">
                            <i class="bi bi-pencil-square me-1 text-secondary"></i>Workout Notes &amp; Reflections
                        </label>
                        <textarea name="ClientNotes" id="modalClientNotes" class="form-control" rows="3" 
                                  placeholder="How did the session feel? Did you hit any PRs or experience muscle fatigue?"></textarea>
                    </div>
                </div>

                <div class="modal-footer border-top bg-light px-4 py-3">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success px-4 fw-bold shadow-sm">
                        <i class="bi bi-check2-circle me-1"></i> Save &amp; Mark Completed
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .bg-emerald-subtle {
        background-color: #d1fae5 !important;
    }
    .text-emerald {
        color: #059669 !important;
    }
    .border-emerald-subtle {
        border-color: #a7f3d0 !important;
    }

    .pulse-indicator {
        width: 8px;
        height: 8px;
        background-color: #10b981;
        border-radius: 50%;
        display: inline-block;
        animation: pulseRing 1.8s infinite;
    }

    @@keyframes pulseRing {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }

    .rpe-select-btn {
        flex: 1;
        border: 1px solid #cbd5e1;
        background-color: #f8fafc;
        color: #1e293b;
        font-weight: bold;
        padding: 8px 4px;
        border-radius: 6px;
        transition: all 0.15s ease;
    }
    .rpe-select-btn:hover {
        background-color: #e2e8f0;
    }
    .rpe-select-btn.active {
        background-color: #0d6efd;
        color: #ffffff;
        border-color: #0d6efd;
        box-shadow: 0 2px 6px rgba(13, 110, 253, 0.35);
        transform: scale(1.05);
    }
</style>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Modal Trigger Fill
        document.querySelectorAll(".btn-trigger-plan-complete").forEach(btn => {
            btn.addEventListener("click", function () {
                const sName = this.getAttribute("data-session-name");
                const mins = this.getAttribute("data-est-mins");
                const cals = this.getAttribute("data-est-cals");

                if (sName) document.getElementById("modalSessionName").value = sName;
                if (mins) document.getElementById("modalDurationMinutes").value = mins;
                if (cals) document.getElementById("modalCaloriesBurned").value = cals;
            });
        });

        // RPE Selection
        const rpeButtons = document.querySelectorAll(".rpe-select-btn");
        const inputRpe = document.getElementById("inputPerceivedExertion");
        const rpeBadge = document.getElementById("rpeValueBadge");

        const rpeLabels = {
            1: "Very Light (Warm-up pace)",
            2: "Light (Easy breathing)",
            3: "Moderate (Comfortable pace)",
            4: "Somewhat Hard (Sweating lightly)",
            5: "Challenging (Noticeable effort)",
            6: "Hard (Speaking in short sentences)",
            7: "Vigorous Effort (Heavy breathing)",
            8: "Very Hard (High fatigue, strong push)",
            9: "Extremely Hard (Near exhaustion)",
            10: "Maximum Effort / All-Out Limit!"
        };

        rpeButtons.forEach(btn => {
            btn.addEventListener("click", function () {
                rpeButtons.forEach(b => b.classList.remove("active"));
                this.classList.add("active");
                const val = this.getAttribute("data-rpe");
                if (inputRpe) inputRpe.value = val;
                if (rpeBadge) rpeBadge.textContent = val + " / 10 | " + (rpeLabels[val] || "Effort");
            });
        });
    });
</script>
}
