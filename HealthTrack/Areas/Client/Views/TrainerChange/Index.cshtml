@model HealthTrack.Areas.Client.ViewModels.ClientTrainerChangePageViewModel
@{
    ViewBag.Title = "Request Coach Change";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-3 py-2">

    <!-- HERO HEADER -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #4338ca 100%);">
        <div class="card-body p-4 text-white">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-white bg-opacity-10 text-white border border-2 border-white border-opacity-25 d-flex align-items-center justify-content-center shadow" style="width: 58px; height: 58px;">
                        <i class="bi bi-arrow-repeat fs-3 text-info"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-white mb-1">Coach Change Management</h4>
                        <p class="text-white-50 mb-0 small">
                            Request a trainer reassignment or monitor the review status of your active requests.
                        </p>
                    </div>
                </div>
                <div>
                    <a href="@Url.Action("Index", "Dashboard", new { area = "Client" })" class="btn btn-sm btn-outline-light rounded-pill px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2">
                        <i class="bi bi-arrow-left"></i>
                        <span>Back to Dashboard</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- ALERTS -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5 text-success"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- MAIN TWO-COLUMN WORKSPACE -->
    <div class="row g-4">

        <!-- ============================================================= -->
        <!-- LEFT COLUMN: SUBMIT TRAINER CHANGE REQUEST                    -->
        <!-- ============================================================= -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 bg-white h-100">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                            <i class="bi bi-pencil-square fs-6"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold text-dark mb-0">Submit Change Request</h5>
                            <span class="x-small text-muted">Submit your request with a detailed reason for admin review</span>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">

                    <!-- CURRENT COACH SNAPSHOT -->
                    <div class="p-3 rounded-4 mb-4 border border-secondary border-opacity-10" style="background: #f8fafc;">
                        <span class="x-small text-uppercase fw-bold text-secondary d-block mb-2">Currently Assigned Coach</span>
                        @if (Model.CurrentTrainer != null)
                        {
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle bg-primary bg-opacity-20 text-primary d-flex align-items-center justify-content-center fw-bold fs-5 shadow-sm" style="width: 48px; height: 48px;">
                                    @Model.CurrentTrainer.FullName.Substring(0, 1)
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="fw-bold text-dark mb-0">@Model.CurrentTrainer.FullName</h6>
                                    <div class="x-small text-muted">
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-0 me-1">
                                            @(Model.CurrentTrainer.PrimarySpecialization ?? Model.CurrentTrainer.Specialization ?? "Coach")
                                        </span>
                                        <span>&bull; Gender: <strong>@Model.CurrentTrainer.Gender</strong></span>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="text-muted small">
                                <i class="bi bi-exclamation-circle text-warning me-1"></i> You currently do not have an assigned coach.
                            </div>
                        }
                    </div>

                    <!-- IF PENDING REQUEST EXISTS: SHOW LOCK NOTICE -->
                    @if (Model.HasPendingRequest)
                    {
                        <div class="alert alert-warning border-0 rounded-4 p-4 shadow-sm">
                            <div class="d-flex gap-3">
                                <div class="rounded-circle bg-warning bg-opacity-25 text-warning p-2 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 42px; height: 42px;">
                                    <i class="bi bi-hourglass-split fs-5"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold text-dark mb-1">Request Under Review</h6>
                                    <p class="small text-muted mb-2">
                                        You already submitted a trainer-change request on <strong>@Model.PendingRequest.RequestedAt.ToString("MMM dd, yyyy")</strong>.
                                    </p>
                                    <div class="p-2 rounded-3 bg-white border border-warning border-opacity-25 x-small text-dark mb-3">
                                        <strong>Reason Category:</strong> @Model.PendingRequest.ReasonCategory<br />
                                        <strong>Details:</strong> @Model.PendingRequest.ReasonDetails
                                    </div>
                                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill x-small fw-semibold">
                                        <i class="bi bi-shield-lock-fill me-1"></i> Pending Administrator Decision
                                    </span>
                                </div>
                            </div>
                        </div>
                    }
                    else if (Model.CurrentTrainer == null)
                    {
                        <div class="alert alert-secondary border-0 rounded-4 p-3 small text-muted">
                            You must have an assigned personal trainer before submitting a coach change request.
                        </div>
                    }
                    else
                    {
                        <!-- SUBMISSION FORM -->
                        using (Html.BeginForm("Submit", "TrainerChange", new { area = "Client" }, FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()

                            <!-- 1. Reason Category -->
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-secondary">Reason Category <span class="text-danger">*</span></label>
                                @Html.DropDownListFor(m => m.Form.ReasonCategory, new List<SelectListItem>
                                {
                                    new SelectListItem { Text = "-- Select Reason Category --", Value = "" },
                                    new SelectListItem { Text = "Schedule & Time Availability Conflict", Value = "Schedule Conflict" },
                                    new SelectListItem { Text = "Fitness Goal & Specialization Mismatch", Value = "Goal Mismatch" },
                                    new SelectListItem { Text = "Communication & Feedback Style", Value = "Communication Style" },
                                    new SelectListItem { Text = "Preference for Different Workout Technique", Value = "Workout Technique" },
                                    new SelectListItem { Text = "Coach Gender Preference", Value = "Gender Preference" },
                                    new SelectListItem { Text = "Other Personal Reasons", Value = "Other" }
                                }, new { @class = "form-select", required = "required" })
                                @Html.ValidationMessageFor(m => m.Form.ReasonCategory, "", new { @class = "text-danger x-small" })
                            </div>

                            <!-- 2. Detailed Reason -->
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-secondary">Detailed Reason &amp; Expectations <span class="text-danger">*</span></label>
                                @Html.TextAreaFor(m => m.Form.ReasonDetails, new { @class = "form-control", rows = "4", placeholder = "Please describe why you are requesting a new trainer and what qualities or schedule you are looking for...", required = "required" })
                                <div class="form-text x-small text-muted">Min. 10 characters. Your reason will be reviewed privately by the Admin.</div>
                                @Html.ValidationMessageFor(m => m.Form.ReasonDetails, "", new { @class = "text-danger x-small" })
                            </div>

                            <!-- 3. Preferred Coach Gender -->
                            <div class="mb-4">
                                <label class="form-label small fw-semibold text-secondary">Preferred Coach Gender</label>
                                @Html.DropDownListFor(m => m.Form.PreferredGender, new List<SelectListItem>
                                {
                                    new SelectListItem { Text = "No Preference (Any Active Coach)", Value = "No Preference" },
                                    new SelectListItem { Text = "Male Coach", Value = "Male" },
                                    new SelectListItem { Text = "Female Coach", Value = "Female" }
                                }, new { @class = "form-select" })
                                @Html.ValidationMessageFor(m => m.Form.PreferredGender, "", new { @class = "text-danger x-small" })
                            </div>

                            <button type="submit" class="btn btn-primary w-100 py-2 rounded-pill fw-semibold shadow-sm d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-send-fill"></i>
                                <span>Submit Change Request</span>
                            </button>
                        }
                    }

                </div>
            </div>
        </div>

        <!-- ============================================================= -->
        <!-- RIGHT COLUMN: STATUS & REQUEST HISTORY TRACKER               -->
        <!-- ============================================================= -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 bg-white h-100">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-0 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-3 bg-info bg-opacity-10 text-info p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                            <i class="bi bi-clock-history fs-6"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold text-dark mb-0">Request Status &amp; History</h5>
                            <span class="x-small text-muted">Track decisions, administrator notes, and coach reassignments</span>
                        </div>
                    </div>
                    <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-1 x-small fw-semibold">
                        @Model.PastRequests.Count Total
                    </span>
                </div>

                <div class="card-body p-4">
                    @if (Model.PastRequests.Any())
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var req in Model.PastRequests)
                            {
                                string cardBorder = req.Status == "Pending" ? "border-warning border-opacity-50" : (req.Status == "Approved" ? "border-success border-opacity-50" : "border-danger border-opacity-50");
                                string badgeClass = req.Status == "Pending" ? "bg-warning text-dark" : (req.Status == "Approved" ? "bg-success text-white" : "bg-danger text-white");
                                string statusIcon = req.Status == "Pending" ? "bi-hourglass-split" : (req.Status == "Approved" ? "bi-check-circle-fill" : "bi-x-circle-fill");

                                string prevTrainerName = (!string.IsNullOrEmpty(req.CurrentTrainerId) && Model.TrainerNames.ContainsKey(req.CurrentTrainerId))
                                    ? Model.TrainerNames[req.CurrentTrainerId]
                                    : "Coach (" + req.CurrentTrainerId + ")";

                                string newTrainerName = (!string.IsNullOrEmpty(req.NewTrainerId) && Model.TrainerNames.ContainsKey(req.NewTrainerId))
                                    ? Model.TrainerNames[req.NewTrainerId]
                                    : (!string.IsNullOrEmpty(req.NewTrainerId) ? "Coach (" + req.NewTrainerId + ")" : "Pending");

                                <div class="card rounded-4 border @cardBorder shadow-sm overflow-hidden">
                                    <div class="card-body p-3">
                                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2 pb-2 border-bottom">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge @badgeClass rounded-pill px-3 py-1 x-small fw-semibold d-inline-flex align-items-center gap-1">
                                                    <i class="bi @statusIcon"></i> @req.Status
                                                </span>
                                                <span class="fw-bold small text-dark">@req.ReasonCategory</span>
                                            </div>
                                            <span class="x-small text-muted">
                                                <i class="bi bi-calendar3 me-1"></i>Requested: @req.RequestedAt.ToString("MMM dd, yyyy - hh:mm tt")
                                            </span>
                                        </div>

                                        <!-- Reason Details -->
                                        <div class="small text-secondary mb-3">
                                            <strong>Client Reason:</strong> @req.ReasonDetails
                                        </div>

                                        <!-- Trainer Details Transition -->
                                        <div class="row g-2 mb-2 x-small">
                                            <div class="col-sm-6">
                                                <div class="p-2 rounded-3 bg-light border">
                                                    <span class="text-muted d-block">Previous Trainer:</span>
                                                    <strong class="text-dark">@prevTrainerName</strong>
                                                </div>
                                            </div>
                                            <div class="col-sm-6">
                                                <div class="p-2 rounded-3 bg-light border">
                                                    <span class="text-muted d-block">Assigned Outcome:</span>
                                                    @if (req.Status == "Approved")
                                                    {
                                                        <strong class="text-success"><i class="bi bi-check-lg me-1"></i>@newTrainerName</strong>
                                                    }
                                                    else if (req.Status == "Rejected")
                                                    {
                                                        <strong class="text-danger"><i class="bi bi-x-lg me-1"></i>Remained with current coach</strong>
                                                    }
                                                    else
                                                    {
                                                        <strong class="text-warning"><i class="bi bi-clock me-1"></i>Under Evaluation</strong>
                                                    }
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Admin Feedback & Notes -->
                                        @if (!string.IsNullOrEmpty(req.AdminNotes) || req.ReviewedAt.HasValue)
                                        {
                                            <div class="p-3 rounded-3 mt-2 @(req.Status == "Approved" ? "bg-success-subtle text-success-emphasis border border-success-subtle" : "bg-danger-subtle text-danger-emphasis border border-danger-subtle") x-small">
                                                <div class="d-flex align-items-center justify-content-between mb-1">
                                                    <strong><i class="bi bi-shield-check me-1"></i>Administrator Response:</strong>
                                                    @if (req.ReviewedAt.HasValue)
                                                    {
                                                        <span class="text-muted">@req.ReviewedAt.Value.ToString("MMM dd, yyyy")</span>
                                                    }
                                                </div>
                                                <div>
                                                    @(string.IsNullOrEmpty(req.AdminNotes) ? (req.Status == "Approved" ? "Request approved by Administrator." : "Request rejected by Administrator.") : req.AdminNotes)
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <div class="rounded-circle bg-light text-muted d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                                <i class="bi bi-inbox fs-2"></i>
                            </div>
                            <h6 class="fw-bold text-dark mb-1">No Change Requests Submitted</h6>
                            <p class="text-muted small mb-0">
                                You haven't submitted any coach-change requests yet. If your schedule or training goals change, you can submit one using the form.
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>

</div>
