@model HealthTrack.Areas.Client.ViewModels.DietPlanDetailsViewModel
@{
    ViewBag.Title = "My Prescribed Diet Plan";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var client = Model.Client;
    var plan = Model.ActivePlan;
}

<div class="container-fluid py-4 px-4">

    <!-- Header Breadcrumb & Actions -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a href="@Url.Action("Index", "Diet", new { area = "Client" })" class="text-decoration-none text-muted small fw-medium">
                    <i class="bi bi-arrow-left me-1"></i> Back to Daily Hub
                </a>
                <span class="text-muted small">&bull;</span>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                    <i class="bi bi-shield-check me-1"></i> Verified Nutritional Routine
                </span>
            </div>
            <h2 class="fw-bold tracking-tight text-dark mb-1">
                @(plan != null ? plan.Title : "Prescribed Diet Plan")
            </h2>
            <p class="text-muted mb-0" style="font-size: 0.95rem;">
                Crafted by <strong class="text-dark">@(!string.IsNullOrWhiteSpace(client.TrainerName) ? client.TrainerName : "Assigned Coach")</strong> &bull;
                Active from <span class="fw-semibold text-dark">@(plan != null ? plan.StartDate.ToString("MMM d, yyyy") : "Current")</span>
                to <span class="fw-semibold text-dark">@(plan != null ? plan.EndDate.ToString("MMM d, yyyy") : "Ongoing")</span>
                @(plan != null ? "(" + plan.DurationWeeks + " Weeks Total)" : "")
            </p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <a href="@Url.Action("Index", "Diet", new { area = "Client" })" class="btn btn-outline-secondary px-3 py-2 rounded-3 shadow-sm">
                <i class="bi bi-speedometer2 me-1"></i> Today's Tracker
            </a>
            <a href="@Url.Action("Calendar", "Diet", new { area = "Client" })" class="btn btn-outline-primary px-3 py-2 rounded-3 shadow-sm">
                <i class="bi bi-calendar3 me-1"></i> Meal Calendar
            </a>
            <a href="javascript:window.print();" class="btn btn-light border px-3 py-2 rounded-3 shadow-sm">
                <i class="bi bi-printer me-1"></i> Print Plan
            </a>
        </div>
    </div>

    @if (plan == null)
    {
        <div class="alert alert-warning rounded-4 p-4 shadow-sm">
            <h5 class="fw-bold"><i class="bi bi-info-circle me-2"></i>No Active Diet Plan Assigned</h5>
            <p class="mb-0 text-muted">Your coach has not assigned a diet plan yet. You can still log custom meals on the daily tracker.</p>
        </div>
    }


    @if (plan != null)
    {
        int planTotalKcal = (plan.TargetProteinGrams * 4)
                          + (plan.TargetCarbsGrams * 4)
                          + (plan.TargetFatsGrams * 9);

        int planPPct = planTotalKcal > 0
            ? (int)Math.Round((plan.TargetProteinGrams * 4.0 / planTotalKcal) * 100)
            : 0;

        int planCPct = planTotalKcal > 0
            ? (int)Math.Round((plan.TargetCarbsGrams * 4.0 / planTotalKcal) * 100)
            : 0;

        int planFPct = planTotalKcal > 0
            ? Math.Max(0, 100 - planPPct - planCPct)
            : 0;
    
    <!-- 1. PLAN STATS & MACRO SPLIT KPI ROW -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: #ffffff;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-uppercase tracking-wider fw-bold text-white-50" style="font-size: 0.75rem;">Daily Energy Goal</span>
                    <div class="rounded-circle bg-warning bg-opacity-20 text-warning p-2 d-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                        <i class="bi bi-fire fs-5"></i>
                    </div>
                </div>
                <h2 class="display-6 fw-extrabold text-white mb-0">@plan.DailyCalorieTarget.ToString("N0") <span class="fs-6 text-white-50 fw-normal">kcal / day</span></h2>
                <div class="text-white-50 small mt-2">
                    Goal: <span class="text-warning fw-semibold">@plan.DietaryPreference</span>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-uppercase tracking-wider fw-bold text-muted" style="font-size: 0.75rem;">Daily Protein</span>
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-2 d-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                        <i class="bi bi-pie-chart-fill fs-5"></i>
                    </div>
                </div>
                <h2 class="display-6 fw-extrabold text-primary mb-0">@plan.TargetProteinGrams <span class="fs-6 text-muted fw-normal">g / day</span></h2>
                <div class="text-muted small mt-2">
                    Muscle retention &amp; recovery (@(planPPct)%)
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-uppercase tracking-wider fw-bold text-muted" style="font-size: 0.75rem;">Carbohydrates</span>
                    <div class="rounded-circle bg-info bg-opacity-10 text-info p-2 d-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                        <i class="bi bi-lightning-charge-fill fs-5"></i>
                    </div>
                </div>
                <h2 class="display-6 fw-extrabold text-info mb-0">@plan.TargetCarbsGrams <span class="fs-6 text-muted fw-normal">g / day</span></h2>
                <div class="text-muted small mt-2">
                    Training energy fuel (@(planCPct)%)
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-uppercase tracking-wider fw-bold text-muted" style="font-size: 0.75rem;">Fats &amp; Hydration</span>
                    <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-2 d-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                        <i class="bi bi-droplet-fill fs-5"></i>
                    </div>
                </div>
                <h2 class="display-6 fw-extrabold text-warning mb-0">@plan.TargetFatsGrams <span class="fs-6 text-muted fw-normal">g</span> &bull; @(plan.WaterIntakeLiters.HasValue ? plan.WaterIntakeLiters.Value.ToString("0.0") : "0.0") <span class="fs-6 text-muted fw-normal">L</span></h2>
                <div class="text-muted small mt-2">
                    Hormonal balance (@(planFPct)%) &amp; daily hydration
                </div>
            </div>
        </div>
    </div>

    <!-- 2. COACH GUIDANCE, ALLERGIES & RESTRICTIONS PROTOCOL -->
    <div class="row g-3 mb-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-4 bg-white">
                <h6 class="fw-bold text-dark mb-2">
                    <i class="bi bi-chat-square-quote-fill text-success me-2"></i>Coach Strategy &amp; Dietary Guidelines
                </h6>
                <p class="text-dark mb-3" style="font-size: 0.95rem; line-height: 1.6;">
                    @(string.IsNullOrWhiteSpace(plan.Description) ? "Personalized dietary plan prescribed by coach." : plan.Description)
                </p>

                @if (!string.IsNullOrWhiteSpace(plan.SpecialInstructions))
                {
                    <div class="p-3 rounded-3 bg-success-subtle border border-success-subtle">
                        <div class="fw-bold text-success mb-1" style="font-size: 0.9rem;">
                            <i class="bi bi-info-circle-fill me-1"></i> Special Preparation &amp; Timing Rules:
                        </div>
                        <div class="text-dark small" style="line-height: 1.5;">@plan.SpecialInstructions</div>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-4 bg-white">
                <h6 class="fw-bold text-dark mb-3">
                    <i class="bi bi-shield-slash text-danger me-2"></i>Allergies &amp; Avoidances
                </h6>
                <div class="mb-3">
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 fs-6 fw-medium d-inline-block">
                        <i class="bi bi-exclamation-octagon-fill me-1"></i> @client.Allergies
                    </span>
                </div>
                <div class="small text-muted">
                    <strong>Prescribed Style:</strong> @client.DietaryRestrictions
                </div>
                <div class="small text-muted mt-1">
                    <strong>Hydration Goal:</strong> Drink at least 8-12 glasses (250ml) spaced throughout waking hours.
                </div>
            </div>
        </div>
    </div>

    <!-- 3. PRESCRIBED MEALS SCHEDULE -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white border-0 py-3 px-4 d-flex align-items-center justify-content-between">
            <div>
                <h5 class="fw-bold text-dark mb-0">
                    <i class="bi bi-grid-3x3-gap-fill text-primary me-2"></i>Prescribed Meals &amp; Recipes Blueprint
                </h5>
                <small class="text-muted">Exact meal formulations, ingredients, portion sizing, and preparation instructions</small>
            </div>
            <span class="badge bg-primary px-3 py-2 rounded-pill">
                @Model.AllMeals.Count Total Prescribed Meals
            </span>
        </div>

        <div class="card-body p-4 pt-1">
            @if (Model.AllMeals != null && Model.AllMeals.Any())
            {
                <div class="row g-4">
                    @foreach (var meal in Model.AllMeals)
                    {
                        var mealTypeColor = "primary";
                        var mealIcon = "bi-egg-fried";
                        if (meal.MealType.Equals("Lunch", StringComparison.OrdinalIgnoreCase)) { mealTypeColor = "success"; mealIcon = "bi-cup-hot-fill"; }
                        else if (meal.MealType.Equals("Dinner", StringComparison.OrdinalIgnoreCase)) { mealTypeColor = "info"; mealIcon = "bi-moon-stars-fill"; }
                        else if (meal.MealType.Equals("Snack", StringComparison.OrdinalIgnoreCase)) { mealTypeColor = "warning"; mealIcon = "bi-apple"; }

                        <div class="col-xl-6 col-lg-12">
                            <div class="card border border-light-subtle rounded-3 h-100 shadow-sm bg-white overflow-hidden">
                                @if (!string.IsNullOrWhiteSpace(meal.ImagePath))
                                {
                                    <div class="position-relative" style="height: 190px; overflow: hidden; background-color: #f8fafc;">
                                        <img src="@Url.Content(meal.ImagePath)" alt="@meal.MealName" class="w-100 h-100" style="object-fit: cover;" onerror="this.onerror=null; this.src='@Url.Content("~/Content/images/meals/placeholder-meal.png")';" />
                                        <div class="position-absolute top-0 start-0 m-3 d-flex align-items-center gap-2">
                                            <span class="badge bg-@mealTypeColor text-white px-3 py-2 shadow-sm">
                                                <i class="bi @mealIcon me-1"></i> @meal.MealType
                                            </span>
                                            <span class="badge bg-dark bg-opacity-75 text-white px-3 py-2 shadow-sm">
                                                <i class="bi bi-clock me-1"></i> @meal.ScheduledTime
                                            </span>
                                        </div>
                                        <div class="position-absolute bottom-0 end-0 m-3">
                                            <span class="badge bg-warning text-dark fw-bold px-3 py-2 shadow-sm">
                                                <i class="bi bi-fire text-danger me-1"></i>@meal.Calories kcal
                                            </span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="card-header bg-light border-bottom-0 py-3 px-4 d-flex align-items-center justify-content-between">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge bg-@mealTypeColor text-white px-2 py-1">
                                                <i class="bi @mealIcon me-1"></i> @meal.MealType
                                            </span>
                                            <span class="text-dark small fw-bold">
                                                <i class="bi bi-clock me-1 text-muted"></i> @meal.ScheduledTime
                                            </span>
                                        </div>
                                        <span class="badge bg-warning-subtle text-dark border border-warning-subtle fw-bold">
                                            <i class="bi bi-fire text-danger me-1"></i>@meal.Calories kcal
                                        </span>
                                    </div>
                                }

                                <div class="card-body p-4">
                                    <h5 class="fw-bold text-dark mb-2">@meal.MealName</h5>

                                    <!-- Macros pill row -->
                                    <div class="d-flex flex-wrap gap-2 mb-3">
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                            @meal.ProteinGrams g Protein
                                        </span>
                                        <span class="badge bg-info-subtle text-info border border-info-subtle">
                                            @meal.CarbsGrams g Carbs
                                        </span>
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                            @meal.FatsGrams g Fats
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(meal.ServingSize))
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                                Portion: @meal.ServingSize
                                            </span>
                                        }
                                    </div>

                                    <!-- Ingredients & Portion Box -->
                                    <div class="p-3 rounded-3 bg-light border border-light-subtle mb-3">
                                        <div class="text-uppercase text-muted x-small fw-bold mb-1">
                                            <i class="bi bi-card-checklist me-1 text-primary"></i> Ingredients &amp; Formulation:
                                        </div>
                                        <div class="text-dark" style="font-size: 0.94rem; line-height: 1.5;">
                                            @(string.IsNullOrWhiteSpace(meal.IngredientsAndPortion) ? "Follow standard portion sizes." : meal.IngredientsAndPortion)
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(meal.Instructions))
                                    {
                                        <div class="p-3 rounded-3 bg-white border border-light-subtle mb-3">
                                            <div class="text-uppercase text-muted x-small fw-bold mb-1">
                                                <i class="bi bi-gear-fill me-1 text-secondary"></i> Preparation Instructions:
                                            </div>
                                            <div class="text-dark small" style="line-height: 1.5;">
                                                @meal.Instructions
                                            </div>
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(meal.TrainerNotes))
                                    {
                                        <div class="p-2 px-3 rounded-2 bg-primary-subtle border border-primary-subtle" style="font-size: 0.88rem;">
                                            <i class="bi bi-chat-quote-fill text-primary me-1"></i>
                                            <strong class="text-primary">Coach Guidance:</strong> @meal.TrainerNotes
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    No meals cataloged for this plan.
                </div>
            }
        </div>
    </div>
    }

    <!-- 4. PAST ASSIGNED PLANS ARCHIVE (IF ANY) -->
    @if (Model.PastPlans != null && Model.PastPlans.Count > 1)
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-0 py-3 px-4">
                <h6 class="fw-bold text-dark mb-0">
                    <i class="bi bi-archive text-secondary me-2"></i>Diet Plan History &amp; Previous Cycles
                </h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted x-small text-uppercase">
                            <tr>
                                <th class="ps-4">Plan Title</th>
                                <th>Daily Target</th>
                                <th>Macro Split</th>
                                <th>Duration</th>
                                <th class="text-end pe-4">Status / Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var past in Model.PastPlans)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">@past.Title</div>
                                        <div class="text-muted small">@past.DietaryPreference</div>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-warning">@past.DailyCalorieTarget kcal</span>
                                    </td>
                                    <td>
                                        <div class="small text-muted">
                                            P: @past.TargetProteinGrams g &bull; C: @past.TargetCarbsGrams g &bull; F: @past.TargetFatsGrams g
                                        </div>
                                    </td>
                                    <td>
                                        <span class="small text-muted">@past.StartDate.ToString("MMM yyyy") - @past.EndDate.ToString("MMM yyyy") (@past.DurationWeeks wks)</span>
                                    </td>
                                    <td class="text-end pe-4">
                                        @if (past.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Active</span>
                                        }
                                        else
                                        {
                                            <a href="@Url.Action("Plan", "Diet", new { area = "Client", id = past.DietPlanId })" class="btn btn-outline-secondary btn-sm rounded-2">
                                                View Blueprint
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
