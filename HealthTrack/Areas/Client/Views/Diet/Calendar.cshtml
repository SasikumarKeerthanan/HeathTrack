@model HealthTrack.Areas.Client.ViewModels.DietCalendarViewModel
@{
    ViewBag.Title = "Meal Calendar & History";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var client = Model.Client;
    var plan = Model.ActivePlan;
    var activeTab = (ViewBag.ActiveTab as string) ?? "calendar";
}

<div class="container-fluid py-4 px-4">

    <!-- Header Breadcrumbs & Controls -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a href="@Url.Action("Index", "Diet", new { area = "Client" })" class="text-decoration-none text-muted small fw-medium">
                    <i class="bi bi-arrow-left me-1"></i> Back to Daily Hub
                </a>
                <span class="text-muted small">&bull;</span>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                    <i class="bi bi-calendar3 me-1"></i> Nutrition Tracking &amp; Logs
                </span>
            </div>
            <h2 class="fw-bold tracking-tight text-dark mb-1">
                Diet Calendar &amp; Meal History
            </h2>
            <p class="text-muted mb-0" style="font-size: 0.95rem;">
                Review your daily nutrition consistency, adherence records, and full archive of logged meals and personal notes.
            </p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <a href="@Url.Action("Index", "Diet", new { area = "Client" })" class="btn btn-outline-secondary px-3 py-2 rounded-3 shadow-sm">
                <i class="bi bi-speedometer2 me-1"></i> Today's Hub
            </a>
            <button type="button" class="btn btn-success px-3 py-2 rounded-3 shadow-sm d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#recordMealQuickModal">
                <i class="bi bi-plus-circle-fill fs-6"></i>
                <span class="fw-semibold">Record Meal &amp; Notes</span>
            </button>
        </div>
    </div>

    <!-- 1. MONTHLY NUTRITION KPI CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-uppercase tracking-wider fw-bold text-muted" style="font-size: 0.75rem;">Adherence Rate</span>
                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-2 d-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                        <i class="bi bi-award-fill fs-5"></i>
                    </div>
                </div>
                <h2 class="display-6 fw-extrabold text-success mb-0">@Model.AdherenceRatePercent%</h2>
                <div class="text-muted small mt-2">
                    <i class="bi bi-check2-circle text-success me-1"></i> Consistent plan compliance
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-uppercase tracking-wider fw-bold text-muted" style="font-size: 0.75rem;">Days On Target</span>
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-2 d-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                        <i class="bi bi-calendar-check-fill fs-5"></i>
                    </div>
                </div>
                <h2 class="display-6 fw-extrabold text-primary mb-0">@Model.DaysOnTarget <span class="fs-6 text-muted fw-normal">days</span></h2>
                <div class="text-muted small mt-2">
                    Within target calorie range
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-uppercase tracking-wider fw-bold text-muted" style="font-size: 0.75rem;">Average Intake</span>
                    <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-2 d-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                        <i class="bi bi-fire fs-5"></i>
                    </div>
                </div>
                <h2 class="display-6 fw-extrabold text-warning mb-0">@Model.AvgDailyCalories.ToString("N0") <span class="fs-6 text-muted fw-normal">kcal / day</span></h2>
                <div class="text-muted small mt-2">
                    Target: @(plan != null ? plan.DailyCalorieTarget.ToString("N0") : "1,750") kcal
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-uppercase tracking-wider fw-bold text-muted" style="font-size: 0.75rem;">Total Logged Meals</span>
                    <div class="rounded-circle bg-info bg-opacity-10 text-info p-2 d-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                        <i class="bi bi-journal-check fs-5"></i>
                    </div>
                </div>
                <h2 class="display-6 fw-extrabold text-info mb-0">@Model.HistoryLogs.Count</h2>
                <div class="text-muted small mt-2">
                    Total recorded entries &amp; snacks
                </div>
            </div>
        </div>
    </div>

    <!-- 2. NAV TABS: CALENDAR VIEW VS MEAL HISTORY -->
    <ul class="nav nav-pills mb-4 gap-2 bg-white p-2 rounded-3 shadow-sm border border-light-subtle d-inline-flex" id="dietTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(activeTab == "calendar" ? "active" : "") fw-bold d-flex align-items-center gap-2 px-4 py-2 rounded-2" id="calendar-tab" data-bs-toggle="pill" data-bs-target="#calendar-view" type="button" role="tab" aria-controls="calendar-view" aria-selected="@(activeTab == "calendar" ? "true" : "false")">
                <i class="bi bi-calendar3"></i> Monthly Meal Calendar
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(activeTab == "history" ? "active" : "") fw-bold d-flex align-items-center gap-2 px-4 py-2 rounded-2" id="history-tab" data-bs-toggle="pill" data-bs-target="#history-view" type="button" role="tab" aria-controls="history-view" aria-selected="@(activeTab == "history" ? "true" : "false")">
                <i class="bi bi-clock-history"></i> Meal History &amp; Reflections (@Model.HistoryLogs.Count)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="dietTabsContent">

        <!-- =========================================================================
             TAB 1: MONTHLY MEAL CALENDAR
             ========================================================================= -->
        <div class="tab-pane fade @(activeTab == "calendar" ? "show active" : "")" id="calendar-view" role="tabpanel" aria-labelledby="calendar-tab">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <!-- Month Navigation Header -->
                <div class="card-header bg-white border-0 py-3 px-4 d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div class="d-flex align-items-center gap-3">
                        <h4 class="fw-bold text-dark mb-0">@Model.MonthName</h4>
                        <div class="btn-group btn-group-sm">
                            <a href="@Url.Action("Calendar", "Diet", new { area = "Client", month = Model.CurrentMonth - 1, year = Model.CurrentYear })" class="btn btn-outline-secondary px-3">
                                <i class="bi bi-chevron-left"></i> Previous
                            </a>
                            <a href="@Url.Action("Calendar", "Diet", new { area = "Client" })" class="btn btn-outline-secondary px-3">
                                Today
                            </a>
                            <a href="@Url.Action("Calendar", "Diet", new { area = "Client", month = Model.CurrentMonth + 1, year = Model.CurrentYear })" class="btn btn-outline-secondary px-3">
                                Next <i class="bi bi-chevron-right"></i>
                            </a>
                        </div>
                    </div>

                    <!-- Legend -->
                    <div class="d-flex flex-wrap align-items-center gap-3 small">
                        <span class="d-flex align-items-center gap-1">
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                <i class="bi bi-check-circle-fill me-1"></i> Target Met
                            </span>
                        </span>
                        <span class="d-flex align-items-center gap-1">
                            <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">
                                <i class="bi bi-arrow-down-circle-fill me-1"></i> Calorie Deficit
                            </span>
                        </span>
                        <span class="d-flex align-items-center gap-1">
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                                <i class="bi bi-arrow-up-circle-fill me-1"></i> Calorie Surplus
                            </span>
                        </span>
                        <span class="d-flex align-items-center gap-1">
                            <span class="badge bg-primary text-white px-2 py-1">
                                Today
                            </span>
                        </span>
                    </div>
                </div>

                <!-- Calendar Grid Table -->
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-bordered mb-0 calendar-grid-table" style="table-layout: fixed;">
                            <thead class="table-light text-center">
                                <tr>
                                    <th class="py-2 text-uppercase text-muted x-small fw-bold">Mon</th>
                                    <th class="py-2 text-uppercase text-muted x-small fw-bold">Tue</th>
                                    <th class="py-2 text-uppercase text-muted x-small fw-bold">Wed</th>
                                    <th class="py-2 text-uppercase text-muted x-small fw-bold">Thu</th>
                                    <th class="py-2 text-uppercase text-muted x-small fw-bold">Fri</th>
                                    <th class="py-2 text-uppercase text-muted x-small fw-bold">Sat</th>
                                    <th class="py-2 text-uppercase text-muted x-small fw-bold">Sun</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int cellIndex = 0;
                                    int totalDays = Model.DaysInMonth.Count;
                                }
                                @while (cellIndex < totalDays)
                                {
                                    <tr>
                                        @for (int col = 0; col < 7 && cellIndex < totalDays; col++, cellIndex++)
                                        {
                                            var day = Model.DaysInMonth[cellIndex];
                                            var cellBg = day.IsCurrentMonth ? (day.IsToday ? "bg-primary-subtle bg-opacity-25" : "bg-white") : "bg-light bg-opacity-50 text-muted";

                                            <td class="p-2 calendar-day-cell @cellBg" style="height: 120px; vertical-align: top; cursor: pointer;" onclick="showDayDetailsModal('@day.Date.ToString("yyyy-MM-dd")', '@day.Date.ToString("dddd, MMMM d, yyyy")', @day.TotalCaloriesConsumed, @day.MealsLoggedCount)">
                                                <div class="d-flex align-items-center justify-content-between mb-1">
                                                    <span class="fw-bold @(day.IsToday ? "badge bg-primary text-white rounded-circle p-1" : (day.IsCurrentMonth ? "text-dark" : "text-muted"))" style="width: 24px; height: 24px; text-align: center; display: inline-block;">
                                                        @day.DayNumber
                                                    </span>

                                                    @if (day.HasLogs)
                                                    {
                                                        <span class="badge bg-@day.StatusClass" style="font-size: 0.65rem;">
                                                            @day.TotalCaloriesConsumed kcal
                                                        </span>
                                                    }
                                                </div>

                                                @if (day.HasLogs)
                                                {
                                                    <div class="d-flex flex-column gap-1 mt-1">
                                                        <div class="small fw-semibold text-dark text-truncate">
                                                            <i class="bi bi-egg-fried text-success me-1"></i>@day.MealsLoggedCount meal(s) logged
                                                        </div>
                                                        @foreach (var mealLog in day.LoggedMeals.Take(2))
                                                        {
                                                            <div class="x-small text-muted text-truncate">
                                                                &bull; @mealLog.MealType: @mealLog.MealName
                                                            </div>
                                                        }
                                                        @if (day.LoggedMeals.Count > 2)
                                                        {
                                                            <div class="x-small text-primary fw-medium">
                                                                +@(day.LoggedMeals.Count - 2) more...
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                                else if (day.IsCurrentMonth && day.IsPast)
                                                {
                                                    <div class="mt-2 text-muted x-small italic text-center">
                                                        No log recorded
                                                    </div>
                                                }
                                                else if (day.IsToday)
                                                {
                                                    <div class="mt-2 text-primary fw-semibold x-small text-center">
                                                        <i class="bi bi-plus-circle me-1"></i> Log Today's Meals
                                                    </div>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- =========================================================================
             TAB 2: COMPREHENSIVE MEAL HISTORY & NOTES LOG
             ========================================================================= -->
        <div class="tab-pane fade @(activeTab == "history" ? "show active" : "")" id="history-view" role="tabpanel" aria-labelledby="history-tab">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <!-- Filter & Search Toolbar (FR-C-62) -->
                <div class="card-header bg-white border-0 py-3 px-4">
                    @using (Html.BeginForm("Calendar", "Diet", new { area = "Client" }, FormMethod.Get, new { @class = "row g-2 align-items-end" }))
                    {
                        <input type="hidden" name="tab" value="history" />

                        <div class="col-lg-3 col-md-6">
                            <label class="form-label x-small text-muted fw-bold text-uppercase mb-1">Search</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                                <input type="text" name="search" class="form-control bg-light border-start-0" placeholder="Meal name, notes, feedback..." value="@Model.SearchTerm" />
                            </div>
                        </div>

                        <div class="col-lg-2 col-md-3 col-6">
                            <label class="form-label x-small text-muted fw-bold text-uppercase mb-1">From Date</label>
                            <input type="date" name="fromDate" class="form-control form-control-sm bg-light" 
                                   value="@(Model.FromDate.HasValue ? Model.FromDate.Value.ToString("yyyy-MM-dd") : "")" />
                        </div>

                        <div class="col-lg-2 col-md-3 col-6">
                            <label class="form-label x-small text-muted fw-bold text-uppercase mb-1">To Date</label>
                            <input type="date" name="toDate" class="form-control form-control-sm bg-light" 
                                   value="@(Model.ToDate.HasValue ? Model.ToDate.Value.ToString("yyyy-MM-dd") : "")" />
                        </div>

                        <div class="col-lg-2 col-md-4">
                            <label class="form-label x-small text-muted fw-bold text-uppercase mb-1">Category</label>
                            <select name="mealType" class="form-select form-select-sm bg-light">
                                <option value="all" @(string.IsNullOrWhiteSpace(Model.FilterMealType) || Model.FilterMealType.Equals("all", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>All Categories</option>
                                <option value="Breakfast" @(Model.FilterMealType == "Breakfast" ? "selected" : "")>Breakfast</option>
                                <option value="Lunch" @(Model.FilterMealType == "Lunch" ? "selected" : "")>Lunch</option>
                                <option value="Dinner" @(Model.FilterMealType == "Dinner" ? "selected" : "")>Dinner</option>
                                <option value="Snack" @(Model.FilterMealType == "Snack" ? "selected" : "")>Snack / Fuel</option>
                                <option value="Hydration" @(Model.FilterMealType == "Hydration" ? "selected" : "")>Hydration</option>
                            </select>
                        </div>

                        <div class="col-lg-2 col-md-4">
                            <label class="form-label x-small text-muted fw-bold text-uppercase mb-1">Status</label>
                            <select name="status" class="form-select form-select-sm bg-light">
                                <option value="all" @(string.IsNullOrWhiteSpace(Model.FilterStatus) || Model.FilterStatus.Equals("all", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>All Statuses</option>
                                <option value="completed" @(Model.FilterStatus == "completed" ? "selected" : "")>Completed / Logged</option>
                                <option value="incomplete" @(Model.FilterStatus == "incomplete" || Model.FilterStatus == "partial" ? "selected" : "")>Incomplete / Planned</option>
                            </select>
                        </div>

                        <div class="col-lg-1 col-md-4 d-flex gap-1">
                            <button type="submit" class="btn btn-sm btn-primary w-100 shadow-sm" title="Apply Filters">
                                <i class="bi bi-funnel"></i>
                            </button>
                            @if (Model.HasActiveHistoryFilter)
                            {
                                <a href="@Url.Action("History", "Diet", new { area = "Client" })" class="btn btn-sm btn-outline-secondary" title="Reset / Clear Filters">
                                    <i class="bi bi-x-lg"></i>
                                </a>
                            }
                        </div>
                    }
                </div>

                <!-- History Table -->
                <div class="card-body p-0">
                    @if (Model.HistoryLogs != null && Model.HistoryLogs.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light text-muted x-small text-uppercase">
                                    <tr>
                                        <th class="ps-4">Logged Date &amp; Time</th>
                                        <th>Category</th>
                                        <th>Meal Name &amp; Serving</th>
                                        <th>Calories</th>
                                        <th>Macros (P / C / F)</th>
                                        <th>Personal Reflection / Coach Feedback</th>
                                        <th class="text-end pe-4">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in Model.HistoryLogs)
                                    {
                                        var mealTypeColor = "primary";
                                        var mealIcon = "bi-egg-fried";
                                        if (log.MealType.Equals("Lunch", StringComparison.OrdinalIgnoreCase)) { mealTypeColor = "success"; mealIcon = "bi-cup-hot-fill"; }
                                        else if (log.MealType.Equals("Dinner", StringComparison.OrdinalIgnoreCase)) { mealTypeColor = "info"; mealIcon = "bi-moon-stars-fill"; }
                                        else if (log.MealType.Equals("Snack", StringComparison.OrdinalIgnoreCase)) { mealTypeColor = "warning"; mealIcon = "bi-apple"; }
                                        else if (log.MealType.Equals("Hydration", StringComparison.OrdinalIgnoreCase)) { mealTypeColor = "primary"; mealIcon = "bi-droplet-fill"; }

                                        <tr>
                                            <td class="ps-4">
                                                <div class="fw-bold text-dark" style="font-size: 0.92rem;">@log.LogDate.ToString("MMM d, yyyy")</div>
                                                <div class="text-muted small">@log.LogDate.ToString("hh:mm tt")</div>
                                            </td>
                                            <td>
                                                <span class="badge bg-@mealTypeColor text-white px-2 py-1" style="font-size: 0.75rem;">
                                                    <i class="bi @mealIcon me-1"></i> @log.MealType
                                                </span>
                                            </td>
                                            <td>
                                                <div class="fw-bold text-dark" style="font-size: 0.95rem;">@log.MealName</div>
                                                @if (!string.IsNullOrWhiteSpace(log.PortionSize))
                                                {
                                                    <div class="text-muted small">Portion: @log.PortionSize</div>
                                                }
                                            </td>
                                            <td>
                                                <span class="fw-extrabold text-warning fs-6">@log.Calories</span> <small class="text-muted">kcal</small>
                                            </td>
                                            <td>
                                                <div class="d-flex gap-2 small">
                                                    <span class="text-primary fw-bold">@log.ProteinGrams g P</span>
                                                    <span class="text-muted">&bull;</span>
                                                    <span class="text-info fw-bold">@log.CarbsGrams g C</span>
                                                    <span class="text-muted">&bull;</span>
                                                    <span class="text-warning fw-bold">@log.FatsGrams g F</span>
                                                </div>
                                            </td>
                                            <td style="max-width: 320px;">
                                                @if (!string.IsNullOrWhiteSpace(log.ClientNotes))
                                                {
                                                    <div class="p-2 rounded-2 bg-light border border-light-subtle small mb-1 text-dark" style="line-height: 1.4;">
                                                        <i class="bi bi-pencil text-secondary me-1"></i><strong>Note:</strong> @log.ClientNotes
                                                    </div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(log.CoachFeedback))
                                                {
                                                    <div class="p-2 rounded-2 bg-success-subtle border border-success-subtle small text-success" style="line-height: 1.4;">
                                                        <i class="bi bi-award-fill text-success me-1"></i><strong>Coach:</strong> @log.CoachFeedback
                                                    </div>
                                                }
                                                @if (string.IsNullOrWhiteSpace(log.ClientNotes) && string.IsNullOrWhiteSpace(log.CoachFeedback))
                                                {
                                                    <span class="text-muted small italic">Standard consumed meal</span>
                                                }
                                            </td>
                                            <td class="text-end pe-4">
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                    <i class="bi bi-check-circle-fill me-1"></i> Verified
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-journal-x fs-1 d-block mb-2 text-muted"></i>
                            <h6 class="fw-bold text-dark">No Meal Records Found</h6>
                            <p class="small text-muted">
                                @(Model.HasActiveHistoryFilter ? "No meal entries match the selected date, category, or status filters." : "You have not recorded any meals yet.")
                            </p>
                            @if (Model.HasActiveHistoryFilter)
                            {
                                <a href="@Url.Action("History", "Diet", new { area = "Client" })" class="btn btn-sm btn-outline-primary px-3 rounded-pill mt-2">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i> Clear Filters
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- =========================================================================
     MODAL: RECORD CONSUMED MEAL QUICK MODAL
     ========================================================================= -->
<div class="modal fade" id="recordMealQuickModal" tabindex="-1" aria-labelledby="recordMealQuickModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            @using (Html.BeginForm("LogMeal", "Diet", new { area = "Client" }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="ClientId" value="@client.ClientId" />
                <input type="hidden" name="DietPlanId" value="@(plan != null ? (object)plan.DietPlanId : "")" />

                <div class="modal-header bg-dark text-white border-0 py-3 px-4">
                    <h5 class="modal-title fw-bold d-flex align-items-center gap-2" id="recordMealQuickModalLabel">
                        <i class="bi bi-journal-plus text-success fs-5"></i>
                        <span>Record Consumed Meal &amp; Notes</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-4">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark small">Meal Category</label>
                            <select class="form-select rounded-3" name="MealType" required>
                                <option value="Breakfast">Breakfast</option>
                                <option value="Lunch">Lunch</option>
                                <option value="Dinner">Dinner</option>
                                <option value="Snack">Snack / Fuel</option>
                                <option value="Hydration">Hydration &amp; Shake</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark small">Consumed Date &amp; Time</label>
                            <input type="datetime-local" class="form-control rounded-3" name="LogDate" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark small">Meal Name / Description</label>
                        <input type="text" class="form-control rounded-3" name="MealName" placeholder="e.g. Chicken breast with brown rice &amp; broccoli" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark small">Serving Size</label>
                        <input type="text" class="form-control rounded-3" name="PortionSize" placeholder="e.g. 1 plate (350g)" />
                    </div>

                    <div class="p-3 bg-light rounded-3 border border-light-subtle mb-3">
                        <div class="text-uppercase text-muted x-small fw-bold mb-2">Nutritional Values</div>
                        <div class="row g-2">
                            <div class="col-3">
                                <label class="small text-muted mb-1">Calories</label>
                                <input type="number" class="form-control form-control-sm rounded-2 text-center fw-bold" name="Calories" value="450" min="0" required />
                            </div>
                            <div class="col-3">
                                <label class="small text-muted mb-1">Protein (g)</label>
                                <input type="number" class="form-control form-control-sm rounded-2 text-center" name="ProteinGrams" value="40" min="0" />
                            </div>
                            <div class="col-3">
                                <label class="small text-muted mb-1">Carbs (g)</label>
                                <input type="number" class="form-control form-control-sm rounded-2 text-center" name="CarbsGrams" value="45" min="0" />
                            </div>
                            <div class="col-3">
                                <label class="small text-muted mb-1">Fats (g)</label>
                                <input type="number" class="form-control form-control-sm rounded-2 text-center" name="FatsGrams" value="12" min="0" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-bold text-dark small">Personal Notes / Reflections</label>
                        <textarea class="form-control rounded-3" name="ClientNotes" rows="3" placeholder="How did this meal make you feel? Hunger levels, satiety, or energy notes..."></textarea>
                    </div>
                </div>

                <div class="modal-footer bg-light border-top-0 py-3 px-4">
                    <button type="button" class="btn btn-outline-secondary px-3 rounded-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success px-4 rounded-3 d-flex align-items-center gap-1 shadow-sm">
                        <i class="bi bi-check2-circle fs-6"></i> Save Meal Record
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<script>
    function showDayDetailsModal(dateStr, formattedDate, calories, mealCount) {
        if (mealCount > 0) {
            // Switch to History tab and filter or scroll
            var tabBtn = document.getElementById('history-tab');
            var tab = new bootstrap.Tab(tabBtn);
            tab.show();
        } else {
            // Pre-fill modal date and open
            var modalDateInput = document.querySelector('#recordMealQuickModal input[name="LogDate"]');
            if (modalDateInput) {
                modalDateInput.value = dateStr + 'T12:00';
            }
            var modal = new bootstrap.Modal(document.getElementById('recordMealQuickModal'));
            modal.show();
        }
    }
</script>
