@model HealthTrack.Areas.Client.ViewModels.DietHubViewModel
@{
    ViewBag.Title = "Nutrition & Meal Hub";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var client = Model.Client;
    var plan = Model.ActivePlan;
    var summary = Model.TodaySummary;
}

<div class="container-fluid py-4 px-4">

    <!-- Top Welcome & Nutrition Status Banner -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                    <i class="bi bi-check-circle-fill me-1"></i> Active Diet Plan
                </span>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                    <i class="bi bi-person-badge me-1"></i> Assigned by @(!string.IsNullOrWhiteSpace(client.TrainerName) ? client.TrainerName : "Assigned Coach")
                </span>
                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                    <i class="bi bi-calendar2-day me-1"></i> @Model.TodayDateFormatted
                </span>
            </div>
            <h2 class="fw-bold tracking-tight text-dark mb-1">
                Daily Nutrition Hub <span class="text-success"><i class="bi bi-egg-fried"></i></span>
            </h2>
            <p class="text-muted mb-0" style="font-size: 0.95rem;">
                Track today's prescribed meals, log custom food consumption, and keep your energy and macros perfectly balanced.
            </p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <a href="@Url.Action("Plan", "Diet", new { area = "Client" })" class="btn btn-outline-secondary d-flex align-items-center gap-2 px-3 py-2 shadow-sm rounded-3">
                <i class="bi bi-journal-text fs-6"></i>
                <span class="fw-semibold">Full Meal Blueprint</span>
            </a>
            <a href="@Url.Action("Calendar", "Diet", new { area = "Client" })" class="btn btn-outline-primary d-flex align-items-center gap-2 px-3 py-2 shadow-sm rounded-3">
                <i class="bi bi-calendar3 fs-6"></i>
                <span class="fw-semibold">Meal Calendar</span>
            </a>
            <button type="button" class="btn btn-success d-flex align-items-center gap-2 px-3 py-2 shadow-sm rounded-3" data-bs-toggle="modal" data-bs-target="#logMealModal">
                <i class="bi bi-plus-circle-fill fs-6"></i>
                <span class="fw-semibold">Record Meal &amp; Notes</span>
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5 text-success"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- 1. TODAY'S MACRO & HYDRATION DASHBOARD -->
    <div class="row g-3 mb-4">
        <!-- Daily Calorie Gauge Card -->
        <div class="col-xl-4 col-lg-5">
            <div class="card border-0 shadow-sm h-100 rounded-4 overflow-hidden" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: #ffffff;">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="text-uppercase tracking-wider fw-bold text-white-50" style="font-size: 0.78rem; letter-spacing: 0.8px;">
                                <i class="bi bi-fire text-warning me-1"></i> Today's Energy Budget
                            </span>
                            <span class="badge bg-warning text-dark fw-bold px-2 py-1" style="font-size: 0.75rem;">
                                @summary.ComplianceStatus
                            </span>
                        </div>

                        <div class="d-flex align-items-baseline gap-2 mb-1">
                            <h1 class="display-5 fw-extrabold mb-0 text-white" id="todayConsumedCalText">@summary.ConsumedCalories.ToString("N0")</h1>
                            <span class="text-white-50 fs-5">/ @summary.TargetCalories.ToString("N0") kcal</span>
                        </div>
                        <p class="text-white-50 small mb-3">
                            <i class="bi bi-arrow-right-short text-success"></i> <span id="todayRemainingCalText" class="fw-bold text-light">@summary.RemainingCalories.ToString("N0") kcal remaining</span> for today
                        </p>

                        <!-- Progress Bar -->
                        <div class="progress bg-white bg-opacity-10 mb-3" style="height: 10px; border-radius: 6px;">
                            <div class="progress-bar bg-warning progress-bar-striped progress-bar-animated" role="progressbar" 
                                 id="todayCalProgressBar"
                                 style="width: @summary.CalorieProgressPercent%; border-radius: 6px;" 
                                 aria-valuenow="@summary.CalorieProgressPercent" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>

                    <!-- Mini Split Footer -->
                    <div class="pt-3 border-top border-white border-opacity-10 d-flex justify-content-between align-items-center text-white-50 small">
                        <div>
                            <span class="text-light fw-bold">@summary.MealsConsumedCount</span> of @summary.TotalMealsScheduled meals logged
                        </div>
                        <div>
                            Plan: <span class="text-warning fw-semibold">@(plan != null ? plan.DietaryPreference : "No Active Plan")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Macronutrients Split Progress Cards -->
        <div class="col-xl-5 col-lg-7">
            <div class="card border-0 shadow-sm h-100 rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="fw-bold text-dark mb-0">
                            <i class="bi bi-pie-chart-fill text-primary me-2"></i>Macronutrient Targets
                        </h6>
                        <span class="text-muted small">Daily Target vs Logged</span>
                    </div>

                    <div class="d-flex flex-column gap-3">
                        <!-- Protein Bar -->
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold text-dark" style="font-size: 0.92rem;">
                                    <i class="bi bi-circle-fill text-primary me-1" style="font-size: 0.6rem;"></i> Protein (Target: @summary.TargetProtein g)
                                </span>
                                <span class="fw-bold text-primary" style="font-size: 0.92rem;" id="todayProteinText">
                                    @summary.ConsumedProtein g <span class="text-muted fw-normal">(@summary.ProteinPercent%)</span>
                                </span>
                            </div>
                            <div class="progress bg-light" style="height: 8px; border-radius: 4px;">
                                <div class="progress-bar bg-primary" role="progressbar" id="todayProteinBar" style="width: @summary.ProteinPercent%;" aria-valuenow="@summary.ProteinPercent" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>

                        <!-- Carbohydrates Bar -->
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold text-dark" style="font-size: 0.92rem;">
                                    <i class="bi bi-circle-fill text-info me-1" style="font-size: 0.6rem;"></i> Carbohydrates (Target: @summary.TargetCarbs g)
                                </span>
                                <span class="fw-bold text-info" style="font-size: 0.92rem;" id="todayCarbsText">
                                    @summary.ConsumedCarbs g <span class="text-muted fw-normal">(@summary.CarbsPercent%)</span>
                                </span>
                            </div>
                            <div class="progress bg-light" style="height: 8px; border-radius: 4px;">
                                <div class="progress-bar bg-info" role="progressbar" id="todayCarbsBar" style="width: @summary.CarbsPercent%;" aria-valuenow="@summary.CarbsPercent" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>

                        <!-- Healthy Fats Bar -->
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold text-dark" style="font-size: 0.92rem;">
                                    <i class="bi bi-circle-fill text-warning me-1" style="font-size: 0.6rem;"></i> Healthy Fats (Target: @summary.TargetFats g)
                                </span>
                                <span class="fw-bold text-warning" style="font-size: 0.92rem;" id="todayFatsText">
                                    @summary.ConsumedFats g <span class="text-muted fw-normal">(@summary.FatsPercent%)</span>
                                </span>
                            </div>
                            <div class="progress bg-light" style="height: 8px; border-radius: 4px;">
                                <div class="progress-bar bg-warning" role="progressbar" id="todayFatsBar" style="width: @summary.FatsPercent%;" aria-valuenow="@summary.FatsPercent" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                    </div>

                    @{
                        int totalMacroKcal = (summary.TargetProtein * 4) + (summary.TargetCarbs * 4) + (summary.TargetFats * 9);
                        int pPct = totalMacroKcal > 0 ? (int)Math.Round((summary.TargetProtein * 4.0 / totalMacroKcal) * 100) : 0;
                        int cPct = totalMacroKcal > 0 ? (int)Math.Round((summary.TargetCarbs * 4.0 / totalMacroKcal) * 100) : 0;
                        int fPct = totalMacroKcal > 0 ? Math.Max(0, 100 - pPct - cPct) : 0;
                    }
                    <!-- Macro ratios guideline box -->
                    <div class="p-2 px-3 mt-3 rounded-3 bg-light border border-light-subtle d-flex align-items-center justify-content-between">
                        <span class="small text-muted">
                            <i class="bi bi-info-circle me-1 text-primary"></i> Macro Distribution:
                        </span>
                        @if (totalMacroKcal > 0)
                        {
                            <div class="d-flex gap-3 small fw-semibold">
                                <span class="text-primary">@pPct% Protein</span>
                                <span class="text-info">@cPct% Carbs</span>
                                <span class="text-warning">@fPct% Fats</span>
                            </div>
                        }
                        else
                        {
                            <span class="small text-muted">Target macros not set</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Water & Hydration Card -->
        <div class="col-xl-3 col-lg-12">
            <div class="card border-0 shadow-sm h-100 rounded-4" style="background: linear-gradient(135deg, #e0f2fe 0%, #bae6fd 100%);">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-uppercase tracking-wider fw-bold text-primary" style="font-size: 0.78rem;">
                                <i class="bi bi-droplet-fill me-1"></i> Daily Hydration
                            </span>
                            <span class="badge bg-white text-primary shadow-sm">Target: @summary.TargetWaterLiters L</span>
                        </div>

                        <div class="d-flex align-items-baseline gap-1 my-2">
                            <h2 class="fw-extrabold text-dark mb-0" id="waterLitersText">@summary.ConsumedWaterLiters.ToString("0.0")</h2>
                            <span class="text-muted fw-bold">/ @summary.TargetWaterLiters.ToString("0.0") Liters</span>
                        </div>

                        <p class="text-secondary small mb-3">
                            <span id="waterGlassesCount" class="fw-bold text-primary">@summary.WaterGlasses</span> of @summary.TargetWaterGlasses glasses (~250ml each) logged today.
                        </p>
                    </div>

                    <div>
                        @if (summary.TargetWaterLiters > 0)
                        {
                            <button type="button" class="btn btn-primary w-100 py-2 d-flex align-items-center justify-content-center gap-2 rounded-3 shadow-sm" onclick="logWaterQuick(0.25)">
                                <i class="bi bi-cup-straw fs-5"></i>
                                <span class="fw-bold">+1 Glass Water (250 ml)</span>
                            </button>
                            <div class="text-center mt-2">
                                <small class="text-muted" style="font-size: 0.8rem;">Tap each time you finish a glass or bottle</small>
                            </div>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-secondary w-100 py-2 d-flex align-items-center justify-content-center gap-2 rounded-3 bg-white bg-opacity-75" disabled title="Trainer has not set a daily water target yet">
                                <i class="bi bi-lock-fill text-warning"></i>
                                <span class="fw-bold text-muted">Water Logging Locked</span>
                            </button>
                            <div class="text-center mt-2">
                                <small class="text-muted" style="font-size: 0.78rem;"><i class="bi bi-shield-lock me-1"></i>Trainer must set water target first</small>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. TODAY'S PRESCRIBED MEALS & LIVE LOGGING SECTION -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white border-0 py-3 px-4 d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div>
                <h5 class="fw-bold text-dark mb-0">
                    <i class="bi bi-clock-history text-success me-2"></i>Today's Prescribed Meals &amp; Check-Off
                </h5>
                <small class="text-muted">Review what your coach scheduled for today and mark meals as consumed or add personalized notes</small>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-light text-dark border px-3 py-2 fw-medium">
                    <i class="bi bi-check2-all text-success me-1"></i> <span id="completedMealsBadge">@summary.MealsConsumedCount of @summary.TotalMealsScheduled</span> Eaten
                </span>
            </div>
        </div>

        <div class="card-body p-4 pt-1">
            @if (Model.TodayMeals != null && Model.TodayMeals.Any())
            {
                <div class="row g-3">
                    @foreach (var meal in Model.TodayMeals)
                    {
                        var mealTypeColor = "primary";
                        var mealIcon = "bi-egg-fried";
                        if (meal.MealType.Equals("Lunch", StringComparison.OrdinalIgnoreCase)) { mealTypeColor = "success"; mealIcon = "bi-cup-hot-fill"; }
                        else if (meal.MealType.Equals("Dinner", StringComparison.OrdinalIgnoreCase)) { mealTypeColor = "info"; mealIcon = "bi-moon-stars-fill"; }
                        else if (meal.MealType.Equals("Snack", StringComparison.OrdinalIgnoreCase)) { mealTypeColor = "warning"; mealIcon = "bi-apple"; }

                        <div class="col-xl-6 col-lg-12">
                            <div class="card border border-light-subtle rounded-3 h-100 shadow-sm transition-all meal-card overflow-hidden @(meal.IsConsumedToday ? "bg-success-subtle bg-opacity-25 border-success" : "bg-white")" id="meal-card-@meal.DietMealId">
                                @if (!string.IsNullOrWhiteSpace(meal.ImagePath))
                                {
                                    <div class="position-relative" style="height: 160px; overflow: hidden; background-color: #f8fafc;">
                                        <img src="@Url.Content(meal.ImagePath)" alt="@meal.MealName" class="w-100 h-100" style="object-fit: cover;" onerror="this.onerror=null; this.src='@Url.Content("~/Content/images/meals/placeholder-meal.png")';" />
                                        <div class="position-absolute top-0 start-0 m-2 d-flex align-items-center gap-1">
                                            <span class="badge bg-@mealTypeColor text-white px-2 py-1 fw-semibold shadow-sm" style="font-size: 0.75rem;">
                                                <i class="bi @mealIcon me-1"></i> @meal.MealType
                                            </span>
                                            <span class="badge bg-dark bg-opacity-75 text-white px-2 py-1 shadow-sm" style="font-size: 0.75rem;">
                                                <i class="bi bi-clock me-1"></i> @meal.ScheduledTime
                                            </span>
                                        </div>
                                        <div class="position-absolute top-0 end-0 m-2" id="status-pill-@meal.DietMealId">
                                            @if (meal.IsConsumedToday)
                                            {
                                                <span class="badge bg-success text-white px-2 py-1 d-inline-flex align-items-center gap-1 shadow-sm">
                                                    <i class="bi bi-check-circle-fill"></i> Consumed @(meal.ConsumedTime != null ? "@ " + meal.ConsumedTime : "")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-white text-dark border px-2 py-1 shadow-sm">Scheduled</span>
                                            }
                                        </div>
                                    </div>
                                }
                                <div class="card-body p-4 d-flex flex-column justify-content-between">
                                    <div>
                                        @if (string.IsNullOrWhiteSpace(meal.ImagePath))
                                        {
                                            <!-- Header row of meal card (when no image) -->
                                            <div class="d-flex align-items-center justify-content-between mb-2">
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="badge bg-@mealTypeColor text-white px-2 py-1 fw-semibold" style="font-size: 0.75rem;">
                                                        <i class="bi @mealIcon me-1"></i> @meal.MealType
                                                    </span>
                                                    <span class="text-muted small fw-medium">
                                                        <i class="bi bi-clock me-1"></i> @meal.ScheduledTime
                                                    </span>
                                                </div>

                                                <div id="status-pill-@meal.DietMealId">
                                                    @if (meal.IsConsumedToday)
                                                    {
                                                        <span class="badge bg-success text-white px-2 py-1 d-inline-flex align-items-center gap-1">
                                                            <i class="bi bi-check-circle-fill"></i> Consumed @(meal.ConsumedTime != null ? "@ " + meal.ConsumedTime : "")
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-light text-secondary border px-2 py-1">Scheduled</span>
                                                    }
                                                </div>
                                            </div>
                                        }

                                        <!-- Meal Title & Nutrition Pill -->
                                        <h5 class="fw-bold text-dark mb-1">@meal.MealName</h5>
                                        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                                            <span class="badge bg-warning-subtle text-dark border border-warning-subtle fw-semibold">
                                                <i class="bi bi-fire text-danger me-1"></i>@meal.Calories kcal
                                            </span>
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                                @meal.ProteinGrams g Protein
                                            </span>
                                            <span class="badge bg-info-subtle text-info border border-info-subtle">
                                                @meal.CarbsGrams g Carbs
                                            </span>
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                                @meal.FatsGrams g Fats
                                            </span>
                                        </div>

                                        <!-- Ingredients & Portion Box -->
                                        <div class="p-3 rounded-3 bg-light border border-light-subtle mb-3">
                                            <div class="text-uppercase text-muted x-small fw-bold mb-1">
                                                <i class="bi bi-basket me-1"></i> Ingredients &amp; Portion:
                                            </div>
                                            <div class="text-dark" style="font-size: 0.94rem; line-height: 1.45;">
                                                @(string.IsNullOrWhiteSpace(meal.IngredientsAndPortion) ? "Standard balanced portion as prescribed by coach." : meal.IngredientsAndPortion)
                                            </div>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(meal.TrainerNotes))
                                        {
                                            <div class="p-2 px-3 rounded-2 bg-primary-subtle border border-primary-subtle mb-3" style="font-size: 0.88rem;">
                                                <i class="bi bi-chat-quote-fill text-primary me-1"></i>
                                                <strong class="text-primary">Coach Tip:</strong> @meal.TrainerNotes
                                            </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(meal.ClientNotes))
                                        {
                                            <div class="p-2 px-3 rounded-2 bg-success-subtle border border-success-subtle mb-3" style="font-size: 0.88rem;" id="client-notes-display-@meal.DietMealId">
                                                <i class="bi bi-pencil-square text-success me-1"></i>
                                                <strong class="text-success">My Note:</strong> @meal.ClientNotes
                                            </div>
                                        }
                                    </div>

                                    <!-- Action Buttons -->
                                    <div class="pt-3 border-top d-flex align-items-center justify-content-between gap-2">
                                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-2 d-flex align-items-center gap-1"
                                                onclick="openCustomModalForMeal('@meal.DietMealId', '@Html.Raw(HttpUtility.JavaScriptStringEncode(meal.MealName))', '@meal.MealType', @meal.Calories, @meal.ProteinGrams, @meal.CarbsGrams, @meal.FatsGrams, '@Html.Raw(HttpUtility.JavaScriptStringEncode(meal.ServingSize ?? ""))')">
                                            <i class="bi bi-pencil-square"></i> Log with Notes
                                        </button>

                                        <div id="toggle-btn-container-@meal.DietMealId">
                                            @if (meal.IsConsumedToday)
                                            {
                                                <button type="button" class="btn btn-outline-danger btn-sm rounded-2 d-flex align-items-center gap-1" onclick="toggleMealConsumed(@meal.DietMealId, false)">
                                                    <i class="bi bi-arrow-counterclockwise"></i> Undo Consumption
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-success btn-sm rounded-2 d-flex align-items-center gap-1 px-3 shadow-sm" onclick="toggleMealConsumed(@meal.DietMealId, true)">
                                                    <i class="bi bi-check2-circle fs-6"></i> Mark as Consumed
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="rounded-circle bg-light d-inline-flex p-4 mb-3">
                        <i class="bi bi-calendar-x fs-1 text-muted"></i>
                    </div>
                    <h5 class="fw-bold text-dark">No Specific Meals Scheduled Today</h5>
                    <p class="text-muted">You can log your custom meals, snacks, or hydration directly below.</p>
                    <button type="button" class="btn btn-primary px-4 py-2 rounded-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#logMealModal">
                        <i class="bi bi-plus-circle me-1"></i> Record Custom Meal
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- 3. RECENT MEAL CONSUMPTION LOGS & COACH GUIDELINES -->
    <div class="row g-4">
        <!-- Recent Logs Table -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 py-3 px-4 d-flex align-items-center justify-content-between">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-clock-history text-primary me-2"></i>Recent Consumed Meals &amp; Notes
                    </h6>
                    <a href="@Url.Action("Calendar", "Diet", new { area = "Client" })" class="text-primary small fw-semibold text-decoration-none">
                        View All History <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
                <div class="card-body p-0">
                    @if (Model.RecentLogs != null && Model.RecentLogs.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light text-muted x-small text-uppercase">
                                    <tr>
                                        <th class="ps-4">Date / Time</th>
                                        <th>Meal &amp; Type</th>
                                        <th>Calories &amp; Macros</th>
                                        <th>Notes &amp; Feedback</th>
                                        <th class="text-end pe-4">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in Model.RecentLogs)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <div class="fw-semibold text-dark" style="font-size: 0.9rem;">@log.LogDate.ToString("MMM d, yyyy")</div>
                                                <div class="text-muted x-small">@log.LogDate.ToString("hh:mm tt")</div>
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary-subtle text-secondary border x-small mb-1">@log.MealType</span>
                                                <div class="fw-bold text-dark" style="font-size: 0.92rem;">@log.MealName</div>
                                                @if (!string.IsNullOrWhiteSpace(log.PortionSize))
                                                {
                                                    <div class="text-muted x-small">Portion: @log.PortionSize</div>
                                                }
                                            </td>
                                            <td>
                                                <div class="fw-bold text-warning" style="font-size: 0.92rem;">@log.Calories kcal</div>
                                                <div class="text-muted x-small">
                                                    P: @log.ProteinGrams g &bull; C: @log.CarbsGrams g &bull; F: @log.FatsGrams g
                                                </div>
                                            </td>
                                            <td style="max-width: 250px;">
                                                @if (!string.IsNullOrWhiteSpace(log.ClientNotes))
                                                {
                                                    <div class="text-dark small text-truncate" title="@log.ClientNotes">
                                                        <i class="bi bi-chat-left-dots text-secondary me-1"></i>@log.ClientNotes
                                                    </div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(log.CoachFeedback))
                                                {
                                                    <div class="text-success small fw-semibold text-truncate" title="@log.CoachFeedback">
                                                        <i class="bi bi-award-fill text-success me-1"></i>@log.CoachFeedback
                                                    </div>
                                                }
                                                @if (string.IsNullOrWhiteSpace(log.ClientNotes) && string.IsNullOrWhiteSpace(log.CoachFeedback))
                                                {
                                                    <span class="text-muted small italic">Standard portion</span>
                                                }
                                            </td>
                                            <td class="text-end pe-4">
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                    <i class="bi bi-check-circle-fill me-1"></i> Logged
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-journal-x fs-2 d-block mb-1"></i>
                            No meals logged yet. Check off your first meal above!
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Coach Nutrition Rules & Prescribed Guidance -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 py-3 px-4">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-shield-check text-success me-2"></i>Coach Nutrition Protocol
                    </h6>
                </div>
                <div class="card-body p-4 pt-1">
                    <div class="p-3 rounded-3 bg-light border border-light-subtle mb-3">
                        <div class="fw-bold text-dark mb-1" style="font-size: 0.95rem;">
                            <i class="bi bi-bullseye text-primary me-1"></i> Primary Goal:
                        </div>
                        <div class="text-muted small">@client.PrimaryGoal</div>
                    </div>

                    <div class="p-3 rounded-3 bg-light border border-light-subtle mb-3">
                        <div class="fw-bold text-dark mb-1" style="font-size: 0.95rem;">
                            <i class="bi bi-exclamation-triangle text-warning me-1"></i> Allergies &amp; Avoidances:
                        </div>
                        <div class="text-muted small">@client.Allergies</div>
                    </div>

                    @if (plan != null && !string.IsNullOrWhiteSpace(plan.SpecialInstructions))
                    {
                        <div class="p-3 rounded-3 bg-primary-subtle border border-primary-subtle mb-3">
                            <div class="fw-bold text-primary mb-1" style="font-size: 0.95rem;">
                                <i class="bi bi-info-circle-fill me-1"></i> Special Instructions:
                            </div>
                            <div class="text-dark small" style="line-height: 1.5;">@plan.SpecialInstructions</div>
                        </div>
                    }

                    <div class="d-grid mt-3">
                        <a href="@Url.Action("Plan", "Diet", new { area = "Client" })" class="btn btn-outline-success py-2 rounded-3">
                            <i class="bi bi-eye me-1"></i> View Full 7-Day Routine
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- =========================================================================
     MODAL: RECORD CONSUMED MEAL & NOTES
     ========================================================================= -->
<div class="modal fade" id="logMealModal" tabindex="-1" aria-labelledby="logMealModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            @using (Html.BeginForm("LogMeal", "Diet", new { area = "Client" }, FormMethod.Post, new { id = "logMealForm" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="ClientId" value="@client.ClientId" />
                <input type="hidden" name="DietPlanId" id="modalDietPlanId" value="@(plan != null ? (object)plan.DietPlanId : "")" />
                <input type="hidden" name="DietMealId" id="modalDietMealId" value="" />

                <div class="modal-header bg-dark text-white border-0 py-3 px-4">
                    <h5 class="modal-title fw-bold d-flex align-items-center gap-2" id="logMealModalLabel">
                        <i class="bi bi-journal-plus text-success fs-5"></i>
                        <span>Record Consumed Meal &amp; Notes</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-4">
                    <!-- Meal Type & Time -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark small">Meal Category</label>
                            <select class="form-select rounded-3" name="MealType" id="modalMealType" required>
                                <option value="Breakfast">Breakfast</option>
                                <option value="Lunch">Lunch</option>
                                <option value="Dinner">Dinner</option>
                                <option value="Snack">Snack / Pre-Workout</option>
                                <option value="Hydration">Hydration &amp; Shake</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark small">Consumed Date &amp; Time</label>
                            <input type="datetime-local" class="form-control rounded-3" name="LogDate" id="modalLogDate" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                        </div>
                    </div>

                    <!-- Meal Name -->
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark small">Meal Name or Food Description</label>
                        <input type="text" class="form-control rounded-3" name="MealName" id="modalMealName" placeholder="e.g. Grilled Salmon with Sweet Potato" required />
                    </div>

                    <!-- Portion Size -->
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark small">Portion / Serving Size</label>
                        <input type="text" class="form-control rounded-3" name="PortionSize" id="modalPortionSize" placeholder="e.g. 1 bowl, 200g, 1 plate" />
                    </div>

                    <!-- Calories & Macros -->
                    <div class="p-3 bg-light rounded-3 border border-light-subtle mb-3">
                        <div class="text-uppercase text-muted x-small fw-bold mb-2">Nutritional Values (Estimated or Actual)</div>
                        <div class="row g-2">
                            <div class="col-3">
                                <label class="small text-muted mb-1">Calories (kcal)</label>
                                <input type="number" class="form-control form-control-sm rounded-2 text-center fw-bold" name="Calories" id="modalCalories" value="400" min="0" required />
                            </div>
                            <div class="col-3">
                                <label class="small text-muted mb-1">Protein (g)</label>
                                <input type="number" class="form-control form-control-sm rounded-2 text-center" name="ProteinGrams" id="modalProtein" value="35" min="0" />
                            </div>
                            <div class="col-3">
                                <label class="small text-muted mb-1">Carbs (g)</label>
                                <input type="number" class="form-control form-control-sm rounded-2 text-center" name="CarbsGrams" id="modalCarbs" value="40" min="0" />
                            </div>
                            <div class="col-3">
                                <label class="small text-muted mb-1">Fats (g)</label>
                                <input type="number" class="form-control form-control-sm rounded-2 text-center" name="FatsGrams" id="modalFats" value="12" min="0" />
                            </div>
                        </div>
                    </div>

                    <!-- Client Personal Notes -->
                    <div class="mb-2">
                        <label class="form-label fw-bold text-dark small">My Reflection / Notes for Coach</label>
                        <textarea class="form-control rounded-3" name="ClientNotes" id="modalClientNotes" rows="3" placeholder="How did this meal make you feel? Any ingredient substitutions, hunger levels, or digestive reflections..."></textarea>
                    </div>
                </div>

                <div class="modal-footer bg-light border-top-0 py-3 px-4">
                    <button type="button" class="btn btn-outline-secondary px-3 rounded-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success px-4 rounded-3 d-flex align-items-center gap-1 shadow-sm">
                        <i class="bi bi-check2-circle fs-6"></i> Save Meal Record
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<script>
    // Quick Toggle Prescribed Meal Consumed / Undo
    function toggleMealConsumed(mealId, markConsumed) {
        var token = $('input[name="__RequestVerificationToken"]').val();
        $.ajax({
            url: '@Url.Action("QuickToggleMeal", "Diet", new { area = "Client" })',
            type: 'POST',
            data: { 
                __RequestVerificationToken: token,
                dietMealId: mealId, 
                markConsumed: markConsumed 
            },
            success: function(resp) {
                if (resp.success) {
                    // Reload to update real macro charts, progress rings and table
                    window.location.reload();
                } else {
                    alert(resp.message || 'Error updating meal.');
                }
            },
            error: function() {
                alert('Could not update meal. Please check connection.');
            }
        });
    }

    // Quick Water Log
    function logWaterQuick(liters) {
        var token = $('input[name="__RequestVerificationToken"]').val();
        $.ajax({
            url: '@Url.Action("LogWater", "Diet", new { area = "Client" })',
            type: 'POST',
            data: { 
                __RequestVerificationToken: token,
                amountLiters: liters 
            },
            success: function(resp) {
                if (resp.success) {
                    $('#waterLitersText').text(resp.totalWaterLiters.toFixed(1));
                    $('#waterGlassesCount').text(resp.totalGlasses);
                } else {
                    alert(resp.message || 'Error logging hydration.');
                }
            },
            error: function() {
                alert('Could not record water.');
            }
        });
    }

    // Populate modal with prescribed meal info for customized logging
    function openCustomModalForMeal(mealId, name, type, cal, prot, carb, fat, portion) {
        $('#modalDietMealId').val(mealId);
        $('#modalMealName').val(name);
        $('#modalMealType').val(type);
        $('#modalCalories').val(cal);
        $('#modalProtein').val(prot);
        $('#modalCarbs').val(carb);
        $('#modalFats').val(fat);
        $('#modalPortionSize').val(portion);
        $('#modalClientNotes').val('');

        var modal = new bootstrap.Modal(document.getElementById('logMealModal'));
        modal.show();
    }
</script>
