@model HealthTrack.Areas.Client.ViewModels.ClientTrackingViewModel

@{
    ViewBag.Title = "Water & Sleep Tracking";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4 px-4">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-droplet-half text-info"></i> Water &amp; Sleep Habits
            </h3>
            <p class="text-muted small mb-0">Record daily hydration, log restful sleep sessions, and review your weekly consistency.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (Model.TargetWaterLiters > 0)
            {
                using (Html.BeginForm("LogWater", "Tracking", new { area = "Client" }, FormMethod.Post, new { @class = "d-inline" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="amountLiters" value="0.25" />
                    <button type="submit" class="btn btn-outline-info rounded-pill px-3 fw-semibold">
                        <i class="bi bi-droplet-fill me-1"></i> +250ml Quick Glass
                    </button>
                }
            }
            else
            {
                <button type="button" class="btn btn-outline-info rounded-pill px-3 fw-semibold" data-bs-toggle="modal" data-bs-target="#setWaterTargetModal">
                    <i class="bi bi-bullseye me-1"></i> Set Water Target
                </button>
            }
            <button type="button" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#logSleepModal">
                <i class="bi bi-moon-stars-fill me-1"></i> Log Sleep
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 rounded-4 shadow-sm py-3 px-4 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <span>@TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 rounded-4 shadow-sm py-3 px-4 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <span>@TempData["ErrorMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- KPI Summary Row -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="x-small text-uppercase fw-bold text-muted">Today's Hydration</span>
                    <div class="rounded-3 bg-info bg-opacity-10 text-info p-2">
                        <i class="bi bi-droplet-fill fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-dark mb-0">@Model.WaterConsumedTodayLiters.ToString("F2") <span class="fs-6 text-muted">L</span></h3>
                <span class="x-small text-muted">
                    @(Model.TargetWaterLiters > 0 ? $"Target: {Model.TargetWaterLiters.ToString("F1")} L ({Model.WaterAdherencePct}%)" : "No water target configured")
                </span>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="x-small text-uppercase fw-bold text-muted">Water Remaining</span>
                    <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-2">
                        <i class="bi bi-cup-straw fs-5"></i>
                    </div>
                </div>
                @if (Model.TargetWaterLiters > 0)
                {
                    <h3 class="fw-bold text-primary mb-0">@((Math.Max(0, Model.TargetWaterLiters - Model.WaterConsumedTodayLiters) * 1000).ToString("N0")) <span class="fs-6 text-muted">ml</span></h3>
                    <span class="x-small text-muted">Left to reach daily goal</span>
                }
                else
                {
                    <h3 class="fw-bold text-muted mb-0">--</h3>
                    <a href="javascript:void(0)" class="x-small text-info text-decoration-none fw-semibold" data-bs-toggle="modal" data-bs-target="#setWaterTargetModal">
                        <i class="bi bi-plus-circle me-1"></i>Set daily water target
                    </a>
                }
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="x-small text-uppercase fw-bold text-muted">Last Sleep Duration</span>
                    <div class="rounded-3 bg-indigo bg-opacity-10 text-primary p-2" style="background-color: rgba(102, 16, 242, 0.1);">
                        <i class="bi bi-moon-stars-fill fs-5" style="color: #6610f2;"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-dark mb-0">
                    @(Model.TodaySleep != null ? Model.TodaySleep.DurationHours.ToString("F1") : "--") <span class="fs-6 text-muted">hrs</span>
                </h3>
                <span class="x-small text-muted">
                    @(Model.TodaySleep != null ? $"Rated {Model.TodaySleep.QualityRating ?? 5}/5 stars" : "Not yet logged for today")
                </span>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="x-small text-uppercase fw-bold text-muted">7-Day Sleep Avg</span>
                    <div class="rounded-3 bg-success bg-opacity-10 text-success p-2">
                        <i class="bi bi-activity fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-success mb-0">@Model.AverageSleepHoursLast7Days.ToString("F1") <span class="fs-6 text-muted">hrs/night</span></h3>
                <span class="x-small text-muted">Recommended: 7.0 - 9.0 hrs</span>
            </div>
        </div>
    </div>

    <!-- MAIN CONTENT: 2 COLUMNS (WATER & SLEEP) -->
    <div class="row g-4">
        <!-- 1. WATER TRACKING -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-2 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-droplet-fill text-info fs-5"></i>
                        <h5 class="fw-bold text-dark mb-0">Daily Water Intake</h5>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        @if (Model.TargetWaterLiters > 0)
                        {
                            <span class="badge bg-info-subtle text-info border border-info-subtle x-small">
                                @Model.WaterConsumedTodayMl / @Model.TargetWaterMl ml
                            </span>
                            <button type="button" class="btn btn-sm btn-outline-info py-0 px-2 rounded-pill x-small fw-semibold" data-bs-toggle="modal" data-bs-target="#setWaterTargetModal" title="Edit your daily water target">
                                <i class="bi bi-pencil-square me-1"></i>Edit Target
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-info text-white py-0 px-2 rounded-pill x-small fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#setWaterTargetModal" title="Set your daily water target">
                                <i class="bi bi-plus-circle me-1"></i>Set Daily Water Target
                            </button>
                        }
                    </div>
                </div>
                <div class="card-body p-4 pt-1">
                    <div class="p-3 rounded-4 bg-light mb-3 border">
                        @if (Model.TargetWaterLiters > 0)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="small fw-semibold text-dark">Today's Target Progress</span>
                                <span class="small fw-bold text-info">@Model.WaterAdherencePct%</span>
                            </div>
                            <div class="progress" style="height: 10px;">
                                <div class="progress-bar bg-info" role="progressbar" style="width: @(Model.WaterAdherencePct)%;"></div>
                            </div>
                            <div class="d-flex justify-content-between text-muted x-small mt-2">
                                <span>Consumed: <strong>@Model.WaterConsumedTodayLiters.ToString("F2") L (@Model.WaterConsumedTodayMl ml)</strong></span>
                                <span>Target: <strong>@Model.TargetWaterLiters.ToString("F1") L (@Model.TargetWaterMl ml)</strong></span>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="small fw-semibold text-dark">Today's Water Consumed</span>
                                <span class="badge bg-secondary-subtle text-secondary fw-bold">@Model.WaterConsumedTodayLiters.ToString("F2") L (@Model.WaterConsumedTodayMl ml)</span>
                            </div>
                            <p class="x-small text-muted mb-2">You haven't set a personalized daily water target yet.</p>
                            <button type="button" class="btn btn-sm btn-info text-white rounded-pill px-3 py-1 fw-semibold" data-bs-toggle="modal" data-bs-target="#setWaterTargetModal">
                                <i class="bi bi-bullseye me-1"></i> Set Daily Water Target
                            </button>
                        }
                    </div>

                    @if (Model.TargetWaterLiters > 0)
                    {
                        <!-- Quick Add Water Buttons -->
                        <div class="mb-4">
                            <span class="x-small text-uppercase fw-bold text-muted d-block mb-2">Quick Log Hydration</span>
                            <div class="row g-2">
                                <div class="col-4">
                                    @using (Html.BeginForm("LogWater", "Tracking", new { area = "Client" }, FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="amountLiters" value="0.25" />
                                        <button type="submit" class="btn btn-outline-info rounded-3 w-100 py-2 small fw-semibold">
                                            <i class="bi bi-cup-straw me-1"></i> +250 ml<br /><span class="x-small text-muted">1 Glass</span>
                                        </button>
                                    }
                                </div>
                                <div class="col-4">
                                    @using (Html.BeginForm("LogWater", "Tracking", new { area = "Client" }, FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="amountLiters" value="0.5" />
                                        <button type="submit" class="btn btn-outline-info rounded-3 w-100 py-2 small fw-semibold">
                                            <i class="bi bi-droplet me-1"></i> +500 ml<br /><span class="x-small text-muted">1 Bottle</span>
                                        </button>
                                    }
                                </div>
                                <div class="col-4">
                                    @using (Html.BeginForm("LogWater", "Tracking", new { area = "Client" }, FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="amountLiters" value="1.0" />
                                        <button type="submit" class="btn btn-outline-info rounded-3 w-100 py-2 small fw-semibold">
                                            <i class="bi bi-water me-1"></i> +1.0 L<br /><span class="x-small text-muted">Large Bottle</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="p-3 rounded-4 bg-light border text-center mb-4">
                            <i class="bi bi-droplet-half text-info fs-3 d-block mb-1"></i>
                            <h6 class="fw-bold text-dark mb-1">Set Your Daily Hydration Goal</h6>
                            <p class="x-small text-muted mb-2">
                                Set your personalized daily water-intake target in millilitres (ml) to unlock quick hydration logging.
                            </p>
                            <button type="button" class="btn btn-sm btn-info text-white rounded-pill px-3 py-1 fw-semibold" data-bs-toggle="modal" data-bs-target="#setWaterTargetModal">
                                <i class="bi bi-plus-circle me-1"></i> Set Daily Water Target
                            </button>
                        </div>
                    }

                    <!-- 7-Day Water History Table -->
                    <h6 class="fw-bold text-dark small mb-2">Past 7 Days Hydration History</h6>
                    @if (Model.WaterHistory.Any())
                    {
                        <div class="list-group list-group-flush border rounded-3 overflow-hidden">
                            @foreach (var w in Model.WaterHistory)
                            {
                                <div class="list-group-item d-flex align-items-center justify-content-between py-2 px-3">
                                    <div>
                                        <span class="small fw-semibold text-dark">@w.Date.ToString("ddd, MMM dd")</span>
                                        @if (w.Date.Date == DateTime.Today.Date)
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle x-small ms-1">Today</span>
                                        }
                                    </div>
                                    <div class="d-flex align-items-center gap-3">
                                        <span class="small fw-bold text-dark">@w.WaterLiters.ToString("F2") L</span>
                                        <div class="progress" style="width: 70px; height: 6px;">
                                            <div class="progress-bar bg-info" style="width: @(w.AdherencePct)%;"></div>
                                        </div>
                                        <span class="x-small text-muted" style="width: 35px; text-align: right;">@w.AdherencePct%</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- 2. SLEEP TRACKING -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-2 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-moon-stars-fill fs-5" style="color: #6610f2;"></i>
                        <h5 class="fw-bold text-dark mb-0">Sleep &amp; Recovery Logs</h5>
                    </div>
                    <button type="button" class="btn btn-sm btn-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#logSleepModal">
                        <i class="bi bi-plus-circle me-1"></i> Log Sleep
                    </button>
                </div>
                <div class="card-body p-4 pt-1">
                    @if (Model.TodaySleep != null)
                    {
                        <div class="p-3 rounded-4 mb-3 border" style="background-color: rgba(102, 16, 242, 0.04);">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge border px-3 py-1 rounded-pill" style="background-color: rgba(102, 16, 242, 0.1); color: #6610f2; border-color: rgba(102, 16, 242, 0.2) !important;">
                                    Latest Session: @Model.TodaySleep.SleepDate.ToString("MMM dd")
                                </span>
                                <div class="text-warning small">
                                    @for (int i = 1; i <= (Model.TodaySleep.QualityRating ?? 5); i++)
                                    {
                                        <i class="bi bi-star-fill"></i>
                                    }
                                </div>
                            </div>
                            <div class="d-flex align-items-baseline gap-2 my-2">
                                <h3 class="fw-bold text-dark mb-0">@Model.TodaySleep.DurationHours.ToString("F1")</h3>
                                <span class="text-muted fw-semibold">hours of sleep</span>
                            </div>
                            <div class="row g-2 text-muted x-small pt-2 border-top">
                                <div class="col-6">
                                    <i class="bi bi-alarm me-1"></i> Bedtime: <strong>@Model.TodaySleep.BedTime.ToString("hh:mm tt")</strong>
                                </div>
                                <div class="col-6">
                                    <i class="bi bi-sun me-1 text-warning"></i> Wake time: <strong>@Model.TodaySleep.WakeTime.ToString("hh:mm tt")</strong>
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(Model.TodaySleep.Notes))
                            {
                                <div class="x-small text-secondary mt-2 fst-italic">
                                    Note: "@Model.TodaySleep.Notes"
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="p-3 rounded-4 bg-light border text-center text-muted mb-3">
                            <i class="bi bi-moon-stars fs-3 d-block mb-1 text-secondary opacity-50"></i>
                            <span class="small d-block fw-semibold text-dark">No sleep session logged for today yet</span>
                            <span class="x-small text-muted">Log your bedtime and wake-up time to track recovery.</span>
                        </div>
                    }

                    <!-- Sleep History List -->
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold text-dark small mb-0">Recent Sleep History</h6>
                        <span class="x-small text-muted">@Model.TotalSleepLoggedCount Records</span>
                    </div>

                    @if (Model.SleepHistory.Any())
                    {
                        <div class="table-responsive border rounded-3">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr class="x-small text-uppercase text-secondary">
                                        <th>Date</th>
                                        <th>Bedtime</th>
                                        <th>Wake Time</th>
                                        <th>Duration</th>
                                        <th>Quality</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in Model.SleepHistory)
                                    {
                                        <tr>
                                            <td class="small fw-semibold text-dark">@s.SleepDate.ToString("MMM dd")</td>
                                            <td class="x-small text-muted">@s.BedTime.ToString("hh:mm tt")</td>
                                            <td class="x-small text-muted">@s.WakeTime.ToString("hh:mm tt")</td>
                                            <td class="small fw-bold text-dark">@s.DurationHours.ToString("F1") hrs</td>
                                            <td>
                                                <span class="text-warning x-small">
                                                    @(s.QualityRating ?? 5) <i class="bi bi-star-fill"></i>
                                                </span>
                                            </td>
                                            <td>
                                                @using (Html.BeginForm("DeleteSleep", "Tracking", new { area = "Client" }, FormMethod.Post, new { onsubmit = "return confirm('Delete this sleep record?');" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="sleepLogId" value="@s.SleepLogId" />
                                                    <button type="submit" class="btn btn-sm btn-link text-danger p-0" title="Delete">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="bi bi-journal-x fs-3 d-block mb-1"></i>
                            <span class="x-small">No recorded sleep logs found.</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL: LOG SLEEP -->
<div class="modal fade" id="logSleepModal" tabindex="-1" aria-labelledby="logSleepModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            @using (Html.BeginForm("LogSleep", "Tracking", new { area = "Client" }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header border-0 pb-0">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-3 p-2" style="background-color: rgba(102, 16, 242, 0.1); color: #6610f2;">
                            <i class="bi bi-moon-stars-fill fs-5"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold text-dark mb-0" id="logSleepModalLabel">Log Sleep Session</h5>
                            <span class="x-small text-muted">Track your nightly sleep duration and rest quality</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body py-3">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Sleep Date <span class="text-danger">*</span></label>
                        <input type="date" name="SleepDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-secondary">Bed Time <span class="text-danger">*</span></label>
                            <input type="datetime-local" name="BedTime" class="form-control" value="@DateTime.Today.AddDays(-1).ToString("yyyy-MM-ddT22:30")" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-secondary">Wake-up Time <span class="text-danger">*</span></label>
                            <input type="datetime-local" name="WakeTime" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-ddT06:30")" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Sleep Quality (1 - 5 Stars)</label>
                        <select name="QualityRating" class="form-select">
                            <option value="5" selected>5 Stars - Very Rested &amp; Refreshed</option>
                            <option value="4">4 Stars - Good Rest</option>
                            <option value="3">3 Stars - Average / Normal</option>
                            <option value="2">2 Stars - Restless / Woke up multiple times</option>
                            <option value="1">1 Star - Poor / Insomnia</option>
                        </select>
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-semibold text-secondary">Notes (Optional)</label>
                        <input type="text" name="Notes" class="form-control" placeholder="e.g. Slept soundly, drank chamomile tea" maxlength="500" />
                    </div>
                </div>

                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold">
                        <i class="bi bi-save me-1"></i> Save Sleep Log
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- SET / UPDATE DAILY WATER-INTAKE TARGET MODAL (FR-C-32) -->
<div class="modal fade" id="setWaterTargetModal" tabindex="-1" aria-labelledby="setWaterTargetModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            @using (Html.BeginForm("SetWaterTarget", "Tracking", new { area = "Client" }, FormMethod.Post, new { id = "setWaterTargetForm" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header border-0 pb-0">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-3 bg-info bg-opacity-10 text-info p-2">
                            <i class="bi bi-droplet-half fs-4"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold text-dark mb-0" id="setWaterTargetModalLabel">
                                @(Model.TargetWaterMl > 0 ? "Update Daily Water Target" : "Set Daily Water Target")
                            </h5>
                            <span class="x-small text-muted">Personalize your daily hydration goal in millilitres (ml)</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body py-3">
                    <div class="alert alert-light border rounded-3 p-3 mb-3 d-flex align-items-start gap-2">
                        <i class="bi bi-info-circle-fill text-info fs-5 mt-1"></i>
                        <div class="small text-muted">
                            Health guidelines recommend an average daily intake between <strong>2,000 ml (2.0 L)</strong> and <strong>3,000 ml (3.0 L)</strong> depending on your activity level and climate.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="dailyWaterInput" class="form-label small fw-semibold text-secondary">
                            Target Water Intake (ml) <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <input type="number" 
                                   id="dailyWaterInput" 
                                   name="DailyWaterTargetMl" 
                                   class="form-control form-control-lg fw-bold text-dark" 
                                   min="500" 
                                   max="10000" 
                                   step="50" 
                                   value="@(Model.TargetWaterMl > 0 ? Model.TargetWaterMl : 2500)" 
                                   required />
                            <span class="input-group-text bg-light fw-semibold text-muted">ml</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <span class="x-small text-muted">Allowed range: 500 ml – 10,000 ml</span>
                            <span class="x-small fw-semibold text-info" id="waterTargetLitersPreview">
                                = @((Model.TargetWaterMl > 0 ? (Model.TargetWaterMl / 1000.0) : 2.5).ToString("F2")) Litres
                            </span>
                        </div>
                    </div>

                    <!-- Quick Presets -->
                    <div class="mb-2">
                        <label class="form-label x-small text-uppercase fw-bold text-muted mb-2">Quick Presets</label>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 btn-preset-water" data-amount="2000">
                                2,000 ml (2.0 L)
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 btn-preset-water" data-amount="2500">
                                2,500 ml (2.5 L)
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 btn-preset-water" data-amount="3000">
                                3,000 ml (3.0 L)
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 btn-preset-water" data-amount="3500">
                                3,500 ml (3.5 L)
                            </button>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-info text-white rounded-pill px-4 fw-semibold shadow-sm">
                        <i class="bi bi-check-lg me-1"></i> @(Model.TargetWaterMl > 0 ? "Update Target" : "Save Target")
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var waterInput = document.getElementById('dailyWaterInput');
            var previewText = document.getElementById('waterTargetLitersPreview');

            function updatePreview() {
                if (!waterInput || !previewText) return;
                var ml = parseFloat(waterInput.value);
                if (!isNaN(ml) && ml > 0) {
                    var liters = (ml / 1000.0).toFixed(2);
                    previewText.textContent = '= ' + liters + ' Litres';
                } else {
                    previewText.textContent = '--';
                }
            }

            if (waterInput) {
                waterInput.addEventListener('input', updatePreview);
                waterInput.addEventListener('change', updatePreview);
            }

            var presetButtons = document.querySelectorAll('.btn-preset-water');
            presetButtons.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var amt = this.getAttribute('data-amount');
                    if (waterInput && amt) {
                        waterInput.value = amt;
                        updatePreview();
                    }
                });
            });
        });
    </script>
}

