@model HealthTrack.Areas.Client.ViewModels.ClientDashboardViewModel

@{
    ViewBag.Title = "Client Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-3 py-1">

    <!-- HERO HEADER -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #0369a1 100%);">
        <div class="card-body p-4 text-white">
            <div class="row align-items-center g-3">
                <div class="col-lg-8 col-md-7">
                    <div class="d-flex align-items-center gap-3">
                        @if (!string.IsNullOrEmpty(Model.Client?.ProfilePicturePath))
                        {
                            <img src="@Url.Content(Model.Client.ProfilePicturePath)" alt="Profile" class="rounded-circle border border-2 border-white shadow flex-shrink-0" style="width: 68px; height: 68px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-primary bg-opacity-25 text-white border border-2 border-white d-flex align-items-center justify-content-center shadow flex-shrink-0" style="width: 68px; height: 68px;">
                                <i class="bi bi-person-fill fs-2"></i>
                            </div>
                        }
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <h3 class="fw-bold text-white mb-0">Welcome back, @(Model.Client?.FullName ?? "Member")!</h3>
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1 small">
                                    <i class="bi bi-patch-check-fill me-1"></i> Active Member
                                </span>
                            </div>
                            <p class="text-white-50 mb-0 small">
                                Assigned Coach: <strong class="text-white">@(Model.AssignedTrainer != null ? Model.AssignedTrainer.FullName : "Pending Assignment")</strong> 
                                @if (Model.AssignedTrainer != null)
                                {
                                    <span>(@(Model.AssignedTrainer.PrimarySpecialization ?? Model.AssignedTrainer.Specialization ?? "Personal Coach"))</span>
                                }
                                &bull; Primary Goal: <span class="text-info fw-semibold">@(Model.Preferences?.PrimaryGoal ?? "General Fitness")</span>
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-5 text-md-end d-flex flex-wrap justify-content-md-end align-items-center gap-2">
                    <a href="@Url.Action("Index", "Progress", new { area = "Client" })" class="btn btn-sm btn-success d-inline-flex align-items-center gap-2 shadow-sm px-3 py-2 fw-semibold">
                        <i class="bi bi-file-earmark-medical-fill"></i>
                        <span>Progress &amp; Plans Report</span>
                    </a>
                    <div class="d-inline-flex align-items-center gap-2 bg-white bg-opacity-10 rounded-3 px-3 py-2 border border-white border-opacity-10">
                        <i class="bi bi-calendar3 text-info fs-5"></i>
                        <div class="text-start">
                            <div class="x-small text-white-50 text-uppercase fw-semibold">Today's Date</div>
                            <div class="small fw-bold text-white">@DateTime.Today.ToString("dddd, MMMM dd, yyyy")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ALERTS -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5 text-success"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- UPCOMING CONSULTATIONS & COACH SLOTS BANNER -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white overflow-hidden">
        <div class="card-body p-3 p-md-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                @if (Model.NextUpcomingAppointment != null)
                {
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle @(Model.NextUpcomingAppointment.Status == "Approved" ? "bg-success bg-opacity-10 text-success" : "bg-warning bg-opacity-10 text-warning") d-flex align-items-center justify-content-center flex-shrink-0" style="width: 52px; height: 52px;">
                            <i class="bi @(Model.NextUpcomingAppointment.Status == "Approved" ? "bi-calendar-check-fill" : "bi-hourglass-split") fs-4"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="badge @(Model.NextUpcomingAppointment.Status == "Approved" ? "bg-success-subtle text-success border border-success-subtle" : "bg-warning-subtle text-dark border border-warning-subtle") fw-semibold px-2 py-1">
                                    <i class="bi @(Model.NextUpcomingAppointment.Status == "Approved" ? "bi-check-circle-fill" : "bi-clock") me-1"></i>
                                    @(Model.NextUpcomingAppointment.Status == "Approved" ? "Confirmed Consultation" : "Appointment Pending Approval")
                                </span>
                                <span class="badge bg-light text-muted border">@Model.NextUpcomingAppointment.AppointmentCode</span>
                            </div>
                            <h5 class="fw-bold text-dark mb-1">@Model.NextUpcomingAppointment.Title</h5>
                            <div class="small text-muted d-flex flex-wrap align-items-center gap-2">
                                <span><i class="bi bi-person-fill text-primary me-1"></i>Coach: <strong>@(Model.NextUpcomingAppointment.Trainers != null ? Model.NextUpcomingAppointment.Trainers.FullName : "Assigned Coach")</strong></span>
                                <span>&bull;</span>
                                <span><i class="bi bi-calendar-event text-info me-1"></i>@Model.NextUpcomingAppointment.AppointmentDate.ToString("ddd, MMM dd, yyyy")</span>
                                <span>&bull;</span>
                                <span><i class="bi bi-clock text-warning me-1"></i>@DateTime.Today.Add(Model.NextUpcomingAppointment.StartTime).ToString("hh:mm tt") - @DateTime.Today.Add(Model.NextUpcomingAppointment.EndTime).ToString("hh:mm tt")</span>
                                @if (!string.IsNullOrWhiteSpace(Model.NextUpcomingAppointment.MeetingLocation))
                                {
                                    <span>&bull;</span>
                                    <span><i class="bi bi-geo-alt-fill text-danger me-1"></i>@Model.NextUpcomingAppointment.MeetingLocation</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2 ms-auto">
                        <a href="@Url.Action("Index", "Appointments", new { area = "Client" })" class="btn btn-outline-primary rounded-pill px-3 fw-semibold btn-sm">
                            <i class="bi bi-calendar2-range me-1"></i> View Appointments (@Model.UpcomingAppointmentsCount)
                        </a>
                        <a href="@Url.Action("Index", "Appointments", new { area = "Client" })" class="btn btn-primary rounded-pill px-3 fw-semibold btn-sm shadow-sm">
                            <i class="bi bi-calendar-plus me-1"></i> Coach Slots (@Model.AvailableCoachSlotsCount Open)
                        </a>
                    </div>
                }
                else
                {
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center flex-shrink-0" style="width: 52px; height: 52px;">
                            <i class="bi bi-calendar2-plus-fill fs-4"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-semibold px-2 py-1">
                                    <i class="bi bi-calendar-check me-1"></i> 1-on-1 Consultations
                                </span>
                                @if (Model.AvailableCoachSlotsCount > 0)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 fw-bold">
                                        <i class="bi bi-clock-history me-1"></i> @Model.AvailableCoachSlotsCount Open Slot@(Model.AvailableCoachSlotsCount > 1 ? "s" : "") Available
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border px-2 py-1">No open slots posted right now</span>
                                }
                            </div>
                            <h5 class="fw-bold text-dark mb-1">Schedule a Consultation with Your Coach</h5>
                            <p class="small text-muted mb-0">
                                @if (Model.AvailableCoachSlotsCount > 0)
                                {
                                    <span>Your coach has posted <strong>@Model.AvailableCoachSlotsCount open appointment slot@(Model.AvailableCoachSlotsCount > 1 ? "s" : "")</strong> ready for you to reserve for personal training or diet reviews.</span>
                                }
                                else
                                {
                                    <span>You do not have any upcoming consultations scheduled. Check available coach slots anytime to plan your next session.</span>
                                }
                            </p>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2 ms-auto">
                        <a href="@Url.Action("Index", "Appointments", new { area = "Client" })" class="btn btn-primary rounded-pill px-4 fw-semibold btn-sm shadow-sm">
                            <i class="bi bi-calendar-plus-fill me-1"></i> @(Model.AvailableCoachSlotsCount > 0 ? $"Book Session ({Model.AvailableCoachSlotsCount} Open)" : "View Consultations")
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- 1. HEALTH STATISTICS & BIOMETRIC METRICS -->
    <div class="row g-3 mb-4">
        <!-- Current Weight -->
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="x-small text-uppercase fw-bold text-secondary">Current Weight</span>
                        <div class="d-flex align-items-center gap-1">
                            <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill x-small fw-semibold" data-bs-toggle="modal" data-bs-target="#logWeightModal" title="Log a new weight entry">
                                <i class="bi bi-plus-circle me-1"></i>Log
                            </button>
                            <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                <i class="bi bi-speedometer2 fs-6"></i>
                            </div>
                        </div>
                    </div>
                    @if (Model.HasWeightRecords)
                    {
                        <div class="d-flex align-items-baseline gap-2 mb-1">
                            <h3 class="fw-bold text-dark mb-0">@Model.CurrentWeightKg.ToString("F1")</h3>
                            <span class="text-muted fw-semibold">kg</span>
                            <span class="badge @(Model.WeightChangeKg <= 0 ? "bg-success-subtle text-success border border-success-subtle" : "bg-warning-subtle text-warning border border-warning-subtle") x-small ms-auto">
                                <i class="bi @(Model.WeightChangeKg <= 0 ? "bi-arrow-down-right" : "bi-arrow-up-right")"></i> @Math.Abs(Model.WeightChangeKg).ToString("F1") kg
                            </span>
                        </div>
                        <div class="d-flex justify-content-between text-muted x-small mt-2 pt-2 border-top">
                            <span>Baseline: <strong>@Model.BaselineWeightKg.ToString("F1") kg</strong></span>
                            <span>Target: <strong>@(Model.TargetWeightKg > 0 ? Model.TargetWeightKg.ToString("F1") + " kg" : "No goal set")</strong></span>
                        </div>
                        <div class="progress mt-2" style="height: 6px;">
                            <div class="progress-bar bg-primary" role="progressbar" style="width: @(Model.WeightGoalProgressPct)%;"></div>
                        </div>
                        <div class="text-end x-small text-muted mt-1">@Model.WeightGoalProgressPct% to target goal</div>
                    }
                    else
                    {
                        <div class="d-flex align-items-baseline gap-2 mb-1">
                            <h3 class="fw-bold text-muted mb-0">--</h3>
                            <span class="text-muted fw-semibold">kg</span>
                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle x-small ms-auto">No records</span>
                        </div>
                        <div class="text-muted x-small mt-2 pt-2 border-top">
                            <span>No weight progress records logged yet</span>
                        </div>
                        <button type="button" class="btn btn-sm btn-primary w-100 mt-2 py-1 rounded-3 x-small fw-semibold" data-bs-toggle="modal" data-bs-target="#logWeightModal">
                            <i class="bi bi-plus-circle me-1"></i>Log Starting Weight
                        </button>
                    }
                </div>
            </div>
        </div>

        <!-- Body Mass Index (BMI) -->
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="x-small text-uppercase fw-bold text-secondary">Body Mass Index (BMI)</span>
                        <div class="rounded-3 bg-success bg-opacity-10 text-success p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                            <i class="bi bi-heart-pulse-fill fs-6"></i>
                        </div>
                    </div>
                    @if (Model.Bmi > 0)
                    {
                        <div class="d-flex align-items-baseline gap-2 mb-1">
                            <h3 class="fw-bold text-dark mb-0">@Model.Bmi.ToString("F1")</h3>
                            <span class="text-muted fw-semibold">kg/m²</span>
                            <span class="badge bg-success-subtle text-success border border-success-subtle x-small ms-auto">
                                @Model.BmiCategory
                            </span>
                        </div>
                        <div class="d-flex justify-content-between text-muted x-small mt-2 pt-2 border-top">
                            <span>Height: <strong>@(Model.HeightCm > 0 ? Model.HeightCm.ToString("F0") + " cm" : "N/A")</strong></span>
                            <span>Normal: <strong>18.5 - 24.9</strong></span>
                        </div>
                        <div class="progress mt-2" style="height: 6px;">
                            <div class="progress-bar @(Model.Bmi >= 18.5m && Model.Bmi <= 24.9m ? "bg-success" : "bg-warning")" role="progressbar" style="width: @(Model.BmiBarPct)%;"></div>
                        </div>
                        <div class="text-end x-small text-muted mt-1">@Model.BmiCategory</div>
                    }
                    else
                    {
                        <div class="d-flex align-items-baseline gap-2 mb-1">
                            <h3 class="fw-bold text-muted mb-0">--</h3>
                            <span class="text-muted fw-semibold">kg/m²</span>
                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle x-small ms-auto">Pending</span>
                        </div>
                        <div class="text-muted x-small mt-2 pt-2 border-top">
                            <span>Height or weight not yet recorded</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Today's Calorie Target -->
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="x-small text-uppercase fw-bold text-secondary">Daily Nutrition Target</span>
                        <div class="rounded-3 bg-warning bg-opacity-10 text-warning p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                            <i class="bi bi-fire fs-6"></i>
                        </div>
                    </div>
                    @if (Model.ActiveDietPlan != null && Model.DailyCalorieTarget > 0)
                    {
                        <div class="d-flex align-items-baseline gap-2 mb-1">
                            <h3 class="fw-bold text-dark mb-0">@Model.CaloriesConsumedToday</h3>
                            <span class="text-muted fw-semibold">/ @Model.DailyCalorieTarget kcal</span>
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle x-small ms-auto">
                                @Model.CalorieAdherencePct%
                            </span>
                        </div>
                        <div class="d-flex justify-content-between text-muted x-small mt-2 pt-2 border-top">
                            <span>Meals Logged: <strong>@Model.TodayMealLogs.Count</strong></span>
                            <span>Remaining: <strong>@Model.CaloriesRemainingToday kcal</strong></span>
                        </div>
                        <div class="progress mt-2" style="height: 6px;">
                            <div class="progress-bar bg-warning" role="progressbar" style="width: @(Model.CalorieAdherencePct)%;"></div>
                        </div>
                        <div class="text-end x-small text-muted mt-1">@Model.CaloriesRemainingToday kcal remaining today</div>
                    }
                    else
                    {
                        <div class="d-flex align-items-baseline gap-2 mb-1">
                            <h3 class="fw-bold text-muted mb-0">--</h3>
                            <span class="text-muted fw-semibold">kcal</span>
                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle x-small ms-auto">No Plan</span>
                        </div>
                        <div class="text-muted x-small mt-2 pt-2 border-top">
                            <span>No active diet plan assigned</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Hydration -->
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="x-small text-uppercase fw-bold text-secondary">Daily Hydration</span>
                        <div class="rounded-3 bg-info bg-opacity-10 text-info p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                            <i class="bi bi-droplet-fill fs-6"></i>
                        </div>
                    </div>
                    @if (Model.TargetWaterLiters > 0)
                    {
                        <div class="d-flex align-items-baseline gap-2 mb-1">
                            <h3 class="fw-bold text-dark mb-0">@Model.WaterConsumedLiters.ToString("F2")</h3>
                            <span class="text-muted fw-semibold">/ @Model.TargetWaterLiters.ToString("F1") L</span>
                            <span class="badge bg-info-subtle text-info border border-info-subtle x-small ms-auto">
                                @Model.WaterAdherencePct%
                            </span>
                        </div>
                        <div class="d-flex justify-content-between text-muted x-small mt-2 pt-2 border-top">
                            <span>Intake: <strong>@((Model.WaterConsumedLiters * 1000).ToString("N0")) ml</strong></span>
                            <span>Target: <strong>@((Model.TargetWaterLiters * 1000).ToString("N0")) ml</strong></span>
                        </div>
                        <div class="progress mt-2" style="height: 6px;">
                            <div class="progress-bar bg-info" role="progressbar" style="width: @(Model.WaterAdherencePct)%;"></div>
                        </div>
                        <div class="text-end x-small text-muted mt-1">@((Math.Max(0, Model.TargetWaterLiters - Model.WaterConsumedLiters) * 1000).ToString("N0")) ml remaining</div>
                    }
                    else
                    {
                        <div class="d-flex align-items-baseline gap-2 mb-1">
                            <h3 class="fw-bold text-dark mb-0">@Model.WaterConsumedLiters.ToString("F2")</h3>
                            <span class="text-muted fw-semibold">L</span>
                            <span class="badge bg-info-subtle text-info border border-info-subtle x-small ms-auto">Logged</span>
                        </div>
                        <div class="text-muted x-small mt-2 pt-2 border-top">
                            <span>Target intake not configured in diet plan</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- NEXT UPCOMING APPOINTMENT BANNER -->
    @if (Model.NextUpcomingAppointment != null)
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4 text-white overflow-hidden" style="background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);">
            <div class="card-body p-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-white bg-opacity-20 d-flex align-items-center justify-content-center text-white" style="width: 52px; height: 52px; font-size: 1.5rem;">
                        <i class="bi bi-calendar2-check-fill"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-white text-primary fw-bold">Next Consultation</span>
                            @if (Model.NextUpcomingAppointment.Status == "Approved")
                            {
                                <span class="badge bg-success text-white fw-bold"><i class="bi bi-check-circle-fill me-1"></i>Confirmed</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark fw-bold"><i class="bi bi-hourglass-split me-1"></i>Awaiting Approval</span>
                            }
                        </div>
                        <h4 class="fw-bold mb-1 text-white">@Model.NextUpcomingAppointment.Title</h4>
                        <div class="small text-white text-opacity-75">
                            <i class="bi bi-clock me-1"></i>@Model.NextUpcomingAppointment.AppointmentDate.ToString("dddd, MMMM dd, yyyy") &bull;
                            <strong>@DateTime.Today.Add(Model.NextUpcomingAppointment.StartTime).ToString("hh:mm tt")</strong> - <strong>@DateTime.Today.Add(Model.NextUpcomingAppointment.EndTime).ToString("hh:mm tt")</strong>
                            &bull; Coach: <strong>@(Model.NextUpcomingAppointment.Trainers?.FullName ?? "Assigned Coach")</strong>
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a href="@Url.Action("Index", "Appointments", new { area = "Client" })" class="btn btn-light rounded-pill px-4 fw-semibold text-primary shadow-sm">
                        Manage Consultations &rarr;
                    </a>
                </div>
            </div>
        </div>
    }

    <!-- 2. TODAY'S WORKOUT & DIET SUMMARY -->
    <div class="row g-4 mb-4">
        <!-- Today's Workout Routine -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-0 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                            <i class="bi bi-lightning-charge-fill fs-5"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold text-dark mb-0">Today's Workout Plan</h5>
                            <span class="x-small text-muted">@Model.TodayWorkoutDay Routine &bull; Active Phase</span>
                        </div>
                    </div>
                    @if (Model.IsTodayWorkoutCompleted)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fw-semibold">
                            <i class="bi bi-check-circle-fill me-1"></i> Completed Today
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2 rounded-pill fw-semibold">
                            <i class="bi bi-clock-history me-1"></i> Ready to Train
                        </span>
                    }
                </div>
                <div class="card-body p-4">
                    @if (Model.ActiveWorkoutPlan != null)
                    {
                        <div class="p-3 rounded-4 bg-light mb-3 border">
                            <h6 class="fw-bold text-dark mb-1">@Model.ActiveWorkoutPlan.Title</h6>
                            <p class="x-small text-muted mb-2">@(string.IsNullOrWhiteSpace(Model.ActiveWorkoutPlan.Description) ? "Personalized training split tailored by coach." : Model.ActiveWorkoutPlan.Description)</p>
                            <div class="row g-2 text-muted x-small pt-2 border-top">
                                <div class="col-4">
                                    <i class="bi bi-collection-play me-1 text-primary"></i> <strong>@Model.TodayWorkoutExercises.Count</strong> Exercises
                                </div>
                                <div class="col-4">
                                    <i class="bi bi-stopwatch me-1 text-primary"></i> <strong>@(Model.IsTodayWorkoutCompleted ? Model.TodayWorkoutLog?.DurationMinutes : (Model.EstimatedWorkoutDurationMinutes > 0 ? Model.EstimatedWorkoutDurationMinutes : 45))</strong> Mins
                                </div>
                                <div class="col-4">
                                    <i class="bi bi-fire me-1 text-primary"></i> <strong>@(Model.IsTodayWorkoutCompleted ? Model.TodayWorkoutLog?.CaloriesBurned : (Model.EstimatedCaloriesBurned > 0 ? Model.EstimatedCaloriesBurned : 350))</strong> kcal
                                </div>
                            </div>
                        </div>

                        if (Model.IsTodayWorkoutCompleted && Model.TodayWorkoutLog != null)
                        {
                            <div class="alert alert-success border-0 rounded-3 py-2 px-3 small d-flex align-items-center gap-2 mb-3">
                                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                <div>
                                    <strong>Session Logged Today!</strong>
                                    @if (Model.TodayWorkoutLog.PerceivedExertion > 0)
                                    {
                                        <span>Perceived exertion: @Model.TodayWorkoutLog.PerceivedExertion/10.</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(Model.TodayWorkoutLog.ClientNotes))
                                    {
                                        <span>Note: @Model.TodayWorkoutLog.ClientNotes</span>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="p-4 rounded-4 bg-light border text-center text-muted mb-3">
                            <i class="bi bi-calendar-x fs-2 d-block mb-2"></i>
                            <h6 class="fw-bold text-dark mb-1">No Active Workout Plan</h6>
                            <p class="x-small text-muted mb-0">Your assigned coach has not yet prescribed an active workout plan.</p>
                        </div>
                    }

                    <div class="d-flex gap-2">
                        <a href="@Url.Action("Index", "Workout", new { area = "Client" })" class="btn btn-primary rounded-3 flex-grow-1 fw-semibold">
                            <i class="bi bi-speedometer2 me-1"></i> Go to Workout Hub
                        </a>
                        <a href="@Url.Action("Plan", "Workout", new { area = "Client" })" class="btn btn-outline-secondary rounded-3 fw-semibold">
                            <i class="bi bi-eye me-1"></i> View Routine
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Today's Nutrition & Diet Split -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-0 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-3 bg-success bg-opacity-10 text-success p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                            <i class="bi bi-egg-fried fs-5"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold text-dark mb-0">Today's Nutrition Summary</h5>
                            <span class="x-small text-muted">@(Model.ActiveDietPlan?.Title ?? "Assigned Nutrition Split")</span>
                        </div>
                    </div>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fw-semibold">
                        <i class="bi bi-check2-all me-1"></i> @Model.TodayMealLogs.Count Meals Logged
                    </span>
                </div>
                <div class="card-body p-4">
                    @if (Model.ActiveDietPlan != null)
                    {
                        <div class="row g-2 mb-3">
                            <div class="col-4">
                                <div class="p-2 rounded-3 bg-light border text-center">
                                    <div class="x-small text-muted text-uppercase fw-bold">Protein</div>
                                    <div class="fw-bold text-dark small my-1">@Model.ProteinConsumedGrams / @Model.TargetProteinGrams g</div>
                                    <div class="progress" style="height: 5px;">
                                        <div class="progress-bar bg-danger" style="width: @(Model.ProteinAdherencePct)%;"></div>
                                    </div>
                                    <div class="x-small text-muted mt-1">@Model.ProteinAdherencePct%</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 rounded-3 bg-light border text-center">
                                    <div class="x-small text-muted text-uppercase fw-bold">Carbs</div>
                                    <div class="fw-bold text-dark small my-1">@Model.CarbsConsumedGrams / @Model.TargetCarbsGrams g</div>
                                    <div class="progress" style="height: 5px;">
                                        <div class="progress-bar bg-primary" style="width: @(Model.CarbsAdherencePct)%;"></div>
                                    </div>
                                    <div class="x-small text-muted mt-1">@Model.CarbsAdherencePct%</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 rounded-3 bg-light border text-center">
                                    <div class="x-small text-muted text-uppercase fw-bold">Fats</div>
                                    <div class="fw-bold text-dark small my-1">@Model.FatsConsumedGrams / @Model.TargetFatsGrams g</div>
                                    <div class="progress" style="height: 5px;">
                                        <div class="progress-bar bg-warning" style="width: @(Model.FatsAdherencePct)%;"></div>
                                    </div>
                                    <div class="x-small text-muted mt-1">@Model.FatsAdherencePct%</div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="p-4 rounded-4 bg-light border text-center text-muted mb-3">
                            <i class="bi bi-egg-fried fs-2 d-block mb-2"></i>
                            <h6 class="fw-bold text-dark mb-1">No Active Diet Plan</h6>
                            <p class="x-small text-muted mb-0">No active nutrition plan is currently assigned by your trainer.</p>
                        </div>
                    }

                    <div class="d-flex gap-2">
                        <a href="@Url.Action("Index", "Diet", new { area = "Client" })" class="btn btn-success rounded-3 flex-grow-1 fw-semibold">
                            <i class="bi bi-pie-chart me-1"></i> Go to Diet Hub
                        </a>
                        <a href="@Url.Action("Plan", "Diet", new { area = "Client" })" class="btn btn-outline-secondary rounded-3 fw-semibold">
                            <i class="bi bi-journal-text me-1"></i> View Diet Plan
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. HEALTH GOAL PROGRESS & COACH GUIDANCE -->
    <div class="row g-4">
        <!-- Goal Milestones -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-2 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-flag-fill text-primary fs-5"></i>
                        <h5 class="fw-bold text-dark mb-0">Active Health Goals</h5>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <a href="@Url.Action("Index", "Goals", new { area = "Client" })" class="x-small text-primary text-decoration-none fw-semibold">
                            Manage &amp; Charts &rarr;
                        </a>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle x-small">
                            @Model.Goals.Count Milestones
                        </span>
                    </div>
                </div>
                <div class="card-body p-4 pt-1">
                    @if (Model.Goals.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var goal in Model.Goals)
                            {
                                int pct = 0;
                                if (goal.IsAchieved)
                                {
                                    pct = 100;
                                }
                                else if (goal.BaselineValue != goal.TargetValue)
                                {
                                    var totalDist = Math.Abs(goal.TargetValue - goal.BaselineValue);
                                    var progressDist = Math.Abs(goal.CurrentValue - goal.BaselineValue);
                                    pct = totalDist > 0 ? (int)Math.Max(0, Math.Min(100, Math.Round((progressDist / totalDist) * 100))) : 0;
                                }

                                <div class="list-group-item px-0 py-3 border-bottom">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <div>
                                            <div class="fw-bold text-dark small">@goal.GoalName</div>
                                            <div class="x-small text-muted">@goal.StatusMessage</div>
                                        </div>
                                        <div class="text-end">
                                            <span class="small fw-bold text-dark">@goal.CurrentValue.ToString("F1") @goal.Unit</span>
                                            <span class="x-small text-muted d-block">Target: @goal.TargetValue.ToString("F1") @goal.Unit</span>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center gap-2 mt-2">
                                        <div class="progress flex-grow-1" style="height: 6px;">
                                            <div class="progress-bar @(goal.IsAchieved ? "bg-success" : "bg-primary")" role="progressbar" style="width: @(pct)%;"></div>
                                        </div>
                                        <span class="x-small fw-bold @(goal.IsAchieved ? "text-success" : "text-primary")">@pct%</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-flag fs-3 d-block mb-2"></i>
                            <p class="small mb-0">No health goals recorded yet.</p>
                        </div>
                    }
                    <div class="mt-3 pt-2 border-top text-center">
                        <a href="@Url.Action("Index", "Goals", new { area = "Client" })" class="btn btn-sm btn-light w-100 rounded-3 fw-semibold text-primary">
                            <i class="bi bi-bar-chart-line me-1"></i> View Goal &amp; Workout Progress Charts
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Coach Guidance & Feedback -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-2 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-chat-quote-fill text-info fs-5"></i>
                        <h5 class="fw-bold text-dark mb-0">Coach Guidance &amp; Feedback</h5>
                    </div>
                    <a href="@Url.Action("Index", "Feedback", new { area = "Client" })" class="x-small text-primary text-decoration-none fw-semibold">
                        All Feedback &rarr;
                    </a>
                </div>
                <div class="card-body p-4 pt-1">
                    @if (Model.RecentCoachFeedback.Any())
                    {
                        foreach (var fb in Model.RecentCoachFeedback)
                        {
                            <div class="p-3 rounded-4 bg-light border mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="badge bg-info-subtle text-info border border-info-subtle x-small">@fb.Category</span>
                                    <span class="x-small text-muted">@fb.SentAt.ToString("MMM dd, yyyy")</span>
                                </div>
                                <h6 class="fw-bold text-dark mb-1">@fb.Title</h6>
                                <p class="x-small text-secondary mb-2">@fb.FeedbackText</p>
                                @if (!string.IsNullOrWhiteSpace(fb.Recommendations))
                                {
                                    <div class="x-small text-dark fw-semibold pt-1 border-top">
                                        <i class="bi bi-lightbulb-fill text-warning me-1"></i> Recommendation: @fb.Recommendations
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="p-3 rounded-4 bg-light border text-center text-muted py-4 mb-3">
                            <i class="bi bi-chat-dots fs-3 d-block mb-1"></i>
                            <span class="small">No feedback messages received yet from your trainer.</span>
                        </div>
                    }

                    <div class="small fw-bold text-secondary text-uppercase x-small mb-2">Recent Completed Sessions</div>
                    @if (Model.RecentWorkoutLogs.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var w in Model.RecentWorkoutLogs)
                            {
                                <div class="list-group-item px-0 py-2 border-bottom">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="small fw-semibold text-dark">@w.SessionName</span>
                                            <div class="x-small text-muted">@w.LogDate.ToString("MMM dd") &bull; @w.DurationMinutes mins &bull; @w.CaloriesBurned kcal</div>
                                        </div>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle x-small">
                                            <i class="bi bi-check-lg"></i> Completed
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-muted x-small py-2">No completed workout sessions logged yet.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL: LOG WEIGHT CHECK-IN -->
    <div class="modal fade" id="logWeightModal" tabindex="-1" aria-labelledby="logWeightModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
            <div class="modal-content border-0 shadow rounded-4">
                @using (Html.BeginForm("LogWeight", "Dashboard", new { area = "Client" }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="modal-header border-0 pb-0">
                        <div class="d-flex align-items-center gap-2">
                            <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                <i class="bi bi-speedometer2"></i>
                            </div>
                            <div>
                                <h6 class="modal-title fw-bold text-dark mb-0" id="logWeightModalLabel">Log Weight Check-in</h6>
                                <p class="x-small text-muted mb-0">Record your current weight to update BMI and progress</p>
                            </div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body pt-3 pb-2">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-secondary">Weight (kg) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="number" step="0.1" min="30" max="300" name="weightKg" class="form-control" placeholder="e.g. 72.5" value="@(Model.CurrentWeightKg > 0 ? Model.CurrentWeightKg.ToString("F1") : "")" required />
                                <span class="input-group-text bg-light fw-semibold text-secondary">kg</span>
                            </div>
                            <div class="form-text x-small text-muted">Enter your weigh-in measurement</div>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-semibold text-secondary">Notes (Optional)</label>
                            <input type="text" name="notes" class="form-control" placeholder="e.g. Morning weigh-in, post-workout" maxlength="200" />
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-sm btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-sm btn-primary rounded-pill px-4 fw-semibold">
                            <i class="bi bi-check2-circle me-1"></i>Save Weigh-in
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

</div>
