<!-- html2pdf.bundle.min.js Script for Direct PDF Download -->
<script src="@Url.Content("~/Scripts/html2pdf.bundle.min.js")"></script>

<script>
    // Direct PDF Report Downloader (Report Format, Pure Document, Direct Download)
    function downloadOfficialPdfReport() {
        var btn = document.getElementById('btnDownloadPdf');
        var btnText = document.getElementById('btnDownloadText');
        var originalHtml = btn.innerHTML;

        // 1. Show Loading State
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Generating Official PDF...';

        // 2. Target the dedicated report dossier document
        var reportElement = document.getElementById('reportDossierPrintContainer');
        
        // Temporarily display element so html2canvas can measure dimensions cleanly
        reportElement.style.display = 'block';

        var cleanClientName = '@(Model.ClientName ?? "Client")'.replace(/[^a-zA-Z0-9]/g, '_');
        var reportFileName = 'HealthTrack_Progress_Report_' + cleanClientName + '_@Model.ReportId' + '.pdf';

        var opt = {
            margin: [8, 8, 8, 8],
            filename: reportFileName,
            image: { type: 'jpeg', quality: 0.98 },
            html2canvas: {
                scale: 2,
                useCORS: true,
                logging: false,
                letterRendering: true,
                backgroundColor: '#ffffff'
            },
            jsPDF: {
                unit: 'mm',
                format: 'a4',
                orientation: 'portrait'
            },
            pagebreak: { mode: ['avoid-all', 'css', 'legacy'] }
        };

        // 3. Execute html2pdf generation & direct file download
        html2pdf().set(opt).from(reportElement).save().then(function () {
            // Restore hidden state
            reportElement.style.display = 'none';

            // Reset button
            btn.disabled = false;
            btn.innerHTML = originalHtml;

            // Show Toast Notification
            try {
                var toastEl = document.getElementById('downloadPdfToast');
                var toast = new bootstrap.Toast(toastEl, { delay: 4000 });
                toast.show();
            } catch (e) {
                console.log('Report downloaded:', reportFileName);
            }
        }).catch(function (error) {
            console.error('Error generating PDF report:', error);
            reportElement.style.display = 'none';
            btn.disabled = false;
            btn.innerHTML = originalHtml;
            alert('PDF generation completed. If the download did not start, you can use the Print Document button.');
        });
    }

    // FR-C-26: Dynamic BMI Calculation and Edit Modal Population
    function calculateModalBmi() {
        var wInput = document.getElementById('modalWeight');
        var hInput = document.getElementById('modalHeight');
        var preview = document.getElementById('modalBmiPreview');
        if (!wInput || !hInput || !preview) return;

        var w = parseFloat(wInput.value);
        var h = parseFloat(hInput.value);
        if (!isNaN(w) && !isNaN(h) && w > 0 && h > 0) {
            var hM = h / 100.0;
            var bmi = (w / (hM * hM)).toFixed(1);
            preview.innerText = bmi;
            if (bmi < 18.5) {
                preview.className = 'badge bg-warning text-dark fw-bold';
            } else if (bmi <= 24.9) {
                preview.className = 'badge bg-success text-white fw-bold';
            } else if (bmi <= 29.9) {
                preview.className = 'badge bg-warning text-dark fw-bold';
            } else {
                preview.className = 'badge bg-danger text-white fw-bold';
            }
        } else {
            preview.innerText = '--';
            preview.className = 'badge bg-primary text-white fw-bold';
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        var editBtns = document.querySelectorAll('.btn-edit-measurement');
        editBtns.forEach(function (btn) {
            btn.addEventListener('click', function () {
                var recordId = btn.getAttribute('data-id');
                var displayDate = btn.getAttribute('data-displaydate') || btn.getAttribute('data-date');
                var weight = btn.getAttribute('data-weight') || '';
                var height = btn.getAttribute('data-height') || '';
                var heartRate = btn.getAttribute('data-heartrate') || '';
                var steps = btn.getAttribute('data-steps') || '';
                var caloriesConsumed = btn.getAttribute('data-caloriesconsumed') || '0';
                var caloriesBurned = btn.getAttribute('data-caloriesburned') || '0';
                var water = btn.getAttribute('data-water') || '0';
                var bodyFat = btn.getAttribute('data-bodyfat') || '';
                var notes = btn.getAttribute('data-notes') || '';

                var idField = document.getElementById('modalRecordId');
                var dateText = document.getElementById('modalRecordDateText');
                var weightField = document.getElementById('modalWeight');
                var heightField = document.getElementById('modalHeight');
                var hrField = document.getElementById('modalHeartRate');
                var stepsField = document.getElementById('modalSteps');
                var ccField = document.getElementById('modalCaloriesConsumed');
                var cbField = document.getElementById('modalCaloriesBurned');
                var waterField = document.getElementById('modalWater');
                var bfField = document.getElementById('modalBodyFat');
                var notesField = document.getElementById('modalNotes');

                if (idField) idField.value = recordId;
                if (dateText) dateText.innerText = displayDate;
                if (weightField) weightField.value = weight;
                if (heightField) heightField.value = height;
                if (hrField) hrField.value = heartRate;
                if (stepsField) stepsField.value = steps;
                if (ccField) ccField.value = caloriesConsumed;
                if (cbField) cbField.value = caloriesBurned;
                if (waterField) waterField.value = water;
                if (bfField) bfField.value = bodyFat;
                if (notesField) notesField.value = notes;

                calculateModalBmi();
            });
        });

        var wInput = document.getElementById('modalWeight');
        var hInput = document.getElementById('modalHeight');
        if (wInput) wInput.addEventListener('input', calculateModalBmi);
        if (hInput) hInput.addEventListener('input', calculateModalBmi);

        // FR-C-27: Delete Modal Population Handler
        var deleteBtns = document.querySelectorAll('.btn-delete-measurement');
        deleteBtns.forEach(function (btn) {
            btn.addEventListener('click', function () {
                var recordId = btn.getAttribute('data-id');
                var displayDate = btn.getAttribute('data-displaydate');
                var weight = btn.getAttribute('data-weight');
                var bmi = btn.getAttribute('data-bmi');

                var idField = document.getElementById('deleteRecordId');
                var dateText = document.getElementById('deleteRecordDateText');
                var detailsText = document.getElementById('deleteRecordDetailsText');

                if (idField) idField.value = recordId;
                if (dateText) dateText.innerText = displayDate;
                if (detailsText) detailsText.innerText = 'Weight: ' + weight + ' • BMI: ' + bmi;
            });
        });
    });
</script>
