@model HealthTrack.Areas.Client.ViewModels.ClientAppointmentIndexViewModel

@{
    ViewBag.Title = "Coach Consultations & Appointments";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4 px-4">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-calendar2-check-fill text-primary"></i> Consultations &amp; Appointments
            </h3>
            <p class="text-muted small mb-0">Schedule 1-on-1 fitness consultations, form reviews, and nutrition strategy sessions with your assigned coach.</p>
        </div>
        <div>
            @if (Model.HasAssignedTrainer)
            {
                <button type="button" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#bookAppointmentModal">
                    <i class="bi bi-calendar-plus-fill"></i> Book Session with Coach
                </button>
            }
            else
            {
                <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2 rounded-pill fw-semibold">
                    <i class="bi bi-person-x-fill me-1"></i> No Assigned Coach Yet
                </span>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 rounded-4 shadow-sm py-3 px-4 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <span>@TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 rounded-4 shadow-sm py-3 px-4 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <span>@TempData["ErrorMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Coach Info Banner -->
    @if (Model.HasAssignedTrainer)
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4 p-3 bg-white">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold fs-4" style="width: 52px; height: 52px;">
                        <i class="bi bi-person-badge-fill"></i>
                    </div>
                    <div>
                        <div class="small text-muted text-uppercase fw-bold" style="letter-spacing: 0.5px;">Your Assigned Coach</div>
                        <h5 class="fw-bold text-dark mb-0">@Model.AssignedTrainerName</h5>
                        <div class="small text-muted">@Model.AssignedTrainerSpecialization &bull; <span class="text-primary">@Model.AssignedTrainerEmail</span></div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-light text-dark border px-3 py-2 fw-semibold">
                        <i class="bi bi-clock-fill text-success me-1"></i> @Model.AvailableSlots.Count Open Booking Slots
                    </span>
                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold" data-bs-toggle="modal" data-bs-target="#bookAppointmentModal">
                        <i class="bi bi-plus-lg me-1"></i> Book Slot
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4 p-4 text-center bg-white">
            <i class="bi bi-person-exclamation text-warning fs-1 mb-2"></i>
            <h5 class="fw-bold text-dark">No Coach Assigned</h5>
            <p class="text-muted small mb-0">You currently do not have an assigned personal trainer. Please contact system support or wait for an administrator to pair you with a certified coach.</p>
        </div>
    }

    <!-- KPI Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="x-small text-uppercase fw-bold text-muted">Upcoming Sessions</span>
                    <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-2">
                        <i class="bi bi-calendar-event-fill fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-dark mb-0">@Model.UpcomingCount</h3>
                <span class="x-small text-muted">Scheduled consultation sessions</span>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="x-small text-uppercase fw-bold text-muted">Pending Confirmation</span>
                    <div class="rounded-3 bg-warning bg-opacity-10 text-warning p-2">
                        <i class="bi bi-hourglass-split fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-warning mb-0">@Model.PendingCount</h3>
                <span class="x-small text-muted">Awaiting coach review</span>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="x-small text-uppercase fw-bold text-muted">Confirmed &amp; Approved</span>
                    <div class="rounded-3 bg-success bg-opacity-10 text-success p-2">
                        <i class="bi bi-check-circle-fill fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-success mb-0">@Model.ApprovedCount</h3>
                <span class="x-small text-muted">Ready to attend</span>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="x-small text-uppercase fw-bold text-muted">Completed History</span>
                    <div class="rounded-3 bg-info bg-opacity-10 text-info p-2">
                        <i class="bi bi-journal-check fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-dark mb-0">@Model.PastCount</h3>
                <span class="x-small text-muted">Past consultations attended</span>
            </div>
        </div>
    </div>

    <style>
        /* Modern Tab Navigation for Client Appointments */
        #appointmentTabs {
            border-bottom: 2px solid #f1f5f9;
            display: flex;
            flex-wrap: wrap;
            gap: 0.25rem;
        }
        #appointmentTabs .nav-link {
            color: #475569;
            background: transparent !important;
            border: none !important;
            border-bottom: 3px solid transparent !important;
            font-weight: 600;
            font-size: 0.95rem;
            padding: 1rem 1.25rem;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            cursor: pointer;
            transition: all 0.2s ease-in-out;
            position: relative;
            bottom: -2px;
        }
        #appointmentTabs .nav-link:hover {
            color: #0f172a;
            background: #f8fafc !important;
            border-radius: 8px 8px 0 0;
        }
        #appointmentTabs .nav-link.active {
            color: #0d6efd !important;
            border-bottom: 3px solid #0d6efd !important;
            font-weight: 700 !important;
            background: transparent !important;
        }
    </style>

    @{
        bool openPastTab = (Model.UpcomingCount == 0 && Model.PastCount > 0);
    }

    <!-- Compact Filter Toolbar (FR-C-62) -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white p-3">
        <form method="get" action="@Url.Action("Index", "Appointments", new { area = "Client" })">
            <div class="row g-2 align-items-end">
                <div class="col-md-3 col-sm-6">
                    <label class="form-label text-muted small fw-semibold mb-1">From Date</label>
                    <input type="date" name="fromDate" class="form-control form-control-sm"
                           value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-md-3 col-sm-6">
                    <label class="form-label text-muted small fw-semibold mb-1">To Date</label>
                    <input type="date" name="toDate" class="form-control form-control-sm"
                           value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-md-3 col-sm-6">
                    <label class="form-label text-muted small fw-semibold mb-1">Status</label>
                    <select name="status" class="form-select form-select-sm">
                        <option value="all" @(Model.FilterStatus == "all" ? "selected" : "")>All Statuses</option>
                        <option value="pending" @(Model.FilterStatus == "pending" ? "selected" : "")>Pending Approval</option>
                        <option value="approved" @(Model.FilterStatus == "approved" ? "selected" : "")>Approved / Confirmed</option>
                        <option value="completed" @(Model.FilterStatus == "completed" ? "selected" : "")>Completed</option>
                        <option value="cancelled" @(Model.FilterStatus == "cancelled" ? "selected" : "")>Cancelled</option>
                        <option value="rejected" @(Model.FilterStatus == "rejected" ? "selected" : "")>Rejected / Declined</option>
                    </select>
                </div>
                <div class="col-md-3 col-sm-6 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold">
                        <i class="bi bi-funnel-fill me-1"></i> Filter
                    </button>
                    @if (Model.HasActiveFilter)
                    {
                        <a href="@Url.Action("Index", "Appointments", new { area = "Client" })" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                            <i class="bi bi-x-circle me-1"></i> Clear Filters
                        </a>
                    }
                </div>
            </div>
        </form>
    </div>

    <!-- Main Navigation Tabs -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden mb-4">
        <div class="card-header bg-white border-bottom p-0 px-4">
            <ul class="nav nav-tabs border-0" id="appointmentTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(openPastTab ? "" : "active")" id="upcoming-tab" data-bs-toggle="tab" data-bs-target="#upcoming" type="button" role="tab" aria-controls="upcoming" aria-selected="@(openPastTab ? "false" : "true")">
                        <i class="bi bi-calendar2-week me-1"></i> Upcoming &amp; Active
                        <span class="badge bg-primary ms-1">@Model.UpcomingCount</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(openPastTab ? "active" : "")" id="past-tab" data-bs-toggle="tab" data-bs-target="#past" type="button" role="tab" aria-controls="past" aria-selected="@(openPastTab ? "true" : "false")">
                        <i class="bi bi-clock-history me-1"></i> Past Consultations
                        <span class="badge bg-secondary ms-1">@Model.PastCount</span>
                    </button>
                </li>
            </ul>
        </div>

        <div class="card-body p-4">
            <div class="tab-content" id="appointmentTabsContent">
                <!-- TAB 1: UPCOMING & ACTIVE -->
                <div class="tab-pane fade @(openPastTab ? "" : "show active")" id="upcoming" role="tabpanel">
                    @if (Model.UpcomingAppointments != null && Model.UpcomingAppointments.Any())
                    {
                        <div class="row g-3">
                            @foreach (var apt in Model.UpcomingAppointments)
                            {
                                <div class="col-lg-6 col-12">
                                    <div class="card border rounded-4 h-100 p-3 shadow-none bg-light bg-opacity-50">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <span class="badge bg-secondary-subtle text-secondary fw-bold me-1">@apt.AppointmentCode</span>
                                                @if (apt.Status == "Approved")
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 fw-bold">
                                                        <i class="bi bi-check-circle-fill me-1"></i> Confirmed
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1 fw-bold">
                                                        <i class="bi bi-hourglass-split me-1"></i> Awaiting Approval
                                                    </span>
                                                }
                                            </div>
                                            <span class="small fw-semibold text-primary">
                                                <i class="bi bi-clock me-1"></i>@apt.AppointmentDate.ToString("ddd, MMM dd, yyyy")
                                            </span>
                                        </div>

                                        <h5 class="fw-bold text-dark mb-1">@apt.Title</h5>
                                        <div class="small text-muted mb-2">
                                            <i class="bi bi-alarm me-1 text-info"></i>
                                            <strong>@DateTime.Today.Add(apt.StartTime).ToString("hh:mm tt")</strong> - <strong>@DateTime.Today.Add(apt.EndTime).ToString("hh:mm tt")</strong>
                                            &bull; Coach: <strong>@apt.TrainerName</strong>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(apt.ClientNotes))
                                        {
                                            <div class="p-2 rounded-3 bg-white border small text-muted mb-2">
                                                <span class="fw-semibold text-dark">Your Goal:</span> @apt.ClientNotes
                                            </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(apt.MeetingLocation))
                                        {
                                            <div class="small text-dark mb-3">
                                                <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                                                Location: <strong>@apt.MeetingLocation</strong>
                                            </div>
                                        }

                                        @if (apt.HasTrainerProposal)
                                        {
                                            <div class="alert alert-warning py-3 px-3 small rounded-3 mb-3 border border-warning shadow-sm">
                                                <div class="d-flex align-items-center justify-content-between mb-2">
                                                    <span class="fw-bold text-dark">
                                                        <i class="bi bi-calendar2-range-fill text-warning me-1"></i>Coach Proposes Alternative Time
                                                    </span>
                                                    <span class="badge bg-warning text-dark fw-bold">Action Requested</span>
                                                </div>
                                                <div class="p-2 bg-white rounded-3 border mb-2">
                                                    <div class="text-muted small mb-1"><i class="bi bi-clock-history me-1"></i>Proposed New Schedule:</div>
                                                    <div class="fw-bold text-primary fs-6">@apt.ProposedDisplayDateTime</div>
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(apt.TrainerProposalMessage))
                                                {
                                                    <div class="text-muted small mb-2 fst-italic">
                                                        <i class="bi bi-chat-left-quote me-1"></i>"@apt.TrainerProposalMessage"
                                                    </div>
                                                }
                                                <div class="d-flex gap-2 justify-content-end pt-2 border-top">
                                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                                            onclick="openRejectProposalModal(@apt.TrainerProposalId, '@apt.AppointmentCode', '@Html.Raw(HttpUtility.JavaScriptStringEncode(apt.Title))', '@Html.Raw(HttpUtility.JavaScriptStringEncode(apt.ProposedDisplayDateTime))')">
                                                        <i class="bi bi-x-circle me-1"></i> Decline
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-success rounded-pill px-4 fw-semibold shadow-sm"
                                                            onclick="openAcceptProposalModal(@apt.TrainerProposalId, '@apt.AppointmentCode', '@Html.Raw(HttpUtility.JavaScriptStringEncode(apt.Title))', '@Html.Raw(HttpUtility.JavaScriptStringEncode(apt.ProposedDisplayDateTime))')">
                                                        <i class="bi bi-check-circle-fill me-1"></i> Accept Alternative
                                                    </button>
                                                </div>
                                            </div>
                                        }

                                        @if (apt.HasPendingRescheduleRequest)
                                        {
                                            <div class="alert alert-info py-2 px-3 small rounded-3 mb-3 border-0 bg-info bg-opacity-10 text-dark">
                                                <div class="d-flex align-items-center gap-2 mb-1">
                                                    <i class="bi bi-hourglass-split text-info fw-bold"></i>
                                                    <strong class="text-info">Reschedule Request Pending Coach Review</strong>
                                                </div>
                                                <div class="small">
                                                    <strong>Requested Slot:</strong> @apt.PendingRescheduleDisplayDateTime
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(apt.PendingRescheduleReason))
                                                {
                                                    <div class="x-small text-muted mt-1 fst-italic">
                                                        Reason: "@apt.PendingRescheduleReason"
                                                    </div>
                                                }
                                                <div class="x-small text-muted mt-1">
                                                    <i class="bi bi-info-circle me-1"></i>Your current session schedule remains active until your coach confirms this request.
                                                </div>
                                            </div>
                                        }

                                        <!-- 24-Hour Policy Notice & Actions -->
                                        <div class="mt-auto pt-2 border-top d-flex flex-wrap align-items-center justify-content-between gap-2">
                                            @if (apt.HasPendingRescheduleRequest)
                                            {
                                                <span class="x-small text-info fw-semibold">
                                                    <i class="bi bi-clock-history me-1"></i>Reschedule under review
                                                </span>
                                                <div class="d-flex gap-2">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" disabled title="A rescheduling request is already awaiting coach approval.">
                                                        <i class="bi bi-hourglass-split me-1"></i> Request Pending
                                                    </button>
                                                    @if (apt.IsEligibleFor24HrChange)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                                                onclick="openCancelModal(@apt.AppointmentId, '@Html.Raw(HttpUtility.JavaScriptStringEncode(apt.Title))')">
                                                            <i class="bi bi-x-circle me-1"></i> Cancel
                                                        </button>
                                                    }
                                                </div>
                                            }
                                            else if (apt.IsEligibleFor24HrChange)
                                            {
                                                <span class="x-small text-muted">
                                                    <i class="bi bi-shield-check text-success me-1"></i>Eligible to reschedule or cancel
                                                </span>
                                                <div class="d-flex gap-2">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3"
                                                            onclick="openRescheduleModal(@apt.AppointmentId, '@Html.Raw(HttpUtility.JavaScriptStringEncode(apt.Title))', '@apt.AppointmentDate.ToString("yyyy-MM-dd")')">
                                                        <i class="bi bi-arrow-repeat me-1"></i> Reschedule
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                                            onclick="openCancelModal(@apt.AppointmentId, '@Html.Raw(HttpUtility.JavaScriptStringEncode(apt.Title))')">
                                                        <i class="bi bi-x-circle me-1"></i> Cancel
                                                    </button>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="x-small text-muted" title="Within 24 hours of start time. Online changes locked per policy.">
                                                    <i class="bi bi-lock-fill text-secondary me-1"></i>Locked (&lt; 24h before start)
                                                </span>
                                                <span class="x-small text-muted">Contact coach directly for urgent changes</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-calendar-check text-muted fs-1 mb-2"></i>
                            @if (Model.HasActiveFilter)
                            {
                                <h5 class="fw-bold text-dark">No Matching Upcoming Consultations</h5>
                                <p class="text-muted small mb-3">No upcoming appointments match your selected date or status filters.</p>
                                <a href="@Url.Action("Index", "Appointments", new { area = "Client" })" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i> Clear Filters
                                </a>
                            }
                            else
                            {
                                <h5 class="fw-bold text-dark">No Upcoming Consultations</h5>
                                <p class="text-muted small mb-3">You don't have any appointments scheduled right now.</p>
                                if (Model.HasAssignedTrainer)
                                {
                                    <button type="button" class="btn btn-primary rounded-pill px-4 fw-semibold" data-bs-toggle="modal" data-bs-target="#bookAppointmentModal">
                                        <i class="bi bi-calendar-plus-fill me-1"></i> Book a Session Now
                                    </button>
                                }
                            }
                        </div>
                    }
                </div>

                <!-- TAB 2: PAST CONSULTATIONS -->
                <div class="tab-pane fade" id="past" role="tabpanel">
                    @if (Model.PastAppointments != null && Model.PastAppointments.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light small text-uppercase fw-bold text-muted">
                                    <tr>
                                        <th>Date &amp; Time</th>
                                        <th>Session Code</th>
                                        <th>Topic</th>
                                        <th>Coach</th>
                                        <th>Status</th>
                                        <th>Coach Feedback / Notes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in Model.PastAppointments)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-semibold text-dark">@p.AppointmentDate.ToString("MMM dd, yyyy")</div>
                                                <div class="x-small text-muted">@DateTime.Today.Add(p.StartTime).ToString("hh:mm tt") - @DateTime.Today.Add(p.EndTime).ToString("hh:mm tt")</div>
                                            </td>
                                            <td><span class="badge bg-light text-dark border">@p.AppointmentCode</span></td>
                                            <td>
                                                <span class="fw-bold text-dark">@p.Title</span>
                                                @if (!string.IsNullOrEmpty(p.ClientNotes))
                                                {
                                                    <div class="x-small text-muted text-truncate" style="max-width: 200px;">@p.ClientNotes</div>
                                                }
                                            </td>
                                            <td>@p.TrainerName</td>
                                            <td>
                                                @if (p.Status == "Completed")
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Completed</span>
                                                }
                                                else if (p.Status == "Cancelled")
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">Cancelled</span>
                                                }
                                                else if (p.Status == "Rejected")
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Declined</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-dark border px-2 py-1">@p.Status</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(p.TrainerNotes))
                                                {
                                                    <span class="small text-dark">@p.TrainerNotes</span>
                                                }
                                                else if (!string.IsNullOrWhiteSpace(p.CancellationReason))
                                                {
                                                    <span class="small text-muted fst-italic">Reason: @p.CancellationReason</span>
                                                }
                                                else
                                                {
                                                    <span class="x-small text-muted">--</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-journal-x text-muted fs-1 mb-2"></i>
                            @if (Model.HasActiveFilter)
                            {
                                <h5 class="fw-bold text-dark">No Matching Past Consultations</h5>
                                <p class="text-muted small mb-3">No previous consultations match your selected date or status filters.</p>
                                <a href="@Url.Action("Index", "Appointments", new { area = "Client" })" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i> Clear Filters
                                </a>
                            }
                            else
                            {
                                <h5 class="fw-bold text-dark">No Previous Appointments</h5>
                                <p class="text-muted small mb-0">Past completed and cancelled consultations will be archived here.</p>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- =========================================================================
     MODAL 1: BOOK NEW APPOINTMENT
     ========================================================================= -->
<div class="modal fade" id="bookAppointmentModal" tabindex="-1" aria-labelledby="bookAppointmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            @using (Html.BeginForm("Book", "Appointments", new { area = "Client" }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header border-0 pb-0 px-4 pt-4">
                    <h5 class="modal-title fw-bold text-dark" id="bookAppointmentModalLabel">
                        <i class="bi bi-calendar-plus-fill text-primary me-2"></i>Book Consultation Session
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    @if (Model.AvailableSlots != null && Model.AvailableSlots.Any())
                    {
                        <!-- Slot Picker -->
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted">Select Available Time Slot <span class="text-danger">*</span></label>
                            <select name="AvailabilityId" class="form-select form-select-lg rounded-3" required>
                                <option value="" disabled selected>-- Choose Available Coach Slot --</option>
                                @foreach (var slot in Model.AvailableSlots)
                                {
                                    <option value="@slot.AvailabilityId">
                                        @slot.AvailableDate.ToString("ddd, MMM dd, yyyy") &bull; @DateTime.Today.Add(slot.StartTime).ToString("hh:mm tt") - @DateTime.Today.Add(slot.EndTime).ToString("hh:mm tt")
                                    </option>
                                }
                            </select>
                        </div>

                        <!-- Title / Topic -->
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted">Session Topic / Goals <span class="text-danger">*</span></label>
                            <input type="text" name="Title" class="form-control" placeholder="e.g. 1-on-1 Form Check &amp; Diet Review" required maxlength="150" />
                        </div>

                        <!-- Notes -->
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted">Questions or Topics to Cover (Optional)</label>
                            <textarea name="ClientNotes" class="form-control" rows="3" placeholder="Tell your coach what you want to focus on during this session..." maxlength="1000"></textarea>
                        </div>

                        <div class="alert alert-info py-2 px-3 small rounded-3 mb-0">
                            <i class="bi bi-info-circle-fill me-1"></i>
                            Your coach will confirm this booking. Per club policy, sessions can be changed up to 24 hours in advance.
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-calendar-x text-warning fs-1 mb-2"></i>
                            <h6 class="fw-bold text-dark">No Open Slots Currently Available</h6>
                            <p class="text-muted small mb-0">Your coach has not posted any new open availability slots yet. Please check back soon or message your coach.</p>
                        </div>
                    }
                </div>
                <div class="modal-footer border-0 pt-0 px-4 pb-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Close</button>
                    @if (Model.AvailableSlots != null && Model.AvailableSlots.Any())
                    {
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                            <i class="bi bi-send-fill me-1"></i> Request Session
                        </button>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- =========================================================================
     MODAL 2: RESCHEDULE APPOINTMENT
     ========================================================================= -->
<div class="modal fade" id="rescheduleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            @using (Html.BeginForm("Reschedule", "Appointments", new { area = "Client" }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="AppointmentId" id="rescheduleAptId" />

                <div class="modal-header border-0 pb-0 px-4 pt-4">
                    <h5 class="modal-title fw-bold text-dark">
                        <i class="bi bi-arrow-repeat text-primary me-2"></i>Request Appointment Rescheduling
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Session</label>
                        <input type="text" class="form-control bg-light" id="rescheduleAptTitle" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Select New Time Slot <span class="text-danger">*</span></label>
                        <select name="NewAvailabilityId" class="form-select rounded-3" required>
                            <option value="" disabled selected>-- Choose New Open Slot --</option>
                            @foreach (var slot in Model.AvailableSlots)
                            {
                                <option value="@slot.AvailabilityId">
                                    @slot.AvailableDate.ToString("ddd, MMM dd, yyyy") &bull; @DateTime.Today.Add(slot.StartTime).ToString("hh:mm tt") - @DateTime.Today.Add(slot.EndTime).ToString("hh:mm tt")
                                </option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Reason for Rescheduling (Optional)</label>
                        <input type="text" name="Reason" class="form-control" placeholder="e.g. Work schedule change" maxlength="500" />
                    </div>

                    <div class="alert alert-info py-2 px-3 small rounded-3 mb-0">
                        <i class="bi bi-info-circle-fill me-1"></i>
                        <strong>Note:</strong> Your coach will review this rescheduling request. Your original session remains confirmed until the new time slot is approved. Rescheduling is permitted at least 24 hours prior to scheduled start.
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 px-4 pb-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold">
                        <i class="bi bi-send-fill me-1"></i>Submit Reschedule Request
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- =========================================================================
     MODAL 3: CANCEL APPOINTMENT
     ========================================================================= -->
<div class="modal fade" id="cancelModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            @using (Html.BeginForm("Cancel", "Appointments", new { area = "Client" }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="AppointmentId" id="cancelAptId" />

                <div class="modal-header border-0 pb-0 px-4 pt-4">
                    <h5 class="modal-title fw-bold text-danger">
                        <i class="bi bi-x-circle-fill me-2"></i>Cancel Consultation Session
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="small text-muted mb-3">
                        Are you sure you want to cancel <strong class="text-dark" id="cancelAptTitle">this session</strong>?
                    </p>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Reason for Cancellation <span class="text-danger">*</span></label>
