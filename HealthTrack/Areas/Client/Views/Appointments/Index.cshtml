        <div class="modal-content border-0 rounded-4 shadow">
            @using (Html.BeginForm("RejectAlternativeProposal", "Appointments", new { area = "Client" }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="ProposalId" id="rejectProposalId" />

                <div class="modal-header border-0 pb-0 px-4 pt-4">
                    <h5 class="modal-title fw-bold text-danger">
                        <i class="bi bi-x-circle-fill me-2"></i>Decline Alternative Appointment Time
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="small text-muted mb-3">
