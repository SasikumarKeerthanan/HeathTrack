                <div class="modal-footer border-0 pt-0 px-4 pb-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Keep Proposal</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold">Decline Proposal</button>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            // Robust tab switching for client appointment tabs
            $('#appointmentTabs button[data-bs-toggle="tab"]').on('click', function (e) {
                e.preventDefault();
                var target = $(this).attr('data-bs-target');

                // Update active tab buttons
                $('#appointmentTabs button').removeClass('active').attr('aria-selected', 'false');
                $(this).addClass('active').attr('aria-selected', 'true');

                // Switch visible pane
                $('#appointmentTabsContent .tab-pane').removeClass('show active');
                $(target).addClass('show active');

                // Remember active tab in browser URL hash
                if (history.replaceState) {
                    history.replaceState(null, null, target);
                }
            });

            // Activate tab from URL hash if present
            var currentHash = window.location.hash;
            if (currentHash) {
                var targetBtn = $('#appointmentTabs button[data-bs-target="' + currentHash + '"]');
                if (targetBtn.length) {
                    targetBtn.trigger('click');
                }
            }
        });

        function openRescheduleModal(id, title, date) {
            $('#rescheduleAptId').val(id);
            $('#rescheduleAptTitle').val(title + ' (' + date + ')');
            var modal = new bootstrap.Modal(document.getElementById('rescheduleModal'));
            modal.show();
        }

        function openCancelModal(id, title) {
            $('#cancelAptId').val(id);
            $('#cancelAptTitle').text(title);
            var modal = new bootstrap.Modal(document.getElementById('cancelModal'));
            modal.show();
        }

        function openAcceptProposalModal(id, code, title, proposedTime) {
            $('#acceptProposalId').val(id);
            $('#acceptProposalTitle').text(title + ' (' + code + ')');
            $('#acceptProposalTime').text(proposedTime);
            var modal = new bootstrap.Modal(document.getElementById('acceptProposalModal'));
            modal.show();
        }

        function openRejectProposalModal(id, code, title, proposedTime) {
            $('#rejectProposalId').val(id);
            $('#rejectProposalTitle').text(title + ' (' + code + ')');
            $('#rejectProposalTime').text(proposedTime);
            var modal = new bootstrap.Modal(document.getElementById('rejectProposalModal'));
            modal.show();
        }
    </script>
}
