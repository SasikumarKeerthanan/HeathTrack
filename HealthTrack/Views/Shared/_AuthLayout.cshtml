<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewBag.Title ?? "Authentication") - HealthTrack</title>
    <link rel="icon" type="image/png" href="@Url.Content("~/Content/images/logo.png")" />
    
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <!-- App CSS -->
    @Styles.Render("~/Content/css")

    <!-- HealthTrack Twilight Dark Auth Styles -->
    <link rel="stylesheet" href="@Url.Content("~/Content/auth.css")" />
</head>
<body>
    <div class="auth-container">
        @RenderBody()
    </div>

    <!-- Simple, Clean Footer -->
    <footer class="text-center py-3 auth-footer small">
        &copy; @DateTime.Now.Year HealthTrack - All rights reserved.
    </footer>

    <!-- Scripts -->
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/jqueryval")
    @RenderSection("Scripts", required: false)
</body>
</html>
